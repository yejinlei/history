        {"entity_name": "浿水", "entity_type": "place", "surface": "浿水"},
        {"entity_name": "持节", "entity_type": "concept", "surface": "信節"},
        {"entity_name": "卫山谕降沮约", "entity_type": "event", "surface": "使衞山……諭右渠……太子……遂不渡浿水，復引歸。天子誅山"}
      ]
    },
    {
      "para_id": "p6",
      "text": "左將軍破浿水上軍，乃前，至城下，圍其西北。樓船亦徃會，居城南。右渠遂堅守城，數月未能下。",
      "mentions": [
        {"entity_name": "荀彘（左将军）", "entity_type": "person", "surface": "左將軍"},
        {"entity_name": "浿水", "entity_type": "place", "surface": "浿水"},
