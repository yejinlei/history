    {
      "para_id": "p5",
      "text": "今天子中寵臣，士人則韓王孫嫣，⟦0⟧宦者則李延年。",
      "mentions": [
        {
          "start": 10,
          "end": 14,
          "entity_id": "person_nx_012",
          "entity_name": "韓嫣",
          "text": "韓王孫嫣"
        },
        {
          "start": 21,
