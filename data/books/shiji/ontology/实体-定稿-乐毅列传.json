        ]
      },
      {
        "name": "燕昭王招贤",
        "alias": [
          "千金买骨",
          "筑黄金台"
        ],
        "note": "昭王屈身下士，先礼郭隗以招贤者；乐毅、邹衍、剧辛等至燕；乐毅为魏使燕，委质为臣，被任为亚卿",
        "evidence": [
          "p1"
        ]
      },
      {
        "name": "齐湣王争帝与骄暴",
        "alias": [],
        "note": "齐湣王南败楚、西摧三晋、击秦、灭中山、破宋，广地千里，与秦昭王争为东西帝而复归之；骄暴致诸侯合从伐齐",
        "evidence": [
          "p2"
        ]
      },
      {
        "name": "五国合纵伐齐济西",
        "alias": [],
        "note": "乐毅为燕昭王约赵惠文王、连楚魏、啖秦以伐齐之利，诸侯争合从；乐毅并护赵楚韩魏燕五国兵，破齐于济西",
        "evidence": [
          "p2"
        ]
      },
      {
        "name": "乐毅下齐七十余城",
        "alias": [
          "乐毅破齐"
        ],
        "note": "乐毅独追入临淄，尽取齐宝财物祭器输燕；燕昭王亲至济上劳军，封乐毅昌国君；乐毅留徇齐五岁，下齐七十余城皆为郡县属燕，惟莒、即墨未服",
        "evidence": [
          "p2",
          "p3"
        ]
      },
      {
        "name": "燕惠王中反间以骑劫代乐毅",
        "alias": [],
        "note": "燕昭王死惠王立，田单反间言乐毅欲王齐；燕惠王使骑劫代将召乐毅；乐毅畏诛降赵，赵封望诸君，尊宠以警动燕齐",
        "evidence": [
          "p3"
        ]
      },
      {
        "name": "田单火牛阵复齐",
        "alias": [
