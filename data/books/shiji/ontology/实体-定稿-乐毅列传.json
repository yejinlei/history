        ]
      },
      {
        "name": "沙丘之乱",
        "alias": [],
        "note": "赵武灵王二十七年（前295）公子成李兑围主父（武灵王）于沙丘宫三月，饿死；乐毅去赵适魏",
        "evidence": [
          "p1"
        ]
      },
      {
        "name": "子之之乱",
        "alias": [],
        "note": "燕王哙让国于相子之，引发内乱；齐宣王乘乱伐燕破之；燕昭王即位谋报复",
        "evidence": [
