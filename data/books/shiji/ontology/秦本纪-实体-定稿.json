{"book":"shiji","chapter":"秦本纪",
"persons":[
{"id": "shiji-person-nvxiu", "name": "女修", "aliases": ["女脩"], "type": "Person", "dynasty": "上古", "role": "始祖", "description": "帝颛顼之苗裔孙女。相传其织布时玄鸟坠卵，女修吞之而生大业，为秦、赵二族传说中的母系始祖。索隐谓秦赵以母族而祖颛顼，非生人之义，别有异说。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-daye", "name": "大业", "aliases": [], "type": "Person", "dynasty": "上古", "role": "始祖", "description": "女修吞玄鸟陨卵所生。娶少典之子女华，生大费。正义引列女传及曹大家注，谓大业即皋陶，为嬴姓远祖。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-nvhua", "name": "女华", "aliases": [], "type": "Person", "dynasty": "上古", "role": "妻族", "description": "少典之女，大业之妻，生大费。见于秦先祖世系之首。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-dafei", "name": "大费", "aliases": ["柏翳", "栢翳", "伯翳", "伯益"], "type": "Person", "dynasty": "上古", "role": "辅臣", "description": "女华之子，佐禹平水土、佐舜调驯鸟兽，帝舜赐姓嬴氏并妻以姚姓玉女。索隐谓其一名伯翳，即尚书之伯益，为嬴姓始祖。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-dalian", "name": "大廉", "aliases": ["鸟俗氏"], "type": "Person", "dynasty": "上古", "role": "先祖", "description": "大费长子，号鸟俗氏。其后有孟戏、中衍，事殷多显。", "evidence": ["P1"], "source": "正文"},
{"id": "shiji-person-ruomu", "name": "若木", "aliases": ["费氏"], "type": "Person", "dynasty": "上古", "role": "先祖", "description": "大费次子，以王父字为费氏。其后有费昌。", "evidence": ["P1"], "source": "正文"},
{"id": "shiji-person-feichang", "name": "费昌", "aliases": [], "type": "Person", "dynasty": "夏商", "role": "先祖", "description": "若木玄孙。当夏桀之时去夏归商，为商汤御，败桀于鸣条。", "evidence": ["P1"], "source": "正文"},
{"id": "shiji-person-mengxi", "name": "孟戏", "aliases": [], "type": "Person", "dynasty": "商", "role": "先祖", "description": "大廉玄孙，与中衍同为鸟身人言。索隐谓旧解以孟戏、中衍为一人，今以孟仲分字，当是二人。", "evidence": ["P1"], "source": "正文"},
{"id": "shiji-person-zhongyan", "name": "中衍", "aliases": [], "type": "Person", "dynasty": "商", "role": "先祖", "description": "大廉玄孙，鸟身人言。帝太戊闻而卜之，使为御，吉，遂妻之。其后世世有功，佐殷国，嬴姓多显为诸侯。", "evidence": ["P1"], "source": "正文"},
{"id": "shiji-person-zhongyu", "name": "中潏", "aliases": [], "type": "Person", "dynasty": "商", "role": "先祖", "description": "中衍玄孙，居西戎，保西垂，生蜚廉。正义引世本作仲滑。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-feilian", "name": "蜚廉", "aliases": ["飞廉"], "type": "Person", "dynasty": "商", "role": "先祖", "description": "中潏之子，善走，与子恶来俱以材力事殷纣。纣死后为坛于霍太山以报，得石棺。复有子季胜。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-elai", "name": "恶来", "aliases": ["恶来革"], "type": "Person", "dynasty": "商", "role": "先祖", "description": "蜚廉之子，有力，与父俱事殷纣。周武王伐纣时被杀。其后为秦之直系先祖。正文又作「恶来革」（P2），二者为同人异名。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-jisheng", "name": "季胜", "aliases": [], "type": "Person", "dynasty": "商", "role": "先祖", "description": "蜚廉之子。其子孙五世至造父，别居赵，为赵氏之祖。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-mengzeng", "name": "孟增", "aliases": ["宅皋狼"], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "季胜之子，幸于周成王，号宅皋狼。正义谓其居皋狼而生衡父。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-hengfu", "name": "衡父", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "孟增之子，生造父。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-zaofu", "name": "造父", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "衡父之子，以善御幸于周缪王。徐偃王作乱时御王长驱归周，一日千里以救乱，缪王以赵城封之，其族由此为赵氏。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-nvfang", "name": "女防", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "恶来之子。生旁皋，为秦之直系先祖。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-panggao", "name": "旁皋", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "女防之子，生太几。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-taiji", "name": "太几", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "旁皋之子，生大骆。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-daluo", "name": "大骆", "aliases": [], "type": "Person", "dynasty": "西周", "role": "先祖", "description": "太几之子。娶申侯之女，生适子成，另有子非子。其族因造父之宠蒙赵城，姓赵氏。", "evidence": ["P2", "P3"], "source": "正文"},
{"id": "shiji-person-feizi", "name": "非子", "aliases": ["秦嬴"], "type": "Person", "dynasty": "西周", "role": "封君·始祖", "description": "大骆之子。居犬丘，好马及畜，善养息之。周孝王召使主马于汧渭之间，马大蕃息，遂邑之秦，使复续嬴氏祀，号秦嬴，为秦国始封之君。", "evidence": ["P2", "P3"], "source": "正文"},
{"id": "shiji-person-qinhou", "name": "秦侯", "aliases": [], "type": "Person", "dynasty": "西周", "role": "君主", "description": "秦嬴之子。立十年卒，生公伯。", "evidence": ["P4"], "source": "正文"},
{"id": "shiji-person-gongbo", "name": "公伯", "aliases": [], "type": "Person", "dynasty": "西周", "role": "君主", "description": "秦侯之子。立三年卒，生秦仲。", "evidence": ["P4"], "source": "正文"},
{"id": "shiji-person-qinzhong", "name": "秦仲", "aliases": [], "type": "Person", "dynasty": "西周", "role": "君主", "description": "公伯之子。周厉王时西戎灭犬丘大骆之族。周宣王即位，以秦仲为大夫诛西戎，秦仲立二十三年死于戎。", "evidence": ["P4", "P5"], "source": "正文"},
{"id": "shiji-person-zhuanggong", "name": "庄公", "aliases": [], "type": "Person", "dynasty": "西周", "role": "君主", "description": "秦仲长子。周宣王召其昆弟五人，与兵七千伐西戎破之，复予秦仲后及大骆地犬丘，为西垂大夫，居西犬丘。", "evidence": ["P5", "P6"], "source": "正文"},
{"id": "shiji-person-shifu", "name": "世父", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "公子", "description": "庄公长子。誓杀戎王为祖父秦仲报仇，遂将击戎，让位其弟襄公。后为戎人所虏，岁余复归。", "evidence": ["P6"], "source": "正文"},
{"id": "shiji-person-xianggong", "name": "襄公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "庄公次子，继庄公立。犬戎与申侯伐周杀幽王，襄公将兵救周有功，又以兵送周平王。平王封为诸侯，赐岐以西之地，襄公于是始国，作西畤祠上帝。十二年伐戎至岐而卒。", "evidence": ["P6"], "source": "正文"},
{"id": "shiji-person-wengong", "name": "文公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "襄公之子。元年居西垂宫，四年至汧渭之会卜居营邑。十六年伐戎败走之，收周余民，地至岐。十三年初有史以纪事，二十年法初有三族之罪。五十年卒葬西山。", "evidence": ["P7"], "source": "正文"},
{"id": "shiji-person-jinggong", "name": "竫公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "太子", "description": "文公太子，先文公而卒，赐谥竫公。其长子后立为宁公。", "evidence": ["P7"], "source": "正文"},
{"id": "shiji-person-ninggong", "name": "宁公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "竫公之子、文公之孙。二年徙居平阳，遣兵伐荡社，灭之。立十二年卒，葬西山。", "evidence": ["P7", "P8"], "source": "正文"},
{"id": "shiji-person-chuzi", "name": "出子", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "宁公之子。宁公卒，大庶长弗忌、威垒、三父废太子武公而立出子。立六年，三父等复令人贼杀之。", "evidence": ["P8"], "source": "正文"},
{"id": "shiji-person-wugong", "name": "武公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "宁公长子。三父等杀出子后复立之。三年诛三父等夷三族。十年伐邽、冀戎初县之，十一年初县杜、郑，灭小虢。二十年卒，初以人从死。", "evidence": ["P8", "P9", "P12"], "source": "正文"},
{"id": "shiji-person-degong", "name": "德公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "武公之弟。元年初居雍城大郑宫，卜居雍。二年初伏，以狗御蛊。立二年卒。", "evidence": ["P12", "P13"], "source": "正文"},
{"id": "shiji-person-xuangong", "name": "宣公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "德公长子。四年作密畤，与晋战河阳胜之。立十二年卒。", "evidence": ["P13", "P14"], "source": "正文"},
{"id": "shiji-person-chenggong", "name": "成公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "德公中子。元年梁伯、芮伯来朝。立四年卒。", "evidence": ["P14", "P15", "P16"], "source": "正文"},
{"id": "shiji-person-mugong", "name": "穆公", "aliases": ["缪公", "任好", "秦缪公"], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "德公少子，名任好。求百里傒、蹇叔而任之，战韩原虏晋惠公，助晋文公入襄王，用由余谋伐戎王，益国十二、开地千里，遂霸西戎。三十九年卒，从死者百七十七人。", "evidence": ["P16", "P17", "P18", "P24", "P34"], "source": "正文"},
{"id": "shiji-person-bailixi", "name": "百里傒", "aliases": ["百里奚", "五羖大夫"], "type": "Person", "dynasty": "春秋", "role": "大夫", "description": "虞国大夫，虞亡被虏为秦穆公夫人媵臣，亡秦走宛为楚人所执。穆公以五羖羊皮赎之，授之国政，号五羖大夫，并荐蹇叔于穆公。", "evidence": ["P18"], "source": "正文"},
{"id": "shiji-person-jianshu", "name": "蹇叔", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "上大夫", "description": "百里傒之友，贤而世莫知。穆公厚币迎以为上大夫。后哭其子西乞术及孟明视之师，预言秦军必败于殽阨。", "evidence": ["P18", "P28"], "source": "正文"},
{"id": "shiji-person-gongsunzhi", "name": "公孙支", "aliases": ["公孙子桑"], "type": "Person", "dynasty": "春秋", "role": "大夫", "description": "秦大夫。晋旱来请粟，主张饥穰更事、不可不与，穆公用其言卒与晋粟。", "evidence": ["P23"], "source": "正文"},
{"id": "shiji-person-pibao", "name": "丕豹", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "大夫", "description": "晋大夫丕郑之子。其父为夷吾所杀，奔秦，说穆公伐晋，穆公阴用之，后使将兵攻晋。", "evidence": ["P21", "P23"], "source": "正文"},
{"id": "shiji-person-mengmingshi", "name": "孟明视", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "将军", "description": "百里傒之子。穆公使与西乞术、白乙丙将兵袭郑，败于殽，三将被晋所虏，后得归。复将兵伐晋，渡河焚船大败晋人，取王官及鄗以报殽之役。", "evidence": ["P28", "P29", "P33"], "source": "正文"},
{"id": "shiji-person-xiqishu", "name": "西乞术", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "将军", "description": "蹇叔之子。与孟明视、白乙丙同将兵袭郑，败于殽被虏。", "evidence": ["P28"], "source": "正文"},
{"id": "shiji-person-baiyibing", "name": "白乙丙", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "将军", "description": "秦将。与孟明视、西乞术同将兵袭郑，败于殽被虏。", "evidence": ["P28"], "source": "正文"},
{"id": "shiji-person-youyu", "name": "由余", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "谋臣", "description": "其先晋人，亡入戎，能晋言。戎王使之观秦，穆公示以宫室积聚，由余讥之。穆公用内史廖之谋离间戎王与由余，由余遂降秦，并献伐戎之形。", "evidence": ["P32", "P34"], "source": "正文"},
{"id": "shiji-person-neishiliao", "name": "内史廖", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "内史", "description": "秦内史。穆公问以制由余之策，廖献遗戎王女乐、为由余请、留而不遣之谋，以疏间戎之君臣。", "evidence": ["P32"], "source": "正文"},
{"id": "shiji-person-kanggong", "name": "康公", "aliases": ["罃"], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "穆公太子，名罃。元年以兵送晋公子雍至令狐，为晋所反击，秦师败。二年伐晋取武城，六年战河曲大败晋军。立十二年卒。", "evidence": ["P34", "P35"], "source": "正文"},
{"id": "shiji-person-gonggong", "name": "共公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "康公之子。立五年卒。", "evidence": ["P35", "P36"], "source": "正文"},
{"id": "shiji-person-huangong", "name": "桓公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "共公之子。在位时秦倍盟与翟合谋击晋，晋率诸侯伐秦追至泾而还。立二十七年卒。", "evidence": ["P36", "P37"], "source": "正文"},
{"id": "shiji-person-jinggong2", "name": "景公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "桓公之子，名后伯车（世本）。时晋悼公为盟主，屡率诸侯伐秦败秦军追至棫林。二十七年与晋平公盟而复背之。立四十年卒。", "evidence": ["P37", "P38"], "source": "正文"},
{"id": "shiji-person-aigong", "name": "哀公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "景公之子。三十一年吴王阖闾伐楚入郢，楚大夫申包胥来告急，秦乃发五百乘救楚败吴师。立三十六年卒。", "evidence": ["P38", "P39"], "source": "正文"},
{"id": "shiji-person-yigong", "name": "夷公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "太子", "description": "哀公太子，蚤死不得立。其子后立为惠公。", "evidence": ["P39"], "source": "正文"},
{"id": "shiji-person-huigong", "name": "惠公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "哀公之孙、夷公之子。惠公元年孔子行鲁相事。立十年卒。", "evidence": ["P39", "P40"], "source": "正文"},
{"id": "shiji-person-daogong", "name": "悼公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "君主", "description": "惠公之子。立十四年卒。孔子以悼公十二年卒。", "evidence": ["P40", "P41"], "source": "正文"},
{"id": "shiji-person-ligonggong", "name": "厉共公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "悼公之子。以兵二万伐大荔取其王城，初县频阳，伐义渠虏其王。立时晋乱，杀智伯分其国与赵、韩、魏。", "evidence": ["P41", "P42"], "source": "正文"},
{"id": "shiji-person-zaogong", "name": "躁公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "厉共公之子。二年南郑反。十三年义渠来伐至渭南。十四年卒，立其弟怀公。", "evidence": ["P42", "P43"], "source": "正文"},
{"id": "shiji-person-huaigong", "name": "怀公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "躁公之弟。四年庶长鼂与大臣围怀公，怀公自杀。其太子昭子早死，大臣乃立昭子之子为灵公。", "evidence": ["P43", "P44"], "source": "正文"},
{"id": "shiji-person-linggong", "name": "灵公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "怀公之孙、昭子之子。六年晋城少梁，秦击之。十三年城籍姑。卒后子献公不得立。", "evidence": ["P44", "P45"], "source": "正文"},
{"id": "shiji-person-jianggong", "name": "简公", "aliases": ["悼子"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "昭子之弟而怀公之子。灵公卒后献公不得立，乃立简公。六年令吏初带剑，壍洛，城重泉。十六年卒。", "evidence": ["P45", "P46"], "source": "正文"},
{"id": "shiji-person-huigong2", "name": "惠公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "简公之子。十二年子出子生，十三年伐蜀取南郑。卒后出子立。", "evidence": ["P46", "P47"], "source": "正文"},
{"id": "shiji-person-chuzi2", "name": "出子", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "惠公之子。立二年，庶长改迎灵公之子献公于河西而立之，杀出子及其母，沈之渊旁。", "evidence": ["P47", "P48"], "source": "正文"},
{"id": "shiji-person-xiangong", "name": "献公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "灵公之子。元年止从死，二年城栎阳。二十一年与晋战石门斩首六万，二十三年与魏晋战少梁虏将公孙痤。二十四年卒，子孝公立。", "evidence": ["P48", "P49"], "source": "正文"},
{"id": "shiji-person-xiaogong", "name": "孝公", "aliases": [], "type": "Person", "dynasty": "战国", "role": "君主", "description": "献公之子。元年下令求强秦之奇计，卫鞅因景监求见，三年用鞅法变法修刑，拜鞅为左庶长。十二年作咸阳徙都之，并诸小乡聚为四十一县，为田开阡陌。十九年天子致伯。", "evidence": ["P49", "P50", "P53", "P54"], "source": "正文"},
{"id": "shiji-person-shangyang", "name": "商鞅", "aliases": ["卫鞅", "公孙鞅", "商君"], "type": "Person", "dynasty": "战国", "role": "改革家", "description": "卫人，西入秦说孝公变法修刑，内务耕稼、外劝战死之赏罚。拜左庶长，后为大良造，将兵围魏安邑降之，击魏虏公子卬，封列侯号商君。孝公卒后被车裂以徇秦国。", "evidence": ["P51", "P53", "P54", "P56", "P58"], "source": "正文"},
{"id": "shiji-person-huiwenjun", "name": "惠文君", "aliases": ["惠王", "秦惠王"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "孝公之子。元年楚、韩、赵、蜀人来朝，三年王冠。十年张仪相秦，魏纳上郡十五县。十三年称王更元，使张仪伐取陕，出其人予魏。", "evidence": ["P58", "P59", "P60", "P61", "P62"], "source": "正文"},
{"id": "shiji-person-zhangyi", "name": "张仪", "aliases": [], "type": "Person", "dynasty": "战国", "role": "相国", "description": "魏人。惠文君十年相秦，说魏纳上郡十五县，后与齐楚大臣会齧桑，又相魏、相楚。秦武王时东出之魏，死于魏。", "evidence": ["P60", "P61", "P62", "P63"], "source": "正文"},
{"id": "shiji-person-simacuo", "name": "司马错", "aliases": [], "type": "Person", "dynasty": "战国", "role": "将军", "description": "秦将。惠文君九年伐蜀灭之，取赵中都西阳。昭襄王六年蜀侯煇反，错定蜀；二十七年发陇西因蜀攻楚黔中拔之。", "evidence": ["P61", "P64", "P65"], "source": "正文"},
{"id": "shiji-person-ganmao", "name": "甘茂", "aliases": [], "type": "Person", "dynasty": "战国", "role": "丞相", "description": "武王二年与樗里疾为左右丞相。武王使甘茂、庶长封伐宜阳，四年拔宜阳斩首六万。昭襄王元年出之魏。", "evidence": ["P63", "P64"], "source": "正文"},
{"id": "shiji-person-wuwang", "name": "武王", "aliases": ["悼武王"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "惠文君之子。有力好戏，力士任鄙、乌获、孟说皆至大官。二年初置丞相。使甘茂伐宜阳拔之。与孟说举鼎绝膑而死，无子，立异母弟昭襄王。", "evidence": ["P62", "P63"], "source": "正文"},
{"id": "shiji-person-zhaoxiangwang", "name": "昭襄王", "aliases": ["秦昭王"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "武王异母弟，母芈氏号宣太后。即位后以穰侯魏冉为相、白起为将，取郢为南郡，破赵于长平，取西周，周民东亡九鼎入秦，周初亡。五十六年卒。", "evidence": ["P63", "P64", "P65", "P66", "P67"], "source": "正文"},
{"id": "shiji-person-xuantaihou", "name": "宣太后", "aliases": ["芈氏"], "type": "Person", "dynasty": "战国", "role": "太后", "description": "昭襄王之母，楚人，姓芈氏。昭襄王时主政，四十二年薨，葬芷阳郦山。", "evidence": ["P63", "P65"], "source": "正文"},
{"id": "shiji-person-baiqi", "name": "白起", "aliases": ["武安君"], "type": "Person", "dynasty": "战国", "role": "将军", "description": "秦名将。昭襄王时历左更、大良造，攻韩魏于伊阙斩首二十四万，攻楚取郢为南郡，大破赵于长平四十余万尽杀之。后以罪为士伍迁阴密，赐死。", "evidence": ["P64", "P65"], "source": "正文"},
{"id": "shiji-person-weiran", "name": "魏冉", "aliases": ["穰侯"], "type": "Person", "dynasty": "战国", "role": "相国", "description": "昭襄王时秦相，封穰侯。十二年魏冉为相，屡相秦，攻魏至大梁破暴鸢。四十一年穰侯出之陶。", "evidence": ["P64", "P65"], "source": "正文"},
{"id": "shiji-person-xiaowenwang", "name": "孝文王", "aliases": ["柱"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "昭襄王之子，名柱（索隐）。元年赦罪人，修先王功臣，褒厚亲戚。除丧十月即位，三日卒。", "evidence": ["P67", "P68"], "source": "正文"},
{"id": "shiji-person-zhuangxiangwang", "name": "庄襄王", "aliases": ["子楚"], "type": "Person", "dynasty": "战国", "role": "君主", "description": "孝文王之子，名子楚（索隐）。元年大赦，使相国吕不韦诛东周君，蒙骜伐韩韩献成皋巩，初置三川郡。三年卒，子政立。", "evidence": ["P68", "P69"], "source": "正文"},
{"id": "shiji-person-lvbuwei", "name": "吕不韦", "aliases": [], "type": "Person", "dynasty": "战国", "role": "相国", "description": "庄襄王元年为秦相国，奉命诛东周君，尽入其国，而不绝其祀，以阳人地赐周君奉其祭祀。", "evidence": ["P69"], "source": "正文"},
{"id": "shiji-person-mengao", "name": "蒙骜", "aliases": [], "type": "Person", "dynasty": "战国", "role": "将军", "description": "庄襄王时秦将。伐韩，韩献成皋、巩；攻赵定太原；又攻魏高都、汲，取赵榆次、新城、狼孟三十七城。后为魏无忌率五国兵所败。", "evidence": ["P69"], "source": "正文"},
{"id": "shiji-person-zheng", "name": "政", "aliases": ["秦王政", "秦始皇", "始皇帝"], "type": "Person", "dynasty": "秦", "role": "君主·皇帝", "description": "庄襄王之子。立二十六年初并天下为三十六郡，号始皇帝。五十一年而崩，子胡亥立为二世皇帝。", "evidence": ["P69", "P70"], "source": "正文"},
{"id": "shiji-person-huhai", "name": "胡亥", "aliases": ["二世皇帝"], "type": "Person", "dynasty": "秦", "role": "皇帝", "description": "秦始皇之子。始皇崩后继立，是为二世皇帝。三年诸侯并起叛秦，赵高杀二世。", "evidence": ["P70"], "source": "正文"},
{"id": "shiji-person-zhaogao", "name": "赵高", "aliases": [], "type": "Person", "dynasty": "秦", "role": "权臣", "description": "秦二世时权臣。二世三年杀二世，立子婴。", "evidence": ["P70"], "source": "正文"},
{"id": "shiji-person-ziying", "name": "子婴", "aliases": [], "type": "Person", "dynasty": "秦", "role": "君主", "description": "赵高杀二世后所立。立月余，诸侯诛之，秦遂亡。", "evidence": ["P70"], "source": "正文"},
{"id": "shiji-person-shenhou", "name": "申侯", "aliases": [], "type": "Person", "dynasty": "西周", "role": "诸侯", "description": "申国君主。其女为大骆妻，生子成。以西戎和睦、申骆重婚说周孝王，使秦为附庸。周幽王时西戎犬戎与申侯伐周，杀幽王于郦山下。", "evidence": ["P3", "P6"], "source": "正文"},
{"id": "shiji-person-zhouxiaowang", "name": "周孝王", "aliases": [], "type": "Person", "dynasty": "西周", "role": "周王", "description": "西周天子。召非子使主马于汧渭之间，从其议分土邑之秦，使复续嬴氏祀，号秦嬴。", "evidence": ["P3"], "source": "正文"},
{"id": "shiji-person-zhouxuanwang", "name": "周宣王", "aliases": [], "type": "Person", "dynasty": "西周", "role": "周王", "description": "西周天子。以秦仲为大夫诛西戎；秦仲死后召庄公昆弟五人，与兵七千伐西戎破之，予其大骆地犬丘。", "evidence": ["P5"], "source": "正文"},
{"id": "shiji-person-zhouyouwang", "name": "周幽王", "aliases": [], "type": "Person", "dynasty": "西周", "role": "周王", "description": "西周天子。用褒姒废太子，数欺诸侯，诸侯叛之。西戎犬戎与申侯伐周，杀幽王于郦山下。", "evidence": ["P6"], "source": "正文"},
{"id": "shiji-person-zhoupingwang", "name": "周平王", "aliases": [], "type": "Person", "dynasty": "东周", "role": "周王", "description": "周天子。避犬戎之难东徙雒邑，秦襄公以兵护送。平王封襄公为诸侯，赐岐以西之地，许其攻逐戎人即有其地。", "evidence": ["P6"], "source": "正文"},
{"id": "shiji-person-jinxiangong", "name": "晋献公", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "晋君", "description": "晋君。灭虞、虢，虏虞君与大夫百里傒。其女为秦穆公夫人。死后晋乱，里克杀奚齐。", "evidence": ["P18", "P21"], "source": "正文"},
{"id": "shiji-person-jinwengong", "name": "晋文公", "aliases": ["重耳"], "type": "Person", "dynasty": "春秋", "role": "晋君", "description": "晋公子重耳。流亡在外，秦穆公迎之于楚，以故子圉妻妻之，送之入晋立为君。后败楚于城濮，与秦围郑。", "evidence": ["P21", "P26", "P27"], "source": "正文"},
{"id": "shiji-person-jinhuigong", "name": "晋惠公", "aliases": ["夷吾"], "type": "Person", "dynasty": "春秋", "role": "晋君", "description": "晋公子夷吾。秦穆公使百里傒将兵送其入晋立之，曾许割河西八城而不与。后与秦战于韩地，为穆公所虏。", "evidence": ["P21", "P24"], "source": "正文"},
{"id": "shiji-person-liji", "name": "骊姬", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "晋夫人", "description": "晋献公宠姬。作乱，太子申生死于新城，重耳、夷吾出奔。", "evidence": ["P19"], "source": "正文"},
{"id": "shiji-person-rongwang", "name": "戎王", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "西戎君", "description": "西戎之王，使由余于秦观政。中秦内史廖之计，受秦女乐终年不还，遂疑由余，由余降秦。", "evidence": ["P32", "P34"], "source": "正文"},
{"id": "shiji-person-zhaozi", "name": "昭子", "aliases": [], "type": "Person", "dynasty": "战国", "role": "太子", "description": "怀公太子，早卒未立。其子后立为灵公，其弟为简公，系怀公至灵公世系之中间环节。", "evidence": ["P44"], "source": "正文"},
{"id": "shiji-person-chuliji", "name": "樗里疾", "aliases": ["㯉里疾", "庶长疾", "严君疾", "樗里子"], "type": "Person", "dynasty": "战国", "role": "丞相", "description": "秦宗室名将、重臣。惠文君时庶长疾攻魏、赵；武王二年与甘茂为左右丞相，又相韩；昭襄王元年严君疾为相，七年卒。", "evidence": ["P61", "P63", "P64", "P65"], "source": "正文"},
{"id": "shiji-person-jinxianggong", "name": "晋襄公", "aliases": ["太子襄公"], "type": "Person", "dynasty": "春秋", "role": "晋君", "description": "晋文公之子。文公丧未葬，发兵遮秦兵于殽，大破秦军、虏秦三将；后又反击送雍之秦师于令狐。", "evidence": ["P29", "P34"], "source": "正文"},
{"id": "shiji-person-dishun", "name": "帝舜", "aliases": ["舜"], "type": "Person", "dynasty": "上古", "role": "帝", "description": "赐大费皁游、姚姓玉女，并赐姓嬴氏，为嬴姓得姓之始。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-yu", "name": "禹", "aliases": [], "type": "Person", "dynasty": "上古", "role": "帝", "description": "与大费平水土，功成受帝锡玄圭，称「非予能成，亦大費爲輔」。", "evidence": ["P0"], "source": "正文"},
{"id": "shiji-person-shangzhou", "name": "商纣", "aliases": ["纣", "殷纣", "帝辛"], "type": "Person", "dynasty": "商", "role": "商王", "description": "殷末之君。蜚廉、恶来父子俱以材力事之。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-zhouwuwang", "name": "周武王", "aliases": ["武王"], "type": "Person", "dynasty": "西周", "role": "周王", "description": "周天子。伐纣时并杀秦先祖恶来。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-person-sanfu", "name": "三父", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "大庶长", "description": "秦大庶长。与弗忌、威垒废太子武公而立出子，后又共令人贼杀出子，终为武公所诛、夷三族。", "evidence": ["P8"], "source": "正文"},
{"id": "shiji-person-fuji", "name": "弗忌", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "大庶长", "description": "秦大庶长。与威垒、三父废太子武公而立出子，后为武公所诛。", "evidence": ["P8"], "source": "正文"},
{"id": "shiji-person-weilei", "name": "威垒", "aliases": [], "type": "Person", "dynasty": "春秋", "role": "大庶长", "description": "秦大庶长。与弗忌、三父废太子武公而立出子，后为武公所诛。", "evidence": ["P8"], "source": "正文"}
],
"places":[
{"id": "shiji-place-xichui", "name": "西垂", "type": "Place", "modern": "约今甘肃天水市西南、陇南礼县一带（汉陇西西县）", "description": "秦先祖中潏所保之地，申侯祖亦保西垂以和西戎。文公元年居西垂宫。周宣王以庄公为西垂大夫。", "evidence": ["P2", "P3", "P7"], "source": "正文"},
{"id": "shiji-place-quanqiu", "name": "犬丘", "type": "Place", "modern": "今陕西兴平市东南（汉扶风槐里县）", "description": "非子所居，以善养马畜。西戎灭犬丘大骆之族，周宣王予庄公大骆地犬丘，庄公居西犬丘。括地志谓犬丘故城一名槐里，亦曰废丘。", "evidence": ["P3", "P5", "P6"], "source": "正文"},
{"id": "shiji-place-qinyi", "name": "秦", "type": "Place", "modern": "今甘肃天水市清水县一带（秦亭、秦谷）", "description": "周孝王邑非子于秦，使复续嬴氏祀，号秦嬴。括地志谓秦州清水县本名秦，嬴姓邑，即秦亭、秦谷，为嬴秦得名之地。", "evidence": ["P3"], "source": "正文"},
{"id": "shiji-place-pingyang", "name": "平阳", "type": "Place", "modern": "今陕西宝鸡市岐山县西（阳平乡平阳聚）", "description": "宁公二年徙居平阳，遣兵伐荡社。武公居平阳封宫，卒葬雍平阳。括地志谓平阳故城在岐州岐山县西四十六里。", "evidence": ["P8", "P9", "P12"], "source": "正文"},
{"id": "shiji-place-yong", "name": "雍", "aliases": ["雍城"], "type": "Place", "modern": "今陕西凤翔县南（岐州雍县）", "description": "德公元年初居雍城大郑宫，卜居雍，后子孙饮马于河。穆公卒葬雍。数世为秦都，有五畤在县南。", "evidence": ["P12", "P13", "P34"], "source": "正文"},
{"id": "shiji-place-liyang", "name": "栎阳", "type": "Place", "modern": "今陕西西安市阎良区武屯一带（汉万年县）", "description": "献公二年城栎阳并徙治之，周太史儋见献公、十八年雨金栎阳皆在此时。括地志谓栎阳故城一名万年城，在雍州东北百二十里。", "evidence": ["P49", "P50"], "source": "正文"},
{"id": "shiji-place-xianyang", "name": "咸阳", "type": "Place", "modern": "今陕西咸阳市东北（汉渭城）", "description": "孝公十二年作为咸阳，筑冀阙，秦徙都之，为秦国后期都城。括地志谓咸阳故城亦名渭城，在雍州咸阳县东十五里。", "evidence": ["P54"], "source": "正文"},
{"id": "shiji-place-qianweihu", "name": "汧渭之会", "type": "Place", "modern": "今陕西宝鸡市区一带（陇州以东）", "description": "汧水与渭水汇合处。周孝王使非子主马于汧渭之间，马大蕃息。文公四年东猎至汧渭之会，卜居营邑。", "evidence": ["P3", "P7"], "source": "正文"},
{"id": "shiji-place-qi", "name": "岐", "type": "Place", "modern": "今陕西宝鸡市岐山县一带", "description": "岐山一带，周之故地。周平王赐襄公岐以西之地，戎侵夺岐、丰。文公十六年伐戎，地至岐，以岐以东献周。", "evidence": ["P6", "P7"], "source": "正文"},
{"id": "shiji-place-xishan", "name": "西山", "type": "Place", "modern": "约今甘肃天水市西南（陇西西县）或陈仓秦陵山，二说", "description": "秦公葬地。文公五十年卒葬西山，宁公亦葬西山。皇甫谧谓葬于西山，在今陇西之西县；正义谓即秦陵山。", "evidence": ["P7", "P8"], "source": "正文"},
{"id": "shiji-place-huotaishan", "name": "霍太山", "type": "Place", "modern": "今山西临汾市霍州市一带（河东彘县）", "description": "即霍山，殷都之北。蜚廉为纣报祭于此，得石棺，死后葬霍太山。地理志谓在河东彘县。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-place-zhaocheng", "name": "赵城", "type": "Place", "modern": "今山西临汾市洪洞县赵城镇", "description": "周缪王以赵城封造父，造父族由此为赵氏。括地志谓赵城今晋州赵城县，本彘县地。", "evidence": ["P2"], "source": "正文"},
{"id": "shiji-place-han", "name": "韩地", "aliases": ["韩原"], "type": "Place", "modern": "今陕西韩城市西南（同州韩城县）", "description": "晋地。秦穆公十五年与晋惠公合战于韩地，虏晋君以归。括地志谓韩原在同州韩城县西南十八里。", "evidence": ["P24"], "source": "正文"},
{"id": "shiji-place-hequ", "name": "河曲", "type": "Place", "modern": "今陕西华阴一带或山西永济一带（蒲阪南）", "description": "黄河弯曲处，春秋秦晋交战之地。穆公自将伐晋战于河曲，康公六年秦军亦战于河曲大败晋军。", "evidence": ["P19", "P35"], "source": "正文"},
{"id": "shiji-place-xiao", "name": "殽", "aliases": ["殽阨", "三殽山"], "type": "Place", "modern": "今河南三门峡市陕州区、洛宁县一带", "description": "秦晋险要之地。晋襄公发兵遮秦兵于殽，大破秦军，无一人得脱。后穆公渡茅津封殽中尸为发丧。括地志谓三殽山在洛州永宁县西北二十里。", "evidence": ["P28", "P29", "P33"], "source": "正文"},
{"id": "shiji-place-pengya", "name": "彭衙", "type": "Place", "modern": "今陕西渭南市白水县东北（同州白水县）", "description": "秦晋战地。穆公三十四年使孟明视等伐晋，战于彭衙，秦不利引兵归。括地志谓彭衙故城在同州白水县东北六十里。", "evidence": ["P31"], "source": "正文"},
{"id": "shiji-place-shaoliang", "name": "少梁", "type": "Place", "modern": "今陕西韩城市南", "description": "秦晋反复争夺之地。康公二年秦伐晋取少梁；灵公六年晋城少梁，秦击之；献公二十三年与魏晋战少梁，虏其将公孙痤。", "evidence": ["P35", "P45", "P49"], "source": "正文"},
{"id": "shiji-place-shimen", "name": "石门", "type": "Place", "modern": "今陕西三原县西北（尧门山）", "description": "献公二十一年与晋战于石门，斩首六万，天子贺以黼黻。括地志谓尧门山俗名石门，在雍州三原县西北三十三里。", "evidence": ["P49"], "source": "正文"},
{"id": "shiji-place-pinyang", "name": "频阳", "type": "Place", "modern": "今陕西富平县东北（同官界）", "description": "厉共公二十一年初县频阳。地理志谓冯翊有频阳县，括地志谓频阳故城在雍州同官县界。", "evidence": ["P42"], "source": "正文"},
{"id": "shiji-place-yique", "name": "义渠", "type": "Place", "modern": "今甘肃庆阳、宁夏固原一带（北地）", "description": "西戎义渠戎国之地。厉共公三十三年伐义渠虏其王，惠文君十一年县义渠，又伐取义渠二十五城。", "evidence": ["P42", "P60", "P61"], "source": "正文"},
{"id": "shiji-place-shangjun", "name": "上郡", "type": "Place", "modern": "今陕西延安、榆林一带（鄜、绥等州）", "description": "魏地。惠文君十年魏纳上郡十五县于秦，尽河西滨洛之地。", "evidence": ["P60"], "source": "正文"},
{"id": "shiji-place-shu", "name": "蜀", "type": "Place", "modern": "今四川成都平原一带", "description": "西南夷之国。惠文君九年司马错伐蜀灭之，此后为秦蜀郡，昭襄王时蜀侯煇反，司马错定蜀。", "evidence": ["P61", "P64"], "source": "正文"},
{"id": "shiji-place-hanzhong", "name": "汉中", "type": "Place", "modern": "今陕西汉中市一带", "description": "惠文君十三年庶长章攻楚汉中，取地六百里，置汉中郡。昭襄王二十年王至汉中、上郡、北河。", "evidence": ["P61", "P65"], "source": "正文"},
{"id": "shiji-place-ying", "name": "郢", "type": "Place", "modern": "今湖北荆州市江陵区", "description": "楚国都城。昭襄王二十九年大良造白起攻楚取郢为南郡，楚王走。括地志谓郢城在荆州江陵县东北六里。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-place-anyi", "name": "安邑", "type": "Place", "modern": "今山西夏县（绛州夏县东北）", "description": "魏地。孝公十年卫鞅将兵围魏安邑降之。后昭襄王二十一年魏献安邑，秦出其人，募徙河东赐爵。", "evidence": ["P54", "P65"], "source": "正文"}
],
"events":[
{"id": "shiji-event-feizi-fengqin", "name": "非子封秦", "type": "Event", "participants": ["shiji-person-feizi", "shiji-person-zhouxiaowang", "shiji-person-shenhou"], "place": "shiji-place-qinyi", "description": "周孝王召非子使主马于汧渭之间，马大蕃息，遂分土为附庸，邑之秦，使复续嬴氏祀，号秦嬴，为秦立国之始。", "evidence": ["P2", "P3"], "source": "正文"},
{"id": "shiji-event-xianggong-shifeng", "name": "秦襄公始封", "type": "Event", "participants": ["shiji-person-xianggong", "shiji-person-zhoupingwang"], "place": "shiji-place-qi", "description": "犬戎与申侯伐周杀幽王，襄公将兵救周有功，又以兵送周平王东徙雒邑。平王封襄公为诸侯，赐岐以西之地，襄公于是始国，作西畤祠上帝。", "evidence": ["P6"], "source": "正文"},
{"id": "shiji-event-wengong-yingyi", "name": "文公营邑汧渭之会", "type": "Event", "participants": ["shiji-person-wengong"], "place": "shiji-place-qianweihu", "description": "文公四年东猎至汧渭之会，追念昔周邑秦嬴于此，乃卜居之，占曰吉，即营邑，秦人势力由此东进。", "evidence": ["P7"], "source": "正文"},
{"id": "shiji-event-ninggong-qianpingyang", "name": "宁公徙居平阳", "type": "Event", "participants": ["shiji-person-ninggong", "shiji-person-wugong"], "place": "shiji-place-pingyang", "description": "宁公二年徙居平阳，遣兵伐荡社，三年与亳战，亳王奔戎，遂灭荡社。", "evidence": ["P8"], "source": "正文"},
{"id": "shiji-event-degong-juyong", "name": "德公初居雍城", "type": "Event", "participants": ["shiji-person-degong"], "place": "shiji-place-yong", "description": "德公元年初居雍城大郑宫，以牺三百牢祠鄜畤，卜居雍，占得后子孙饮马于河之吉兆。", "evidence": ["P12", "P13"], "source": "正文"},
{"id": "shiji-event-wugong-chuxian", "name": "武公初县邽冀杜郑", "type": "Event", "participants": ["shiji-person-wugong"], "place": "shiji-place-pingyang", "description": "武公十年伐邽、冀戎，初县之；十一年初县杜、郑，灭小虢。为秦推行县制、扩张疆土之始。", "evidence": ["P9"], "source": "正文"},
{"id": "shiji-event-hanyuan-zhi-zhan", "name": "韩原之战", "type": "Event", "participants": ["shiji-person-mugong", "shiji-person-jinhuigong", "shiji-person-pibao"], "place": "shiji-place-han", "description": "晋惠公背约不与河西城，秦兴兵击之，十五年九月战于韩地。穆公伤而被围，岐下食善马者三百人驰冒晋军解围，穆公遂虏晋君以归，后盟而归之，晋献河西地。", "evidence": ["P24"], "source": "正文"},
{"id": "shiji-event-xiao-zhi-zhan", "name": "殽之战", "type": "Event", "participants": ["shiji-person-mengmingshi", "shiji-person-xiqishu", "shiji-person-baiyibing", "shiji-person-jinxianggong"], "place": "shiji-place-xiao", "description": "穆公不听蹇叔、百里傒之谏，使孟明视、西乞术、白乙丙将兵袭郑，灭滑而还。晋襄公发兵遮秦兵于殽，大破之，无一人得脱，虏秦三将。", "evidence": ["P28", "P29"], "source": "正文"},
{"id": "shiji-event-mugong-ba", "name": "穆公称霸西戎", "type": "Event", "participants": ["shiji-person-mugong", "shiji-person-youyu", "shiji-person-neishiliao"], "place": "shiji-place-xichui", "description": "穆公用由余之谋伐戎王，益国十二，开地千里，遂霸西戎。天子使召公过贺穆公以金鼓。三十九年穆公卒，从死者百七十七人。", "evidence": ["P32", "P34"], "source": "正文"},
{"id": "shiji-event-shangyang-bianfa", "name": "商鞅变法", "type": "Event", "participants": ["shiji-person-shangyang", "shiji-person-xiaogong"], "place": "shiji-place-xianyang", "description": "卫鞅说孝公变法修刑，内务耕稼，外劝战死之赏罚，拜为左庶长。并诸小乡聚为四十一县，为田开阡陌，秦人治。孝公卒后鞅被车裂。", "evidence": ["P51", "P53", "P54", "P58"], "source": "正文"},
{"id": "shiji-event-xiaogong-qianxianyang", "name": "孝公徙都咸阳", "type": "Event", "participants": ["shiji-person-xiaogong"], "place": "shiji-place-xianyang", "description": "孝公十二年作为咸阳，筑冀阙，秦徙都之；并诸小乡聚集为大县，县一令，凡四十一县，为田开阡陌，东地渡洛。", "evidence": ["P54"], "source": "正文"},
{"id": "shiji-event-qinbingbashu", "name": "秦并巴蜀", "type": "Event", "participants": ["shiji-person-simacuo", "shiji-person-huiwenjun"], "place": "shiji-place-shu", "description": "惠文君九年司马错伐蜀灭之，又伐取赵中都、西阳。此后蜀为秦地，秦因蜀攻楚黔中，为秦并南方要地之始。", "evidence": ["P61"], "source": "正文"},
{"id": "shiji-event-changping-zhi-zhan", "name": "长平之战", "type": "Event", "participants": ["shiji-person-baiqi", "shiji-person-zhaoxiangwang"], "place": "shiji-place-shangjun", "description": "昭襄王四十七年秦攻韩上党，上党降赵，秦因攻赵，使武安君白起击之，大破赵于长平，四十余万尽杀之。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-event-qinmiezhou", "name": "秦灭周", "type": "Event", "participants": ["shiji-person-zhaoxiangwang"], "place": "", "description": "昭襄王五十一年将军摎攻西周，西周君走来自归，尽献其邑三十六城。五十二年周民东亡，其器九鼎入秦，周初亡。", "evidence": ["P66"], "source": "正文"},
{"id": "shiji-event-shimen-zhi-zhan", "name": "石门之战", "type": "Event", "participants": ["shiji-person-xiangong"], "place": "shiji-place-shimen", "description": "献公二十一年与晋战于石门，斩首六万，天子贺以黼黻，为秦东进复强之重要一役。", "evidence": ["P49"], "source": "正文"},
{"id": "shiji-event-qinbingtianxia", "name": "秦并天下", "type": "Event", "participants": ["shiji-person-zheng", "shiji-person-huhai", "shiji-person-ziying"], "place": "shiji-place-xianyang", "description": "秦王政立二十六年初并天下为三十六郡，号始皇帝。其后二世胡亥立，三年诸侯并起叛秦，赵高杀二世立子婴，子婴立月余诸侯诛之，秦遂亡。", "evidence": ["P70"], "source": "正文"}
],
"offices":[
{"id": "shiji-office-dafu", "name": "大夫", "description": "周及秦之官。周宣王以秦仲为大夫诛西戎。", "evidence": ["P5"], "source": "正文"},
{"id": "shiji-office-xichuidafu", "name": "西垂大夫", "description": "以西方边地西垂为辖之职。周宣王予庄公大骆地犬丘，为西垂大夫。", "evidence": ["P5"], "source": "正文"},
{"id": "shiji-office-dashuzhang", "name": "大庶长", "description": "秦官。宁公卒，大庶长弗忌、威垒、三父废太子而立出子。", "evidence": ["P8"], "source": "正文"},
{"id": "shiji-office-shuzhang", "name": "庶长", "description": "秦官。怀公四年庶长鼂与大臣围怀公；出子二年庶长改迎献公立之；昭襄王时庶长壮作乱被诛。", "evidence": ["P44", "P48", "P64"], "source": "正文"},
{"id": "shiji-office-zuoshuzhang", "name": "左庶长", "description": "秦爵官。孝公用卫鞅变法，乃拜鞅为左庶长。", "evidence": ["P53"], "source": "正文"},
{"id": "shiji-office-daliangzao", "name": "大良造", "description": "秦最高爵官之一。孝公十年卫鞅为大良造，将兵围魏安邑；昭襄王时白起为大良造攻魏楚。", "evidence": ["P54", "P65"], "source": "正文"},
{"id": "shiji-office-xiang", "name": "相", "description": "辅相之官。惠文君十年张仪相秦，后乐池、张仪复相秦。", "evidence": ["P60", "P62"], "source": "正文"},
{"id": "shiji-office-chengxiang", "name": "丞相", "description": "秦官。武王二年初置丞相，樗里疾、甘茂为左右丞相。昭襄王时楼缓为丞相。", "evidence": ["P63", "P64"], "source": "正文"},
{"id": "shiji-office-xiangguo", "name": "相国", "description": "秦官，位尊于丞相。庄襄王元年使相国吕不韦诛东周君。", "evidence": ["P69"], "source": "正文"},
{"id": "shiji-office-neishi", "name": "内史", "description": "周官，掌京师治理。穆公问内史廖以离间戎王由余之策。", "evidence": ["P32"], "source": "正文"},
{"id": "shiji-office-wugudafu", "name": "五羖大夫", "description": "穆公以五羖羊皮赎百里傒而授之国政，号曰五羖大夫。", "evidence": ["P18"], "source": "正文"},
{"id": "shiji-office-shangdafu", "name": "上大夫", "description": "秦官。穆公厚币迎蹇叔，以为上大夫。", "evidence": ["P18"], "source": "正文"},
{"id": "shiji-office-keqing", "name": "客卿", "description": "秦官，以他国之人充任。昭襄王时客卿胡阳、客卿竈等攻魏、齐。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-office-zuogeng", "name": "左更", "description": "秦爵。昭襄王十三年左更白起攻新城，十四年左更白起攻韩魏于伊阙。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-office-zhonggeng", "name": "中更", "description": "秦爵。昭襄王三十八年中更胡阳攻赵阏与。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-office-wudafu", "name": "五大夫", "description": "秦爵。昭襄王时五大夫礼、五大夫贲、五大夫陵等为将。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-office-junshou", "name": "郡守", "description": "郡之长官，秦官。昭襄王时任鄙为汉中守，蜀守若伐楚取巫郡。", "evidence": ["P65"], "source": "正文"},
{"id": "shiji-office-xianling", "name": "县令", "description": "县之长官。孝公十二年并诸小乡聚集为大县，县一令，凡四十一县。", "evidence": ["P54"], "source": "正文"}
],
