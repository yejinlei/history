{
  "book": "shiji",
  "chapter_id": "shiji-宋微子世家第八",
  "title": "宋微子世家第八",
  "paragraphs": [
    {
      "para_id": "p0",
      "text": "微子開者，殷帝乙之首子而帝紂之庶兄也……遂亡。",
      "persons": [
        "微子启",
        "纣王",
        "帝乙",
        "祖伊",
        "周文王"
      ],
      "places": [],
      "events": [
        "微子去殷"
      ]
    },
    {
      "para_id": "p1",
      "text": "箕子者，紂親戚也……故傳之曰箕子操。",
      "persons": [
        "纣王",
        "箕子"
      ],
      "places": [],
      "events": [
        "箕子佯狂为奴"
      ]
    },
    {
      "para_id": "p2",
      "text": "王子比干者，亦紂之親戚也……刳視其心。",
      "persons": [
        "纣王",
        "箕子",
        "比干"
      ],
      "places": [],
      "events": [
        "比干剖心"
      ]
    },
    {
      "para_id": "p3",
      "text": "微子曰：「父子有骨肉，而臣主以義屬……太師、少師乃勸微子去，遂行。",
      "persons": [
        "微子启"
      ],
      "places": [],
      "events": [
        "微子去殷"
      ]
    },
    {
      "para_id": "p4",
      "text": "周武王伐紂克殷，微子乃持其祭器造於軍門……復其位如故。",
      "persons": [
        "微子启",
        "周武王"
      ],
      "places": [],
      "events": [
        "微子归周"
      ]
    },
    {
      "para_id": "p5",
      "text": "武王封紂子武庚祿父以續殷祀，使管叔、蔡叔傅相之。",
      "persons": [
        "周武王",
        "武庚禄父",
        "管叔",
        "蔡叔"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p6",
      "text": "武王旣克殷，訪問箕子。",
      "persons": [
        "箕子",
        "周武王"
      ],
      "places": [],
      "events": [
        "洪范九畴之对"
      ]
    },
    {
      "para_id": "p7",
      "text": "武王曰：「於乎！維天陰定下民，相和其居，我不知其常倫所序。」",
      "persons": [
        "周武王"
      ],
      "places": [],
      "events": [
        "洪范九畴之对"
      ]
    },
    {
      "para_id": "p8",
      "text": "箕子對曰：「在昔鯀陻鴻水，汨陳其五行……天乃錫禹鴻範九等，常倫所序。",
      "persons": [
        "箕子",
        "鲧",
        "禹"
      ],
      "places": [],
      "events": [
        "洪范九畴之对"
      ]
    },
    {
      "para_id": "p9",
      "text": "「初一曰五行；二曰五事；三曰八政……九曰嚮用五福，畏用六極。",
      "persons": [],
      "places": [],
      "events": [
        "洪范九畴之对"
      ]
    },
    {
      "para_id": "p10",
      "text": "五行：一曰水，二曰火，三曰木，四曰金，五曰土……稼穡作甘。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p11",
      "text": "五事：一曰貌，二曰言，三曰視，四曰聽，五曰思……睿作聖。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p12",
      "text": "八政：一曰食，二曰貨，三曰祀，四曰司空，五曰司徒，六曰司寇，七曰賔，八曰師。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p13",
      "text": "五紀：一曰歲，二曰月，三曰日，四曰星辰，五曰歷數。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p14",
      "text": "皇極：皇建其有極，歛時五福，用傅錫其庶民……曰天子作民父母，以爲天下王。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p15",
      "text": "三德：一曰正直，二曰剛克，三曰柔克……民用僭忒。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p16",
      "text": "稽疑：擇建立卜筮人……龜筮共違于人，用靜吉，用作凶。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p17",
      "text": "庶徵：曰雨，曰陽，曰奧，曰寒，曰風，曰時……月之從星，則以風雨。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p18",
      "text": "五福：一曰壽，二曰富，三曰康寧……六曰弱。」",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p19",
      "text": "於是武王乃封箕子於朝鮮而不臣也。",
      "persons": [
        "箕子",
        "周武王"
      ],
      "places": [
        "朝鲜"
      ],
      "events": [
        "箕子封朝鲜"
      ]
    },
    {
      "para_id": "p20",
      "text": "其後箕子朝周，過故殷虛……殷民聞之，皆爲流涕。",
      "persons": [
        "纣王",
        "箕子"
      ],
      "places": [
        "殷虚"
      ],
      "events": []
    },
    {
      "para_id": "p21",
      "text": "武王崩，成王少，周公旦代行政當國……故殷之餘民甚戴愛之。",
      "persons": [
        "微子启",
        "周武王",
        "武庚禄父",
        "管叔",
        "蔡叔",
        "周公旦"
      ],
      "places": [
        "宋"
      ],
      "events": [
        "三监之乱",
        "微子封宋"
      ]
    },
    {
      "para_id": "p22",
      "text": "微子開卒，立其弟衍，是爲微仲……厲公卒，子釐公舉立。",
      "persons": [
        "微子启",
        "微仲衍",
        "宋公稽",
        "丁公申",
        "湣公共",
        "炀公熙",
        "鲋祀",
        "釐公举"
      ],
      "places": [
        "宋"
      ],
      "events": [
        "鲋祀弑炀公"
      ]
    },
    {
      "para_id": "p23",
      "text": "釐公十七年，周厲王出奔彘。",
      "persons": [
        "釐公举"
      ],
      "places": [
        "周",
        "彘"
      ],
      "events": [
        "周厉王出奔彘"
      ]
    },
    {
      "para_id": "p24",
      "text": "二十八年，釐公卒，子惠公覸立……哀公元年卒，子戴公立。",
      "persons": [
        "釐公举",
        "宋惠公",
        "宋哀公",
        "戴公"
      ],
      "places": [
        "周"
      ],
      "events": [
        "周宣王即位"
      ]
    },
    {
      "para_id": "p25",
      "text": "戴公二十九年，周幽王爲犬戎所殺，秦始列爲諸侯。",
      "persons": [
        "戴公",
        "犬戎"
      ],
      "places": [
        "秦",
        "周"
      ],
      "events": [
        "周幽王为犬戎所杀",
        "秦始列为诸侯"
      ]
    },
    {
      "para_id": "p26",
      "text": "三十四年，戴公卒，子武公司空立……十八年，武公卒，子宣公力立。",
      "persons": [
        "戴公",
        "宋武公",
        "宋宣公"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p27",
      "text": "宣公有太子與夷……宣公卒，弟和立，是爲穆公。",
      "persons": [
        "宋宣公",
        "宋穆公",
        "宋殇公"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p28",
      "text": "穆公九年，病，召大司馬孔父謂曰……立其弟以成義，然卒其子復享之。",
      "persons": [
        "宋宣公",
        "宋穆公",
        "孔父嘉",
        "宋殇公",
        "宋庄公"
      ],
      "places": [
        "郑"
      ],
      "events": [
        "穆公遗命立殇公"
      ]
    },
    {
      "para_id": "p29",
      "text": "殤公元年，衞公子州吁弒其君完自立……其後諸侯數來侵伐。",
      "persons": [
        "宋殇公",
        "宋庄公"
      ],
      "places": [
        "郑",
        "卫",
        "东门"
      ],
      "events": [
        "州吁弑卫君完",
        "宋卫伐郑",
        "郑报东门之役"
      ]
    },
    {
      "para_id": "p30",
      "text": "九年，大司馬孔父嘉妻好，出，道遇太宰華督……是爲莊公。",
      "persons": [
        "孔父嘉",
        "华督",
        "宋殇公",
        "宋庄公"
      ],
      "places": [
        "郑",
        "鲁"
      ],
      "events": [
        "华督弑殇公"
      ]
    },
    {
      "para_id": "p31",
      "text": "莊公元年，華督爲相……十九年，莊公卒，子湣公捷立。",
      "persons": [
        "华督",
        "宋庄公",
        "祭仲",
        "公子突",
        "宋湣公"
      ],
      "places": [
        "郑"
      ],
      "events": []
    },
    {
      "para_id": "p32",
      "text": "湣公七年，齊桓公即位……此言乃公子子魚教湣公也。",
      "persons": [
        "宋湣公",
        "臧文仲",
        "齐桓公",
        "公子子鱼"
      ],
      "places": [
        "鲁"
      ],
      "events": []
    },
    {
      "para_id": "p33",
      "text": "十年夏，宋伐魯，戰於乘丘……宋人醢萬也。",
      "persons": [
        "华督",
        "宋湣公",
        "南宫万",
        "仇牧",
        "南宫牛",
        "公子游",
        "宋桓公"
      ],
      "places": [
        "亳",
        "萧",
        "蒙泽",
        "乘丘",
        "陈"
      ],
      "events": [
        "南宫万弑湣公"
      ]
    },
    {
      "para_id": "p34",
      "text": "桓公二年，諸侯伐宋，至郊而去……襄公徃會。",
      "persons": [
        "齐桓公",
        "目夷",
        "宋桓公",
        "卫文公",
        "秦穆公",
        "宋襄公"
      ],
      "places": [
        "卫",
        "葵丘",
        "齐",
        "秦"
      ],
      "events": []
    },
    {
      "para_id": "p35",
      "text": "襄公七年，宋地霣星如雨，與雨偕下；六鶂退蜚，風疾也。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p36",
      "text": "八年，齊桓公卒，宋欲爲盟會……即奴事之耳，又何戰爲？」",
      "persons": [
        "齐桓公",
        "目夷",
        "宋襄公",
        "楚成王"
      ],
      "places": [
        "亳",
        "泓水",
        "鹿上",
        "盂",
        "楚"
      ],
      "events": [
        "泓水之战"
      ]
    },
    {
      "para_id": "p37",
      "text": "楚成王已救鄭，鄭享之；去而取鄭二姬以歸……有以知其不遂霸也。」",
      "persons": [
        "楚成王",
        "叔瞻"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p38",
      "text": "是年，晉公子重耳過宋，襄公以傷於楚，欲得晉援，厚禮重耳以馬二十乘。",
      "persons": [
        "宋襄公",
        "晋文公"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p39",
      "text": "十四年夏，襄公病傷於泓而竟卒，子成公王臣立。",
      "persons": [
        "宋襄公",
        "宋成公"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p40",
      "text": "成公元年，晉文公即位……十六年，秦穆公卒。",
      "persons": [
        "秦穆公",
        "楚成王",
        "晋文公",
        "宋成公",
        "商臣"
      ],
      "places": [
        "晋",
        "秦"
      ],
      "events": [
        "楚成王伐宋",
        "晋文公救宋"
      ]
    },
    {
      "para_id": "p41",
      "text": "十七年，成公卒……宋人共殺君禦而立成公少子杵臼，是爲昭公。",
      "persons": [
        "宋成公",
        "御",
        "公孙固",
        "宋昭公"
      ],
      "places": [],
      "events": [
        "成公弟御之乱"
      ]
    },
    {
      "para_id": "p42",
      "text": "昭公四年，宋敗長翟緣斯於長丘……七年，楚莊王即位。",
      "persons": [
        "宋昭公",
        "楚庄王",
        "缘斯"
      ],
      "places": [
        "长丘"
      ],
      "events": []
    },
    {
      "para_id": "p43",
      "text": "九年，昭公無道，國人不附……弟鮑革立，是爲文公。",
      "persons": [
        "宋昭公",
        "王姬",
        "卫伯",
        "宋文公",
        "华元"
      ],
      "places": [],
      "events": [
        "王姬弑昭公"
      ]
    },
    {
      "para_id": "p44",
      "text": "文公元年，晉率諸侯伐宋，責以弒君……出武、繆之族。",
      "persons": [
        "宋昭公",
        "宋文公",
        "须"
      ],
      "places": [
        "晋"
      ],
      "events": []
    },
    {
      "para_id": "p45",
      "text": "四年春，鄭命楚伐宋……未盡入，華元亡歸宋。",
      "persons": [
        "华元",
        "羊斟"
      ],
      "places": [],
      "events": [
        "郑囚华元"
      ]
    },
    {
      "para_id": "p46",
      "text": "十四年，楚莊王圍鄭……鄭伯降楚，楚復釋之。",
      "persons": [
        "楚庄王"
      ],
      "places": [
        "郑"
      ],
      "events": []
    },
    {
      "para_id": "p47",
      "text": "十六年，楚使過宋，宋有前仇，執楚使……以信故，遂罷兵去。",
      "persons": [
        "楚庄王",
        "华元",
        "子反"
      ],
      "places": [
        "楚"
      ],
      "events": []
    },
    {
      "para_id": "p48",
      "text": "二十二年，文公卒，子共公瑕立……君子譏華元不臣矣。",
      "persons": [
        "宋文公",
        "华元",
        "宋共公"
      ],
      "places": [],
      "events": [
        "始厚葬"
      ]
    },
    {
      "para_id": "p49",
      "text": "共公九年，華元善楚將子重……乃立共公少子成，是爲平公。",
      "persons": [
        "华元",
        "宋共公",
        "子重",
        "栾书",
        "鱼石",
        "唐山",
        "太子肥",
        "宋平公"
      ],
      "places": [
        "晋"
      ],
      "events": [
        "华元弭兵"
      ]
    },
    {
      "para_id": "p50",
      "text": "平公三年，楚共王拔宋之彭城，以封宋左師魚石……四十四年，平公卒，子元公佐立。",
      "persons": [
        "鱼石",
        "宋平公",
        "楚共王",
        "楚灵王",
        "宋元公"
      ],
      "places": [
        "彭城",
        "楚"
      ],
      "events": [
        "彭城封鱼石",
        "诸侯诛鱼石归彭城"
      ]
    },
    {
      "para_id": "p51",
      "text": "元公三年，楚公子弃疾弒靈王，自立爲平王……行道卒，子景公頭曼立。",
      "persons": [
        "宋元公",
        "鲁昭公",
        "季氏",
        "楚平王",
        "太子建",
        "宋景公"
      ],
      "places": [
        "鲁"
      ],
      "events": [
        "元公诈杀诸公子",
        "华向之乱",
        "楚太子建奔宋",
        "元公求纳鲁昭公"
      ]
    },
    {
      "para_id": "p52",
      "text": "景公十六年，魯陽虎來犇，已復去……三十六年，齊田常弒簡公。",
      "persons": [
        "宋景公",
        "阳虎",
        "桓魋",
        "田常",
        "齐简公",
        "孔子"
      ],
      "places": [
        "曹",
        "齐"
      ],
      "events": [
        "宋灭曹",
        "孔子过宋",
        "田常弑齐简公",
        "鲁阳虎来奔"
      ]
    },
    {
      "para_id": "p53",
      "text": "三十七年，楚惠王滅陳。熒惑守心……於是候之，果徙三度。",
      "persons": [
        "宋景公",
        "子韦",
        "楚惠王"
      ],
      "places": [
        "陈",
        "楚"
      ],
      "events": [
        "子韦移荧惑"
      ]
    },
    {
      "para_id": "p54",
      "text": "六十四年，景公卒。宋公子特攻殺太子而自立，是爲昭公……故昭公怨殺太子而自立。",
      "persons": [
        "宋元公",
        "宋景公",
        "宋昭公"
      ],
      "places": [],
      "events": []
    },
    {
      "para_id": "p55",
      "text": "昭公四十七年卒，子悼公購由立……剔成敗奔齊，偃自立爲宋君。",
      "persons": [
        "宋昭公",
        "宋悼公",
        "宋休公",
        "宋辟公",
        "剔成",
        "宋王偃"
      ],
      "places": [],
      "events": [
        "剔成被攻袭"
      ]
    },
    {
      "para_id": "p56",
      "text": "君偃十一年，自立爲王……殺王偃，遂滅宋而三分其地。",
      "persons": [
        "宋王偃",
        "齐湣王"
      ],
      "places": [
        "齐"
      ],
      "events": [
        "宋王偃称王",
        "宋王偃败齐楚魏",
        "桀宋之灭"
      ]
    },
    {
      "para_id": "p57",
