    "concepts": [
      {
        "id": "concept_yx_001",
        "name": "游俠",
        "note": "荀悅定義為「立氣齊，作威福，結私交，以立彊於世者」，司馬遷肯定游俠「言必信行必果，己諾必誠，不愛其軀赴士之阨困，不矜其能羞伐其德」的品格，與暴豪之徒區分",
        "evidence": [
          "p0",
          "p1",
          "p5"
        ]
      },
      {
        "id": "concept_yx_002",
        "name": "言必信行必果",
        "note": "出自《論語》，本為貶義，指小人硜硜然守小信，司馬遷用來肯定游俠守信果決、救人危難的品格，成為後世俠義精神的核心信條",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "concept_yx_003",
        "name": "緩急",
        "note": "偏義複詞，指危難、緊急關頭，「緩急人之所時有」是司馬遷肯定游俠存在價值的重要論點：亂世人人都可能遇難，需要游俠這樣仗義救人的人",
        "evidence": [
          "p2"
        ]
      },
      {
        "id": "concept_yx_004",
        "name": "竊鉤者誅竊國者侯",
        "note": "出自《莊子·胠篋》，諷刺統治階級仁義道德的虛偽性，為布衣游俠不受正統認可鳴不平",
        "evidence": [
          "p3"
        ]
      },
      {
        "id": "concept_yx_005",
        "name": "修行砥名",
        "note": "指閭巷之俠修養品德、磨礪名節，不靠王者親屬卿相之勢，全憑個人義氣聞名天下，比戰國四公子更難能可貴",
        "evidence": [
          "p5"
        ]
      },
      {
        "id": "concept_yx_006",
        "name": "踐更",
        "note": "漢代徭役制度，貧者受錢代富者服役稱踐更，郭解暗中幫助箕踞者免除踐更，以德報怨的典型事跡",
        "evidence": [
          "p10"
        ]
      },
      {
        "id": "concept_yx_007",
        "name": "徙茂陵",
        "note": "元朔二年漢武帝采主父偃建議，徙天下家訾三百萬以上豪富於茂陵，加強中央集權控制地方豪強，是導致郭解滅族的直接契機",
        "evidence": [
          "p13"
        ]
      },
      {
        "id": "concept_yx_008",
        "name": "不名一錢",
        "note": "形容極度貧窮，一文錢都沒有，本傳鄧通「竟不得名一錢寄死人家」，後世成為成語，比喻貧困",
        "evidence": [
          "p3"
        ]
      },
      {
        "id": "concept_yx_009",
        "name": "人貌榮名",
        "note": "篇末司馬遷贊郭解語，謂人的相貌是普通的，但榮名和精神是不朽的，沒有窮盡，表達了對游俠精神的高度肯定和對郭解之死的惋惜",
        "evidence": [
          "p16"
        ]
      }
