      "name": "景帝分封十三子",
      "note": "孝景皇帝子凡十三人为王，母五人，同母者为宗。",
      "evidence": [
        "p1"
      ]
    },
    {
      "name": "河间献王之治",
      "note": "好儒学，山东诸儒多从之游，二十六年卒。",
      "evidence": [
        "p2"
      ]
    },
    {
      "name": "临江闵王荣坐侵庙壖垣",
      "note": "坐侵庙壖垣为宫，上征荣，轴折车废。",
      "evidence": [
        "p4"
      ]
    },
    {
      "name": "荣自杀葬蓝田",
      "note": "郅都责讯，荣恐自杀，燕数万衔土置冢上。",
      "evidence": [
        "p4"
      ]
    },
    {
      "name": "鲁共王徙鲁",
      "note": "以孝景前三年由淮阳王徙为鲁王。",
      "evidence": [
        "p6"
      ]
    },
    {
      "name": "江都易王击吴",
      "note": "吴楚反时非年十五，上书愿击吴，赐将军印。",
      "evidence": [
        "p7"
      ]
    },
    {
      "name": "刘建奸淖姬",
      "note": "易王死未葬，建迎淖姬奸于服舍。",
      "evidence": [
        "p7"
      ]
    },
    {
      "name": "淮南衡山谋反及江都",
      "note": "淮南事发，治党与颇及江都王建，建恐自杀，国除为广陵郡。",
      "evidence": [
        "p7"
      ]
    },
    {
      "name": "胶西削国去太半",
      "note": "有司再请削其国，去太半，端心愠而益纵。",
      "evidence": [
        "p8"
      ]
    },
    {
      "name": "赵王彭祖胁制二千石",
      "note": "衣皁布衣自迎除舍，设疑事作动之，以罪去者甚众。",
      "evidence": [
        "p11"
      ]
    },
    {
      "name": "赵太子丹之废",
      "note": "丹与女及同产姊奸，客江充告之，丹以故废。",
      "evidence": [
        "p11"
      ]
    },
    {
      "name": "唐儿夜进生发",
      "note": "景帝召程姬，程姬有辟，饰唐儿使夜进，醉幸而生发。",
      "evidence": [
        "p14"
      ]
    },
    {
      "name": "长沙王得武陵零陵桂阳",
      "note": "景帝以武陵、零陵、桂阳属长沙王。",
      "evidence": [
        "p14"
      ]
    },
    {
      "name": "广川王齐告汉公卿",
      "note": "桑距怨王上书告其与同产奸，齐亦数上书告汉公卿及所忠。",
      "evidence": [
        "p16"
      ]
    },
    {
      "name": "胶东康王私备淮南",
      "note": "私作楼车镞矢战守备，候淮南之起，事发发病死。",
      "evidence": [
        "p17"
      ]
    },
    {
      "name": "六安王庆之封",
      "note": "封庆于故衡山地，为六安王。",
      "evidence": [
        "p17"
      ]
    },
    {
      "name": "常山宪王卒后争产",
      "note": "王后、太子不分财物于长子梲，梲怨而自言其不侍病。",
      "evidence": [
        "p19"
      ]
    },
    {
      "name": "勃迁房陵国绝",
      "note": "有司请诛，上不忍，废王后、徙勃房陵，国绝。",
      "evidence": [
        "p19"
      ]
    },
    {
      "name": "封真定王平泗水王商",
      "note": "天子诏封宪王子平为真定王、商为泗水王，各三万户。",
      "evidence": [
        "p19"
      ]
    },
    {
      "name": "兒姁子孙分封为六",
      "note": "兒姁四子本封四国，其后汉益封其支子为六安王、泗水王二国，凡为六王。",
      "evidence": [
        "p22"
      ]
    },
    {
      "name": "汉削诸侯之权",
      "note": "吴楚反后汉为置二千石，去丞相曰相，诸侯独得食租税。",
      "evidence": [
        "p23"
      ]
    }
  ],
  "concepts": [
    {
      "name": "五宗",
      "note": "景帝十三子出自五母，同母者为宗，故称五宗。",
      "evidence": [
        "p0",
        "p1"
      ]
    },
    {
      "name": "同母为宗",
      "note": "同母者为一宗，本篇立篇之本。",
      "evidence": [
        "p1"
      ]
    },
    {
      "name": "皇子封王",
      "note": "皇子或以襁褓立为诸侯王。",
      "evidence": [
        "p1"
      ]
    },
    {
      "name": "内史",
      "note": "高祖时诸侯得自除内史以下，汉独为置丞相。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "丞相与相",
      "note": "高祖时汉为诸侯置丞相黄金印，吴楚反后去丞相曰相，银印。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "黄金印",
      "note": "高祖时汉为诸侯置丞相所用之印，见诸侯权盛之制。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "银印",
      "note": "吴楚反后汉为诸侯置相所用之印，见诸侯权削之制。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "榷会",
      "note": "赵王彭祖使使即县为贾人榷会，入多于国经租税。",
      "evidence": [
        "p11"
      ]
    },
    {
      "name": "庙壖垣",
      "note": "临江王荣坐侵庙壖垣为宫而得罪。",
      "evidence": [
        "p4"
      ]
    },
    {
      "name": "祖",
      "note": "荣行祖于江陵北门，祖者行神，行而祭之。",
      "evidence": [
        "p4"
      ]
    },
    {
      "name": "祝诅",
      "note": "巫祝祷祠之属，江都王建信之。",
      "evidence": [
        "p7"
      ]
    },
    {
      "name": "藩臣",
      "note": "中山王与赵王相非，赵王以不佐天子拊循百姓责之。",
      "evidence": [
        "p12"
      ]
    },
    {
      "name": "支子别封",
      "note": "诸侯支子别封，漢益封兒姁支子为六安、泗水二国。",
      "evidence": [
        "p17",
        "p22"
      ]
    },
    {
      "name": "卑溼貧國",
      "note": "长沙定王以母微无宠，王卑湿贫国。",
      "evidence": [
        "p14"
      ]
    },
    {
      "name": "口吃",
      "note": "鲁共王余为人吃，不喜辞辩。",
      "evidence": [
        "p6"
      ]
    },
    {
      "name": "食租税",
      "note": "吴楚反后诸侯独得食租税，夺之权。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "乘牛车",
      "note": "其后诸侯贫者或乘牛车。",
      "evidence": [
        "p23"
      ]
    },
    {
      "name": "汉",
      "note": "汉廷、汉朝。赵王遂反之所反，淮南王谋反之所谋，及封国除地为郡之所入。",
      "evidence": [
        "p7",
        "p11",
        "p23"
      ]
    }
  ],
