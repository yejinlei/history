    "events": [
      {
        "id": "e1",
        "name": "长桑君授扁鹊禁方",
        "note": "长桑君客于舍馆，慎遇十余年，乃出怀中药与禁方书尽授扁鹊，忽不见。",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "e2",
        "name": "赵简子病梦钧天",
        "note": "晋昭公时赵简子病五日不知人，梦与百神游钧天、射熊罴受二笥翟犬；扁鹊诊之，二日半而寤。",
        "evidence": [
          "p2",
          "p3"
        ]
      },
      {
        "id": "e3",
        "name": "扁鹊起虢太子尸蹷",
        "note": "虢太子暴蹷而死，扁鹊使弟子子阳厉针、子豹为五分之熨，太子复苏，天下以为能生死人。",
        "evidence": [
          "p4",
          "p5",
          "p6"
        ]
      },
      {
        "id": "e4",
        "name": "扁鹊望齐桓侯而退",
        "note": "扁鹊三见齐桓侯，言疾在腠理、血脉、肠胃而不听；再见疾入骨髓，望而退走，桓侯遂病死。",
        "evidence": [
          "p7"
        ]
      },
      {
        "id": "e5",
        "name": "李醯刺杀扁鹊",
        "note": "秦太医令李醯自知伎不如扁鹊，使人刺杀之。",
        "evidence": [
          "p9"
        ]
      },
      {
        "id": "e6",
        "name": "缇萦上书救父",
        "note": "淳于意当刑西之长安，幼女缇萦随父上书，愿入身为官婢以赎父刑。",
        "evidence": [
          "p11"
        ]
      },
      {
        "id": "e7",
        "name": "汉文帝除肉刑",
        "note": "文帝悲缇萦之意，是年除肉刑法。",
        "evidence": [
          "p11"
        ]
      },
      {
        "id": "e8",
        "name": "仓公受学阳庆",
        "note": "高后八年，淳于意事临菑元里公乘阳庆，尽弃故方，受脉书上下经、五色诊、奇咳术等，三年而精。",
        "evidence": [
          "p10",
          "p14"
        ]
      },
      {
        "id": "e9",
        "name": "仓公奉诏对策载诊籍",
        "note": "文帝诏问淳于意治病决死生之验，仓公据诊籍逐条对答，凡二十五例。",
