{
  "book": "shiji",
  "chapter_id": "shiji-衞康叔世家第七",
  "title": "卫康叔世家第七",
  "paragraphs": [
    {
      "para_id": "p0",
      "text": "衞康叔名封，周武王同母少弟也……冉季最少。",
      "persons": ["卫康叔", "周武王", "冉季"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p1",
      "text": "武王已克殷紂……以武庚殷餘民封康叔爲衞君，居河、淇間故商墟。",
      "persons": ["周武王", "武庚禄父", "管叔", "蔡叔", "成王", "周公旦", "卫康叔"],
      "places": ["成周", "卫", "河", "淇", "故商墟"],
      "events": ["三监之乱"]
    },
    {
      "para_id": "p2",
      "text": "周公旦懼康叔齒少，乃申告康叔曰……民大說。",
      "persons": ["周公旦", "卫康叔"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p3",
      "text": "成王長，用事，舉康叔爲周司宼……以章有德。",
      "persons": ["成王", "卫康叔"],
      "places": ["卫"],
      "events": []
    },
    {
      "para_id": "p4",
      "text": "康叔卒，子康伯代立……貞伯卒，子頃侯立。",
      "persons": ["卫康叔", "康伯", "考伯", "嗣伯", "𢈻伯", "靖伯", "贞伯", "顷侯"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p5",
      "text": "頃侯厚賂周夷王，夷王命衞爲侯……子釐侯立。",
      "persons": ["顷侯", "周夷王", "釐侯"],
      "places": ["卫"],
      "events": []
    },
    {
      "para_id": "p6",
      "text": "釐侯十三年，周厲王出犇于彘，共和行政焉。二十八年，周宣王立。",
      "persons": ["釐侯", "周厉王", "周宣王"],
      "places": ["彘"],
      "events": ["共和行政"]
    },
    {
      "para_id": "p7",
      "text": "四十二年，釐侯卒，太子共伯餘立爲君……而立和爲衞侯，是爲武公。",
      "persons": ["釐侯", "共伯余", "武公和"],
      "places": ["卫"],
      "events": ["共伯之死"]
    },
    {
      "para_id": "p8",
      "text": "武公即位，修康叔之政……周平王命武公爲公。五十五年，卒，子莊公揚立。",
      "persons": ["武公和", "卫康叔", "周幽王", "周平王", "庄公扬"],
      "places": [],
      "events": ["犬戎杀周幽王"]
    },
    {
      "para_id": "p9",
      "text": "莊公五年，取齊女爲夫人……二十三年，莊公卒，太子完立，是爲桓公。",
      "persons": ["庄公扬", "庄姜", "戴妫", "桓公完", "州吁", "石碏"],
      "places": ["齐", "陈"],
      "events": ["州吁之乱"]
    },
    {
      "para_id": "p10",
      "text": "桓公二年，弟州吁驕奢……而迎桓公弟晉於邢而立之，是爲宣公。",
      "persons": ["桓公完", "州吁", "郑伯弟段", "石碏", "陈侯", "右宰丑", "宣公晋"],
      "places": ["卫", "郑", "宋", "陈", "蔡", "邢", "濮"],
      "events": ["州吁之乱"]
    },
    {
      "para_id": "p11",
      "text": "宣公七年，魯弒其君隱公……十年，晉曲沃莊伯弒其君哀侯。",
      "persons": ["宣公晋", "鲁隐公", "宋督", "宋殇公", "孔父", "晋曲沃庄伯", "晋哀侯"],
      "places": ["鲁", "宋", "晋"],
      "events": []
    },
    {
      "para_id": "p12",
      "text": "十八年，初，宣公愛夫人夷姜……十九年，宣公卒，太子朔立，是爲惠公。",
      "persons": ["宣公晋", "夷姜", "太子伋", "公子寿", "惠公朔"],
      "places": ["齐"],
      "events": ["伋寿之死"]
    },
    {
      "para_id": "p13",
      "text": "左右公子不平朔之立也……惠公犇齊。",
      "persons": ["惠公朔", "太子伋", "黔牟"],
      "places": ["齐"],
      "events": ["左右公子之乱"]
    },
    {
      "para_id": "p14",
      "text": "衞君黔牟立八年，齊襄公率諸侯奉王命共伐衞……與前通年凡十三年矣。",
      "persons": ["黔牟", "齐襄公", "惠公朔"],
      "places": ["卫", "齐"],
      "events": ["齐襄公纳惠公"]
    },
    {
      "para_id": "p15",
      "text": "二十五年，惠公怨周之容舍黔牟，與燕伐周……三十一年，惠公卒，子懿公赤立。",
      "persons": ["惠公朔", "黔牟", "周惠王", "王子颓", "懿公赤"],
      "places": ["卫", "燕", "温", "郑"],
      "events": ["惠公伐周立王子颓"]
    },
    {
      "para_id": "p16",
      "text": "懿公即位，好鸖，淫樂奢侈……翟於是遂入，殺懿公。",
      "persons": ["懿公赤"],
      "places": ["卫"],
      "events": ["翟伐卫杀懿公"]
    },
    {
      "para_id": "p17",
      "text": "懿公之立也，百姓大臣皆不服……是爲戴公。",
      "persons": ["懿公赤", "惠公朔", "太子伋", "黔牟", "昭伯顽", "戴公申"],
      "places": [],
      "events": ["翟伐卫杀懿公"]
    },
    {
      "para_id": "p18",
      "text": "戴公申元年卒。齊桓公以衞數亂……是爲文公。文公以亂故犇齊，齊人入之。",
      "persons": ["戴公申", "齐桓公", "文公燬"],
      "places": ["卫", "楚丘", "齐"],
      "events": ["齐桓公筑楚丘"]
    },
    {
      "para_id": "p19",
      "text": "初，翟殺懿公也……復立其弟燬爲文公。",
      "persons": ["懿公赤", "宣公晋", "太子伋", "公子寿", "黔牟", "惠公朔", "昭伯顽", "戴公申", "文公燬"],
      "places": ["卫"],
      "events": ["翟伐卫杀懿公"]
    },
    {
      "para_id": "p20",
      "text": "文公初立，輕賦平罪……以收衞民。",
      "persons": ["文公燬"],
      "places": ["卫"],
      "events": []
    },
    {
      "para_id": "p21",
      "text": "十六年，晉公子重耳過，無禮……二十五年，文公卒，子成公鄭立。",
      "persons": ["晋文公", "齐桓公", "文公燬", "成公郑"],
      "places": ["齐", "晋"],
      "events": []
    },
    {
      "para_id": "p22",
      "text": "成公三年，晉欲假道於衞救宋……三十五年，成公卒，子穆公遬立。",
      "persons": ["成公郑", "元咺", "晋文公", "卫君瑕", "晋襄公", "秦穆公", "穆公遬"],
      "places": ["晋", "卫", "宋", "陈", "齐", "秦"],
      "events": ["元咺之乱"]
    },
    {
      "para_id": "p23",
      "text": "穆公二年，楚莊王伐陳，殺夏徵舒……定公十二年卒，子獻公衎立。",
      "persons": ["穆公遬", "楚庄王", "夏徵舒", "孙良夫", "定公臧", "献公衎"],
      "places": ["楚", "陈", "郑", "鲁", "齐"],
      "events": []
    },
    {
      "para_id": "p24",
      "text": "獻公十三年，公令師曹教宮妾鼓琴……是爲殤公。",
      "persons": ["献公衎", "师曹", "孙林父", "宁殖", "蘧伯玉", "殇公剽", "定公臧"],
      "places": ["宿", "齐", "聚邑", "卫"],
      "events": ["孙宁逐献公"]
    },
    {
      "para_id": "p25",
      "text": "殤公秋立，封孫文子林父於宿……獻公亡在外十二年而入。",
      "persons": ["殇公剽", "孙林父", "宁喜", "献公衎", "齐景公", "晋平公"],
      "places": ["宿", "晋", "齐", "卫"],
      "events": ["孙宁逐献公"]
    },
    {
      "para_id": "p26",
      "text": "獻公後元年，誅寗喜。",
      "persons": ["献公衎", "宁喜"],
      "places": [],
      "events": ["孙宁逐献公"]
    },
    {
      "para_id": "p27",
      "text": "三年，吳延陵季子使過衞……是年，獻公卒，子襄公惡立。",
      "persons": ["蘧伯玉", "史鰌", "孙林父", "献公衎", "襄公恶"],
      "places": ["卫", "宿"],
      "events": []
    },
    {
      "para_id": "p28",
      "text": "襄公六年，楚靈王會諸侯，襄公稱病不徃。",
      "persons": ["襄公恶", "楚灵王"],
      "places": ["楚"],
      "events": []
    },
    {
      "para_id": "p29",
      "text": "九年，襄公卒……是爲靈公。",
      "persons": ["襄公恶", "卫康叔", "孔成子", "灵公元"],
      "places": ["卫"],
      "events": []
    },
    {
      "para_id": "p30",
      "text": "靈公五年，朝晉昭公……十一年，火。",
      "persons": ["灵公元", "晋昭公", "楚平王", "楚灵王"],
      "places": ["晋", "楚"],
      "events": []
    },
    {
      "para_id": "p31",
      "text": "三十八年，孔子來，祿之如魯……後復來。",
      "persons": ["孔子", "灵公元"],
      "places": ["鲁"],
      "events": []
    },
    {
      "para_id": "p32",
      "text": "三十九年，太子蒯聵與靈公夫人南子有惡……已而之晉趙氏。",
      "persons": ["太子蒯聩", "南子", "戏阳遬", "灵公元"],
      "places": ["宋", "晋"],
      "events": ["太子蒯聩出奔"]
    },
    {
      "para_id": "p33",
      "text": "四十二年春，靈公游于郊，令子郢僕……於是衞乃以輙爲君，是爲出公。",
      "persons": ["灵公元", "子郢", "太子蒯聩", "出公辄"],
      "places": ["卫"],
      "events": ["灵公卒出公立"]
    },
    {
      "para_id": "p34",
      "text": "六月乙酉，趙簡子欲入蒯聵……衞人亦罷兵。",
      "persons": ["赵简子", "太子蒯聩", "阳虎"],
      "places": ["卫", "宿"],
      "events": []
    },
    {
      "para_id": "p35",
      "text": "出公輙四年，齊田乞弒其君孺子。八年，齊鮑子弒其君悼公。",
      "persons": ["出公辄", "齐田乞", "齐孺子", "齐鲍子", "齐悼公"],
      "places": ["齐"],
      "events": []
    },
    {
      "para_id": "p36",
      "text": "孔子自陳入衞。九年，孔文子問兵於仲尼……仲尼反魯。",
      "persons": ["孔子", "孔文子"],
      "places": ["陈", "卫", "鲁"],
      "events": []
    },
    {
      "para_id": "p37",
      "text": "十二年，初，孔圉文子取太子蒯聵之姊，生悝……奉出公輙犇魯。",
      "persons": ["孔文子", "太子蒯聩", "孔悝", "浑良夫", "伯姬", "栾宁", "仲由", "出公辄"],
      "places": ["宿", "鲁"],
      "events": ["孔悝之乱"]
    },
    {
      "para_id": "p38",
      "text": "仲由將入，遇子羔將出……孔悝竟立太子蒯聵，是爲莊公。",
      "persons": ["仲由", "子羔", "公孙敢", "孔悝", "太子蒯聩", "石乞", "盂黶", "孔子", "庄公蒯聩"],
      "places": ["卫"],
      "events": ["孔悝之乱"]
    },
    {
      "para_id": "p39",
      "text": "莊公蒯聵者，出公父也，居外……羣臣欲作亂，乃止。",
      "persons": ["庄公蒯聩", "出公辄"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p40",
      "text": "二年，魯孔丘卒。",
      "persons": ["孔子"],
      "places": ["鲁"],
      "events": []
    },
    {
      "para_id": "p41",
      "text": "三年，莊公上城，見戎州……更立公子起爲衞君。",
      "persons": ["庄公蒯聩", "赵简子", "公子斑师", "公子起"],
      "places": ["戎州", "卫", "齐"],
      "events": ["赵简子围卫"]
    },
    {
      "para_id": "p42",
      "text": "衞君起元年，衞石曼尃逐其君起……是爲悼公。",
      "persons": ["公子起", "石曼尃", "出公辄", "悼公黔"],
      "places": ["卫", "齐"],
      "events": ["出公复归悼公立"]
    },
    {
      "para_id": "p43",
      "text": "悼公五年卒，子敬公弗立……衞如小侯，屬之。",
      "persons": ["悼公黔", "敬公弗", "昭公紏"],
      "places": ["卫"],
      "events": []
    },
    {
      "para_id": "p44",
      "text": "昭公六年，公子亹弒之代立，是爲懷公……聲公十一年卒，子成侯速立。",
      "persons": ["昭公紏", "怀公亹", "慎公颓", "公子适", "敬公弗", "声公训", "成侯速"],
      "places": [],
      "events": ["战国卫弑君"]
    },
    {
      "para_id": "p45",
      "text": "成侯十一年，公孫鞅入秦。十六年，衞更貶號曰侯。",
      "persons": ["成侯速", "公孙鞅"],
      "places": ["秦", "卫"],
      "events": ["卫更贬号"]
    },
    {
      "para_id": "p46",
      "text": "二十九年，成侯卒，子平侯立。平侯八年卒，子嗣君立。",
      "persons": ["成侯速", "平侯", "嗣君"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p47",
      "text": "嗣君五年，更貶號曰君，獨有濮陽……二十五年，元君卒，子君角立。",
      "persons": ["嗣君", "怀君", "元君", "君角"],
      "places": ["濮阳", "魏", "秦", "东郡", "野王", "卫"],
      "events": ["卫更贬号"]
    },
    {
      "para_id": "p48",
      "text": "君角九年，秦并天下，立爲始皇帝。二十一年，二世廢君角爲庶人，衞絕祀。",
      "persons": ["君角", "始皇帝", "二世"],
      "places": ["秦", "卫"],
      "events": ["卫绝祀"]
    },
    {
      "para_id": "p49",
      "text": "太史公曰：余讀世家言，至於宣公之太子以婦見誅……亦獨何哉？",
      "persons": ["太史公", "宣公晋", "太子伋", "公子寿", "晋太子申生", "骊姬"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p50",
      "text": "索隱述贊曰：司宼受封，梓材有作……衞祚日衰，失於君角。",
      "persons": ["卫康叔", "成王", "周夷王", "武公和", "文公燬", "石碏", "宣公晋", "太子伋", "惠公朔", "太子蒯聩", "出公辄", "君角"],
      "places": ["卫"],
      "events": []
    }
  ]
}
