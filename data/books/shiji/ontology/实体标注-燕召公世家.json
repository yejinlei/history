{
  "book": "shiji",
  "chapter_id": "shiji-燕召公世家第四",
  "title": "燕召公世家第四",
  "paragraphs": [
    {
      "para_id": "p0",
      "text_summary": "召公奭与周同姓姬氏，周武王灭纣后封于北燕。",
      "persons": ["召公奭", "周武王"],
      "places": ["北燕"],
      "events": ["召公封燕"]
    },
    {
      "para_id": "p1",
      "text_summary": "成王时召公为三公，分陕而治；周公摄政，召公疑之，作《君奭》，周公称引商代贤臣以明志，召公乃悦。",
      "persons": ["召公奭", "周公旦", "周成王", "伊尹", "伊陟", "臣扈", "巫咸", "巫贤", "甘般"],
      "places": ["陕"],
      "events": ["分陕而治", "召公疑周公·《君奭》之作"]
    },
    {
      "para_id": "p2",
      "text_summary": "召公治西方得民和，于甘棠树下决狱政事，民思其政作《甘棠》之诗。",
      "persons": ["召公奭"],
      "places": ["甘棠"],
      "events": ["甘棠遗爱"]
    },
    {
      "para_id": "p3",
      "text_summary": "自召公以下九世至惠侯，当周厉王奔彘、共和之时。",
      "persons": ["燕惠侯"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p4",
      "text_summary": "惠侯卒，子釐侯立，当周宣王初即位；釐侯卒子顷侯立。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p5",
      "text_summary": "顷侯二十年，周幽王为犬戎所弑，秦始列为诸侯。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p6",
      "text_summary": "顷侯卒，子哀侯、郑侯、缪侯相次立。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p7",
      "text_summary": "缪侯至庄公，鲁隐公元年当缪侯七年，桓侯曾徙临易。",
      "persons": [],
      "places": ["临易（易县）"],
      "events": []
    },
    {
      "para_id": "p8",
      "text_summary": "庄公时齐桓公始霸；燕与宋卫伐周惠王立子穨，郑执燕仲父纳惠王；山戎侵燕，齐桓公救燕北伐山戎，割地与燕，命修召公之法。",
      "persons": ["燕庄公", "齐桓公", "周惠王"],
      "places": ["山戎", "燕留"],
      "events": ["齐桓公救燕北伐山戎"]
    },
    {
      "para_id": "p9",
      "text_summary": "襄公之世，晋文公践土之会称霸，秦师败于殽，秦穆公卒。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p10",
      "text_summary": "桓公、宣公、昭公、武公相继，是岁晋灭三郤大夫。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p11",
      "text_summary": "武公、文公、懿公、惠公相继，齐崔杼弑庄公。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p12",
      "text_summary": "惠公宠姬宋，诸大夫共诛之，惠公奔齐；齐晋伐燕入惠公，惠公至燕而死，燕立悼公。",
      "persons": ["燕惠公"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p13",
      "text_summary": "悼公、共公、平公、简公、献公、孝公相继；晋公室卑六卿强；吴王阖闾入郢；孔子卒；田常弑齐简公。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p14",
      "text_summary": "孝公十二年，韩魏赵灭知伯分其地，三晋强。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p15",
      "text_summary": "孝公、成公、湣公、釐公相继，三晋列为诸侯。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p16",
      "text_summary": "釐公伐败齐于林营，桓公、文公相继，秦献公卒秦益强。",
      "persons": [],
      "places": ["林营"],
      "events": []
    },
    {
      "para_id": "p17",
      "text_summary": "文公时齐威王卒；苏秦始来见说文公，约六国为合纵长；秦惠王以女妻燕太子。",
      "persons": ["燕文公", "苏秦"],
      "places": [],
      "events": ["苏秦合纵说燕文公"]
    },
    {
      "para_id": "p18",
      "text_summary": "文公卒，太子易王立。",
      "persons": [],
      "places": [],
      "events": []
    },
    {
      "para_id": "p19",
      "text_summary": "易王初立，齐宣王趁丧伐燕取十城，苏秦说齐复归之；十年燕君为王；苏秦惧诛，说王使齐为反间；易王卒子燕王哙立。",
      "persons": ["苏秦", "燕王哙"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p20",
      "text_summary": "燕王哙立，齐人杀苏秦；子之相燕贵重主断，苏代为齐使激燕王尊子之，燕王大信子之。",
      "persons": ["燕王哙", "子之", "苏秦", "苏代"],
      "places": [],
      "events": ["燕王哙让国子之之乱"]
    },
    {
      "para_id": "p21",
      "text_summary": "鹿毛寿说燕王让国子之，或人又以禹荐益、启自取之事说王，王收三百石以上印效之子之，子之南面行王事，哙反为臣。",
      "persons": ["燕王哙", "子之", "鹿毛寿"],
      "places": [],
      "events": ["燕王哙让国子之之乱"]
    },
    {
      "para_id": "p22",
      "text_summary": "子之三年国大乱，将军市被与太子平谋攻子之不克，反攻太子平，构难数月死者数万；孟轲劝齐伐燕，章子将五都之兵伐燕，士卒不战城门不闭，燕王哙死，齐大胜；二年燕人立太子平为昭王。",
      "persons": ["太子平", "市被", "子之", "燕王哙", "孟轲", "章子", "齐湣王", "燕昭王"],
      "places": [],
      "events": ["燕王哙让国子之之乱", "齐宣王伐燕破燕"]
    },
    {
      "para_id": "p23",
      "text_summary": "燕昭王即位后卑身厚币招贤，郭隗请先从隗始，昭王为隗改筑宫师事之；乐毅、邹衍、剧辛争趋燕；燕王吊死问孤与百姓同甘苦。",
      "persons": ["燕昭王", "郭隗", "乐毅", "邹衍", "剧辛"],
      "places": [],
      "events": ["燕昭王筑黄金台招贤"]
    },
    {
      "para_id": "p24",
      "text_summary": "昭王二十八年，燕殷富，以乐毅为上将军与秦楚三晋伐齐，齐兵败湣王出亡；燕兵独追北入临淄，尽取齐宝烧宫室宗庙，齐惟聊、莒、即墨不下，属燕六岁。",
      "persons": ["燕昭王", "乐毅", "齐湣王"],
      "places": ["临淄", "莒", "即墨"],
      "events": ["乐毅伐齐下七十余城"]
    },
    {
      "para_id": "p25",
      "text_summary": "昭王三十三年卒，子惠王立。",
      "persons": ["燕昭王", "燕惠王"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p26",
      "text_summary": "惠王为太子时与乐毅有隙，即位后使骑劫代将，乐毅亡走赵；齐田单以即墨败燕军，骑劫死燕兵归，齐悉复故城；湣王死于莒，立襄王。",
      "persons": ["燕惠王", "乐毅", "骑劫", "田单", "齐湣王"],
      "places": ["即墨", "莒"],
      "events": ["田单火牛阵破燕复齐"]
    },
    {
      "para_id": "p27",
      "text_summary": "惠王七年卒，韩魏楚共伐燕，燕武成王立。",
      "persons": ["燕惠王", "燕武成王"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p28",
      "text_summary": "武成王七年齐田单伐燕拔中阳；十三年秦败赵于长平坑四十余万；十四年武成王卒孝王立。",
      "persons": ["田单", "燕武成王"],
      "places": ["中阳"],
      "events": []
    },
    {
      "para_id": "p29",
      "text_summary": "孝王元年秦围邯郸解去；三年卒，子今王喜立。",
      "persons": ["燕王喜", "燕孝王"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p30",
      "text_summary": "今王喜四年，栗腹约欢赵还报可伐，昌国君乐间谏不听；将渠又谏王不听，王自将偏军随；赵使廉颇破栗腹于鄗、破卿秦乐乘于代，乐间奔赵，廉颇追围燕；赵必令将渠处和，燕以将渠为相处和，赵听将渠解围。",
      "persons": ["燕王喜", "栗腹", "乐间", "卿秦", "将渠", "廉颇"],
      "places": ["鄗", "代", "宋子"],
      "events": []
    },
    {
      "para_id": "p31",
      "text_summary": "秦灭东西周置三川郡，拔赵榆次置太原郡，秦王政初立；廉颇攻繁阳，赵孝成王卒悼襄王立，使乐乘代廉颇，廉颇奔大梁；赵李牧攻燕拔武遂方城；剧辛与庞煖故善，燕使剧辛击赵，赵使庞煖击杀剧辛取燕军二万；秦拔魏二十城置东郡，拔赵邺九城；太子丹质于秦亡归；秦虏韩王安灭韩置颍川郡；秦虏赵王迁灭赵，公子嘉自立为代王。",
      "persons": ["廉颇", "李牧", "剧辛", "庞煖", "太子丹", "秦王政"],
      "places": ["武遂", "方城", "邺"],
      "events": []
    },
    {
      "para_id": "p32",
      "text_summary": "秦兵临易水祸至燕，太子丹阴养壮士使荆轲献督亢地图刺秦王，秦王觉杀轲，使王翦击燕；二十九年秦拔蓟，燕王亡走辽东，斩丹献秦；秦灭魏。",
      "persons": ["太子丹", "荆轲", "秦王政", "王翦", "燕王喜"],
      "places": ["易水", "督亢", "蓟", "辽东"],
      "events": ["荆轲刺秦王"]
    },
    {
      "para_id": "p33",
      "text_summary": "三十三年秦拔辽东，虏燕王喜灭燕；是岁王贲亦虏代王嘉。",
      "persons": ["燕王喜", "王贲"],
      "places": ["辽东", "代"],
      "events": ["秦灭燕虏燕王喜"]
    },
    {
      "para_id": "p34",
      "text_summary": "太史公论召公奭可谓仁，甘棠尚思之；燕北迫蛮貊、内错齐晋，崎岖强国间最弱小，然社稷血食八九百岁，于姬姓独后亡，岂非召公之烈。",
      "persons": ["召公奭"],
      "places": [],
      "events": []
    },
    {
      "para_id": "p35",
      "text_summary": "索隐述赞概述召公分陕、甘棠遗爱、庄送霸主、惠罗宠姬、苏秦合纵、哙让子之、昭王待士、督亢不就燕国覆灭。",
      "persons": ["召公奭", "苏秦", "子之", "燕昭王", "荆轲"],
      "places": [],
      "events": ["分陕而治", "甘棠遗爱", "苏秦合纵说燕文公", "燕王哙让国子之之乱", "乐毅伐齐下七十余城", "荆轲刺秦王", "秦灭燕虏燕王喜"]
    }
  ]
}
