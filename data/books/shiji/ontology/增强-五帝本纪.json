    },
    {
      "order": 3,
      "event": "黄帝征师诸侯，与蚩尤战于涿鹿之野，擒杀蚩尤",
      "evidence": "p3"
    },
    {
      "order": 4,
      "event": "诸侯尊轩辕为天子，代神农氏，是为黄帝",
      "evidence": "p3"
    },
    {
      "order": 5,
      "event": "黄帝东至于海、西至空桐、南至江、北逐荤粥，合符釜山，邑于涿鹿",
      "evidence": "p4"
    },
    {
      "order": 6,
      "event": "黄帝举风后、力牧等治民，有土德之瑞，号黄帝",
      "evidence": "p4"
    },
    {
      "order": 7,
      "event": "黄帝娶嫘祖，生玄嚣、昌意；黄帝崩葬桥山，孙颛顼（高阳）立",
      "evidence": "p6"
    },
    {
      "order": 8,
      "event": "颛顼北至幽陵、南至交阯、西至流沙、东至蟠木，莫不砥属",
      "evidence": "p7"
    },
    {
      "order": 9,
      "event": "颛顼崩，玄嚣之孙高辛（帝喾）立",
      "evidence": "p8"
    },
    {
      "order": 10,
      "event": "帝喾崩，挚立；挚不善，弟放勋（尧）立",
