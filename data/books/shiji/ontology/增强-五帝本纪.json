    {
      "order": 14,
      "event": "舜流四罪（共工、驩兜、三苗、鲧），天下咸服",
      "evidence": "p17"
    },
    {
      "order": 15,
      "event": "尧崩，三年丧毕，舜让辟丹朱，天下归舜，践天子位",
      "evidence": "p18"
