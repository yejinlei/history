{
  "book": "shiji",
  "chapter_id": "shiji-陳杞世家第六",
  "title": "陈杞世家第六",
  "paragraphs": [
    {"para_id": "p0", "text": "陳胡公滿者，虞帝舜之後也……是爲胡公。", "persons": ["虞舜", "陈胡公满", "周武王", "商均"], "places": ["陈", "妫汭"], "events": ["周武王封舜后妫满于陈"]},
    {"para_id": "p1", "text": "胡公卒，子申公犀侯立……子幽公寧立。", "persons": ["陈胡公满", "申公犀侯", "相公皋羊", "孝公突", "慎公圉戎", "幽公宁"], "places": ["陈"], "events": []},
    {"para_id": "p2", "text": "幽公十二年，周厲王奔于彘。", "persons": ["幽公宁", "周厉王"], "places": ["彘"], "events": []},
    {"para_id": "p3", "text": "二十三年，幽公卒……秦始列爲諸侯。", "persons": ["幽公宁", "釐公孝", "周宣王", "武公灵", "夷公说", "周幽王", "平公燮"], "places": ["陈"], "events": []},
    {"para_id": "p4", "text": "二十三年，平公卒，子文公圉立。", "persons": ["平公燮", "文公圉"], "places": [], "events": []},
    {"para_id": "p5", "text": "文公元年，取蔡女，生子佗……長子桓公鮑立。", "persons": ["文公圉", "陈厉公（佗）", "桓公鲍"], "places": ["蔡"], "events": []},
    {"para_id": "p6", "text": "桓公二十三年，魯隱公初立……魯弒其君隱公。", "persons": ["桓公鲍", "鲁隐公", "卫州吁"], "places": ["鲁", "卫"], "events": []},
    {"para_id": "p7", "text": "三十八年正月甲戌己丑……故再赴。", "persons": ["桓公鲍", "陈厉公（佗）", "五父", "太子免"], "places": ["蔡", "陈"], "events": ["蔡人杀五父立佗为厉公"]},
    {"para_id": "p8", "text": "厲公二年，生子敬仲完……陳衰，此其昌乎？", "persons": ["陈厉公", "陈完", "周太史", "太岳"], "places": ["陈", "齐"], "events": ["田氏代齐预言"]},
    {"para_id": "p9", "text": "厲公取蔡女……是爲宣公。", "persons": ["陈厉公", "陈利公（跃）", "庄公林", "陈宣公（杵臼）", "蔡人"], "places": ["蔡"], "events": ["蔡人杀厉公立跃"]},
    {"para_id": "p10", "text": "宣公三年，楚武王卒……周惠王娶陳女爲后。", "persons": ["陈宣公", "楚武王", "周惠王"], "places": ["楚", "陈"], "events": []},
    {"para_id": "p11", "text": "二十一年，宣公後有嬖姬生子欵……莫之與京。", "persons": ["陈宣公", "太子御寇", "陈欵（穆公）", "陈完", "齐桓公", "齐懿仲"], "places": ["齐"], "events": ["陈完奔齐", "田氏代齐预言"]},
    {"para_id": "p12", "text": "三十七年，齊桓公伐蔡……晉獻公殺其太子申生。", "persons": ["齐桓公", "蔡女", "辕涛涂", "晋献公", "太子申生"], "places": ["蔡", "楚", "召陵", "陈"], "events": ["齐桓公伐蔡伐楚至召陵"]},
    {"para_id": "p13", "text": "四十五年，宣公卒……子靈公平國立。", "persons": ["陈宣公", "穆公", "齐桓公", "晋文公", "共公朔", "楚成王", "商臣（楚穆王）", "秦穆公", "陈灵公"], "places": ["城濮", "陈", "楚"], "events": ["晋楚城濮之战"]},
    {"para_id": "p14", "text": "靈公元年，楚莊王即位……陳及楚平。", "persons": ["陈灵公", "楚庄王"], "places": ["陈", "楚"], "events": []},
    {"para_id": "p15", "text": "十四年，靈公與其大夫孔寧……舒之母也。", "persons": ["陈灵公", "孔宁", "仪行父", "夏姬", "泄冶", "夏征舒"], "places": ["株林"], "events": ["夏姬之乱", "夏征舒弑陈灵公"]},
    {"para_id": "p16", "text": "成公元年冬，楚莊王爲夏徵舒殺靈公……輕千乘之國而重一言。", "persons": ["楚庄王", "夏征舒", "申叔时", "陈成公（午）", "孔子"], "places": ["陈", "楚", "齐", "晋"], "events": ["楚庄王县陈复陈", "蹊田夺牛之谏"]},
    {"para_id": "p17", "text": "二十八年，楚莊王卒……罷兵去。", "persons": ["楚庄王", "楚共王", "陈成公", "陈哀公"], "places": ["陈", "楚"], "events": []},
    {"para_id": "p18", "text": "哀公三年，楚圍陳……弒其君郟敖自立爲靈王。", "persons": ["陈哀公", "楚灵王（公子围）", "郏敖"], "places": ["陈", "楚"], "events": []},
    {"para_id": "p19", "text": "三十四年，初，哀公娶鄭……使弃疾爲陳公。", "persons": ["陈哀公", "长姬", "悼太子师", "少姬", "偃", "留", "胜", "司徒招", "楚灵王", "楚平王（弃疾）", "陈君留"], "places": ["郑", "陈", "楚"], "events": ["楚灵王灭陈"]},
    {"para_id": "p20", "text": "招之殺悼太子也……其在齊乎？", "persons": ["司徒招", "悼太子师", "吴（陈惠公）", "晋平公", "太史赵", "颛顼", "幕", "瞽瞍", "虞遂", "陈胡公满"], "places": ["晋", "齐", "陈"], "events": []},
    {"para_id": "p21", "text": "楚靈王滅陳五歲……空籍五歲矣。", "persons": ["楚灵王", "楚平王（弃疾）", "陈惠公（吴）"], "places": ["陈", "楚"], "events": ["楚平王复陈"]},
    {"para_id": "p22", "text": "七年，陳火……子懷公栁立。", "persons": ["陈惠公", "吴王僚", "公子光", "吴王阖闾", "伍子胥", "陈怀公"], "places": ["胡", "沈", "郢", "陈"], "events": ["吴伐陈取胡沈", "吴入郢"]},
    {"para_id": "p23", "text": "懷公元年，吳破楚……是爲湣公。", "persons": ["陈怀公", "吴王（阖闾/夫差）", "陈湣公"], "places": ["陈", "吴", "楚"], "events": ["陈怀公被留吴"]},
    {"para_id": "p24", "text": "湣公六年，孔子適陳……白公自殺。", "persons": ["陈湣公", "孔子", "吴王夫差", "楚昭王", "田常", "白公胜", "子西", "子綦", "楚惠王", "叶公"], "places": ["陈", "吴", "楚", "城父", "曹", "齐", "艾陵"], "events": ["孔子适陈", "艾陵之战", "田常弑齐简公", "白公之乱"]},
    {"para_id": "p25", "text": "二十四年，楚惠王復國……是歲，孔子卒。", "persons": ["楚惠王", "陈湣公", "孔子"], "places": ["陈", "楚"], "events": ["楚惠王灭陈"]},
    {"para_id": "p26", "text": "杞東樓公者……以奉夏后氏祀。", "persons": ["夏禹", "杞东楼公", "周武王"], "places": ["杞"], "events": ["周武王封夏后东楼公于杞"]},
    {"para_id": "p27", "text": "東樓公生西樓公……杞後陳亡三十四年。", "persons": ["东楼公", "西楼公", "题公", "谋娶公", "武公", "靖公", "共公", "德公", "桓公姑容", "孝公匄", "文公益姑", "平公郁", "悼公成", "隐公乞", "釐公（遂）", "杞湣公维", "杞哀公（阏路）", "出公欶", "杞简公春", "楚惠王"], "places": ["杞", "陈"], "events": ["楚惠王灭杞"]},
    {"para_id": "p28", "text": "杞小微，其事不足稱述。", "persons": [], "places": ["杞"], "events": []},
    {"para_id": "p29", "text": "舜之後……弗論也。", "persons": ["虞舜", "夏禹", "契", "后稷", "皋陶", "伯夷（太公望）", "伯翳", "垂", "益", "夔", "龙", "楚穆王", "齐湣王", "秦昭王", "项羽"], "places": ["陈", "杞", "殷/宋", "周", "英", "六", "齐", "秦", "滕", "薛", "驺", "会稽"], "events": []},
    {"para_id": "p30", "text": "周武王時……故弗采著于傳上。", "persons": ["周武王", "周幽王", "周厉王"], "places": ["江", "黄", "胡", "沈"], "events": []},
    {"para_id": "p31", "text": "太史公曰……其後越王勾踐興。", "persons": ["虞舜", "夏禹", "田常", "楚惠王", "越王勾践"], "places": ["陈", "杞", "齐", "越"], "events": ["舜德百世血食"]},
    {"para_id": "p32", "text": "索隱述贊曰……豈其苗裔？", "persons": ["虞舜", "夏禹", "陈胡公满", "杞东楼公", "杞哀公（阏路）", "夏姬", "楚惠王", "越王勾践", "田和"], "places": ["陈", "杞", "越", "齐"], "events": []}
  ]
}
