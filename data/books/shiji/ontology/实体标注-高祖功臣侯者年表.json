    {
      "para_id": "p0",
      "text": "〔正義〕高祖初定天下，表明有功之臣而侯之，若蕭、曹等。",
      "entities": [
        {"start": 4, "end": 6, "text": "高祖", "type": "person", "ref": "person-hangaozu"},
        {"start": 17, "end": 19, "text": "有功之臣", "type": "institution", "ref": "inst-houjou"},
