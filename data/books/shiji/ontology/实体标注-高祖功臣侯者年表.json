        {"start": 94, "end": 100, "text": "篤於仁義，奉上法", "type": "institution", "ref": "inst-du-yu-renyi"},
        {"start": 110, "end": 114, "text": "百有餘人", "type": "event", "ref": "event-gaozu-feng-gongchen"},
