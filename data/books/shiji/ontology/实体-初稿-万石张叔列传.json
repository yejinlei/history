        "note": "文帝时东阳侯张相如为太子太傅免，选可为傅者皆推石奋，奋为太子太傅；景帝即位以为九卿，徙为诸侯相。",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "e03",
        "name": "号奋为万石君",
        "note": "石奋及四子建、甲、乙、庆皆官至二千石，景帝曰「人臣尊宠乃集其门」，号奋为万石君。",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "e04",
        "name": "万石君家法",
        "note": "万石君以上大夫禄归老，过宫门阙必下车趋、见路马必式；子孙来谒必朝服见之；子孙有过不谯让，为便坐对案不食，待肉袒谢罪乃许。",
        "evidence": [
          "p2"
        ]
      },
      {
        "id": "e05",
        "name": "王臧获罪石建石庆进用",
        "note": "建元二年郎中令王臧以文学获罪，皇太后以为儒者文多质少，乃以石建为郎中令、石庆为内史。",
        "evidence": [
          "p3"
        ]
      },
      {
        "id": "e06",
        "name": "石建窃浣亲衣",
        "note": "石建为郎中令，每五日洗沐归谒亲，入子舍窃问侍者，取亲中裙厕牏身自浣涤，不敢令万石君知，以为常。",
        "evidence": [
          "p4"
        ]
      },
      {
        "id": "e07",
        "name": "内史庆醉归不下车",
        "note": "内史石庆醉归入外门不下车，万石君闻之不食；庆肉袒请罪不许，举宗及兄建肉袒，万石君让之，乃谢罢庆。",
        "evidence": [
          "p5"
        ]
      },
      {
        "id": "e08",
        "name": "石建误书马字",
        "note": "石建为郎中令，奏章批下后发现「馬」字少一笔（当五今四），惶恐谓「上谴死矣」，其谨慎如此。",
        "evidence": [
          "p7"
        ]
      },
      {
        "id": "e09",
        "name": "石庆数马",
        "note": "石庆为太仆御出，上问车中几马，庆以策数马毕举手曰「六马」；庆为诸子中最简易者，犹如此。",
        "evidence": [
          "p8"
        ]
      },
      {
        "id": "e10",
        "name": "石庆为齐相立石相祠",
        "note": "石庆为齐相，齐国皆慕其家行，不言而齐国大治，为立石相祠。",
        "evidence": [
          "p8"
        ]
      },
      {
        "id": "e11",
        "name": "石庆为丞相",
        "note": "元鼎五年丞相有罪罢，制诏以御史大夫石庆为丞相，封牧丘侯。时汉南诛两越、东击朝鲜、北逐匈奴、西伐大宛，事不关决于丞相，丞相醇谨而已，在位九年无所匡言。",
        "evidence": [
          "p10"
        ]
      },
      {
        "id": "e12",
        "name": "元封四年流民之议",
        "note": "元封四年关东流民二百万口，公卿议欲徙流民于边；上以丞相老谨，赐告归，案御史大夫以下议者。石庆惭上书请归丞相侯印、乞骸骨，天子以书让之，庆惭复视事。",
        "evidence": [
          "p11"
        ]
      },
      {
        "id": "e13",
        "name": "卫绾不奉诏受剑",
        "note": "景帝幸上林诏卫绾参乘，问其所以得参乘；绾答不自知，并言先帝赐剑六，不敢奉诏受剑。上使取六剑，剑尚盛未尝服。",
        "evidence": [
          "p14"
        ]
      },
      {
        "id": "e14",
        "name": "卫绾将河间兵击吴楚",
        "note": "吴楚反，诏卫绾为将，将河间兵击吴楚有功，拜为中尉；三岁以军功，孝景前六年封为建陵侯。",
        "evidence": [
          "p14"
        ]
      },
      {
        "id": "e15",
        "name": "废栗太子使郅都治捕栗氏",
        "note": "景帝废太子、诛栗卿之属，以卫绾长者不忍，赐绾告归，而使郅都治捕栗氏；既已，立胶东王为太子，召绾为太子太傅。",
        "evidence": [
          "p15"
        ]
      },
      {
        "id": "e16",
        "name": "直不疑偿金",
        "note": "直不疑为郎，同舍有告归者误持同舍郎金去，金主妄意不疑，不疑谢有之、买金偿；告归者归金，前郎大惭，以此称为长者。",
        "evidence": [
          "p17"
        ]
      },
      {
        "id": "e17",
        "name": "直不疑不自明",
        "note": "人或毁直不疑「善盗嫂」，不疑闻之曰「我乃无兄」，然终不自明。",
        "evidence": [
          "p17"
        ]
      },
      {
        "id": "e18",
        "name": "周仁阴重不泄",
        "note": "周仁为人阴重不泄，衣敝补、溺袴，期为不絜清，以是得幸；景帝入卧内后宫秘戏，仁常在旁，至景帝崩终无所言；上时问人，仁曰「上自察之」，亦无所毁。",
        "evidence": [
          "p21"
        ]
      },
      {
        "id": "e19",
        "name": "张欧涕泣封狱事",
        "note": "张欧为吏未尝言案人，专以诚长者处官；上具狱事，有可郤则郤之，不可者不得已涕泣面对而封之，其爱人如此。",
        "evidence": [
          "p23"
        ]
      }
    ],
    "concepts": [
      {
        "id": "c01",
        "name": "孝谨",
        "note": "孝顺恭谨；万石君家以孝谨闻乎郡国，子孙遵教。",
        "evidence": [
          "p1",
          "p2"
        ]
      },
      {
        "id": "c02",
        "name": "驯行孝谨",
        "note": "驯良的品行、孝顺恭谨；石奋四子皆以驯行孝谨官至二千石。",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "c03",
        "name": "醇谨",
        "note": "醇厚谨慎；卫绾「醇谨无他」，石庆为丞相「醇谨而已」。",
        "evidence": [
          "p4",
          "p10",
          "p13"
        ]
      },
      {
        "id": "c04",
        "name": "长者",
        "note": "忠厚朴讷的德厚之人；卫绾、直不疑、周仁、张欧皆被称为长者。",
        "evidence": [
          "p13",
          "p17",
          "p19",
          "p23"
        ]
      },
      {
        "id": "c05",
        "name": "讷言敏行",
        "note": "语出《论语·里仁》「君子欲讷于言而敏于行」，谓言语迟钝而行动敏捷；太史公以此许万石、建陵、张叔。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "c06",
        "name": "不肃而成不严而治",
        "note": "不用严厉而教化有成、不用峻严而治理有成；太史公谓万石诸家之教如此。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "c07",
        "name": "笃行君子",
        "note": "笃行实践的君子；太史公谓万石、建陵、张叔「可谓笃行君子矣」。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "c08",
        "name": "酎金失侯",
        "note": "汉制诸侯于八月献金助祭宗庙，成色分量不合者夺爵；卫信、直望皆坐酎金失侯。",
        "evidence": [
          "p16",
          "p19"
        ]
      },
      {
        "id": "c09",
        "name": "封禅",
        "note": "帝王祭天地的盛典；汉武帝巡狩、修神祠、封禅、兴礼乐。",
        "evidence": [
          "p10"
        ]
      },
      {
        "id": "c10",
        "name": "刑名",
        "note": "刑名之学（法家、名学）；张欧以治刑名言事太子。",
        "evidence": [
          "p23"
        ]
      },
      {
        "id": "c11",
        "name": "老子言",
        "note": "老子之学；直不疑学老子言，为官如故、不好立名。",
        "evidence": [
          "p19"
        ]
      },
      {
        "id": "c12",
        "name": "微巧",
        "note": "稍涉机巧；太史公讥塞侯（直不疑）「微巧」，为其近于佞。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "c13",
        "name": "处谄",
        "note": "处于谄媚之地；太史公讥周文「处谄」，谓其近于佞。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "c14",
        "name": "无他肠",
        "note": "没有别的心思、无异心；景帝以卫绾「忠实无他肠」而信之。",
        "evidence": [
          "p14"
        ]
      }
    ]
