{
  "book": "shiji",
  "book_name": "史记",
  "chapter_id": "shiji-惠景間侯者年表第七",
  "title": "惠景間侯者年表第七",
  "juan": "卷十九",
  "tili": "biao",
  "author": "司马迁",
  "paragraphs": [
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p0",
      "text": "太史公讀列封至便侯，⟦0⟧曰：有以也夫！長沙王者，著令甲，稱其忠焉。⟦1⟧昔高祖定天下，功臣非同姓疆土而王者八國。⟦2⟧⟦3⟧至孝惠時，唯獨長沙全，禪五世，⟦4⟧以無嗣絕，⟦5⟧竟無過，爲藩守職，信矣。故其澤流枝庶，毋功而侯者數人。⟦6⟧及孝惠訖孝景間五十載，追脩高祖時遣功臣，及從代來，吳楚之勞，諸侯子弟若肺腑，⟦7⟧外國歸義，封者九十有餘。咸表始終，當世仁義成功之著者也。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p1",
      "text": "索隱述贊曰：惠景之際，天下已平。諸呂構禍，吳楚連兵。條侯出討，壯武奉迎。薄竇恩澤，張趙忠貞。本枝分蔭，外腑歸誠。新市死事，建陵勳榮。咸開青社，俱受丹青。旋窺甲令，吳便有聲。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p2",
      "text": "〔索隱〕漢志縣名，屬桂陽。便音鞭。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p3",
      "text": "元年九月，頃侯吳淺元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p4",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p5",
      "text": "後七年，恭侯信元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p6",
      "text": "十一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p7",
      "text": "前六年，侯廣志元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p8",
      "text": "元鼎五年，侯千秋坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p9",
      "text": "〔集解〕音大。〔索隱〕縣名，在江夏。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p10",
      "text": "二年四月庚子，侯利倉元年。⟦0⟧"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p11",
      "text": "六"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p12",
      "text": "三年，侯豨元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p13",
      "text": "八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p14",
      "text": "十六年，侯彭祖元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p15",
      "text": "〔索隱〕屬東海。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p16",
      "text": "五年六月乙亥，孝侯劉到元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p17",
      "text": "二十一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p18",
      "text": "三年，侯成元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p19",
      "text": "後二年，侯成有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p20",
      "text": "右孝惠時三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p21",
      "text": "〔索隱〕縣名，屬信都。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p22",
      "text": "元年四月庚寅，侯昌平元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p23",
      "text": "八年，侯平坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p24",
      "text": "〔索隱〕，縣名，屬沛郡。一作「洨」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p25",
      "text": "元年四月辛卯，侯呂產元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p26",
      "text": "六年七月壬辰，產爲呂王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p27",
      "text": "高后八年九月，產以呂王爲漢相，謀爲不善。大臣誅產，遂滅諸呂。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p28",
      "text": "〔索隱〕縣名，屬信都。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p29",
      "text": "元年四月丙寅，侯張買元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p30",
      "text": "高后八年，侯買坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p31",
      "text": "〔索隱〕縣名，屬彭城。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p32",
      "text": "元年四月乙酉，齊侯陽成延元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p33",
      "text": "二"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p34",
      "text": "七年，敬侯去疾元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p35",
      "text": "七"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p36",
      "text": "中元三年，靖侯偃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p37",
      "text": "元光三年，侯戎奴元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p38",
      "text": "十四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p39",
      "text": "元狩五年，侯戎奴坐謀殺孝父弃市，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p40",
      "text": "〔索隱〕漢志闕。或鄉名。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p41",
      "text": "元年四月乙酉，敬侯齊受元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p42",
      "text": "四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p43",
      "text": "二年，齊侯市人元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p44",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p45",
      "text": "六年，恭侯應元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p46",
      "text": "元光二年，康侯延居元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p47",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p48",
      "text": "元鼎二年，侯昌元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p49",
      "text": "二"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p50",
      "text": "元鼎四年，侯昌有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p51",
      "text": "元年四月乙酉，敬侯馮無擇元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p52",
      "text": "四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p53",
      "text": "四年，侯代元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p54",
      "text": "高后八年，侯代坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p55",
      "text": "〔索隱〕縣名，屬沛郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p56",
      "text": "元年四月乙酉，侯呂種元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p57",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p58",
      "text": "爲不其侯。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p59",
      "text": "高后八年，侯種坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p60",
      "text": "〔索隱〕縣名，屬潁川。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p61",
      "text": "元年四月辛卯，侯義元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p62",
      "text": "高后四年，侯義爲常山王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p63",
      "text": "〔索隱〕縣名，屬河內。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p64",
      "text": "元年四月辛卯，侯朝元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p65",
      "text": "高后四年，侯朝爲常山王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p66",
      "text": "元年四月辛卯，侯武元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p67",
      "text": "高后五年，侯武爲淮陽王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p68",
      "text": "〔索隱〕縣，近長沙，漢志屬武陵。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p69",
      "text": "元年十一月壬申，頃侯吳陽元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p70",
      "text": "六"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p71",
      "text": "後二年，頃侯福元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p72",
      "text": "四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p73",
      "text": "中元五年，哀侯周元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p74",
      "text": "後二年，侯周薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p75",
      "text": "二年五月丙申，侯劉郢客元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p76",
      "text": "孝文元年，侯郢客爲楚王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p77",
      "text": "〔索隱〕縣名，屬琅邪。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p78",
      "text": "二年五月丙申，侯劉章元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p79",
      "text": "孝文二年，侯章爲城陽王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p80",
      "text": "〔索隱〕縣名，屬上谷。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p81",
      "text": "四年二月癸未，侯太元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p82",
      "text": "高后七年，太爲呂王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p83",
      "text": "〔索隱〕縣名，屬臨淮。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p84",
      "text": "四年四月丙申，侯呂勝元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p85",
      "text": "八年，侯勝坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p86",
      "text": "四年四月丙申，貞侯朱通元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p87",
      "text": "六"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p88",
      "text": "後元二年，侯悼元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p89",
      "text": "後元三年，侯悼有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p90",
      "text": "四年四月丙申，簡侯衞無擇元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p91",
      "text": "三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p92",
      "text": "六年，恭侯勝元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p93",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p94",
      "text": "後元三年，侯侈元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p95",
      "text": "建元六年，侯侈坐以買田宅不法，又請求吏罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p96",
      "text": "四年四月丙申，真侯王恬開元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p97",
      "text": "二十"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p98",
      "text": "四年，惠侯中黃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p99",
      "text": "十三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p100",
      "text": "四年，敬侯觸龍元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p101",
      "text": "元狩五年，侯當元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p102",
      "text": "八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p103",
      "text": "元封元年，侯當坐與奴闌入上林苑，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p104",
      "text": "〔集解〕徐廣曰「松，一作『祝』。」〔索隱〕縣名，屬廬江 。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p105",
      "text": "四年四月丙申，夷侯徐厲元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p106",
      "text": "十七"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p107",
      "text": "七年，康侯悼元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p108",
      "text": "四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p109",
      "text": "中六年，侯偃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p110",
      "text": "建元六年，侯偃有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p111",
      "text": "〔集解〕徐廣曰：「一作『陰』。」〔索隱〕漢志地闕。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p112",
      "text": "四年四月丙申，夷侯周信元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p113",
      "text": "十二年，孝侯勃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p114",
      "text": "三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p115",
      "text": "十五年，侯勃有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p116",
      "text": "〔集解〕如淳曰：「音輸」。〔索隱〕縣名，屬清河。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p117",
      "text": "⟦0⟧"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p118",
      "text": "四年四月丙申，侯呂它元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p119",
      "text": "八年，侯它坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p120",
      "text": "〔索隱〕劉氏云作「勝」，恐誤。今按滕縣屬沛郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p121",
      "text": "四年四月丙申，侯呂更始元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p122",
      "text": "八年，侯更始坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p123",
      "text": "〔索隱〕縣名，屬長沙。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p124",
      "text": "四年四月丙申，侯越元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p125",
      "text": "孝文四年，侯越有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p126",
      "text": "四年四月丙申，侯呂忿元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p127",
      "text": "八年，侯忿坐呂氏事誅，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p128",
      "text": "〔索隱〕縣名，屬東萊。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p129",
      "text": "六年四月丁酉，侯劉興居元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p130",
      "text": "孝文二年，侯興居爲濟北王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p131",
      "text": "〔集解〕一作「鉅」。〔索隱〕縣名，屬東萊。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p132",
      "text": "六年四月丁酉，侯呂通元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p133",
      "text": "高后八年，侯通爲燕王，坐呂氏事，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p134",
      "text": "〔索隱〕縣名，屬信都。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p135",
      "text": "八年四月丁酉，侯侈元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p136",
      "text": "八年四月丁酉，侯受元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p137",
      "text": "〔索隱〕漢書作「琅邪」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p138",
      "text": "〔索隱〕漢表在「東海」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p139",
      "text": "〔索隱〕澤一名釋。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p140",
      "text": "〔集解〕徐廣曰：「一作『康』。〔索隱〕縣名，在東平。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p141",
      "text": "右高后時三十一，孝文二十三，孝景十六。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p142",
      "text": "〔索隱〕表在新野，志屬勃海，恐有二縣。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p143",
      "text": "元年二月辛丑，侯劉揭元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p144",
      "text": "九"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p145",
      "text": "十五年，侯中意元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p146",
      "text": "景帝六年，侯中意有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p147",
      "text": "⟦0⟧"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p148",
      "text": "元年四月乙巳，侯薄昭元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p149",
      "text": "十三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p150",
      "text": "十一年，易侯戎奴元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p151",
      "text": "建元二年，侯梁元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p152",
      "text": "⟦0⟧"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p153",
      "text": "元年四月辛亥，侯宋昌元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p154",
      "text": "十三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p155",
      "text": "中元四年，侯昌奪侯，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p156",
      "text": "〔集解〕徐廣曰：「一作『鄡』，音苦堯反。」〔索隱〕漢表「鄔侯」，鄔，太原縣。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p157",
      "text": "〔索隱〕舅父即舅，猶姨曰姨母也。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p158",
      "text": "元年四月辛未，侯駟鈞元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p159",
      "text": "孝文前六年，鈞有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p160",
      "text": "〔索隱〕縣名，屬上郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p161",
      "text": "元年四月辛未，侯趙兼元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p162",
      "text": "孝文前六年，兼有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p163",
      "text": "〔索隱〕縣名，屬東平。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p164",
      "text": "元年六月丙寅，侯蔡兼元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p165",
      "text": "九"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p166",
      "text": "十五年，康侯客元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p167",
      "text": "〔集解〕徐廣曰：「客，一作『容』。」"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p168",
      "text": "七"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p169",
      "text": "中元三年，恭侯平元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p170",
      "text": "元朔二年，侯辟方元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p171",
      "text": "十四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p172",
      "text": "元鼎四年，侯辟方有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p173",
      "text": "〔索隱〕管，古國，今爲縣，屬滎陽。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p174",
      "text": "四年五月甲寅，恭侯劉罷軍元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p175",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p176",
      "text": "六年，恭侯戎奴元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p177",
      "text": "三年，侯戎奴反，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p178",
      "text": "〔索隱〕縣，在魏郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p179",
      "text": "四年五月甲寅，侯劉寧國元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p180",
      "text": "九"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p181",
      "text": "十五年，侯偃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p182",
      "text": "三年，侯偃反，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p183",
      "text": "〔索隱〕表在濟南。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p184",
      "text": "四年五月甲寅，平侯劉信都元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p185",
      "text": "十"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p186",
      "text": "十四年，侯廣元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p187",
      "text": "孝景三年，侯廣反，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p188",
      "text": "四年五月甲寅，恭侯劉將廬元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p189",
      "text": "〔索隱〕漢書作「將閭」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p190",
      "text": "十六年，侯將廬爲齊王，有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p191",
      "text": "〔集解〕音力。〔索隱〕縣名，屬平原。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p192",
      "text": "四年五月甲寅，侯劉辟光元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p193",
      "text": "十六年，侯辟光爲濟南王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p194",
      "text": "四年五月甲寅，侯劉志元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p195",
      "text": "十六年，侯志爲濟北王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p196",
      "text": "〔索隱〕縣名，屬平原。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p197",
      "text": "四年五月甲寅，侯劉卬元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p198",
      "text": "十六年，侯卬爲膠西王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p199",
      "text": "〔索隱〕漢志闕。凡闕者，或鄉名，或尋廢，故志不載。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p200",
      "text": "四年五月甲寅，侯劉賢元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p201",
      "text": "十六年，侯賢爲菑川王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p202",
      "text": "〔索隱〕縣名，屬金城。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p203",
      "text": "四年五月甲寅，侯劉雄渠元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p204",
      "text": "十六年，侯雄渠爲膠東王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p205",
      "text": "〔索隱〕漢表波作泜，音坻。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p206",
      "text": "七年三月甲寅，康侯魏駟元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p207",
      "text": "孝文十二年，康侯魏駟薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p208",
      "text": "〔集解〕徐廣曰：「一作『朝』。」〔索隱〕韋昭音貞，一音程。李彤云：「河南有𨜓亭。」音赬。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p209",
      "text": "〔索隱〕起，名也，史失其姓。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p210",
      "text": "孝文時坐復父故奪爵級，關內侯。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p211",
      "text": "〔索隱〕縣名，屬九江。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p212",
      "text": "八年五月丙午，侯劉安元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p213",
      "text": "孝文十六年，安爲淮南王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p214",
      "text": "〔索隱〕縣名，屬馮翊。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p215",
      "text": "八年五月丙午，侯勃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p216",
      "text": "孝文十六年，侯勃爲衡山王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p217",
      "text": "八年五月丙寅，侯劉賜元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p218",
      "text": "孝文十六年，侯賜爲廬江王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p219",
      "text": "〔索隱〕縣名，屬九江。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p220",
      "text": "八年五月丙寅，哀侯劉良元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p221",
      "text": "孝文十五年，侯良薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p222",
      "text": "〔索隱〕縣名，屬東郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p223",
      "text": "十年四月癸丑，頃侯召奴元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p224",
      "text": "三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p225",
      "text": "後五年，侯澤元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p226",
      "text": "元朔五年，侯延元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p227",
      "text": "十九"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p228",
      "text": "元封六年，侯延坐不出持馬，斬，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p229",
      "text": "〔索隱〕縣名，屬琅邪。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p230",
      "text": "十四年三月丁巳，侯孫鄲元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p231",
      "text": "孝景前三年，侯鄲謀反，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p232",
      "text": "〔索隱〕漢表在營陵。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p233",
      "text": "十六年六月丙子，莊侯韓頹當元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p234",
      "text": "前元年，侯則元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p235",
      "text": "元朔五年，侯則薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p236",
      "text": "〔索隱〕志屬潁川。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p237",
      "text": "十六年六月丙子，哀侯韓嬰元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p238",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p239",
      "text": "後元七年，侯澤之元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p240",
      "text": "元朔四年，侯澤之坐詐病不從，不敬，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p241",
      "text": "〔索隱〕縣名，屬涿郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p242",
      "text": "後元三年四月丁巳，節侯申屠嘉元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p243",
      "text": "十四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p244",
      "text": "前三年，恭侯元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p245",
      "text": "元狩二年，清安侯臾元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p246",
      "text": "五"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p247",
      "text": "元鼎元年，臾坐爲九江太守有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p248",
      "text": "〔索隱〕縣名，屬勃海。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p249",
      "text": "後元七年六月乙卯，景侯竇廣國元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p250",
      "text": "十"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p251",
      "text": "前七年，恭侯完元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p252",
      "text": "元光三年，侯常坐元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p253",
      "text": "十"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p254",
      "text": "元狩元年，侯常坐謀殺人未殺罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p255",
      "text": "〔索隱〕縣名，屬勃海。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p256",
      "text": "後元七年六月乙卯，侯竇彭祖元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p257",
      "text": "建元六年，夷侯良元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p258",
      "text": "五"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p259",
      "text": "元光五年，侯桑林元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p260",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p261",
      "text": "元鼎五年，侯桑林坐酎金罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p262",
      "text": "右孝文時二十八，孝景十六。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p263",
      "text": "〔索隱〕縣名，屬西河。又有東平陸，在東平。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p264",
      "text": "元年四月乙巳，侯劉禮元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p265",
      "text": "〔集解〕一云「乙卯」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p266",
      "text": "孝景三年，侯禮爲楚王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p267",
      "text": "元年四月乙巳，侯富元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p268",
      "text": "孝景三年，侯富以兄子戊爲楚王反，富與家屬至長安北闕自歸，不能相教，上印綬。詔復王。後以平陸侯爲楚王，更封富爲紅侯。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p269",
      "text": "〔索隱〕漢表在高苑。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p270",
      "text": "元年四月乙巳，夷侯劉穢元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p271",
      "text": "建元五年，侯受元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p272",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p273",
      "text": "元狩三年，侯受坐故爲宗正聽謁不具宗室，不敬，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p274",
      "text": "〔索隱〕楚元王傳，休侯富免後封紅侯，此則並列，誤也。漢表一書而已。紅、休，蓋二鄉名。王莽封劉歆爲紅休侯。一云紅即虹縣。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p275",
      "text": "三年四月乙巳，莊侯富元年。⟦0⟧"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p276",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p277",
      "text": "前七年，悼侯澄元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p278",
      "text": "九"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p279",
      "text": "中元元年，敬侯發元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p280",
      "text": "〔集解〕發，一作「嘉」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p281",
      "text": "元朔四年，侯章元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p282",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p283",
      "text": "元朔五年，侯章薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p284",
      "text": "〔索隱〕縣名，屬濟陰。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p285",
      "text": "元年四月乙巳，侯劉執元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p286",
      "text": "〔索隱〕蕭該執音藝。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p287",
      "text": "孝景三年，侯執反，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p288",
      "text": "〔索隱〕縣名，屬琅邪。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p289",
      "text": "三年六月乙巳，侯竇嬰元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p290",
      "text": "建元元年爲丞相，二歲免。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p291",
      "text": "元光四年，侯嬰坐爭灌夫事，上書稱爲先帝詔，矯制害，弃市，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p292",
      "text": "三年八月壬子，敬侯劉調元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p293",
      "text": "建元二年，恭侯應元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p294",
      "text": "元朔元年，侯慶元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p295",
      "text": "十六"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p296",
      "text": "元鼎五年，侯慶坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p297",
      "text": "〔索隱〕俞音輸，縣名，屬清河。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p298",
      "text": "六年四月丁卯，侯欒布元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p299",
      "text": "中元五年，侯布薨。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p300",
      "text": "元狩六年，侯賁坐爲太常廟犧牲不如令，有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p301",
      "text": "〔集解〕一云元朔二年，侯賁元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p302",
      "text": "六年四月丁卯，敬侯衞綰元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p303",
      "text": "元光五年，侯信元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p304",
      "text": "十八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p305",
      "text": "元鼎五年，侯信坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p306",
      "text": "〔索隱〕縣名，屬沛郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p307",
      "text": "六年四月丁卯，哀侯程嘉元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p308",
      "text": "元光二年，節侯橫元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p309",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p310",
      "text": "元光三年，侯回元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p311",
      "text": "一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p312",
      "text": "元光四年，侯回薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p313",
      "text": "〔索隱〕漢表在高城。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p314",
      "text": "六年四月己巳，侯公孫昆邪元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p315",
      "text": "〔索隱〕漢書昆作「渾」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p316",
      "text": "中元四年，侯昆邪有罪，國除。太僕賀父。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p317",
      "text": "〔索隱〕縣，在東海。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p318",
      "text": "六年四月壬申，康侯蘇嘉元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p319",
      "text": "〔集解〕徐廣曰：「蘇，一作『籍』。」〔索隱〕漢表作「蘇息」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p320",
      "text": "七"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p321",
      "text": "中元二年，懿侯盧元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p322",
      "text": "〔集解〕徐廣曰：「一作『哀侯』。」"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p323",
      "text": "建元三年，侯明元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p324",
      "text": "六"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p325",
      "text": "元朔六年，侯雕元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p326",
      "text": "十一"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p327",
      "text": "元鼎五年，侯雕坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p328",
      "text": "〔索隱〕漢表，鄉名，在常山。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p329",
      "text": "中元二年四月己巳，侯橫元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p330",
      "text": "〔索隱〕史失其姓。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p331",
      "text": "後元二年，侯橫有罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p332",
      "text": "〔索隱〕縣名，屬鉅鹿。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p333",
      "text": "中元二年四月乙巳，侯康元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p334",
      "text": "三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p335",
      "text": "後元元年，殤侯始昌元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p336",
      "text": "元光四年，殤侯始昌爲人所殺，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p337",
      "text": "〔索隱〕漢表在臨淮。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p338",
      "text": "中元二年四月乙巳，侯周元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p339",
      "text": "元鼎五年，侯周坐爲丞相知列侯酎金輕，下廷尉，自殺，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p340",
      "text": "中元二年四月乙巳，侯當居元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p341",
      "text": "元朔五年，侯當居坐爲太常程博士弟子故，不以實罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p342",
      "text": "〔集解〕徐廣曰：「程，一作『澤』。」"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p343",
      "text": "中元三年十一月庚子，侯子軍元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p344",
      "text": "建元六年，侯子軍薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p345",
      "text": "〔索隱〕縣名，屬河東。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p346",
      "text": "中元二年十二月丁丑，侯賜元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p347",
      "text": "六年，賜死，不得及嗣。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p348",
      "text": "〔索隱〕縣名，屬涿郡。音茲鳩反。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p349",
      "text": "〔集解〕徐廣曰：「漢書云武後二年」。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p350",
      "text": "〔索隱〕縣名，屬涿郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p351",
      "text": "中元三年十二月丁丑，侯唯徐盧元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p352",
      "text": "建元二年，康侯綽元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p353",
      "text": "二"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p354",
      "text": "元朔三年，侯光元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p355",
      "text": "後三年，五月壬辰，侯光坐祠祝詛，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p356",
      "text": "〔索隱〕縣名，屬涿郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p357",
      "text": "中元二年十二月丁丑，侯僕黥元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p358",
      "text": "後元二年，侯僕黥薨，無嗣。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p359",
      "text": "〔索隱〕縣名，屬涿郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p360",
      "text": "中元三年十二月丁丑，端侯代元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p361",
      "text": "元光二年，懷侯德元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p362",
      "text": "二"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p363",
      "text": "元光四年，侯德薨，無後，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p364",
      "text": "〔索隱〕漢表在內黃。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p365",
      "text": "中元三年十二月丁丑，侯邯鄲元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p366",
      "text": "元光四年，侯邯鄲坐行來不請長信，不敬，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p367",
      "text": "〔索隱〕一作「亞父」，漢表在河內。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p368",
      "text": "中元五年四月丁巳，簡侯它父"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p369",
      "text": "〔索隱〕簡侯它父。元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p370",
      "text": "三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p371",
      "text": "後元元年，安侯種元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p372",
      "text": "建元元年，康侯偏元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p373",
      "text": "二十四"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p374",
      "text": "元光六年，侯賀元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p375",
      "text": "征和三年七月辛巳，侯賀坐太子事，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p376",
      "text": "〔索隱〕音林閭。縣名，屬河內。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p377",
      "text": "中元五年五月丁丑，侯蟜元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p378",
      "text": "〔集解〕徐廣曰：「案本紀乃前五年，非中元五年。」"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p379",
      "text": "元鼎元年，侯蟜坐母長公主薨未除服，姦，禽獸行，當死，自殺，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p380",
      "text": "〔索隱〕縣名，屬濟陰。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p381",
      "text": "中元六年，侯買嗣爲梁王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p382",
      "text": "中元五年五月丁卯，侯明元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p383",
      "text": "孝景中六年，爲濟川王，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p384",
      "text": "〔索隱〕漢表在勃海。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p385",
      "text": "中元三年五月甲戌，靖侯王信元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p386",
      "text": "元狩三年，侯偃元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p387",
      "text": "八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p388",
      "text": "元鼎五年，侯偃坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p389",
      "text": "後元元年八月，侯直不疑元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p390",
      "text": "建元四年，侯相如元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p391",
      "text": "十二"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p392",
      "text": "元朔四年，侯堅元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p393",
      "text": "十三"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p394",
      "text": "元鼎五年，堅坐酎金，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p395",
      "text": "〔索隱〕縣名，屬魏郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p396",
      "text": "後元三年三月，侯田蚡元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p397",
      "text": "元光四年，侯梧元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p398",
      "text": "五"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p399",
      "text": "元朔三年，侯梧坐衣襜褕入宮廷中，不敬，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p400",
      "text": "〔索隱〕縣名，屬上郡。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p401",
      "text": "後元三年三月，懿侯田勝元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p402",
      "text": "元光六年，侯彭祖元年。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p403",
      "text": "八"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p404",
      "text": "元狩二年，侯彭祖坐當歸與章侯宅不與罪，國除。"
    },
    {
      "id": "text:shiji:shiji-惠景間侯者年表第七:p405",
      "text": "右孝景時三十一"
    }
  ]
}