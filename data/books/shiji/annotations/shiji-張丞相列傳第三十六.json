    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p13",
    "annotator": "集解",
    "text": "徐廣曰：「一作『𩕕』，音瞶。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a42",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p13",
    "annotator": "索隱",
    "text": "案漢書云傳子至孫毅有罪，國除，今此云康侯代，八年卒，子類代侯，則類即毅也，與漢書略同。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a43",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p14",
    "annotator": "集解",
    "text": "漢書云長八尺。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a44",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p15",
    "annotator": "集解",
    "text": "徐廣曰：「勇健有材力開張。」駰案：如淳曰「材官之多力，能腳蹋強弩張之，故曰蹶張。律有蹶張士」。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a45",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p15",
    "annotator": "索隱",
    "text": "孟康云：「主張強弩。」蹶音其月反。漢令有蹶張士百人是也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a46",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p15",
    "annotator": "索隱",
    "text": "所類反。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a47",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p15",
    "annotator": "集解",
    "text": "徐廣曰：「後二年八月。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a48",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p15",
    "annotator": "正義",
    "text": "今易州界武陽城中東南隅故城是也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a49",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p16",
    "annotator": "集解",
    "text": "如淳曰：「嘉語其吏曰：『今便行斬之。』」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a50",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p17",
    "annotator": "集解",
    "text": "服虔曰：「宮外垣也。」如淳曰：「堧音『畏愞』之『愞』。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a51",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p17",
    "annotator": "索隱",
    "text": "愞音乃喚反。韋昭音而緣反。又音軟。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a52",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p17",
    "annotator": "正義",
    "text": "自歸帝首露。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a53",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p17",
    "annotator": "索隱",
    "text": "漢書作「冗官」，謂散官也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a54",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p17",
    "annotator": "集解",
    "text": "徐廣曰：「一本無侯去病，而云共侯蔑三十三年，子臾改封靖安侯。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a55",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「陶青，高祖功臣陶舍之子也，謚夷。劉舍，本項氏親也，賜姓劉氏。父襄佐高祖有功。舍謚哀侯。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a56",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「高祖功臣許溫之孫，謚哀侯。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a57",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「高祖功臣廣平侯薛歐之孫平棘節侯薛澤。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a58",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「高祖功臣莊不識之孫。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a59",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「周父夷吾爲楚王戊太傅，諫爭而死。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a60",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「娖音七角反。一作『斷』，一作『𪘏』。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a61",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p18",
    "annotator": "索隱",
    "text": "娖音側角反。小顏云「持整之貌」。漢書作「𪘏」，𪘏音初角反。斷音都亂反。義如尚書「斷斷猗無他技」。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a62",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p19",
    "annotator": "集解",
    "text": "張晏曰：「不考經典，專用顓頊曆，何哉？」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a63",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p19",
    "annotator": "正義",
    "text": "言其質直掘強如木石焉。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a64",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p19",
    "annotator": "集解",
    "text": "張晏曰：「謂傷辱呂后吏。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a65",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p21",
    "annotator": "集解",
    "text": "名千秋。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a66",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p21",
    "annotator": "索隱",
    "text": "自車千秋已下，皆褚先生等所記，然丞相傳都省略，漢書則備。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a67",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p22",
    "annotator": "集解",
    "text": "名廣漢。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a68",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p22",
    "annotator": "索隱",
    "text": "繁，姓也，音婆。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a69",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p26",
    "annotator": "集解",
    "text": "名廣德也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a70",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p28",
    "annotator": "集解",
    "text": "徐廣曰：「微，一作『徵』。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a71",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p28",
    "annotator": "集解",
    "text": "高堂隆答魏朝訪曰：「物，無也。故，事也。言無復所能於事。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a72",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p28",
    "annotator": "索隱",
    "text": "案此論匡衡已來事，則後人所述也，或亦稱「太史公」，其序述淺陋，一何誣也！"
  }
]