    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p5",
    "annotator": "集解",
    "text": "孟康曰：「方與，縣名；公，其號。」瓚曰：「方與縣令也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a19",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p5",
    "annotator": "正義",
    "text": "古用簡牘，書有錯謬，以刀削之，故號曰「刀筆吏」。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a20",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p5",
    "annotator": "索隱",
    "text": "謂不知其計所出也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a21",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p5",
    "annotator": "正義",
    "text": "桓譚新論云：「使周相趙，不如使取呂后家女爲妃，令戚夫人善事呂后，則如意無斃也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a22",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p5",
    "annotator": "索隱",
    "text": "諸侯王表有左官之律。韋昭以爲「左猶下也，禁不得下仕於諸侯王也」。然地道尊右，右貴左賤，故謂貶秩爲「左遷」。他皆類此。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a23",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p6",
    "annotator": "集解",
    "text": "徐廣曰：「十年也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a24",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p6",
    "annotator": "集解",
    "text": "徐廣曰：「十一年。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a25",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p7",
    "annotator": "集解",
    "text": "徐廣曰：「謚悼也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a26",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p7",
    "annotator": "索隱",
    "text": "漢書列傳及表咸言周昌謚悼，韋昭云「或謚惠」，非也。漢書又曰「傳子至孫意，有罪，國除。景帝復封昌孫左車爲安陽侯，有罪，國除。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a27",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p8",
    "annotator": "正義",
    "text": "高后之年。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a28",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p8",
    "annotator": "集解",
    "text": "徐廣曰：「呂后元年，國除。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a29",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p9",
    "annotator": "正義",
    "text": "辟音避。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a30",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p9",
    "annotator": "集解",
    "text": "徐廣曰：「文帝二年，任敖卒，謚懿侯。曾孫越人，元鼎二年爲太常，坐酒酸，國除。」駰案：漢書任敖孝文元年薨，徐誤也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a31",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p9",
    "annotator": "索隱",
    "text": "此徐氏據漢書爲說，而誤云「二年」，裴駰又引任安書證，爲得其實。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a32",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p9",
    "annotator": "正義",
    "text": "按：史記書表云孝文二年卒，漢表又云封十九年卒，計高祖十一年封，到文帝二年則十九年矣。而漢書誤，裴氏不考，乃云徐誤，何其貳過也！"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a33",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "集解",
    "text": "文穎曰：「緒，尋也。或曰緒，業也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a34",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "正義",
    "text": "姚察云：「蒼是秦人，猶用推五勝之法，以周赤烏爲火，漢勝火以水也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a35",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "集解",
    "text": "如淳曰：「比謂五音清濁各有所比也。以定十二月律之法令於樂官，使長行之。」瓚曰：「謂以比故取類，以定法律與條令也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a36",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "正義",
    "text": "比音鼻，或音必履反，謂比方也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a37",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "集解",
    "text": "如淳曰：「若，順也。百工爲器物皆有尺寸斤兩，皆使得宜，此之謂順。」晉灼曰：「若，預及之辭。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a38",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "索隱",
    "text": "晉灼說爲得。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a39",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p11",
    "annotator": "集解",
    "text": "漢書曰：「著書十八篇，言陰陽律曆事。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a40",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p13",
    "annotator": "集解",
    "text": "張晏曰：「所選保任者也。」瓚曰：「中候，官名。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a41",
