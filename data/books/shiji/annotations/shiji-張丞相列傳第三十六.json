    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p0",
    "annotator": "正義",
    "text": "鄭州陽武縣也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a2",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p0",
    "annotator": "集解",
    "text": "如淳曰：「方，版也，謂書事在版上者也。秦以上置柱下史，蒼爲御史，主其事。或曰四方文書。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a3",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p0",
    "annotator": "索隱",
    "text": "周秦皆有柱下史，謂御史也。所掌及侍立恆在殿柱之下，故老子爲周柱下史。今蒼在秦代亦居斯職。方書者，如淳以爲方板，謂小事書之於方也，或曰主四方文書也。姚氏以爲下云「明習天下圖書計籍，主郡上計」，則方爲四方文書是也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a4",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p0",
    "annotator": "索隱",
    "text": "小顏云：「質，椹也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a5",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p1",
    "annotator": "集解",
    "text": "文穎曰：「能計，故號曰計相。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a6",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p1",
    "annotator": "集解",
    "text": "張晏曰：「以列侯典校郡國簿書。」如淳曰：「以其所主，因以爲官號，與計相同。時所卒立，非久施也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a7",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p1",
    "annotator": "索隱",
    "text": "謂改計相之名，更名主計也。此蓋權時立號也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a8",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p2",
    "annotator": "集解",
    "text": "徐廣曰：「主旗幟之屬。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a9",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p2",
    "annotator": "索隱",
    "text": "官名也。職，主也。志，旗幟也，謂掌旗幟之官也。音昌志反。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a10",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p2",
    "annotator": "集解",
    "text": "張晏曰：「爲帳下賔客，不掌官。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a11",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p3",
    "annotator": "集解",
    "text": "徐廣曰：「四年三月也。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a12",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p3",
    "annotator": "集解",
    "text": "徐廣曰：「九年封，封三十九年，文帝後元四年謀反死，國除。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a13",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p4",
    "annotator": "集解",
    "text": "漢書音義曰：「以上燕時入奏事。」"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a14",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p4",
    "annotator": "正義",
    "text": "昌以口吃，每語故重言期期也。"
  },
  {
    "id": "anno:shiji:shiji-張丞相列傳第三十六:a15",
    "book": "shiji",
    "chapter_id": "shiji-張丞相列傳第三十六",
    "target_para_id": "text:shiji:shiji-張丞相列傳第三十六:p4",
    "annotator": "集解",
    "text": "韋昭曰：「殿東堂也。」"
  },
