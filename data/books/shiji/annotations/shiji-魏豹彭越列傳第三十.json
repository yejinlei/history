[
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a0",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p0",
    "annotator": "索隱",
    "text": "案彭越傳云「魏豹，魏王咎從弟，真魏後也。」晉灼云「寗陵，梁國縣也，即今寧陵是」。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a1",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p0",
    "annotator": "正義",
    "text": "王，于放反。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a2",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p0",
    "annotator": "索隱",
    "text": "老子曰「國家昏亂有忠臣」，此取以爲說也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a3",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p0",
    "annotator": "集解",
    "text": "徐廣曰：「元年十二月也。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a4",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p1",
    "annotator": "正義",
    "text": "故城在淄州高苑縣北二里，本漢縣。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a5",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p1",
    "annotator": "索隱",
    "text": "案項它，楚將；田巴，齊將也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a6",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p1",
    "annotator": "正義",
    "text": "它，徒多反。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a7",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p2",
    "annotator": "集解",
    "text": "徐廣曰：「二年六月。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a8",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p2",
    "annotator": "正義",
    "text": "今晉州。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a9",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p3",
    "annotator": "正義",
    "text": "臨晉在同州朝邑縣界。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a10",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p3",
    "annotator": "索隱",
    "text": "莊子云「無異騏驥之馳過隙」，則謂馬也。小顏云「白駒謂日影也。隙，壁隙也」。以言速疾，若日影過壁隙也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a11",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p3",
    "annotator": "集解",
    "text": "徐廣曰：「二年九月也。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a12",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p3",
    "annotator": "集解",
    "text": "高祖本紀曰：「置三郡，河東、太原、上黨。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a13",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p4",
    "annotator": "正義",
    "text": "漢武更山陽爲昌邑國，有梁丘鄉。梁兵故城在曹州城武縣東北三十三里。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a14",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p5",
    "annotator": "索隱",
    "text": "旦日謂明日之朝日出時也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a15",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p6",
    "annotator": "正義",
    "text": "碭音徒郎反。宋州碭山縣。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a16",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p6",
    "annotator": "正義",
    "text": "蕭縣令。楚縣令稱公；角，名。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a17",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p6",
    "annotator": "索隱",
    "text": "擅猶專也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a18",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "滑州河上。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a19",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "睢陽，宋州宋城也。外黃在汴州雍丘縣東。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a20",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "河南府氾水是。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a21",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "爲，于偽反。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a22",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "在齊州東阿縣東二十六里是。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a23",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p7",
    "annotator": "正義",
    "text": "夏，古雅反。陳州太康縣也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a24",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "正義",
    "text": "固陵，地名，在陳州宛丘縣西北三十二里。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a25",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "正義",
    "text": "從宋州已北至鄆州以西，曹、濮、汴、滑並與彭越。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a26",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "集解",
    "text": "音附"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a27",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "正義",
    "text": "從陳、潁州北以東，亳、泗、徐、淮北之地，東至海，并淮南、淮陰之邑，盡與韓信。韓信又先有故齊舊地。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a28",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "正義",
    "text": "在亳州也。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a29",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p8",
    "annotator": "正義",
    "text": "曹州。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a30",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "集解",
    "text": "張晏曰：「扈輒勸越反，不聽，而云『反形已見』，有司非也。」瓚曰：「扈輒勸越反，而越不誅輒，是反形已具。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a31",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "集解",
    "text": "文穎曰：「青衣，縣名，在蜀。」瓚曰：「今漢嘉是也。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a32",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "索隱",
    "text": "蘇林曰：「縣名，今爲臨卭。」瓚說爲是。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a33",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "索隱",
    "text": "地理地鄭屬京兆。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a34",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "正義",
    "text": "華州。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a35",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p10",
    "annotator": "正義",
    "text": "上唯季反。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a36",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p11",
    "annotator": "正義",
    "text": "言魏地闊千里，如席卷舒。"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a37",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p11",
    "annotator": "集解",
    "text": "徐廣曰：「喋，一作『唼』。韓傳亦有『喋血』語也。」"
  },
  {
    "id": "anno:shiji:shiji-魏豹彭越列傳第三十:a38",
    "book": "shiji",
    "chapter_id": "shiji-魏豹彭越列傳第三十",
    "target_para_id": "text:shiji:shiji-魏豹彭越列傳第三十:p11",
    "annotator": "索隱",
    "text": "音牒。喋猶踐也。殺敵踐血而行，孝文紀「喋血京師」是也。"
  }
]