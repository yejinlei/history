[
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a0",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p0",
    "annotator": "索隱",
    "text": "潁，水名。地理志潁水出陽城。漢有潁陽、臨潁二縣，今亦有潁上縣。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a1",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p0",
    "annotator": "正義",
    "text": "韋昭云：「夷吾，姬姓之後，管嚴之子敬仲也。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a2",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p0",
    "annotator": "索隱",
    "text": "呂氏春秋：「管仲與鮑叔同賈南陽，及分財利，而管仲嘗欺鮑叔，多自取。鮑叔知其有母而貧，不以爲貪也。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a3",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p0",
    "annotator": "正義",
    "text": "齊世家云：「鮑叔牙曰：『君將治齊，則高傒與叔牙足矣。君且欲霸王，非管夷吾不可。夷吾所居國國重，不可失也。』於是桓公從之。」韋昭云：「鮑叔，齊大夫，姒姓之後，鮑叔之子叔牙也。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a4",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p0",
    "annotator": "正義",
    "text": "管子云：「相齊以九惠之教，一曰老，二曰慈，三曰孤，四曰疾，五曰獨，六曰病，七曰通，八曰賑，九曰絕也。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a5",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p1",
    "annotator": "正義",
    "text": "賈音古。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a6",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p2",
    "annotator": "索隱",
    "text": "按：系本云「莊仲山產敬仲夷吾，夷吾產武子鳴，鳴產桓子啟方，啟方產成子孺，孺產莊子盧，盧產悼子其夷，其夷產襄子武，武產景子耐涉，耐涉產微，凡十代」。系譜同。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a7",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "正義",
    "text": "國語云：「齊桓公使鮑叔爲相，辭曰：『臣之不若夷吾者五：寬和惠民，不若也；治國家不失其柄，不若也；忠惠可結於百姓，不若也；制禮義可法於四方，不若也；執枹鼓立於軍門，使百姓皆加勇，不若也。』」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a8",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "正義",
    "text": "齊國東濵海也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a9",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "索隱",
    "text": "是夷吾著書所稱管子者，其書有此言，故略舉其要。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a10",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "正義",
    "text": "上之服御物有制度，則六親堅固也。六親謂外祖父母一，父母二，姊妹三，妻兄弟之子四，從母之子五，女之子六也。王弼云「父、母、兄、弟、妻、子也」。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a11",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "注",
    "text": "管子曰：「四維，一曰禮，二曰義，三曰廉，四曰恥。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a12",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p3",
    "annotator": "正義",
    "text": "言爲政令卑下鮮少，而百姓易作行也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a13",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "索隱",
    "text": "輕重謂錢也。今管子有輕重篇。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a14",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "正義",
    "text": "輕重謂恥辱也，權衡謂得失也。有恥辱甚貴重之，有得失甚戒慎之。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a15",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "索隱",
    "text": "按：謂怒蕩舟之姬，歸而未絕，蔡人嫁之。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a16",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "正義",
    "text": "今齊州東阿也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a17",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "索隱",
    "text": "沫音昧，亦音末。左傳作「曹劌」。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a18",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "正義",
    "text": "沫，莫葛反。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a19",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "正義",
    "text": "以劫許之，歸魯侵地。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a20",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p4",
    "annotator": "索隱",
    "text": "老子曰「將欲取之，必固與之」，是知此爲政之所寶也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a21",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p5",
    "annotator": "正義",
    "text": "三歸，三姓女也。婦人謂嫁曰歸。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a22",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p5",
    "annotator": "正義",
    "text": "括地志云：「管仲冢在青州臨淄縣南二十一里牛山之阿。說苑云『齊桓公使管仲治國，管仲對曰：「賤不能臨貴。」桓公以爲上卿，而國不治，曰：「何故？」管仲對曰：「貧不能使富。」桓公賜之齊巿租，而國不治。桓公曰：「何故？」對曰：「疏不能制近。」桓公立以爲仲父，齊國大安，而遂霸天下。』孔子曰：『管仲之賢而不得此三權者，亦不能使其君南面而稱伯。』」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a23",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "集解",
    "text": "劉向別錄曰：「萊者，今東萊地也。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a24",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "索隱",
    "text": "名嬰，平謚，仲字。父桓子名弱也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a25",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "正義",
    "text": "晏氏齊記云齊城三百里有夷安，即晏平仲之邑。漢爲夷安縣，屬高密國。應劭云故萊夷維邑。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a26",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "索隱",
    "text": "按：系家及系本靈公名環，莊公名光，景公名杵臼也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a27",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "正義",
    "text": "謂己謙讓，非云功能。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a28",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "正義",
    "text": "行，下孟反。謂君不知己，增脩業行，畏責及也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a29",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p6",
    "annotator": "正義",
    "text": "衡，秤也。謂國無道制秤量之，可行即行。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a30",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p7",
    "annotator": "正義",
    "text": "縲音力追反。縲，黑索也。紲，繫也。晏子春秋云：「晏子之晉，至中牟，睹獘冠反裘負薪，息於途側。晏子問曰：『何者？』對曰：『我石父也。苟免飢凍，爲人臣僕。』晏子解左驂贖之，載與俱歸。」按：與此文小異也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a31",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p7",
    "annotator": "正義",
    "text": "戄，床縛反。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a32",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p7",
    "annotator": "索隱",
    "text": "信讀曰申，古周禮皆然也。申於知己謂以彼知我而我志獲申。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a33",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p9",
    "annotator": "集解",
    "text": "皇覽曰：「晏子冢在臨菑城南淄水南桓公冢西北。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a34",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p9",
    "annotator": "正義",
    "text": "注皇覽云：「晏子冢在臨淄城南菑水南桓公冢西北。」括地志云：「齊桓公墓在青州臨淄縣東南二十三里鼎足上。」又云：「齊晏嬰冢在齊子城北門外。晏子云『吾生近市，死豈易吾志』。乃葬故宅後，人名曰清節里。」按：恐皇覽誤，乃管仲冢也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a35",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "集解",
    "text": "劉向別錄曰：「九府書民閒無有。山高一名形勢。」"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a36",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "索隱",
    "text": "皆管氏所著書篇名也。按：九府，蓋錢之府藏，其書論鑄錢之輕重，故云輕重九府。餘如別錄之說。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a37",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "正義",
    "text": "七略云管子十八篇，在法家。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a38",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "索隱",
    "text": "按：嬰所著書名晏子春秋。今其書有七篇，故下云「其書世多有」也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a39",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "正義",
    "text": "七略云晏子春秋七篇，在儒家。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a40",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p10",
    "annotator": "正義",
    "text": "軼音逸。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a41",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p11",
    "annotator": "正義",
    "text": "言管仲世所謂賢臣，孔子所以小之者，蓋以爲周道衰，桓公賢主，管仲何不勸勉輔弼至於帝王，乃自稱霸主哉？故孔子小之云。蓋爲前疑夫子小管仲爲此。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a42",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p11",
    "annotator": "正義",
    "text": "言管仲相齊，順百姓之美，匡救國家之惡，令君臣百姓相親者，是管之能也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a43",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p12",
    "annotator": "索隱",
    "text": "按：左傳崔杼弒莊公，晏嬰入，枕莊公尸股而哭之，成禮而出，崔杼欲殺之是也。"
  },
  {
    "id": "anno:shiji:shiji-管晏列傳第二:a44",
    "book": "shiji",
    "chapter_id": "shiji-管晏列傳第二",
    "target_para_id": "text:shiji:shiji-管晏列傳第二:p12",
    "annotator": "索隱",
    "text": "太史公之羨慕仰企平仲之行，假令晏生在世，己雖與之爲僕隸，爲之執鞭，亦所忻慕。其好賢樂善如此。賢哉良史，可以示人臣之炯戒也。"
  }
]