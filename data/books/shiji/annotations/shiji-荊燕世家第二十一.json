[
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a0",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p0",
    "annotator": "正義",
    "text": "年表云都吳也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a1",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p0",
    "annotator": "集解",
    "text": "漢書賈，高帝從父兄。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a2",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p0",
    "annotator": "索隱",
    "text": "按：注引漢書，云賈，高祖從父兄，則班固或別有所見也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a3",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p0",
    "annotator": "索隱",
    "text": "賈將兵定塞地，塞即桃林之塞。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a4",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p1",
    "annotator": "正義",
    "text": "括地志云：「黎陽，一名白馬津，在滑州白馬縣北三十里。」按：賈從此津南過入楚地也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a5",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p2",
    "annotator": "集解",
    "text": "徐廣曰：「在陽夏。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a6",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p2",
    "annotator": "正義",
    "text": "括地志云：「固陵，陵名。在陳州宛丘縣西北四十二里。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a7",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p2",
    "annotator": "正義",
    "text": "今壽州壽春縣是也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a8",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p2",
    "annotator": "索隱",
    "text": "共敖之子。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a9",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p2",
    "annotator": "正義",
    "text": "今荊州也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a10",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p3",
    "annotator": "正義",
    "text": "今陳州也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a11",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p3",
    "annotator": "索隱",
    "text": "按表云劉賈都吳。又漢書以東陽郡封賈。東陽即臨淮，故云淮東也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a12",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p3",
    "annotator": "正義",
    "text": "括地志云西北四十里，蓋此縣是也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a13",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p3",
    "annotator": "正義",
    "text": "淮以西徐、泗、濠等州也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a14",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p4",
    "annotator": "索隱",
    "text": "地理志縣名，屬臨淮。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a15",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p4",
    "annotator": "正義",
    "text": "括地志云：「富陵故城在楚州盱眙縣東北六十里。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a16",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p5",
    "annotator": "集解",
    "text": "漢書曰：「澤，高祖從祖昆弟。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a17",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p5",
    "annotator": "索隱",
    "text": "按注引漢書云高祖從祖昆弟。又楚漢春秋田子春說張卿云「劉澤，宗家也」。按言「宗家」，似疏遠矣。然則班固言「從祖昆弟」，當別有所見矣。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a18",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p5",
    "annotator": "索隱",
    "text": "地理志縣名，在北海。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a19",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p5",
    "annotator": "正義",
    "text": "括地志云：「營陵故城在青州北海縣南三十里。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a20",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "晉灼曰：「楚漢春秋田子春。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a21",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "服虔曰：「以計畫干之也。」文穎曰：「以工畫得寵也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a22",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "索隱",
    "text": "畫，一音「計畫」之「畫」，又音「圖畫」之「畫」，兩家義並通也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a23",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "孟康曰：「與，黨與。言不復與我爲與也。」文穎曰：「不得與汝相知。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a24",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「名澤。」駰案：如淳曰閹人也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a25",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "索隱",
    "text": "按：此一切猶一例，同時也，非如他一切訓權時也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a26",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "如淳曰：「呂公知高祖相貴，以女妻之，推轂使爲長者。」瓚曰：「謂諸呂共推轂高祖征伐成帝業。雅，正意也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a27",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "索隱",
    "text": "按雅訓素也。謂呂氏素心奉推高祖取天下，若人推轂欲前進塗然也，此略同臣瓚之意也。推音昌誰反。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a28",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "集解",
    "text": "文穎曰：「欲發之，恐大臣不聽。」鄧展曰：「重難發事。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a29",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "正義",
    "text": "高后紀云封張卿爲建陵侯。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a30",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p6",
    "annotator": "索隱",
    "text": "觖音決，又音企。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a31",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p7",
    "annotator": "集解",
    "text": "漢書音義曰：「澤至齊，爲齊王所劫，不得去。乃說王，求詣京師，齊具車送之。不爲本與齊合謀也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a32",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p7",
    "annotator": "索隱",
    "text": "按漢書齊王傳云使祝午劫琅邪王至齊，因留琅邪王不得反國。澤乃說求入關，齊乃送之。與此文不同者，劉氏以爲燕、齊兩史各言其主立功之跡，太史公聞疑傳疑，遂各記之，則所謂實錄。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a33",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p7",
    "annotator": "集解",
    "text": "漢書音義曰：「跳驅，馳至長安也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a34",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p7",
    "annotator": "索隱",
    "text": "跳，他彫反，脫獨去也。又音條，謂疾去也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a35",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p7",
    "annotator": "集解",
    "text": "李奇曰：「本齊地，分以王澤，今復與齊也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a36",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p9",
    "annotator": "集解",
    "text": "如淳曰：「定國自欲有所殺餘臣，肥如令郢人以告之。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a37",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p9",
    "annotator": "索隱",
    "text": "按如淳意以肥如亦臣名，令郢人以告定國也。小顏以爲定國欲有所誅殺餘臣，而肥如令郢人乃告定國也。然按地理志，肥如在遼西也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a38",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p10",
    "annotator": "索隱",
    "text": "按謂田子春欲王劉澤，先使張卿說封呂產，乃恐以大臣觖望，澤卒得王，故爲權激諸呂也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a39",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p10",
    "annotator": "集解",
    "text": "晉灼曰：「澤以金與田生以事張卿，張卿言之呂后，而劉澤得王，故曰『事發相重』。或曰事起於相重也。」"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a40",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p10",
    "annotator": "索隱",
    "text": "按：謂先發呂氏令重，我亦得其功，是事發相重也。"
  },
  {
    "id": "anno:shiji:shiji-荊燕世家第二十一:a41",
    "book": "shiji",
    "chapter_id": "shiji-荊燕世家第二十一",
    "target_para_id": "text:shiji:shiji-荊燕世家第二十一:p10",
    "annotator": "索隱",
    "text": "偉者盛也，蓋盛其能激發也。"
  }
]