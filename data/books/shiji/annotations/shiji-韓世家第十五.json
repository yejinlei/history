    "book": "shiji",
    "chapter_id": "shiji-韓世家第十五",
    "target_para_id": "text:shiji:shiji-韓世家第十五:p19",
    "annotator": "索隱",
    "text": "言韓王信楚之救，雖不能聽待楚救至，折入於秦，猶德於楚也。"
  },
  {
    "id": "anno:shiji:shiji-韓世家第十五:a42",
