[
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a0",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p2",
    "annotator": "索隱",
    "text": "軻音苦何反，又苦賀反。鄒，魯地名。又云「邾」，邾人徙鄒故也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p2",
    "annotator": "正義",
    "text": "軻字子輿，爲齊卿。鄒，兗州縣。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p2",
    "annotator": "索隱",
    "text": "王劭以「人」爲衍字，則以軻親受業孔伋之門也。今言「門人」者，乃受業於子思之弟子也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p2",
    "annotator": "索隱",
    "text": "孟子有萬章、公明高等，蓋並軻之門人也。萬，姓；章，名。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "集解",
    "text": "並，蒲浪反。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "索隱",
    "text": "言其大體隨代盛衰，觀時而說事。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "索隱",
    "text": "桓寬、王充並以衍之所言迂怪虛妄，干惑六國之君，因納其異說，所謂「匹夫而營惑諸侯」者是也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "索隱",
    "text": "裨音脾。裨海，小海也。九州之外，更有大瀛海，故知此裨是小海也。且將有裨將，裨是小義也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "索隱",
    "text": "濫即濫觴，是江源之初始，故此文意以濫爲初也。謂衍之術言君臣上下六親之際，行事之所施所始，皆可爲後代之宗本，故云濫耳。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p4",
    "annotator": "索隱",
    "text": "懼音劬。謂衍之術皆動人心，見者莫不懼然駐想，又內心留顧而已化之，謂欲從其術也。按：化者，是易常聞而貴異術也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "按字林曰「襒音疋結反」。韋昭曰「敷蔑反」。張揖三蒼訓詁云「襒，拂也。謂側而行，以衣襒席爲敬，不敢正坐當賔主之禮也」。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "彗，帚也。謂爲之埽地，以衣袂擁帚而却行，恐塵埃之及長者，所以爲敬也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "正義",
    "text": "碣石宮在幽州薊縣西三十里寧臺之東。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "劉向別錄云鄒子書有主運篇。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "仲尼、孟子法先王之道，行仁義之化，且菜色困窮；而鄒衍執詭怪營惑諸侯，其見禮重如此，可爲長太息哉。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "孟子「太王去邠」是軻對滕文公語，今云梁惠王謀攻趙，與孟子不同。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "方枘是筍也，圜鑿是孔也。謂工人斲木，以方筍而內之圜孔，不可入也。故楚詞云「以方枘而內圜鑿，吾固知其齟齬而不入」是也。謂戰國之時，仲尼、孟軻以仁義干世主，猶方枘圜鑿然。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p5",
    "annotator": "索隱",
    "text": "呂氏春秋云「函牛之鼎不可以烹雞」，是牛鼎言衍之術迂大，儻若大用之，是有牛鼎之意。而譙周亦云「觀太史公此論，是其愛奇之甚」。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p6",
    "annotator": "索隱",
    "text": "按稷，齊之城門也。或云稷，山名。謂齊之學士集於稷門之下也。環淵、接子，古著書人之稱號也。駢音步堅反，又步經反。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p6",
    "annotator": "正義",
    "text": "慎子十卷，在法家，則戰國時處士。接子二篇。田子二十五篇，齊人，游稷下，號「天口」。接、田二人，道家。騶奭十二篇，陰陽家。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p7",
    "annotator": "索隱",
    "text": "謂私心實在彼馬與謳也。有之，謂我實有此二事也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「今慎子，劉向所定，有四十一篇。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p10",
    "annotator": "集解",
    "text": "爾雅曰：「四達謂之衢，五達謂之康，六達謂之莊。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "索隱",
    "text": "名況。卿者，時人相尊而號爲卿也。仕齊爲祭酒，仕楚爲蘭陵令。後亦謂之孫卿子者，避漢宣帝諱改也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "集解",
    "text": "徐廣曰：「一作『亂諣』。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "集解",
    "text": "劉向別錄曰：「騶衍之所言五德終始，天地廣大，盡言天事，故曰『談天』。騶奭脩衍之文，飾若雕鏤龍文，故曰『雕龍』。」別錄曰「過」字作「輠」。輠者，車之盛膏器也。炙之雖盡，猶有餘流者。言淳于髠智不盡如炙輠也。左思齊都賦注曰「言其多智難盡，如炙膏過之有潤澤也」。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "索隱",
    "text": "劉氏云「轂，衍字也」。今按：文稱「炙轂過」，則過是器名，音如字讀，謂盛脂之器名過。「過」與「鍋」字相近，蓋即脂器也。轂即車轂，過爲潤轂之物，則「轂」非衍字矣。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "索隱",
    "text": "襄王名法章，湣王子，莒人所立者。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "索隱",
    "text": "禮食必祭先，飲酒亦然，必以席中之尊者一人當祭耳，後因以爲官名，故吳王濞爲劉氏祭酒是也。而卿三爲祭酒者，謂荀卿出入前後三度處列大夫康莊之位，而皆爲其所尊，故云「三爲祭酒」也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p11",
    "annotator": "正義",
    "text": "蘭陵，縣，屬東海郡，今沂州承縣有蘭陵山。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "集解",
    "text": "晉太康地記云：「汝南西平縣有龍淵水可用淬刀劔，特堅利，故有堅白之論，云『黃，所以爲堅也；白，所以爲利也』。或辯之曰『白，所以爲不堅；黃，所以爲不利』。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "索隱",
    "text": "龍即仲尼弟子名也。此云趙人，弟子傳作衞人，鄭玄云楚人，各不能知其真也。又下文云「並孔子同時，或曰在其後」，所以知非別人也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "正義",
    "text": "藝文志公孫龍子十四篇，顏師古云即爲堅白之辯。按平原君傳，騶衍同時。括地志云「西平縣，豫州西北百四十里，有龍淵水」也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "集解",
    "text": "徐廣曰：「按應劭氏姓注直云『處子』也。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "索隱",
    "text": "著書之人姓劇氏而稱子也，前史不記其名也，故趙有劇孟及劇辛也。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "正義",
    "text": "藝文志：「李子三十二篇。李悝相魏文侯，富國彊兵。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a36",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "集解",
    "text": "劉向別錄曰：「楚有尸子，疑謂其在蜀。今按尸子書，晉人也，名佼，秦相衞鞅客也。衞鞅商君謀事畫計，立法理民，未嘗不與佼規之也。商君被刑，佼恐并誅，乃亡逃入蜀。自爲造此二十篇書，凡六萬餘言。卒，因葬蜀。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a37",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "索隱",
    "text": "尸子名佼，音絞，晉人，事具別錄。長盧，未詳。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a38",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "正義",
    "text": "長盧九篇，楚人。"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a39",
    "book": "shiji",
    "chapter_id": "shiji-孟子荀卿列傳第十四",
    "target_para_id": "text:shiji:shiji-孟子荀卿列傳第十四:p12",
    "annotator": "集解",
    "text": "徐廣曰：「阿者，今之東阿。」"
  },
  {
    "id": "anno:shiji:shiji-孟子荀卿列傳第十四:a40",
    "book": "shiji",
