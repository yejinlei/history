[
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a0",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p0",
    "annotator": "集解",
    "text": "徐廣曰：「遇，一作『偶』。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a1",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "索隱",
    "text": "伉音苦浪反。言暴猛伉直。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a2",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "正義",
    "text": "籍，閎，皆名也。孺，幼小也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a3",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "索隱",
    "text": "關通也。謂公卿因之而通其詞說。劉氏云「有所言說，皆關由之」。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a4",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「鵔鸃，鳥名。以毛羽飾冠，以貝飾帶。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a5",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "索隱",
    "text": "許慎云：「鵔鸃，鷩鳥也。」淮南子云：「趙武靈王服貝帶鵔鸃。」漢官儀云：「秦破趙，以其冠賜侍中。」三倉云：「鵔鸃，神鳥也，飛光映天者也。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a6",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "索隱",
    "text": "傅音付。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a7",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p1",
    "annotator": "正義",
    "text": "惠帝陵邑。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a8",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "索隱",
    "text": "案漢書作「趙談」，此云「同」者，避太史公父名也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a9",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "正義",
    "text": "顏云「姓北宮，名伯子」也。按：伯子，名。北宮之宦者也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a10",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「後屬犍爲。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a11",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「著黃帽也。」駰案：漢書音義曰「善濯船池中也。一說能持擢行船也。土，水之母，故施黃旄於船頭，因以名其郎曰黃頭郎」。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a12",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "索隱",
    "text": "濯音棹，遲教反。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a13",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一無此字。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a14",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "索隱",
    "text": "音篤。裻者，衫襦之橫腰者。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a15",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "索隱",
    "text": "覺音教。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a16",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "正義",
    "text": "括地志云：「漸臺在長安故城中。關中記云未央宮西有蒼池，池中有漸臺，王莽死於此臺。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a17",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "索隱",
    "text": "漢書云：「上曰『鄧猶登也』，悅之。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a18",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "正義",
    "text": "言賜通巨萬以至於十也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a19",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "正義",
    "text": "括地志云：「雅州榮經縣北三里有銅山，即鄧通得賜銅山鑄錢者。」案：榮經即嚴道。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a20",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p2",
    "annotator": "正義",
    "text": "錢譜云：「文字稱兩，同漢四銖文。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a21",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "索隱",
    "text": "唶，仕格反。吮，仕兗反。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a22",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "集解",
    "text": "韋昭曰：「景帝姊也。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a23",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "索隱",
    "text": "案即館陶公主也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a24",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "索隱",
    "text": "謂長公主別有物賜通，吏輙沒入以充贓也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a25",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "索隱",
    "text": "謂公主令人假與衣食。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a26",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p3",
    "annotator": "索隱",
    "text": "始天下名「鄧氏錢」，今皆沒入，卒竟無一錢之名也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a27",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p4",
    "annotator": "索隱",
    "text": "案漢書稱「周仁」，此上稱「周文」，今兼「文」作，恐後人加耳。案：仁字文。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a28",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p4",
    "annotator": "索隱",
    "text": "案庸，常也。言仁最被恩寵，過於常人，乃不甚篤，如韓嫣也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a29",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p5",
    "annotator": "索隱",
    "text": "音偃，又音於建反。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a30",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p6",
    "annotator": "集解",
    "text": "徐廣曰：「韓王信之子頹當也。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a31",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p6",
    "annotator": "索隱",
    "text": "謂還爵封於天子，而請入宿衞。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a32",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p6",
    "annotator": "集解",
    "text": "徐廣曰：「嗛，讀與『銜』同，漢書作『銜』字。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a33",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p6",
    "annotator": "索隱",
    "text": "說音悅。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a34",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p7",
    "annotator": "集解",
    "text": "徐廣曰：「主獵犬也。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a35",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p7",
    "annotator": "索隱",
    "text": "或犬監也。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a36",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p7",
    "annotator": "索隱",
    "text": "初詩，即所新造樂章。"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a37",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p7",
    "annotator": "集解",
    "text": "徐廣曰：「埒，等也。蜀都賦曰『卓鄭埒名』。又云埒者，疇等之名。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a38",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p7",
    "annotator": "集解",
    "text": "徐廣曰：「一云坐弟季與中人亂。」"
  },
  {
    "id": "anno:shiji:shiji-佞幸列傳第六十五:a39",
    "book": "shiji",
    "chapter_id": "shiji-佞幸列傳第六十五",
    "target_para_id": "text:shiji:shiji-佞幸列傳第六十五:p9",
    "annotator": "索隱",
    "text": "衞靈公之臣，事見說苑也。"
  }
]