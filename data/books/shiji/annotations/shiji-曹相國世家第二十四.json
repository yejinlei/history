[
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a0",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p0",
    "annotator": "正義",
    "text": "晉州城即平陽故城也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p0",
    "annotator": "集解",
    "text": "張華曰：「曹參字敬伯。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p0",
    "annotator": "索隱",
    "text": "地理志平陽縣屬河東。又按春秋緯及博物志，並云參字敬伯。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p0",
    "annotator": "正義",
    "text": "按：沛，今徐州縣也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「中涓如中謁者。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "涓音古玄反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "地理志二縣皆屬山陽郡。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "胡陵，縣名，在方與之南。方音房，與音預，兗州縣也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「監，御史監郡者；公，名。秦一郡置守、尉、監三人。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "按注，公者監之名，然本紀泗川監名平，則平是名，公爲相尊之稱也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "曹參擊方與。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "時雍齒守豐，爲魏反沛公。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "音夷。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「伍被曰『吳濞敗於狐父』。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "地理志碭屬梁國。狐父，地名，在梁碭之閒。徐氏引伍被云「吳濞敗於狐父」，是吳與梁相拒而敗處。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "括地志云：「狐父亭在宋州碭山縣東南三十里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "文穎曰：「善置，置名也。」晉灼曰：「祁音坻。孫檢曰『漢謂驛曰置。善，名也』。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "按：司馬彪郡國志穀熟有祁亭。劉氏音遲，又如字。善置，置名，漢謂驛爲置。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "括地志云：「故祁城在宋州下邑縣東北四十九里，漢祁城縣也。」言取碭、狐父及祁縣之善置。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "地理志下邑、虞皆屬梁國。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "宋州下邑縣在州東百一十里。漢下邑城，今碭山縣是。虞城縣在州北五十里，古虞國，商均所封。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「宣帝時有爰戚侯。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "蘇林云「縣名，屬山陽」。按功臣表，爰戚侯趙成。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "音寂。劉音七歷反。今在兗州南，近亢父縣。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "地理志縣名，屬東平。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "括地志：「亢父故城在兗州任城縣南五十一里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "時章邯圍田榮於東阿也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "今濟州東阿也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "淄州高苑縣西北二里有狄故城，安帝改曰臨濟。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "集解",
    "text": "張晏曰：「孤卿也。或曰楚官名。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "地理志建成縣屬沛郡。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "索隱",
    "text": "謂遷參爲戚令。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p1",
    "annotator": "正義",
    "text": "即爰戚縣也，是時屬沛郡。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "地理志成武縣屬山陽。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "地理志縣名，在濟陰。成，地名。周武王封弟季載於成，其後代遷於成之陽，故曰成陽。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "成陽故城，濮州雷澤縣是。史記云武王封弟季載於成。其後遷於成之陽，故曰成陽也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a36",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "賁音奔。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a37",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "集解",
    "text": "徐廣曰：「在中牟。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a38",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "曲，丘禹反。遇，牛凶反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a39",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "曲，丘羽反。遇，牛恭反。司馬彪郡國志云「中牟有曲遇聚」。按：中牟，鄭州縣也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a40",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "集解",
    "text": "張晏曰：「侯伯執珪以朝，位比之。」如淳曰：「呂氏春秋『得伍員者位執珪』。古爵名。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a41",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "括地志云：「陽武故城在鄭州陽武縣東北十八里，漢陽武縣城也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a42",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "地理志陽武、緱氏二縣屬河南。轘轅，道名，在緱氏南。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a43",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "緱氏，洛州縣也。括地志云：「轘轅故關在洛州緱氏縣東南四十里。十三州志云轘轅道凡十二曲，是險道。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a44",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "津，濟渡處。括地志云：「平陰故津在洛州洛陽縣東北五十里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a45",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "集解",
    "text": "徐廣曰：「尸在偃師。」孟康曰：「尸鄉北。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a46",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "破趙賁軍於尸鄉之北也。括地志云：「尸鄉亭在洛州偃師縣，在洛州東南也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a47",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "集解",
    "text": "應劭曰：「今赭陽。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a48",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "索隱",
    "text": "徐廣云「陽城在南陽」，應劭云「今赭陽」。赭陽是南陽之縣。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a49",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "陷南陽守於陽城郭東也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a50",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "括地志云：「故武關在商州商洛縣東九十里。藍田關在雍州藍田縣東南九十里，即秦嶢關也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a51",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p2",
    "annotator": "正義",
    "text": "雍州藍田縣在州東南八十里，因藍田山爲名。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a52",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "梁州本漢中郡。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a53",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "地理志二縣名，皆屬武都。辯音皮莧反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a54",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "括地志云：「成州同谷縣，本漢下辯道。」又云：「鳳州兩當縣，本漢故道縣，在州西五十里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a55",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "地理志二縣名，屬右扶風。斄音胎。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a56",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "斄作「邰」，音貽。括地志云：「故雍縣南七里。故斄城一名武功，縣西南二十二里，古邰國也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a57",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "括地志云：「好畤城在雍州好畤縣東南十三里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a58",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "文穎曰：「地名。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a59",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "櫟音歷。按：文穎云「壤鄉、高櫟皆地名也」。然盡在右扶風，今其地闕也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a60",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "音歷。皆村邑名。壤鄉，今雍州武功縣東南一十餘里高壤坊，是高櫟近壤鄉也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a61",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "按：漢書高帝元年咸陽名新城，武帝改名曰渭城。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a62",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "漢書音義曰：「縣名也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a63",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "蘇林曰：「今華陰。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a64",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "周曰犬丘，秦更名廢丘，漢更名槐里，今故城在雍州始平縣東南十里。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a65",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "即蒲津關也，在臨晉縣。故言臨晉關，今在同州也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a66",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "今懷州獲嘉縣，古脩武也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a67",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "徐廣曰：「東郡白馬有圍津。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a68",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "顧氏按：水經注白馬津有韋鄉、韋津城。「圍」與「韋」同，古今字變爾。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a69",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "括地志云：「黎陽津一名白馬津，在滑州白馬縣北三十里。帝王世紀云『白馬縣南有韋城，故豕韋國也』。續漢書郡國志云『白馬縣有韋城』。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a70",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "徐州二縣。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a71",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "徐廣曰：「內黃縣有黃澤。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a72",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "徐廣曰：「東郡燕縣。」駰案：漢書音義曰「皆漢將」。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a73",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "天柱侯不知其誰封。衍氏，魏邑。地理志云天柱在廬江潛縣。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a74",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "集解",
    "text": "瓚曰：「武彊城在陽武。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a75",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "正義",
    "text": "括地志云：「武彊故城在鄭州管城縣東北三十一里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a76",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p3",
    "annotator": "索隱",
    "text": "才用反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a77",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "集解",
    "text": "徐廣曰：「張者，地名。功臣表有張侯毛澤之。」駰按：蘇林曰屬河東。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a78",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "索隱",
    "text": "遫音速。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a79",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "正義",
    "text": "括地志云：「張陽故城一名東張城，在蒲州虞鄉縣西北四十里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a80",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "正義",
    "text": "括地志云：「上曲陽，定州恆陽縣是。下曲陽在定州鼓城縣西五里。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a81",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "集解",
    "text": "徐廣曰：「河東有垣縣。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a82",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "正義",
    "text": "括地志云：「武垣縣，今瀛州城是。地理志云武垣縣屬涿郡也。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a83",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "正義",
    "text": "晉州城是。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a84",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "集解",
    "text": "徐廣曰：「鄔縣在太原。音烏古反。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a85",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "索隱",
    "text": "地理志鄔，太原縣名。音烏古反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a86",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "索隱",
    "text": "地理志著縣屬濟南，盧縣屬泰山，漯陰、平原、鬲三縣屬平原。漯音吐答反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a87",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "正義",
    "text": "括地志云：「平原故城在德州平原縣東南十里。故鬲城在德州安德縣西北十五里。」盧縣，今濟州理縣是也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a88",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "集解",
    "text": "文穎曰：「或以爲高密。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a89",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p4",
    "annotator": "索隱",
    "text": "漢書亦作「假密」。按：下定齊七十縣，則上假密非高密，亦是齊地，今闕。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a90",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p6",
    "annotator": "索隱",
    "text": "地理志蘄、竹邑、相、蕭四縣屬沛。韋昭云「留今屬彭城」，則漢初亦屬沛也。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a91",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p6",
    "annotator": "正義",
    "text": "括地志云：「徐州符離縣城，漢竹邑城也。李奇云『今竹邑也』。故相城在符離縣西北九十里。輿地志云『宋共公自睢陽徙相子城，又還睢陽』。蕭，徐州縣，古蕭叔國城也。故留城在徐州沛縣東南五十里，張良所封。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a92",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p7",
    "annotator": "集解",
    "text": "漢書音義曰：「楚之卿號。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a93",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p9",
    "annotator": "集解",
    "text": "漢書音義曰：「夫獄市兼受善惡，若窮極，姦人無所容竄；姦人無所容竄，久且爲亂。秦人極刑而天下畔，孝武峻法而獄繁，此其效也。老子曰『我無爲而民自化，我好靜而民自正』。參欲以道化其本，不欲擾其末。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a94",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p11",
    "annotator": "集解",
    "text": "如淳曰：「不事丞相之事。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a95",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p11",
    "annotator": "集解",
    "text": "如淳曰：「開謂有所啟白。」"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a96",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p14",
    "annotator": "索隱",
    "text": "音張律反。"
  },
  {
    "id": "anno:shiji:shiji-曹相國世家第二十四:a97",
    "book": "shiji",
    "chapter_id": "shiji-曹相國世家第二十四",
    "target_para_id": "text:shiji:shiji-曹相國世家第二十四:p14",
    "annotator": "索隱",
