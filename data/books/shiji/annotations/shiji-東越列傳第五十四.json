[
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a0",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "韋昭曰：「閩音武巾反。東越之別名。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "索隱",
    "text": "案說文云「閩，東越蛇種也」，故字從「虫」。閩音旻。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "徐廣曰：「騶，一作『駱』。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "索隱",
    "text": "徐廣云一作「駱」，是上云「歐駱」，不姓騶。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "徐廣曰：「今建安候官是。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "索隱",
    "text": "小顏以爲即今之泉州建安也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "正義",
    "text": "今閩州又改爲福也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "漢書音義曰：「主號令諸侯，不王無諸、搖等。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "應劭曰：「在吳郡東南濵海云。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "集解",
    "text": "徐廣曰：「今之永寧也。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p0",
    "annotator": "索隱",
    "text": "姚氏云：「甌，水名。」永嘉記：「水出永寧山，行三十餘里，去郡城五里入江。昔有東甌王都城，有亭，積石爲道，今猶在也。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p2",
    "annotator": "集解",
    "text": "徐廣曰：「年表云東甌王廣武侯望，率其衆四萬餘人來降，家廬江郡。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p2",
    "annotator": "索隱",
    "text": "徐廣據年表而爲說。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p3",
    "annotator": "索隱",
    "text": "劉氏鏦音窗。鏦，撞也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p3",
    "annotator": "集解",
    "text": "徐廣曰：「漢書作『殞』。耘義當取『耘除』。或言耘音于粉反，此楚人聲重耳。隕耘當同音，但字有假借，聲有輕重。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p3",
    "annotator": "索隱",
    "text": "繇音搖，邑號也。丑，名。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p5",
    "annotator": "集解",
    "text": "徐廣曰：「在會稽界。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p5",
    "annotator": "索隱",
    "text": "徐說非也。案今豫章三十里有梅嶺，在洪崖山足，當古驛道。此文云「豫章梅嶺」，知非會稽也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p5",
    "annotator": "正義",
    "text": "括地志云：「梅嶺在虔化縣東北百二十八里。」虔州漢亦屬豫章郡，二所未詳。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p6",
    "annotator": "集解",
    "text": "徐廣曰：「在豫章界」。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p6",
    "annotator": "索隱",
    "text": "案今豫章北二百里，接鄱陽界，地名白沙，有小水入湖，名曰白沙阬。東南八十里有武陽亭，亭東南三十里地名武林。此白沙、武林，今當閩越入京道。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p6",
    "annotator": "集解",
    "text": "徐廣曰：「成陽共王子。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "索隱",
    "text": "鄭氏音勾，會稽縣也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "正義",
    "text": "句章故城在越州鄮縣西一百里，漢縣。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "索隱",
    "text": "案姚氏云「地名，今闕」。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "正義",
    "text": "越州有若耶山、若耶溪。「若」「如」一。預州有白沙山。蓋從如此邪。白沙東故閩州。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "正義",
    "text": "錢唐，杭州縣。轅，姓；終古，名。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "集解",
    "text": "漢書音義曰：「今吳南亭是也。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p7",
    "annotator": "正義",
    "text": "「禦」字今作「語」。語兒鄉在蘇州嘉興縣南七十里，臨官道也。"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「亦東越臣。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "索隱",
    "text": "韋昭曰：「在九江。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "索隱",
    "text": "徐廣云：「敖，東越臣。」韋昭云：「開陵屬臨淮。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「音遼縈。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "索隱",
    "text": "服虔云：「嫈音榮，縣名。」劉伯莊云：「繚音遼，下音紆營反。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「多軍，名也。」"
  },
  {
    "id": "anno:shiji:shiji-東越列傳第五十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-東越列傳第五十四",
    "target_para_id": "text:shiji:shiji-東越列傳第五十四:p8",
    "annotator": "索隱",
    "text": "韋昭云：「多，姓；軍，名也。」"
  }
]