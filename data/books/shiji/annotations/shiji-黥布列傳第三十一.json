[
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a0",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "索隱",
    "text": "地理志廬江有六縣。蘇林曰：「今爲六安也。」布本姓英。英，國名也，咎繇之後。布以少時有人相云「當刑而王」，故漢雜事云「布改姓黥，以厭當之」也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a1",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "正義",
    "text": "故六城在壽州安豐縣西南百三十三里。按：黥布封淮南王，都六，即此城。又春秋傳六與蓼，咎繇之後，或封於英、六，蓋英後改爲蓼也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a2",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "集解",
    "text": "徐廣曰：「幾，一作『豈』。」駰謂幾，近也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a3",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "索隱",
    "text": "臣瓚音機。楚漢春秋作「豈是乎」，故徐廣云一作「豈」。劉氏作「祈」，祈者語辭也，亦通。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a4",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "索隱",
    "text": "謂衆共以俳優輩笑之。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a5",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "正義",
    "text": "言布論決受黥竟，麗山作陵也。時會稽郡輸身徒。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a6",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p0",
    "annotator": "索隱",
    "text": "曹，輩也。偶，類也。謂徒輩之類。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a7",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p1",
    "annotator": "正義",
    "text": "時會稽郡所理在吳闔閭城中。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a8",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p2",
    "annotator": "正義",
    "text": "薛古城在徐州滕縣界也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a9",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p2",
    "annotator": "正義",
    "text": "南郡當陽縣也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a10",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p3",
    "annotator": "正義",
    "text": "新安故城在河南府澠池縣東二十二里。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a11",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p3",
    "annotator": "索隱",
    "text": "鄒氏云「間猶閑也，謂私也」。今以間音紀莧反。間道即他道，猶若反間之義。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a12",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p3",
    "annotator": "索隱",
    "text": "案漢書作「楚軍前簿」，簿者鹵簿。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a13",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p4",
    "annotator": "正義",
    "text": "郴，丑林反。今郴州有義帝冢及祠。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a14",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p5",
    "annotator": "集解",
    "text": "漢書音義曰：「誚，責也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a15",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "正義",
    "text": "今宋州虞城也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a16",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "案謂隨何。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a17",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "集解",
    "text": "漢書音義曰：「淮南太宰作內主也。」韋昭曰：「主，舍也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a18",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "太宰，掌膳食之官。韋昭曰「主，舍」。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a19",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "集解",
    "text": "李奇曰：「板，牆板也。築，杵也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a20",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "集解",
    "text": "音埽。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a21",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "負猶被也。以不義被其身。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a22",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "徼謂邊境亭鄣。以徼繞邊陲，常守之也。乘者，登也，登塞垣而守之。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a23",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "集解",
    "text": "張晏曰：「羽從齊還，當經梁地八九百里，迺得羽地。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a24",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "案服虔曰「梁在楚漢之中閒」。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a25",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「恃，一作『罷』。言其已困，不足復苦也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a26",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p6",
    "annotator": "索隱",
    "text": "案漢書作「罷」，音皮。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a27",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p7",
    "annotator": "集解",
    "text": "文穎曰：「在淮南王所。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a28",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p7",
    "annotator": "索隱",
    "text": "搆成也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a29",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p7",
    "annotator": "索隱",
    "text": "走音奏，向也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a30",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p7",
    "annotator": "正義",
    "text": "宋州碭山縣。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a31",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p8",
    "annotator": "集解",
    "text": "徐廣曰：「三年十二月。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a32",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p8",
    "annotator": "正義",
    "text": "高祖以布先分爲王，恐其自尊大，故峻禮令布折服；已而美其帷帳，厚其飲食，多其從官，以悅其心；權道也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a33",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p10",
    "annotator": "索隱",
    "text": "腐音輔。謂之腐儒者，言如腐敗之物不任用。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a34",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p12",
    "annotator": "集解",
    "text": "張晏曰：「欲有所會。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a35",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p13",
    "annotator": "集解",
    "text": "徐廣曰：「賁音肥。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a36",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p13",
    "annotator": "索隱",
