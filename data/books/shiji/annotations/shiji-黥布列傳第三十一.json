  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a37",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p13",
    "annotator": "集解",
    "text": "一作「徵」。"
  },
  {
