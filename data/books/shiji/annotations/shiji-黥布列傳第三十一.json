    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "集解",
    "text": "漢書音義曰：「疏，分也。『禹決江疏河』是也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a39",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "索隱",
    "text": "尚書曰「列爵惟五，分土惟三」。按；裂地是對文，故知疏即分也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a40",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "集解",
    "text": "張晏曰：「往年、前年同耳，使文相避也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a41",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "正義",
    "text": "荊王劉賈都吳，蘇州闔廬城也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a42",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "正義",
    "text": "楚王劉交都徐州下邳。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a43",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "索隱",
    "text": "案太康地記云「秦建敖倉於成臯」。又云「庾」，故云「敖庾」也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a44",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "正義",
    "text": "古州來國。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a45",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "正義",
    "text": "今潭州。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a46",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "集解",
    "text": "桓譚新論曰：「世有圍碁之戲，或言是兵法之類也。及爲之上者，遠碁疏張，置以會圍，因而成多，得道之勝。中者，則務相絕遮要，以爭便求利，故勝負狐疑，須計數而定。下者，則守邊隅，趨作罫，以自生於小地，然亦必不如。」察薛公之言上計，云取吳、楚，并齊、魯及燕、趙者，此廣道地之謂。中計云取吳、楚，并韓、魏，塞成臯，據敖倉，此趨遮要爭利者也。下計云取吳、下蔡，據長沙以臨越，此守邊隅，趨作罫者也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a47",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "索隱",
    "text": "罫音烏卦反。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a48",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p14",
    "annotator": "索隱",
    "text": "劉氏云：「薛公得封千戶，蓋關內侯也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a49",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "正義",
    "text": "故城在楚州盱眙縣東北六十里。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a50",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "集解",
    "text": "如淳曰：「地名也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a51",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "索隱",
    "text": "案地理志臨淮有徐縣、僮縣。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a52",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "正義",
    "text": "杜預云：「徐在下邳僮縣東。」括地志云：「大徐城在泗州徐城縣北四十里，古徐國也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a53",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "集解",
    "text": "漢書音義曰：「謂散滅之地。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a54",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p15",
    "annotator": "正義",
    "text": "魏武帝注孫子曰：「卒戀土地，道近而易敗散。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a55",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "索隱",
    "text": "上古外反，下持瑞反。韋昭云「蘄之鄉名」。漢書作「𦉈」，應劭音保，非也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a56",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "正義",
    "text": "蘄音機。沛郡蘄城也。甀，逐瑞反。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a57",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "注",
    "text": "鄧展曰：「地名也。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a58",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "集解",
    "text": "徐廣曰：「表云成王臣，吳芮之子也。」駰案；晉灼曰「芮之孫固」。或曰是成王，非哀王也，傳誤也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a59",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "索隱",
    "text": "番陽鄱縣之鄉。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a60",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p16",
    "annotator": "正義",
    "text": "英布冢在饒州鄱陽縣北百五十二里十三步。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a61",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p17",
    "annotator": "正義",
    "text": "期思故城在光州固始縣界。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a62",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p17",
    "annotator": "集解",
    "text": "漢書曰：「將封者六人。」"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a63",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p18",
    "annotator": "索隱",
    "text": "拔音白曷反，疾也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a64",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p18",
    "annotator": "集解",
    "text": "媢音冒。媢亦妒也。"
  },
  {
    "id": "anno:shiji:shiji-黥布列傳第三十一:a65",
    "book": "shiji",
    "chapter_id": "shiji-黥布列傳第三十一",
    "target_para_id": "text:shiji:shiji-黥布列傳第三十一:p18",
    "annotator": "索隱",
    "text": "漢書外戚傳亦云「或結寵妾妒媢之誅」。又論衡云「妒夫媢婦」，則媢是妒之別名。今原英布之誅爲疑賁赫與其妃有亂，故至滅國，所以不得言妒媢是媚也。一云男妒曰媢。"
  }
