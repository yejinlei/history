[
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a0",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "正義",
    "text": "潮仙二音。括地志云：「高驪都平壤城，本漢樂浪郡王險城，又古云朝鮮地也。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a1",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "索隱",
    "text": "案漢書，滿，燕人，姓衞，擊破朝鮮而自王之。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a2",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "集解",
    "text": "徐廣曰：「一作『莫』。遼東有番汗縣。番音普寒反。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a3",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "索隱",
    "text": "始全燕時，謂六國燕方全盛之時，常略二國以屬己也。應劭云：「玄菟本真番國。」徐氏云遼東有番汗縣，據地理志而知也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a4",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「浿音傍沛反。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a5",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "正義",
    "text": "地理志云浿水出遼東塞外，西南至樂浪縣西入海。浿普大反。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a6",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "正義",
    "text": "命謂教令。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a7",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "索隱",
    "text": "案地理志樂浪有雲鄣。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a8",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "集解",
    "text": "徐廣曰：「昌黎有險瀆縣也。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a9",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p1",
    "annotator": "索隱",
    "text": "韋昭云「古邑名」。應劭注「地理志遼東險瀆縣，朝鮮王舊都」。臣瓚云「王險城在樂浪郡浿水之東」也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a10",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p2",
    "annotator": "索隱",
    "text": "東夷小國，後以爲郡。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a11",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p2",
    "annotator": "正義",
    "text": "括地志云：「朝鮮、高驪、貊、東沃沮五國之地，國東西千三百里，南北二千里，在京師東，東至大海四百里，北至營州界九百二十里，南至新羅國六百里，北至靺鞨國千四百里。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a12",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "正義",
    "text": "其孫名也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a13",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "索隱",
    "text": "誘一作譙。說文云：「譙，讓也。」諭，曉也。譙音才笑反。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a14",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "索隱",
    "text": "即送何之御也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a15",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "正義",
    "text": "顏師古云：「長者，裨王名也。送何至浿水，何因刺殺也。」按：裨王及將士長，恐顏非也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a16",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "正義",
    "text": "入平州榆林關也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a17",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "索隱",
    "text": "有殺將之美名。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a18",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p3",
    "annotator": "正義",
    "text": "地理志云遼東郡武次縣，東部都尉所理也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a19",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「凡五人也。戎狄不知官紀，故皆稱相。唊音頰。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a20",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "索隱",
    "text": "路人，漁陽縣人。如淳云：「相，其國宰相。路人，名也。唊音頰，一音協。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a21",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "徐廣曰：「表云『長路』。漢書表云『長路』，音各。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a22",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "索隱",
    "text": "路人子也，名最。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a23",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "真番、臨屯、樂浪、玄菟也。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a24",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "韋昭曰：「屬齊。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a25",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "索隱",
    "text": "顧氏澅音獲。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a26",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "韋昭曰：「屬勃海。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a27",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "索隱",
    "text": "陰，荻苴侯。荻音狄，苴音子餘反。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a28",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "韋昭曰：「屬梁父。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a29",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "韋昭曰：「屬河東。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a30",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "索隱",
    "text": "幾縣名。"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a31",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p8",
    "annotator": "集解",
    "text": "韋昭曰：「屬齊。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a32",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p9",
    "annotator": "索隱",
    "text": "蘇林云：「列口縣名。度海先得之。」"
  },
  {
    "id": "anno:shiji:shiji-朝鮮列傳第五十五:a33",
    "book": "shiji",
    "chapter_id": "shiji-朝鮮列傳第五十五",
    "target_para_id": "text:shiji:shiji-朝鮮列傳第五十五:p10",
    "annotator": "集解",
    "text": "徐廣曰：「言其所將卒狹少。」"
  }
]