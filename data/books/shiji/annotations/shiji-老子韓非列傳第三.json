    "chapter_id": "shiji-老子韓非列傳第三",
    "target_para_id": "text:shiji:shiji-老子韓非列傳第三:p20",
    "annotator": "正義",
    "text": "晉世家云襲滅虞公，及大夫百里以媵秦穆姬也。"
  },
