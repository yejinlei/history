    "chapter_id": "shiji-老子韓非列傳第三",
    "target_para_id": "text:shiji:shiji-老子韓非列傳第三:p21",
    "annotator": "正義",
    "text": "世本云：「胡，歸姓也。」括地志云：「胡城在豫州郾城縣界。」"
  },
  {
    "id": "anno:shiji:shiji-老子韓非列傳第三:a133",
