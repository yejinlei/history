    "book": "shiji",
    "chapter_id": "shiji-老子韓非列傳第三",
    "target_para_id": "text:shiji:shiji-老子韓非列傳第三:p20",
    "annotator": "索隱",
    "text": "按：韓子作「非能士之所恥也」。"
  },
  {
    "id": "anno:shiji:shiji-老子韓非列傳第三:a131",
    "book": "shiji",
    "chapter_id": "shiji-老子韓非列傳第三",
    "target_para_id": "text:shiji:shiji-老子韓非列傳第三:p21",
    "annotator": "正義",
    "text": "其子鄰父說皆當矣，而切見疑，非處知則難乎！"
  },
  {
    "id": "anno:shiji:shiji-老子韓非列傳第三:a132",
