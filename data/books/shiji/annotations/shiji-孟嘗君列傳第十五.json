[
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a0",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "索隱",
    "text": "戰國策及諸書並無此言，蓋諸田之別子也，故戰國策每稱「嬰子」、「肦子」，高誘注云「田肦」、「田嬰」也。王劭又按：戰國策云「齊貌辯謂宣王曰：『王方爲太子時，辯謂靖郭君，不若廢太子，更立郊師。靖郭君不忍。』宣王太息曰：『寡人少，殊不知。』」以此言之，嬰非宣王弟明也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a1",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "索隱",
    "text": "紀年當梁惠王二十八年，至三十六年改爲後元也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a2",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "正義",
    "text": "東阿，濟州縣也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a3",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "索隱",
    "text": "紀年當惠王之後元十一年。彼文作「平阿」。又云「十三年會齊威王于鄄」，與此明年齊宣王與梁惠王會鄄文同。但齊之威宣二王，文舛互並不同。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a4",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "集解",
    "text": "音絹。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a5",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "正義",
    "text": "紀年云梁惠王三十年，下邳遷于薛，改名徐州。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a6",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "索隱",
    "text": "紀年以爲梁惠王後元十三年四月，齊威王封田嬰于薛。十月，齊城薛。十四年，薛子嬰來朝。十五年，齊威王薨，嬰初封彭城。皆與此文異也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a7",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p0",
    "annotator": "正義",
    "text": "薛故城在今徐州滕縣南四十四里也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a8",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p1",
    "annotator": "索隱",
    "text": "上「舉」謂初誕而舉之，下「舉」謂浴而乳之。生謂長養之也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a9",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p1",
    "annotator": "索隱",
    "text": "風俗通云「俗說五月五日生子，男害父，女害母」。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a10",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p2",
    "annotator": "索隱",
    "text": "爾雅云「玄孫之子爲來孫，來孫之子爲昆孫，昆孫之子爲仍孫，仍孫之子爲雲孫」。又有耳孫，亦是玄孫之子，不同也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a11",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p2",
    "annotator": "索隱",
    "text": "短亦音豎。豎褐，謂褐衣而豎裁之，以其省而便事也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a12",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p2",
    "annotator": "索隱",
    "text": "遺音唯季反。猶言不知欲遺與何人也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a13",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p2",
    "annotator": "集解",
    "text": "皇覽曰：「靖郭君冢在魯國薛城中東南陬。」"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a14",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p2",
    "annotator": "索隱",
    "text": "謚爲靖郭君者，謂死後別號之曰「靖郭」耳，則「靖郭」或封邑號，故漢齊王舅父駟鈞封靖郭侯是也。陬音鄒，亦音緅。陬者，城隅也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a15",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p3",
    "annotator": "索隱",
    "text": "舍業者，拾弃其家產而厚事賔客也。劉氏云「舍音赦。謂爲之築舍立居業也」。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a16",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p4",
    "annotator": "索隱",
    "text": "偶音寓。謂以土木爲之偶，類於人也。蘇代以土偶比涇陽君，木偶比孟嘗君也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a17",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p5",
    "annotator": "索隱",
    "text": "抵音丁禮反。按：抵謂觸冒而求之也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a18",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p5",
    "annotator": "集解",
    "text": "韋昭曰：「以狐之白毛爲裘。謂集狐腋之毛，言美而難得者。」"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a19",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p5",
    "annotator": "正義",
    "text": "藏，在浪反。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a20",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p5",
    "annotator": "索隱",
    "text": "更者，改也。改前封傳而易姓名，不言是孟嘗之名。封傳猶今之驛券。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a21",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p5",
    "annotator": "正義",
    "text": "關在陝州桃林縣西南十三里。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a22",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p7",
    "annotator": "索隱",
    "text": "得一作德，是愍王遣孟嘗君，自言己無德也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a23",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p8",
    "annotator": "集解",
    "text": "徐廣曰：「年表曰韓、魏、齊共擊秦軍於函谷。」"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a24",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p8",
    "annotator": "索隱",
    "text": "戰國策作「韓慶爲西周謂薛公」。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a25",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p8",
    "annotator": "正義",
    "text": "宛在鄧州，葉在許州。二縣以北舊屬楚，二國共沒以入韓、魏。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a26",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p8",
    "annotator": "正義",
    "text": "東國，齊、徐夷。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a27",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p9",
    "annotator": "索隱",
    "text": "舍人官微，記姓而略其名，故云魏子。收謂收其國之租稅也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a28",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p9",
    "annotator": "索隱",
    "text": "：「湣王三十四年，田甲劫王，薛文走。」"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a29",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p10",
    "annotator": "正義",
    "text": "周最，周之公子。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a30",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p10",
    "annotator": "集解",
    "text": "親弗，人姓名。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a31",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p10",
    "annotator": "索隱",
    "text": "戰國策作「祝弗」，蓋「祝」爲得之。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a32",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p10",
    "annotator": "索隱",
    "text": "周最本厚於齊，今欲逐之而相秦之亡將。蘇代謂孟嘗君，令齊收周最以自厚其行，又且得反齊王之有信，以不逐周最也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a33",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p10",
    "annotator": "索隱",
    "text": "變謂齊、秦合則親弗、呂禮用，用則秦、齊輕孟嘗也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a34",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p12",
    "annotator": "集解",
    "text": "皇覽曰：「孟嘗君冢在魯國薛城中向門東。向門，出北邊門也。」詩云「居常與許」，鄭玄曰「『常』或作『嘗』，在薛之南」。孟嘗邑于薛城也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a35",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p12",
    "annotator": "索隱",
    "text": "孟嘗襲父封薛，而號曰孟嘗君，此云謚，非也。孟，字也；嘗，邑名。詩云「居常與許」，鄭箋云「『常』或作『嘗』，嘗邑在薛之旁」是也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a36",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p12",
    "annotator": "正義",
    "text": "括地志云：「孟嘗君墓在徐州滕縣五十二里。卒在齊襄王之時也。」"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a37",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p13",
    "annotator": "集解",
    "text": "音歡。復作「煖」，音許袁反。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a38",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p13",
    "annotator": "索隱",
    "text": "屩音脚。字亦作「蹻」，又作「僑」。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a39",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p13",
    "annotator": "索隱",
    "text": "傳音逐緣反。按：傳舍、幸舍及代舍，並當上、中、下三等之客所舍之名耳。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a40",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p13",
    "annotator": "集解",
    "text": "蒯音苦怪反。茅之類，可爲繩。言其劔把無物可裝，以小繩纏之也。緱音侯，亦作「候」，謂把劔之處。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a41",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p13",
    "annotator": "索隱",
    "text": "蒯，草名，音「蒯聵」之「蒯」。緱音侯，字亦作「候」，謂把劔之物。言其劔無物可裝，但以蒯繩纏之，故云「蒯緱」。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a42",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p14",
    "annotator": "正義",
    "text": "奉，符用反。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a43",
    "book": "shiji",
    "chapter_id": "shiji-孟嘗君列傳第十五",
    "target_para_id": "text:shiji:shiji-孟嘗君列傳第十五:p14",
    "annotator": "索隱",
    "text": "與猶還也。息猶利也。"
  },
  {
    "id": "anno:shiji:shiji-孟嘗君列傳第十五:a44",
    "book": "shiji",
