[
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a0",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p0",
    "annotator": "索隱",
    "text": "宣太后之異父長弟也，姓魏，名冉，封之穰。地理志穰縣在南陽。宣太后者，惠王之妃，姓羋氏，曰羋八子者是也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a1",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p0",
    "annotator": "正義",
    "text": "芊，亡爾反。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a2",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "索隱",
    "text": "秦本紀云：「昭王二年，庶長壯與大臣公子爲逆，皆誅，及惠文后皆不得良死。」又按：紀年云「秦內亂，殺其太后及公子雍、公子壯」是也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a3",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "索隱",
    "text": "華陽，韓地，後屬秦。羋戎後又號新城君。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a4",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "正義",
    "text": "司馬彪云：「華陽，亭名，在洛州密縣。」又故華城在鄭州管城縣南三十里，即此。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a5",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "索隱",
    "text": "名顯。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a6",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "索隱",
    "text": "名悝。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a7",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "集解",
    "text": "徐廣曰：「年表曰季君爲亂，誅。本紀曰庶長壯與大臣公子謀反。伏誅。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a8",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p1",
    "annotator": "索隱",
    "text": "按季君即公子壯，僭立而號曰季君。穰侯力能立昭王，爲將軍，衞咸陽，誅季君及惠文后，故本紀言「伏誅」。又云「及惠文后皆不得良死」，蓋謂惠文后時黨公子壯，欲立之，及壯誅而太后憂死，故云「不得良死」，亦史諱之也。又逐武王后出之魏，亦事勢然也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a9",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p2",
    "annotator": "索隱",
    "text": "戰國策作「仇郝」，蓋是一人而記別也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a10",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p2",
    "annotator": "正義",
    "text": "音亦，姓名。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a11",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p2",
    "annotator": "索隱",
    "text": "戰國策作「宋交」。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a12",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p3",
    "annotator": "集解",
    "text": "徐廣曰：「一作『陰』。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a13",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p3",
    "annotator": "索隱",
    "text": "陶即定陶也。徐廣云作「陰」，陶陰字本易惑也。王劭按：定陶見有魏冉冢，作「陰」，誤也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a14",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "集解",
    "text": "上莫卬反。下陌飽反。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a15",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "集解",
    "text": "徐廣曰：「魏惠王五年，與韓會宅陽。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a16",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "正義",
    "text": "竹書云：「宅陽，一名北宅。」括地志云：「宅陽故城在鄭州滎陽縣西南十七里。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a17",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "集解",
    "text": "徐廣曰：「田完世家云魏伐趙，趙不利，戰於南梁。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a18",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "三梁即南梁也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a19",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "衞之故國，蓋楚丘也。下文「故地」，亦同謂楚丘也。戰國策「衞」字皆作「燕」，「子良」作「子之」，恐非也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a20",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "河東、河西、河內並是魏地，即故晉國。今言秦蠶食魏氏，盡晉國之地也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a21",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "集解",
    "text": "徐廣曰：「韓將暴鳶。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a22",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "講，和也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a23",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "謂與秦欲講，少割地而求秦質子；恐不然必被秦欺也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a24",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "須賈說穰侯，言魏人謂梁王若少割地而求秦質，必是欺我，即聞魏見欺於秦也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a25",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "集解",
    "text": "爾雅曰：「四尺謂之仞，倍仞謂之尋。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a26",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "「陶」一作「魏」。言秦前攻得魏之城邑，秦罷則亡而還於魏也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a27",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "正義",
    "text": "定陶近大梁，穰侯攻梁兵疲，定陶必爲魏伐。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a28",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "賈引魏人之說不許王講于秦，是言魏氏方疑，可以少割地而收魏也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a29",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "楚、趙怒魏之與秦講，皆爭事秦，是東方從國於是解散也，故云「從以此散」。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a30",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "正義",
    "text": "從，足松反。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a31",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "穰侯封陶，魏效絳與安邑，是得河東地。言從秦適陶，開河西、河東之兩道。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a32",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "正義",
    "text": "穰故封定陶，故宋及單父是陶之南道也，魏之安邑及絳是陶北道。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a33",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "上音祈。此時宋已滅，是秦將盡得宋地也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a34",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "索隱",
    "text": "言莫行圍梁之危事。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a35",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p5",
    "annotator": "正義",
    "text": "表云魏安釐王二年，秦軍大梁城，韓來救，與秦溫以和也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a36",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "集解",
    "text": "丘權反。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a37",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "索隱",
    "text": "旣得觀津，仍令趙伐齊，而秦又以兵益助趙也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a38",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "索隱",
    "text": "告齊王，言秦必定不益兵以助趙。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a39",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "正義",
    "text": "臣，蘇代也。必知秦與趙甲四萬以伐齊。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a40",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "正義",
    "text": "謂齊王也。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a41",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p7",
    "annotator": "正義",
    "text": "今晉、楚伐齊，晉、楚之國亦獘敗。"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a42",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p8",
    "annotator": "集解",
    "text": "徐廣曰：「濟北有剛縣。」"
  },
  {
    "id": "anno:shiji:shiji-穰侯列傳第十二:a43",
    "book": "shiji",
    "chapter_id": "shiji-穰侯列傳第十二",
    "target_para_id": "text:shiji:shiji-穰侯列傳第十二:p8",
    "annotator": "正義",
    "text": "故剛城在兗州龔丘縣界。壽張，鄆州縣也。"
  }
]