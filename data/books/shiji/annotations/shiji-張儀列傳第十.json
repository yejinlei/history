[
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a0",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p0",
    "annotator": "集解",
    "text": "呂氏春秋曰：「儀，魏氏餘子。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a1",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p0",
    "annotator": "索隱",
    "text": "晉有大夫張老，又河東有張城，張氏爲魏人必也。而呂覽以爲魏氏餘子，則蓋魏之支庶也。又書略說餘子謂庶子也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a2",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p0",
    "annotator": "正義",
    "text": "左傳晉有公族、餘子、公行。杜預云：「皆官卿之嫡爲公族大夫。餘子，嫡子之母弟也。公行，庶子掌公戎行也。」藝文志云張子十篇，在縱橫流。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a3",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p1",
    "annotator": "索隱",
    "text": "說音稅。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a4",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p1",
    "annotator": "集解",
    "text": "醳音釋。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a5",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p1",
    "annotator": "索隱",
    "text": "古釋字。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a6",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p1",
    "annotator": "索隱",
    "text": "音僖。鄭玄曰：「嘻，悲恨之聲。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a7",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p2",
    "annotator": "索隱",
    "text": "從音足容反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a8",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p2",
    "annotator": "索隱",
    "text": "謂數設詞而讓之。讓亦責也。數音朔。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a9",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p4",
    "annotator": "集解",
    "text": "渠音詎。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a10",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p4",
    "annotator": "索隱",
    "text": "渠音詎，古字少，假借耳。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a11",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p4",
    "annotator": "集解",
    "text": "徐廣曰：「一作『尺一之檄』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a12",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p4",
    "annotator": "索隱",
    "text": "王劭按春秋後語云「丈二尺檄」。許慎云「檄，二尺書」。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a13",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p4",
    "annotator": "索隱",
    "text": "若者，汝也。下文而亦訓汝。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a14",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p5",
    "annotator": "集解",
    "text": "徐廣曰：「譙周曰益州『天苴』讀爲『包黎』之『包』，音與『巴』相近，以爲今之巴郡。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a15",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p5",
    "annotator": "索隱",
    "text": "苴音巴。謂巴、蜀之夷自相攻擊也。今字作「苴」者，按巴苴是草名，今論巴，遂誤作「苴」也。或巴人、巴郡本因芭苴得名，所以其字遂以「苴」爲「巴」也。注「益州天苴讀爲芭黎」，天苴即巴苴也。譙周，蜀人也，知「天苴」之音讀爲「芭黎」之「芭」。按：芭黎即織木葺爲葦籬也，今江南亦謂葦籬曰芭籬也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a16",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p5",
    "annotator": "正義",
    "text": "華陽國志云：「昔蜀王封其弟于漢中，號曰苴侯，因命之邑曰葭萌。苴侯與巴王爲好，巴與蜀爲讎，故蜀王怒，伐苴。苴奔巴，求救於秦。秦遣張儀從子午道伐蜀，王自葭萌禦之，敗績，走至武陽，爲秦軍所害。秦遂滅蜀，因取苴與巴焉。」括地志云：「苴侯都葭萌，今利州益昌縣五十里葭萌故城是。蜀侯都益州巴子城，在合州石鏡縣南五里，故墊江縣也。巴子都江州，在都之北，又峽州界也。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a17",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p5",
    "annotator": "索隱",
    "text": "錯音七各反，又音七故反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a18",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "集解",
    "text": "徐廣曰：「一作『尋』，成臯鞏縣有尋口。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a19",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "索隱",
    "text": "一本作「尋谷」，尋什聲相近，故其名惑也。戰國策云「轘轅、緱氏之口」，亦其地相近也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a20",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "正義",
    "text": "括地志云：「溫泉水即尋，源出洛州鞏縣西南四十里。注水經云鄩城水出北山鄩溪。又有故鄩城，在鞏縣西南五十八里。」按：洛州緱氏縣東南四十里，與鄩溪相近之地。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a21",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "正義",
    "text": "屯留，潞州縣也。道即太行羊腸阪道也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a22",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "正義",
    "text": "南陽，懷州也。是當屯留之道，令魏絕斷壞羊腸、韓上黨之路也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a23",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "正義",
    "text": "是塞什谷之口也。令楚兵臨鄭南，塞轘轅鄩口，斷韓南陽之兵也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a24",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "索隱",
    "text": "新城當在河南伊闕之左右。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a25",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "正義",
    "text": "洛州福昌縣也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a26",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p6",
    "annotator": "索隱",
    "text": "王音于放反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a27",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "索隱",
    "text": "戰國策「取」作「得」。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a28",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "正義",
    "text": "繕音膳，同「饍」，具食也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a29",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "索隱",
    "text": "西海謂蜀川也。海者珍藏所聚生，猶謂秦中爲「陸海」然也。其實西亦有海也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a30",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "正義",
    "text": "海之言晦也，西夷晦昧無知，故言海也。言利盡西方羌戎。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a31",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "索隱",
    "text": "名謂傳其德也，實謂土地財寶。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a32",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "索隱",
    "text": "論者，告也，陳也。故，謂陳不宜伐之端由也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a33",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p7",
    "annotator": "正義",
    "text": "韓自知亡三川，故與周并力合謀也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a34",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p8",
    "annotator": "索隱",
    "text": "六國年表在惠王二十二年十月也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a35",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p8",
    "annotator": "正義",
    "text": "表云秦惠王後元年十月，擊滅之。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a36",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "集解",
    "text": "徐廣曰：「一作『革』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a37",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "索隱",
    "text": "魏邑名也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a38",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "正義",
    "text": "在隰州隰州縣，蒲邑故城是也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a39",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "集解",
    "text": "徐廣曰：「夏陽在梁山龍門。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a40",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "索隱",
    "text": "夏音下，山名也，亦曰大夏，是蜀所都。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a41",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p9",
    "annotator": "正義",
    "text": "少梁城，同州韓城縣南二十三里。夏陽城在縣南二十里。梁山在縣東南十九里。龍門山在縣北五十里。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a42",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p10",
    "annotator": "正義",
    "text": "表云惠王之十三年，周顯王之三十四年也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a43",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p12",
    "annotator": "集解",
    "text": "觀音貫。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a44",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p13",
    "annotator": "集解",
    "text": "音桓。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a45",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "索隱",
    "text": "河之西，即曲沃、平周之邑等。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a46",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "正義",
    "text": "河外即卷、衍、燕、酸棗。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a47",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "注",
    "text": "卷，丘權反。衍，以善反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a48",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "索隱",
    "text": "卷縣在河南。衍，地名。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a49",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "正義",
    "text": "卷、衍屬鄭州；燕，滑州胙城縣；酸棗屬滑州：皆黃河南岸地。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a50",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "正義",
    "text": "故城在曹州乘氏縣西北三十七里。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a51",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p14",
    "annotator": "索隱",
    "text": "戰國策「折」作「挾」也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a52",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p15",
    "annotator": "正義",
    "text": "枕，針鴆反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a53",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p20",
    "annotator": "索隱",
    "text": "劉氏云：「商即今之商州，有古商城；其西二百餘里有古於城。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a54",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p21",
    "annotator": "正義",
    "text": "詳音羊。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a55",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p21",
    "annotator": "集解",
    "text": "徐廣曰：「在枝江。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a56",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p21",
    "annotator": "正義",
    "text": "今梁州也，在漢水北。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a57",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p22",
    "annotator": "正義",
    "text": "要音腰。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a58",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p22",
    "annotator": "正義",
    "text": "即商於之地。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a59",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p22",
    "annotator": "索隱",
    "text": "按：「不」字當作「必」。時張儀爲楚所囚，故必欲出之也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a60",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p22",
    "annotator": "正義",
    "text": "秦王不欲出張儀使楚，若欲自行，今秦欲以上庸地及美人贖儀。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a61",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p22",
    "annotator": "正義",
    "text": "今房州也"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a62",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p23",
    "annotator": "索隱",
    "text": "此時當秦惠王之後元十四年。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a63",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p23",
    "annotator": "索隱",
    "text": "常山於天下在北，有若人之背脊也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a64",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p23",
    "annotator": "正義",
    "text": "古之帝王多都河北、河東故也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a65",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p23",
    "annotator": "注",
    "text": "。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a66",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p25",
    "annotator": "正義",
    "text": "挑，田鳥反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a67",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p25",
    "annotator": "正義",
    "text": "卒，葱勿反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a68",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "正義",
    "text": "汶音泯。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a69",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "索隱",
    "text": "枋音方，謂並兩船也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a70",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "集解",
    "text": "徐廣曰：「巴郡魚復縣有扞水關。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a71",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "索隱",
    "text": "扞關在楚之西界。復音伏。按：地理志巴郡有魚復縣。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a72",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "正義",
    "text": "在硤州巴山縣界。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a73",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p26",
    "annotator": "正義",
    "text": "楚之北境斷絕。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a74",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p27",
    "annotator": "索隱",
    "text": "偏，匹連反。此云「新城」，當在吳楚之閒。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a75",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p27",
    "annotator": "正義",
    "text": "新攻得之城，未詳所在。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a76",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p28",
    "annotator": "集解",
    "text": "徐廣曰：「一作『吞』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a77",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p28",
    "annotator": "索隱",
    "text": "其地在秦南山之南，楚之西北，漢水之北，名曰漢中。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a78",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p28",
    "annotator": "集解",
    "text": "徐廣曰：「或音『戟』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a79",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p29",
    "annotator": "集解",
    "text": "徐廣曰：「關，一作『開』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a80",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p29",
    "annotator": "索隱",
    "text": "攻衞陽晉，大關天下胸。夫以常山爲天下脊，則此衞及陽晉當天下胸，蓋其地是秦、晉、齊、楚之交道也。以言秦兵據陽晉，是大關天下胸，則他國不得動也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a81",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p29",
    "annotator": "索隱",
    "text": "謂邊近泗水之側，當戰國之時有十二諸侯，宋、魯、邾、莒之比也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a82",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p30",
    "annotator": "索隱",
    "text": "混，本作「棍」，同胡本反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a83",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "索隱",
    "text": "厮徒謂雜役之賤者。負養謂負檐以給養公家，亦賤人也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a84",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "集解",
    "text": "跿跔音徒俱，跳躍也。又云偏舉一足曰跿跔。科頭謂不著兜鍪入敵。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a85",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "索隱",
    "text": "跔又音劬。劉氏云「謂跳躍也」。又韻集云「偏舉一足曰跿跔」。戰國策曰「虎摯之士跿跔」。科頭謂不著兜鍪。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a86",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "集解",
    "text": "執戟奮怒而入陳也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a87",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "索隱",
    "text": "兩手捧頤而直入敵，言其勇也。又有執戟者奮怒而趨入陣也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a88",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "索隱",
    "text": "謂馬前足探向前，後足趹於後。趹音烏穴反。趹謂後足抉地，言馬之走埶疾也。七尺曰尋。言馬走之疾，前後蹄閒一擲過三尋也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a89",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p33",
    "annotator": "索隱",
    "text": "徒跣也。裼，袒也，謂袒而見肉也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a90",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p35",
    "annotator": "集解",
    "text": "徐廣曰：「桑，一作『栗』。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a91",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p35",
    "annotator": "索隱",
    "text": "此皆韓之宮苑，亦見戰國策。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a92",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p36",
    "annotator": "集解",
    "text": "于偽反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a93",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p37",
    "annotator": "索隱",
    "text": "番音盤，又音婆，趙之邑也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a94",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "索隱",
    "text": "河外，河之南邑，若曲沃、平周等也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a95",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "正義",
    "text": "謂同、華州地也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a96",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "注",
    "text": "綿善反。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a97",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "索隱",
    "text": "謂河漳之閒邑，暫割以事秦耳。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a98",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "正義",
    "text": "河閒，瀛州縣。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a99",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p38",
    "annotator": "正義",
    "text": "博關在博州。趙兵從貝州度黃河，指博關，則漯河南臨淄、即墨危矣。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a100",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p40",
    "annotator": "正義",
    "text": "飾音敕。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a101",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p40",
    "annotator": "索隱",
    "text": "督者，正其事而責之。督過，是深責其過也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a102",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p43",
    "annotator": "索隱",
    "text": "此午道當在趙之東，齊之西也。午道，地名也。鄭玄云「一縱一橫爲午」，謂交道也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a103",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p43",
    "annotator": "正義",
    "text": "河外謂鄭、滑州，北臨河。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a104",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p44",
    "annotator": "正義",
    "text": "趨音趣。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a105",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "正義",
    "text": "句注山在代州也。上音勾。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a106",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "索隱",
    "text": "斗音主。凡方者爲斗，若安長柄，則名爲枓，音主。尾即斗之柄，其形若刀也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a107",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "索隱",
    "text": "音昌悅反。按：謂熱而啜之，是羹也。於下云「厨人進斟」，斟謂羹勺，故因名羹曰斟。左氏「羊羹不斟」是也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a108",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "正義",
    "text": "反即倒斗柄擊也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a109",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "集解",
    "text": "笄，婦人之首飾，如今象牙擿。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a110",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p45",
    "annotator": "正義",
    "text": "笄，今簪也。摩笄山在蔚州飛狐縣東北百五十里。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a111",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p46",
    "annotator": "正義",
    "text": "並在易州界。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a112",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p48",
    "annotator": "集解",
    "text": "音在。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a113",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p48",
    "annotator": "索隱",
    "text": "尾猶末也。謂獻恆山城以與秦。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a114",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p49",
    "annotator": "索隱",
    "text": "凡王者大祭祀必陳設文物軒車彝器等，因謂此等爲祭器也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a115",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p49",
    "annotator": "索隱",
    "text": "此與戰國策同。舊本作「憙」者，誤也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a116",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p49",
    "annotator": "索隱",
    "text": "謂齊之伐梁也。梁之與齊，先相許與約從爲鄰，故云與國也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a117",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p50",
    "annotator": "索隱",
    "text": "年表張儀以安僖王十年卒。紀年云梁安僖王九年五月卒。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a118",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p52",
    "annotator": "索隱",
    "text": "軫語犀首，言我故來，欲有教汝之事，何不相見。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a119",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p52",
    "annotator": "索隱",
    "text": "饜一豔反。饜者，飽也，謂欲令其多事也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a120",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p52",
    "annotator": "索隱",
    "text": "需時爲魏相。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a121",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p53",
    "annotator": "索隱",
    "text": "蓋謂侍御之官。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a122",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p53",
    "annotator": "索隱",
    "text": "此蓋張儀等之計策。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a123",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p53",
    "annotator": "索隱",
    "text": "子指陳軫也。子主謂楚王。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a124",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p53",
    "annotator": "索隱",
    "text": "戰國策作館莊子。館謂逆旅舍，其人字莊子，或作「卞莊子」。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a125",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p53",
    "annotator": "索隱",
    "text": "臣主，爲軫之主楚王也。王，秦惠王。以言我主與王俱宜待韓、魏之斃而擊之，亦無異也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a126",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p54",
    "annotator": "集解",
    "text": "司馬彪曰：「犀首，魏官名，若今虎牙將軍。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a127",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p55",
    "annotator": "正義",
    "text": "此張儀合秦魏之辭也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a128",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p55",
    "annotator": "索隱",
    "text": "錯音措。錯，停止也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a129",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p55",
    "annotator": "集解",
    "text": "徐廣曰：「復相秦。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a130",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "音戈。言義渠道遠，今日已後，不復得更過相見。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a131",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂欲以秦之緩急告語之也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a132",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂山東諸侯齊、魏之大國等。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a133",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "正義",
    "text": "中國謂關東六國。無事，不共攻秦。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a134",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "集解",
    "text": "徐廣曰：「一孤切。」"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a135",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "掇音都活反，謂焚燒而侵掠。焚杅音煩烏二音。按：焚揉而牽制也。戰國策云「秦且燒概君之國」，是說其事也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a136",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂山東諸國共伐秦也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a137",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂秦求親義渠君也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a138",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "正義",
    "text": "有事謂六國攻秦。秦若被攻伐，則必輕使重幣，事義渠之國，欲令相助。犀首此言，令義渠君勿援秦也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a139",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "按表秦惠王後元七年，楚、魏、齊、韓、趙五國共攻秦，是其事也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a140",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "凡絲綿布帛等一段爲一純。純音屯。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a141",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂上文犀首云「君之國有事，秦將輕使重幣事君之國」，故云「衍之所謂」，因起兵襲秦以傷張儀也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a142",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p56",
    "annotator": "索隱",
    "text": "謂義渠破秦軍於李伯之下，則李伯人名或邑號。戰國策「伯」作「帛」。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a143",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p57",
    "annotator": "索隱",
    "text": "犀首後相五國，或從或橫，常爲約長。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a144",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p58",
    "annotator": "索隱",
    "text": "暴音步卜反。振謂振揚而暴露其短。扶謂說彼之非，成我之是，扶會己之說辭也。"
  },
  {
    "id": "anno:shiji:shiji-張儀列傳第十:a145",
    "book": "shiji",
    "chapter_id": "shiji-張儀列傳第十",
    "target_para_id": "text:shiji:shiji-張儀列傳第十:p58",
    "annotator": "索隱",
    "text": "張儀說六國，使連衡而事秦，故云「成其衡道」。然山東地形從長，蘇秦相六國，令從親而賔秦也。關西地形衡長，張儀相六國，令破其從而連秦之衡，故謂張儀爲連橫矣。"
  }
]