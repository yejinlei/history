    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p0",
    "annotator": "索隱",
    "text": "案下文，字少卿。陘音刑，縣名，屬中山。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p0",
    "annotator": "索隱",
    "text": "本燕人，樂毅之後。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p0",
    "annotator": "正義",
    "text": "樂，姓；巨公，名。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p0",
    "annotator": "正義",
    "text": "喜音許記反。諸公謂丈人行也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「七年，韓王信反，高帝征之。十年，代相陳豨反。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p1",
    "annotator": "索隱",
    "text": "案謂死而蟲出也。左傳「齊桓公死，未葬，蟲流於戶外」是也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「九年十二月捕貫高等也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p4",
    "annotator": "索隱",
    "text": "搏音博。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p4",
    "annotator": "正義",
    "text": "王之財物所藏也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p5",
    "annotator": "正義",
    "text": "魯共王，景帝子，都兗州曲阜縣故魯城中。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p5",
    "annotator": "正義",
    "text": "括地志云：「矍相圃在兗州曲阜縣南三十里。禮記云孔子射於矍相之圃，觀者如堵墻也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p5",
    "annotator": "索隱",
    "text": "上音步卜反。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "集解",
    "text": "張晏曰：「衞青也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "正義",
    "text": "百官表云：「監御史，秦官，掌監郡，漢省，丞相遣御史分刺州，不常置也。」案：三河，河南、河東、河內也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "正義",
    "text": "百官表云：「右扶風、左馮翊、京兆尹是爲三輔。元鼎四年，置三輔都尉。」服虔云：「皆治長安城中也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "正義",
    "text": "百官表云：「武帝元狩五年，初置司直，秩比二千石，掌佐丞相舉不法也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "正義",
    "text": "謂戾太子。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "集解",
    "text": "徐廣曰：「劉屈氂時爲丞相也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "集解",
    "text": "漢書百官表曰：「武帝元狩五年，初置司直，秩比二千石，掌佐丞相舉不法。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "集解",
    "text": "徐廣曰：「陘城，縣名也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p7",
    "annotator": "正義",
    "text": "今定州也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "索隱",
    "text": "將車猶御車也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "索隱",
    "text": "言卜占而自占著家口名數，隸於武功，猶今附籍然也。占音之豔反。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "括地志云：「漢武功縣在渭水南，今盩厔縣西界也。駱谷閒在雍州之盩厔縣西南二十里，開駱谷道以通梁州也。」按：行谷有棧道也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "索隱",
    "text": "易音以豉反。言邑小無豪，易得高名也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "集解",
    "text": "郭璞曰：「亭卒也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "安留武功，替人爲求盜亭父也。應劭云：「舊時亭有兩卒，其一爲亭父，掌關閉掃除；一爲求盜，掌逐捕盜賊也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "百官表云：「十里一亭，亭有長也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "少卿，安字。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "百官表云：「十亭一鄉，鄉有三老一人，掌教化也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p10",
    "annotator": "正義",
    "text": "百官表云：「萬戶已上爲令，秩千石至六百石；減萬戶爲長，秩五百石至三百石。皆有丞、尉也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p11",
    "annotator": "正義",
    "text": "衞青也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p12",
    "annotator": "集解",
    "text": "徐廣曰：「移猶施。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p13",
    "annotator": "正義",
    "text": "地理志云武帝改曰梁州。百官表云：「元封五年，初置部刺史，掌奉詔條察州，秩六百石，員十三。」按：若今採訪按察六條也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p13",
    "annotator": "正義",
    "text": "百官表云：「丞相有兩長史，秩千石。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p14",
    "annotator": "集解",
    "text": "杜，杜周也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a36",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p14",
    "annotator": "正義",
    "text": "謂石慶。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a37",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p15",
    "annotator": "集解",
    "text": "徐廣曰：「暴勝之爲御史大夫。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a38",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p16",
    "annotator": "集解",
    "text": "徐廣曰：「佯，或作『詳』也。」"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a39",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p16",
    "annotator": "索隱",
    "text": "詳音羊。謂詐受節不發兵，不傅會太子也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a40",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p16",
    "annotator": "索隱",
    "text": "不傅事可也。傅音附，謂不附會也。"
  },
  {
    "id": "anno:shiji:shiji-田叔列傳第四十四:a41",
    "book": "shiji",
    "chapter_id": "shiji-田叔列傳第四十四",
    "target_para_id": "text:shiji:shiji-田叔列傳第四十四:p16",
    "annotator": "索隱",
    "text": "鮮音仙。謂太子請其鮮好之兵甲也。"
  }
]