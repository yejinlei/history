[
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a0",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p1",
    "annotator": "索隱",
    "text": "案周禮有太卜之官。此云由漢興者，謂漢自文帝卜大橫之後，其卜官更興盛焉。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a1",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p2",
    "annotator": "索隱",
    "text": "按云楚人而太史公不序其系，蓋楚相司馬子期、子反後，羋姓也。季主見列仙傳。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a2",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p3",
    "annotator": "正義",
    "text": "漢官五日一假洗沐也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a3",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p3",
    "annotator": "索隱",
    "text": "卜數猶術數也。音所具反。劉氏云「具數筮之」，亦通。筮必以易，易用大衍之數也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a4",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p4",
    "annotator": "索隱",
    "text": "獵猶攬也。攬其冠纓而正其衣襟，謂變而自飾也。危一作免。謂俯俛爲敬。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a5",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p4",
    "annotator": "索隱",
    "text": "音烏故反。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a6",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p6",
    "annotator": "索隱",
    "text": "謂卜者自矜誇而莊嚴，說禍以誑人也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a7",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p10",
    "annotator": "索隱",
    "text": "疵音貲。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a8",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p10",
    "annotator": "索隱",
    "text": "孅音纖。纖趍猶足恭也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a9",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p10",
    "annotator": "集解",
    "text": "徐廣曰：「客旅謂之賔，人求長官謂之正。」"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a10",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p11",
    "annotator": "索隱",
    "text": "音釋。適猶調也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a11",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p11",
    "annotator": "索隱",
    "text": "奉音扶用反。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a12",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p12",
    "annotator": "集解",
    "text": "徐廣曰：「式音栻。」"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a13",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p12",
    "annotator": "索隱",
    "text": "按式即栻也。旋，轉也。栻之形上圓象天，下方法地，用之則轉天綱加地之辰，故云旋式。棋者，筮之狀。正棋，蓋謂卜以作卦也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a14",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p12",
    "annotator": "索隱",
    "text": "謂若卜之不祥，則式不收也。卜吉而後有，故云「有之」。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a15",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p12",
    "annotator": "索隱",
    "text": "倣音方往反。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a16",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p15",
    "annotator": "集解",
    "text": "徐廣曰：「一作『險』。」"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a17",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p17",
    "annotator": "索隱",
    "text": "芒音莫郎反。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a18",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p17",
    "annotator": "索隱",
    "text": "悵音暢。噤音禁。劉氏音其錦反。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a19",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p18",
    "annotator": "集解",
    "text": "徐廣曰：「音所。」駰案：離騷經曰「懷椒糈而要之」，王逸云「糈，精米，所以享神」。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a20",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p18",
    "annotator": "索隱",
    "text": "糈者，卜求神之米也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a21",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p18",
    "annotator": "索隱",
    "text": "言卜之不中，乃不見奪其糈米。若爲人主計不審，則身無所處也。"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a22",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p18",
    "annotator": "集解",
    "text": "徐廣曰：「曾，一作『莊』。」"
  },
  {
    "id": "anno:shiji:shiji-日者列傳第六十七:a23",
    "book": "shiji",
    "chapter_id": "shiji-日者列傳第六十七",
    "target_para_id": "text:shiji:shiji-日者列傳第六十七:p19",
    "annotator": "索隱",
    "text": "言宋忠、賈誼皆務華而喪其身，是絕其根本也。"
  }
]