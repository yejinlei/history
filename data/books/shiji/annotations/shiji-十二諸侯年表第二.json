[
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a0",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p0",
    "annotator": "索隱",
    "text": "篇言十二，實叙十三者，賤夷狄不數吳，又霸在後故也。不數而叙之者，闔閭霸盟上國故也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a1",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "案劉杳云「三代系表旁行邪上，其放周譜。譜起周代。藝文志有古帝王譜。又自古爲春秋學者，有年曆、譜諜之說，故杜元凱作春秋長曆及公子譜。蓋因於舊說，故太史公得讀焉」也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a2",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "集解",
    "text": "鄭玄曰：「師摯，太師之名。周道衰微，鄭衞之音作，正樂廢而失節，魯太師摯識關雎之聲，首理其亂也。」"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a3",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "鄒氏及劉氏箸皆音直慮反，即筯也。今案：箕子云「爲象箸者必爲玉桮」，則箸者是樽也，音治略反。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a4",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "唏，嗚歎聲，音許旣反。又音希，希亦聲餘，故記曰：「夫子曰嘻其甚也」，亦餼音也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a5",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "惡，烏故反。過，古卧反。故國語云「厲王止謗，道路以目」是也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a6",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "彘，地名，在河東，後爲永安縣也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a7",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "挾音協也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a8",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "伯音霸。五霸者，齊桓公、晉文公、秦穆公、宋襄公、楚莊王也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a9",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "下孟反。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a10",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "介音界，言楚以江淮爲界。一云介者夾也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a11",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "文去重。去，羌呂反。重，逐龍反。言約史記脩春秋，去其重文也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a12",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "傳音逐宣反。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a13",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "鐸椒所撰。名鐸氏微者，春秋有微婉之詞故也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a14",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "正義",
    "text": "案：其文八篇，藝文志云十五篇，虞卿撰。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a15",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "荀況、孟軻、韓非皆著書，自稱「子」。宋有公孫固，無所述。此固，齊人韓固，傳詩者。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a16",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "案：張蒼著終始五德傳也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a17",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p1",
    "annotator": "索隱",
    "text": "作春秋繁露是。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a18",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "索隱",
    "text": "上音疏具反，謂陰陽術數之家也。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a19",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一作『通』也。」"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a20",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "索隱",
    "text": "壹觀。音官。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a21",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "索隱",
    "text": "下奴丹反。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a22",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一云『治國聞者』也。」"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a23",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p2",
    "annotator": "索隱",
    "text": "爲成學治文者要刪焉。言表見春秋國語，本爲成學之人欲覽其要，故刪爲此篇焉。"
  },
  {
    "id": "anno:shiji:shiji-十二諸侯年表第二:a24",
    "book": "shiji",
    "chapter_id": "shiji-十二諸侯年表第二",
    "target_para_id": "text:shiji:shiji-十二諸侯年表第二:p42",
    "annotator": "索隱",
    "text": "熊儀也，號若敖。"
  }
]