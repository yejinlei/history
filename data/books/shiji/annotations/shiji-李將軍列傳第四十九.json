  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a6",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p1",
    "annotator": "集解",
    "text": "文穎曰：「廣爲漢將，私受梁印，故不以賞也。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a7",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p1",
    "annotator": "集解",
    "text": "昆音魂。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a8",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p1",
    "annotator": "索隱",
    "text": "案典屬國，官名。公孫，姓也；昆邪，名。服虔云「中國人」。包愷云「昆音魂」也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a9",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "集解",
    "text": "漢書音義曰：「內官之幸貴者。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a10",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "索隱",
    "text": "案董巴輿服志云「黃門丞至密近，使聽察天下，謂之中貴人使者」。崔浩云「在中而貴幸，非德望，故名不見也」。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a11",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「放縱馳騁。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a12",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "正義",
    "text": "射音石。還謂轉也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a13",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "集解",
    "text": "文穎曰：「雕，鳥也，故使善射者射也。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a14",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "索隱",
    "text": "案服虔云「雕，鶚也。」說文云「似鷲，黑色，多子」。一名鷲，以其毛作矢羽。韋昭云「鶚，一名鵰也」。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a15",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p2",
    "annotator": "正義",
    "text": "其將乘白馬，而出監護也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a16",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "索隱",
    "text": "案百官志云「將軍領軍皆有部曲。大將軍營五部，部校尉一人，部下有曲，曲有軍候一人」也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a17",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "索隱",
    "text": "音去聲。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a18",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "集解",
    "text": "孟康曰：「以銅作鐎器，受一斗，晝炊飯食，夜擊持行，名曰刁斗。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a19",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "索隱",
    "text": "刁音貂。案荀悅云「刁斗，小鈴，如宮中傳夜鈴也」。蘇林云「形如鋗，以銅作之，無緣，受一斗，故云刁斗」。鋗即鈴也。埤倉云「鐎，溫器，有柄斗，似銚無緣。音焦」。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a20",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "索隱",
    "text": "案大顏云「凡將軍謂之莫府者，蓋兵行舍於帷帳，故稱莫府。古字通用，遂作『莫』耳」。小爾雅訓莫爲大，非也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a21",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p3",
    "annotator": "索隱",
    "text": "案許慎注淮南子云「斥，度也。候，視也，望也」。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a22",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p4",
    "annotator": "集解",
    "text": "徐廣曰：「一云『抱兒鞭馬南馳』也。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a23",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p5",
    "annotator": "集解",
    "text": "孫，灌嬰之孫，名強。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a24",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p5",
    "annotator": "索隱",
    "text": "案百官志云「尉，大縣二人，主盜賊。凡有賊發，則推索尋案之」也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a25",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p5",
    "annotator": "集解",
    "text": "蘇林曰韓安國。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a26",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p7",
    "annotator": "集解",
    "text": "徐廣曰：「一作『沒羽』。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a27",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p8",
    "annotator": "集解",
    "text": "如淳曰：「臂如猿，通肩。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a28",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p8",
    "annotator": "集解",
    "text": "如淳曰：「射戲求疏密，持酒以飲不勝者。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a29",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p8",
    "annotator": "正義",
    "text": "飲音於禁反。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a30",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p8",
    "annotator": "索隱",
    "text": "謂終竟廣身至死，以爲恆也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a31",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p9",
    "annotator": "集解",
    "text": "如淳曰：「中猶充也。充本法得首若干封侯。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a32",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p9",
    "annotator": "集解",
    "text": "徐廣曰：「南都賦曰『黃閒機張，善弩之名』。」駰案：鄭德曰「黃肩弩，淵中黃朱之」。孟康曰「太公六韜曰『陷堅敗強敵，用大黃連弩』」。韋昭曰「角弩色黃而體大也」。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a33",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p9",
    "annotator": "索隱",
    "text": "案大黃，黃閒，弩名也。故韋昭曰「角弩也，色黃體大」是也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a34",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p9",
    "annotator": "注",
    "text": "。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a35",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p10",
    "annotator": "索隱",
    "text": "中音丁仲反。率音律，亦音雙筆反。小顏云：「率謂軍功封賞之科，著在法令，故云中率。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a36",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p10",
    "annotator": "索隱",
    "text": "案以九品而論，在下之中，當第八。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a37",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p10",
    "annotator": "索隱",
    "text": "案謂不在人後。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a38",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "集解",
    "text": "徐廣曰：「主爵趙食其爲右將軍。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a39",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "集解",
    "text": "張晏曰：「以水草少，不可羣輩。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a40",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "索隱",
    "text": "今得當單于。案：廣言自少時結髮而與匈奴戰，唯今者得與單于相當遇也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a41",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "集解",
    "text": "如淳曰：「數爲匈奴所敗，奇爲不偶也。」"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a42",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "索隱",
    "text": "案服虔云「作事數不偶也」。音朔。小顏音所具反。奇，蕭該音居宜反。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a43",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "正義",
    "text": "令廣如其文牒，急引兵徙東道也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a44",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "索隱",
    "text": "食其音異基。案：趙將軍名也。或亦依字讀。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a45",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "索隱",
    "text": "謂無人導引，軍故失道也。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a46",
    "book": "shiji",
    "chapter_id": "shiji-李將軍列傳第四十九",
    "target_para_id": "text:shiji:shiji-李將軍列傳第四十九:p12",
    "annotator": "正義",
    "text": "絕，度也。南歸度沙幕。"
  },
  {
    "id": "anno:shiji:shiji-李將軍列傳第四十九:a47",
