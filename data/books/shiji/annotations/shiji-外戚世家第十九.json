[
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a0",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "按繼體謂非創業之主，而是嫡子繼先帝之正體而立者也。守文猶守法也，謂非受命創制之君，但守先帝法度爲之主耳。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a1",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "按謂非獨君德於內茂盛，而亦有賢后妃外戚之親以助教化。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a2",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "韋昭云：「塗山，國名，禹所娶，在今九江。」應劭云：「九江當塗有禹墟。大戴云『禹娶塗山氏之女，謂之僑，僑產啟』。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a3",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "國語「桀伐有施，有施人以妹喜女焉」，韋昭云「有施氏女，姓喜」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a4",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "韋昭云：「契母簡狄，有娀國女。音嵩。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a5",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "國語「殷辛伐有蘇氏，有蘇氏以妲己女焉」。按：有蘇，國也。己，姓也。妲，字也。包愷云「妲音丁達反」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a6",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "系本云：「帝嚳上妃有邰氏之女，曰姜原。」鄭玄箋詩云：「姜姓，嫄名，履大人跡而生后稷。」大任，文王之母，故詩云「摯仲氏任」，毛詩云「摯國任姓之中女也」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a7",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "國語曰：「幽王伐有襃，有襃人以襃姒女焉。」按：襃是國名，姒是其姓，即龍漦之子，襃人育而以女於幽王也。然此文自「夏之興」至「襃姒」皆是魏如耳之母詞，見國語及列女傳。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a8",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "按：公羊「紀裂繻來逆女，何以書？譏也，譏不親迎也」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a9",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "以言若樂聲調，能令四時和，而陰陽變，則能生萬物，是陰陽即夫婦也。夫婦道和而能化生萬物。萬物，人爲之本，故云「萬物之統」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a10",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "妃音配，又如字。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a11",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "以言夫婦親愛之情，雖君父之尊而不奪臣子所好愛，使移其本意，是不能得也。故曰「匹夫不可奪志」是也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a12",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "按鄭玄注禮記云「姓者，生也。子姓，謂衆孫也」。按即趙飛燕等是也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a13",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "按謂有始不能要其終也。以言雖有子姓而意不能要終，如栗姬、衞后等皆是也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a14",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p1",
    "annotator": "索隱",
    "text": "惡音烏，猶於何也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a15",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「姁音況羽反。呂后姊字長姁也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a16",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p2",
    "annotator": "索隱",
    "text": "呂后字，音況羽反。按：漢書呂后名雉。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a17",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p2",
    "annotator": "索隱",
    "text": "漢書云得定陶戚姬。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a18",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p2",
    "annotator": "索隱",
    "text": "爾雅云「恙，憂也」。一說，古者野居露宿，恙，噬人蟲也，故人相恤云「得無恙乎」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a19",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p3",
    "annotator": "索隱",
    "text": "按皇甫謐云名嫣。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a20",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p4",
    "annotator": "集解",
    "text": "關中記曰：「高祖陵在西，呂后陵在東。漢帝后同塋，則爲合葬，不合陵也。諸陵皆如此。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a21",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p4",
    "annotator": "集解",
    "text": "徐廣曰：「一作『衷』。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a22",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p4",
    "annotator": "索隱",
    "text": "按宮在未央北，故曰北宮。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a23",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p4",
    "annotator": "正義",
    "text": "括地志云：「北宮在雍州長安縣西北十三里，與桂宮相近，在長安故城中。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a24",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p5",
    "annotator": "索隱",
    "text": "媼音烏老反。然媼是婦人之老者通號，故趙太后自稱媼，及王媼、劉媼之屬是也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a25",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p5",
    "annotator": "索隱",
    "text": "顧氏按冢墓記，在會稽縣，縣西北楫山上今猶有兆域。楫音莊洽反。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a26",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p5",
    "annotator": "正義",
    "text": "括地志云：「楫山在越州會稽縣西北三里，一名稷山。」楫音莊洽反。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a27",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p6",
    "annotator": "索隱",
    "text": "按是河南宮之成臯臺，漢書作「成臯靈臺」。西征記云「武牢城內有高祖殿，西南有武庫」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a28",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p6",
    "annotator": "正義",
    "text": "括地志云：「洛州氾水縣，古東虢州，故鄭之制邑，漢之成臯縣也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a29",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p8",
    "annotator": "索隱",
    "text": "按地理志，軹縣在河內，恐地遠非其封也。按：長安東有軹道亭，或當是所封也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a30",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p10",
    "annotator": "索隱",
    "text": "按廟記云「在霸陵南十里，故謂南陵」。按：今在長安東滻水東東原上，名曰少陰。在霸陵西南，故曰「東望吾子，西望吾夫」是也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a31",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p10",
    "annotator": "正義",
    "text": "括地志云：「南陵故縣在雍州萬年縣東南二十四里。漢南陵縣，本薄太后陵邑。陵在東北，去縣六里。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a32",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p10",
    "annotator": "集解",
    "text": "徐廣曰：「霸陵縣有軹道亭。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a33",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p11",
    "annotator": "索隱",
    "text": "按皇甫謐云名猗房。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a34",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p11",
    "annotator": "正義",
    "text": "在冀州棗強縣東北二十五里。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a35",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p11",
    "annotator": "正義",
    "text": "謂宦者爲吏，主發遣宮人也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a36",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p11",
    "annotator": "索隱",
    "text": "音疋消反。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a37",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p12",
    "annotator": "索隱",
    "text": "按摯虞注決錄云「竇太后父少遭秦亂，隱身漁釣，墜泉而死。景帝立，太后遣使者填父所墜淵，起大墳於觀津城南，人閒號曰竇氏青山也」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a38",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p13",
    "annotator": "索隱",
    "text": "按決錄云建字長君。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a39",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p13",
    "annotator": "索隱",
    "text": "謂從逐其宜陽之主人家，而皆往長安也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a40",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p13",
    "annotator": "索隱",
    "text": "決者，別也。傳音轉。傳舍謂郵亭傳置之舍。蓋竇后初入宮時，別其弟於傳舍之中也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a41",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p13",
    "annotator": "索隱",
    "text": "丐音蓋。丐者，乞也。沐，米潘也。謂后乞潘爲弟沐。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a42",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p13",
    "annotator": "索隱",
    "text": "按公亦祖也，謂皇后同祖之昆弟，如竇嬰即皇后之兄子之比，亦得家於長安。故劉氏云「公昆弟謂廣國等」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a43",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p15",
    "annotator": "索隱",
    "text": "地理志縣名，屬勃海。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a44",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p15",
    "annotator": "正義",
    "text": "括地志云：「滄州魯城縣。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a45",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p15",
    "annotator": "索隱",
    "text": "地理志縣名，屬勃海。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a46",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p15",
    "annotator": "正義",
    "text": "括地志云：「故南皮城在滄州南皮縣北四里，漢南皮縣也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a47",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p15",
    "annotator": "索隱",
    "text": "地理志縣名，屬琅邪。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a48",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p17",
    "annotator": "索隱",
    "text": "當武帝建元六年，此文是也。而漢書作「元光」，誤。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a49",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "索隱",
    "text": "按皇甫謐云名娡。音志。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a50",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "索隱",
    "text": "按地理志右扶風槐里，本名廢丘。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a51",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "正義",
    "text": "括地志云：「犬丘故城一名槐里，亦曰廢丘，城在雍州始平縣東南十里也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a52",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "索隱",
    "text": "即后及兒姁也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a53",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "索隱",
    "text": "奇者，異之也。漢書作「倚」。倚者，依也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a54",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p18",
    "annotator": "索隱",
    "text": "即武帝也。漢武故事云「帝以乙酉年七月七月日生於猗蘭殿」。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a55",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p19",
    "annotator": "索隱",
    "text": "況羽反。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a56",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p19",
    "annotator": "索隱",
    "text": "謂廣川王越、膠東王寄、清河王乘、常山王舜也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a57",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p21",
    "annotator": "索隱",
    "text": "過音戈。謂踰之。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a58",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p21",
    "annotator": "索隱",
    "text": "望猶責望，謂恨之也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a59",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p22",
    "annotator": "索隱",
    "text": "嗛音銜。銜謂恨也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a60",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p23",
    "annotator": "索隱",
    "text": "大行，禮官。行音衡。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a61",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p23",
    "annotator": "索隱",
    "text": "此皆公羊傳文。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a62",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p23",
    "annotator": "索隱",
    "text": "地理志蓋縣屬太山。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a63",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p24",
    "annotator": "正義",
    "text": "德州縣也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a64",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p24",
    "annotator": "索隱",
    "text": "地理志縣名，屬魏郡。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a65",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p24",
    "annotator": "正義",
    "text": "括地志云：「武安故城在洛州武安縣西南七里，六國時趙邑，漢武安縣城也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a66",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p24",
    "annotator": "索隱",
    "text": "地理志縣名，屬上郡。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a67",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p24",
    "annotator": "正義",
    "text": "括地志云：「周陽故城在絳州聞喜縣東二十九里也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a68",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p25",
    "annotator": "正義",
    "text": "括地志云：「平陽故城即晉州城西面，今平陽故城東面也。城記云堯築也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a69",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p25",
    "annotator": "正義",
    "text": "南宮，冀州縣也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a70",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p25",
    "annotator": "索隱",
    "text": "縣名，屬河內。本名隆慮，避殤帝諱，改名林慮。慮音廬。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a71",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p25",
    "annotator": "正義",
    "text": "林慮，相州縣也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a72",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p26",
    "annotator": "正義",
    "text": "括地志云：「陽陵在雍州咸陽縣東四十里。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a73",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "正義",
    "text": "衞青傳云：「父鄭季爲吏，給事平陽侯家，與侯妾衞媼通，生青，故冒衞氏。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a74",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "集解",
    "text": "徐廣曰：「平陽侯曹壽尚平陽公主。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a75",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "集解",
    "text": "徐廣曰：「三月上巳，臨水祓除謂之禊。呂后本紀亦云『三月祓還過軹道』。蓋與『游』字相似，故或定之也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a76",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "索隱",
    "text": "蘇林音廢，今亦音拂，謂祓禊之，游水自潔，故曰祓除。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a77",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "正義",
    "text": "尚，主也。於主衣車中得幸也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a78",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "索隱",
    "text": "按謂諸邑、石邑及衞長公主後封當利公主是。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a79",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p27",
    "annotator": "索隱",
    "text": "即戾太子也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a80",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p28",
    "annotator": "索隱",
    "text": "漢武故事云「后名阿嬌」即長公主嫖女也。曾祖父嬰，堂邑侯，傳至父午，尚長公主，生后。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a81",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p28",
    "annotator": "集解",
    "text": "徐廣曰：「即景帝姊嫖也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a82",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p28",
    "annotator": "索隱",
    "text": "按：漢書云「女子楚服等坐爲皇后咒詛，大逆無道，相連誅者三百人」，乃廢后居長門宮。故司馬相如賦云「陳皇后別在長門宮，怨悶悲思，奉黃金百斤爲相如取酒，乃爲作頌以奏，皇后復親幸」。作頌信有之也，復親幸之恐非實也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a83",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p30",
    "annotator": "索隱",
    "text": "地理志縣名，屬汝南。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a84",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p30",
    "annotator": "索隱",
    "text": "地理志冠軍屬河陽。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a85",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p31",
    "annotator": "索隱",
    "text": "名閎。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a86",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p32",
    "annotator": "索隱",
    "text": "名髆。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a87",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p32",
    "annotator": "正義",
    "text": "名賀。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a88",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p33",
    "annotator": "索隱",
    "text": "李延年之女弟。漢書云「帝悼之，李少翁致其形，帝爲作賦」。此史記以爲王夫人最寵，武帝悼惜。新論亦同史記爲王夫人。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a89",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p33",
    "annotator": "正義",
    "text": "漢武帝令李廣利征大宛，國近西海，故號海西侯也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a90",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p34",
    "annotator": "索隱",
    "text": "漢書云李姬生廣陵王胥、燕王旦也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a91",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "正義",
    "text": "疑此元成之閒褚少孫續之也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a92",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "集解",
    "text": "徐廣曰：「名俗。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a93",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "正義",
    "text": "按：後封修成君者。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a94",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "注",
    "text": "集解如淳曰：「橫音光。三輔黃圖云北面西頭門。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a95",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "正義",
    "text": "括地志云：「渭橋本名橫橋，架渭水上，在雍州咸陽縣東南二十二里。」按：此橋對門也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a96",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "索隱",
    "text": "烏百反。蓋驚怪之辭耳。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a97",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "正義",
    "text": "嚄，嘖，失聲驚愕貌也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a98",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "正義",
    "text": "武帝道上詔令通名狀於門使，引入至太后所。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a99",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "索隱",
    "text": "金氏甥，修成君之子也。而名仲者，又與大外祖王氏同字，恐非也。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a100",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p36",
    "annotator": "集解",
    "text": "徐廣曰：「嫁爲淮南王安太子妃也。」"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a101",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p37",
    "annotator": "索隱",
    "text": "名不疑。地理志縣名，屬魏郡。"
  },
  {
    "id": "anno:shiji:shiji-外戚世家第十九:a102",
    "book": "shiji",
    "chapter_id": "shiji-外戚世家第十九",
    "target_para_id": "text:shiji:shiji-外戚世家第十九:p37",
    "annotator": "正義",
    "text": "括地志云：「陰安故城魏州頓丘縣北六十里也。」"
  },
