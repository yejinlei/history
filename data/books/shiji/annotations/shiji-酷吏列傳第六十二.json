    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p15",
    "annotator": "集解",
    "text": "徐廣曰：「隨勢沈浮也。」駰案：服虔曰「射成敗也」。如淳曰「得利爲乾，失利爲沒」。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a50",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p15",
    "annotator": "正義",
    "text": "此二說非也。按：乾沒謂無潤及之而取他人也。又云陽浮慕爲乾，心內不合爲沒也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a51",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p15",
    "annotator": "集解",
    "text": "徐廣曰：「姓魚也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a52",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "索隱",
    "text": "傅音附。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a53",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "李奇曰：「亭，平也，均也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a54",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "索隱",
    "text": "使之平疑事也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a55",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "韋昭曰：「在板絜。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a56",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "正義",
    "text": "按謂律令也。古以板書之。言上所是，著之爲正獄，以廷尉法令決平之，揚主之明監也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a57",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "徐廣曰：「應，一作『權』。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a58",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "正義",
    "text": "百官表云：「廷尉，秦官。有正、左、右監，皆秩千石也。」按：上即責，湯應對謝之如上意，必引正、監等賢者本爲臣建議如上意，臣不用，愚昧不從至此也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a59",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "蘇林曰：「主坐不用諸掾語，故至於此。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a60",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "徐廣曰：「詔，答聞也，如今制曰『聞』矣。」駰案：瓚曰「謂常見原」。"
  },
  {
