    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "索隱",
    "text": "緡，錢貫也。漢氏有告緡令，楊可主之。謂緡錢出入有不出筭錢者，令得告之也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a95",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "索隱",
    "text": "謂求楊可之使。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a96",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "集解",
    "text": "漢書音義曰：「武帝使楊可主告緡，沒入其財物，縱捕爲可使者，此爲廢格詔書，沮已成之事。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a97",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "索隱",
    "text": "格音閣。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a98",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p28",
    "annotator": "集解",
    "text": "徐廣曰：「屬馮翊。」"
  },
