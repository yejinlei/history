    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p13",
    "annotator": "集解",
    "text": "如淳曰：「決獄之書，謂律令也。」"
