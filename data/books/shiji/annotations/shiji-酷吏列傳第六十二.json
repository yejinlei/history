    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p26",
    "annotator": "集解",
    "text": "徐廣曰：「孔、暴二姓，大族。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a88",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p26",
    "annotator": "集解",
    "text": "漢書音義曰：「一切皆捕之也。律，諸囚徒私解脫桎梏鉗赭，加罪一等；爲人解脫，與同罪。縱鞫相贍餉者二百人爲解脫死罪，盡殺也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a89",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p26",
    "annotator": "索隱",
    "text": "案謂豪猾之人干豫吏政，故云「佐吏爲理」也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a90",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "集解",
    "text": "徐廣曰：「鷙鳥將擊，必張羽毛也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a91",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "索隱",
    "text": "卒音七忽反。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a92",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "集解",
    "text": "徐廣曰：「嗛音銜。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a93",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p27",
    "annotator": "集解",
    "text": "韋昭曰：「人有告言不出緡者，可方受之。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a94",
