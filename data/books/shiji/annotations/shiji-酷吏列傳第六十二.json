    "id": "anno:shiji:shiji-酷吏列傳第六十二:a99",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p28",
    "annotator": "集解",
    "text": "徐廣曰：「椎殺人而埋之。或謂發冢。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a100",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p29",
    "annotator": "索隱",
    "text": "梨音犁。梨，比也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a101",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p29",
    "annotator": "集解",
    "text": "徐廣曰：「有殘刻之名。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a102",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p29",
    "annotator": "索隱",
    "text": "案漢書作「徒請召猜禍吏」。服虔曰：「徒，但也。猜，惡也」。應劭曰「猜，疑也。取吏名爲好猜疑人作禍敗者而使之」。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a103",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p29",
    "annotator": "集解",
    "text": "徐廣曰：「一云『麻成』。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a104",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p30",
    "annotator": "索隱",
    "text": "茌音仕疑反。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a105",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p31",
    "annotator": "集解",
    "text": "漢書音義曰：「千夫若五大夫。武帝軍用不足，令民出錢穀爲之。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a106",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p31",
    "annotator": "集解",
    "text": "徐廣曰：「受封四年，征朝鮮還，贖爲庶人。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a107",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p31",
    "annotator": "索隱",
    "text": "案漢書云「與左將軍荀彘俱擊朝鮮，爲彘所縛。還，免爲庶人，病死。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a108",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "索隱",
    "text": "惛音昏。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a109",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "集解",
    "text": "徐廣曰：「音項，器名也，如今之投書函中。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a110",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "索隱",
    "text": "缿，受投書之器，入不可出。三倉音胡江反。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a111",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "集解",
    "text": "徐廣曰：「一作『落』。古『村落』字亦作『格』。街陌屯落皆設督長也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a112",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "索隱",
    "text": "伯音阡陌，格音村落。言阡陌村落皆置長也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a113",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "集解",
    "text": "焄音熏。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a114",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p32",
    "annotator": "索隱",
    "text": "案熏猶熏炙之。謂下戶之中有姦猾之人，令案之，以熏逐大姦。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a115",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p33",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎六年，出會稽破東越。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a116",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p33",
    "annotator": "正義",
    "text": "漢書元封三年。三輔舊事云：「起甘泉通天臺，高五十丈。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a117",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p34",
    "annotator": "集解",
    "text": "漢書音義曰：「發兵伐大宛。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a118",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p35",
    "annotator": "集解",
    "text": "徐廣曰：「尹齊死未及斂，恐怨家欲燒之，屍亦飛去。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a119",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p36",
    "annotator": "集解",
    "text": "徐廣曰：「殷，一作『假』，人亦有姓假者也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a120",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p36",
    "annotator": "集解",
    "text": "漢書音義曰：「沈，藏匿也。命，亡逃也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a121",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p36",
    "annotator": "索隱",
    "text": "服虔云：「沈匿不發覺之法。」韋昭云：「沈，沒也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a122",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p36",
    "annotator": "集解",
    "text": "徐廣曰：「詐爲虛文，言無盜賊也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a123",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p37",
    "annotator": "正義",
    "text": "百官表云大僕屬官有大廄，各五丞一尉也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a124",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p37",
    "annotator": "集解",
    "text": "漢書曰：「成信，宣吏。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a125",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p37",
    "annotator": "正義",
    "text": "郿令，今岐州岐縣北，時屬右扶風。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a126",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p38",
    "annotator": "正義",
    "text": "杜氏譜云字長孺。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a127",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p38",
    "annotator": "索隱",
    "text": "地名也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a128",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p38",
    "annotator": "集解",
    "text": "文穎曰：「邊卒多亡也。或曰郡縣主守有所亡失也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a129",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p39",
    "annotator": "集解",
    "text": "李奇曰：「其用罪深刻至骨。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a130",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p39",
    "annotator": "索隱",
    "text": "次，至也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a131",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p39",
    "annotator": "集解",
    "text": "漢書音義曰：「以三尺竹簡書法律也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a132",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p40",
    "annotator": "集解",
    "text": "如淳曰：「郡吏，郡太守也。」孟康曰：「舉之廷尉，以章劾付廷尉治之。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a133",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p40",
    "annotator": "集解",
    "text": "張晏曰：「詔書赦，或有不從此令。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a134",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p40",
    "annotator": "索隱",
    "text": "大氐盡柢以不道。案：大氐猶大都也。氐音至。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a135",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p41",
    "annotator": "集解",
    "text": "徐廣曰：「天漢三年爲御史大夫，四歲，太始三年卒。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a136",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p42",
    "annotator": "集解",
    "text": "徐廣曰：「一本無此四字。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a137",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p42",
    "annotator": "集解",
    "text": "徐廣曰：「一作『成』。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a138",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p42",
    "annotator": "索隱",
    "text": "推音直追反，減作成，是也。謂推繫之以成獄也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a139",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p42",
    "annotator": "索隱",
    "text": "蝮音蝮蛇，鷙音至。以言苛酷比之蝮毒鷹攫。"
  }
]