    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p25",
    "annotator": "集解",
    "text": "漢書音義曰：「姁音煦，縱姊名也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a81",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p25",
    "annotator": "索隱",
    "text": "案謂補上黨郡中之令，史失其縣名。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a82",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p25",
    "annotator": "集解",
    "text": "漢書音義曰：「敢行暴政而少蘊藉也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a83",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p25",
    "annotator": "索隱",
    "text": "蘊音慍。藉音才夜反。張晏云：「爲人無所避，故少所假借也。」"
  },
