    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "李奇曰：「先見上，口言之，欲與輕平也。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a62",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "李奇曰：「湯口所先言皆見原釋。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a63",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p16",
    "annotator": "集解",
    "text": "徐廣曰：「元狩二年。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a64",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p17",
    "annotator": "正義",
    "text": "緡音岷，錢貫也。武帝伐四夷，國用不足，故稅民田宅船乘畜產奴婢等，皆平作錢數，每千錢一筭，出一等，賈人倍之；若隱不稅，有告之，半與告人，餘半入官，謂緡。出此令，用鋤築豪強兼并富商大賈之家也。一筭，百二十文也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a65",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p17",
    "annotator": "集解",
    "text": "徐廣曰：「時李蔡、莊青翟爲丞相。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a66",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p18",
    "annotator": "正義",
    "text": "障謂塞上要險之處別築城，置吏士守之，以扞寇盜也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a67",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p19",
    "annotator": "集解",
    "text": "徐廣曰：「以利交。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a68",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p21",
    "annotator": "集解",
    "text": "如淳曰：「太官之別也，主酒。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a69",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p21",
    "annotator": "集解",
    "text": "如淳曰：「瘞埋錢於園陵以送死。」"
  },
