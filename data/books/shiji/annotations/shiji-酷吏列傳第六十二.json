    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p3",
    "annotator": "索隱",
    "text": "荀悅音閑，鄒氏劉氏音並同也。"
