    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p21",
    "annotator": "集解",
    "text": "張晏曰：「見知故縱，以其罪罪之。」"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a71",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p22",
    "annotator": "正義",
    "text": "朱買臣，吳人也，此時蘇州爲會稽郡也。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a72",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p22",
    "annotator": "正義",
    "text": "周末越王句踐滅吳，楚威王滅越，吳之地總屬楚，故謂朱買臣爲楚士。"
  },
  {
    "id": "anno:shiji:shiji-酷吏列傳第六十二:a73",
    "book": "shiji",
    "chapter_id": "shiji-酷吏列傳第六十二",
    "target_para_id": "text:shiji:shiji-酷吏列傳第六十二:p22",
    "annotator": "集解",
    "text": "漢書音義曰：「長短術興於六國時。行長入短，其語隱謬，用相激怒。」"
  },
