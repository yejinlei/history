    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p3",
    "annotator": "索隱",
    "text": "地理志京兆有湖縣，本名胡，武帝更名湖，即今湖城縣也。"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a11",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p3",
    "annotator": "正義",
    "text": "今虢州湖城縣也。"
  },
  {
