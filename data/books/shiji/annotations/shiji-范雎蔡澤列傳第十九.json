    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "索隱",
    "text": "劉氏云：「入猶充也。謂招攜離散，充滿城邑也。」"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a108",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "索隱",
    "text": "信音申。詘音屈。謂志已展而不退。"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a109",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "集解",
    "text": "班固弈指曰：「博縣於投，不必在行。」駰謂投，投瓊也。"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a110",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "索隱",
    "text": "言夫博弈，或欲大投其瓊以致勝，或欲分功者，謂觀其勢弱，則投地而分功以遠救也，事具小爾雅也。按：方言云「所以投博謂之枰」。音平，局也。"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a111",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "正義",
    "text": "施猶展也，言伐得三川之地。以實宜陽，言展開三川，實宜陽。"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a112",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p31",
    "annotator": "集解",
    "text": "徐廣曰：「白起。」"
  },
  {
    "id": "anno:shiji:shiji-范雎蔡澤列傳第十九:a113",
    "book": "shiji",
    "chapter_id": "shiji-范雎蔡澤列傳第十九",
    "target_para_id": "text:shiji:shiji-范雎蔡澤列傳第十九:p34",
    "annotator": "索隱",
    "text": "二子，范雎、蔡澤也。雎厄於魏齊，折脅摺齒；澤困於趙，被逐弃鬲是也。惡音烏，激音擊也。"
  }
