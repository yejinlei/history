[
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a0",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p0",
    "annotator": "索隱",
    "text": "翟音狄，俗又音宅。地理志縣名，屬潁川。按：戰國策以不韋爲濮陽人，又記其事跡亦多，與此傳不同。班固雖云太史公採戰國策，然爲此傳當別有所聞見，故不全依彼說。或者劉向定戰國策時，以己異聞改彼書，遂令不與史記合也。賈音古。鄭玄注周禮云「行曰商，處曰賈」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a1",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p0",
    "annotator": "正義",
    "text": "陽翟，今河南府縣。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a2",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p0",
    "annotator": "集解",
    "text": "徐廣曰：「一本云『陽翟大賈也，往來賤買貴賣』也。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a3",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p0",
    "annotator": "索隱",
    "text": "王劭賣作鬻，音育。案育賣義同，今如字讀。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a4",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p1",
    "annotator": "索隱",
    "text": "名柱，後立，是爲孝文王也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a5",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p1",
    "annotator": "索隱",
    "text": "即莊襄王也。戰國策曰本名異人，後從趙還，不韋使以楚服見，王后悅之，曰「吾楚人也而子字之」，乃變其名曰子楚也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a6",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p1",
    "annotator": "索隱",
    "text": "質舊音致，今讀依此。穀梁傳曰「交質不及二伯」。左傳曰「信不由中，質無益也」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a7",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "索隱",
    "text": "韓王信傳亦曰「韓信，襄王孽孫」。張晏曰「孺子曰孽子」。何休注公羊「孽，賤子也。以非嫡正，故曰孽」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a8",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "索隱",
    "text": "按：下文云「以五百金爲進用」，宜依小顏讀爲「賮」，音才刃反。進者，財也，古字假借之也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a9",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "集解",
    "text": "以子楚方財貨也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a10",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "正義",
    "text": "戰國策云：「濮陽人呂不韋賈邯鄲，見秦質子異人，謂其父曰：『耕田之利幾倍？』曰：『十倍。』『珠玉之贏幾倍？』曰：『百倍。』『立主定國之贏幾倍？』曰：『無數。』不韋曰：『今力田疾作，不得煖衣飽食；今定國立君，澤可遺後世，願往事之。』秦子異人質於趙，處於聊城，故往說之。乃說秦王后弟陽泉君曰：『君之罪至死，君知之乎？君門下無不居高官尊位，太子門下無貴者，而駿馬盈外廄，美女充後庭。王之春秋高矣，一日山陵崩，太子用事，君危於累卵，而不壽於朝生。今有計可以使君富千萬，寧於太山，必無危亡之患矣。』陽泉曰：『請聞其說。』不韋曰：『王年高矣，王后無子。子傒有承國之業，士倉又輔之。王一日山陵崩，子傒立，士倉用事，王后之門必生蓬蒿。子楚異人，賢材也，弃在於趙，無母，引領西望，欲一得歸。王后誠請而立之，是異人無國有國，王后無子有子。』陽泉曰：『諾。』入說王后，爲請於趙而歸之。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a11",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "索隱",
    "text": "謂旣解不韋所言之意，遂與密謀深語也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a12",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "正義",
    "text": "適音嫡。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a13",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "正義",
    "text": "言子楚無望得爲太子。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a14",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p2",
    "annotator": "索隱",
    "text": "幾音冀。幾，望也。左傳曰「日月以幾」。戰國策曰「子傒承國之業」。高誘注云「子傒，秦太子異人之異母兄弟也」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a15",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p3",
    "annotator": "索隱",
    "text": "戰國策作「說秦王后弟陽泉君」也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a16",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p3",
    "annotator": "索隱",
    "text": "以此爲一句。子謂養之爲子也。然欲分「立以爲適」作上句，而「子之夫在則尊重」作下句，意亦通。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a17",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p3",
    "annotator": "索隱",
    "text": "閒音閑。從音七恭反。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a18",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p4",
    "annotator": "索隱",
    "text": "言其姿容絕美而又善舞也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a19",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p4",
    "annotator": "索隱",
    "text": "釣者，以取魚喻也。奇即上云「此奇貨可居」也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a20",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p4",
    "annotator": "集解",
    "text": "徐廣曰：「期，十二月也。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a21",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p4",
    "annotator": "索隱",
    "text": "譙周云「人十月生，此過二月，故云『大期』」，蓋當然也。旣云自匿有娠，則生政固當踰常期也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a22",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p6",
    "annotator": "索隱",
    "text": "劉氏本作「所生母」，「生」衍字。今檢諸本並無「生」字也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a23",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p6",
    "annotator": "索隱",
    "text": "下文「尊爲相國」。案：百官表曰「皆秦官，金印紫綬，掌承天子助理萬機。秦置左右，高帝置一，後又更名相國，哀帝時更名大司徒」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a24",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p6",
    "annotator": "索隱",
    "text": "戰國策曰「食藍田十二縣」。而秦本紀莊襄王元年初置三川郡，地理志高祖更名河南。此秦代而曰「河南」者，史記後作，據漢郡而言之耳。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a25",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p7",
    "annotator": "集解",
    "text": "徐廣曰：「時年十三。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a26",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p7",
    "annotator": "正義",
    "text": "仲，中也，次父也。蓋效齊桓公以管仲爲仲父。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a27",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p8",
    "annotator": "正義",
    "text": "年表云秦昭王五十六年，平原君卒；始皇四年，信陵君死；始皇九年，李園殺春申君。孟嘗君當秦昭王二十四年已後而卒，最早。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a28",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p8",
    "annotator": "索隱",
    "text": "王劭云「孟嘗、春申死已久」。據表及傳，孟嘗、平原死稍在前。信陵將五國兵攻秦河外，正當在莊襄王時，不韋已爲相。又春申與不韋並時，各相向十餘年，不得言死之久矣。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a29",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p8",
    "annotator": "索隱",
    "text": "八覽者，有始、孝行、慎大、先識、審分、審應、離俗、時君也。六論者，開春、慎行、貴直、不苟、以順、士容也。十二紀者，記十二月也，其書有孟春等紀。二十餘萬言，二十六卷也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a30",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p8",
    "annotator": "索隱",
    "text": "地理志右扶風渭城縣，故咸陽，高帝更名新城，景帝更名渭城。案：咸訓皆，其地在渭水之北，北阪之南，水北曰陽，山南亦曰陽，皆在二者之陽也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a31",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p9",
    "annotator": "正義",
    "text": "以桐木爲小車輪。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a32",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p9",
    "annotator": "正義",
    "text": "腐音輔，謂宮刑胥靡也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a33",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p9",
    "annotator": "正義",
    "text": "雍故城在岐雍縣南七里，有秦都大鄭宮。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a34",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "正義",
    "text": "秦孝文王陵在雍州萬年縣東北二十五里。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a35",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "索隱",
    "text": "芷音止。地理志京兆霸陵縣故芷陽。案：在長安東也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a36",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "正義",
    "text": "秦莊襄陵在雍州新豐縣西南三十五里。始皇在北，故俗亦謂之「見子陵」。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a37",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "索隱",
    "text": "杜原之東也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a38",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "正義",
    "text": "夏太后陵在萬年縣東南二十五里。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a39",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p10",
    "annotator": "索隱",
    "text": "宣帝元康元年起杜陵。漢舊儀武、昭、宣三陵皆三萬戶，計去此一百六十餘年也。"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a40",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p11",
    "annotator": "集解",
    "text": "說苑曰：「毐與侍中左右貴臣博弈飲酒，醉，爭言而鬬，瞋目大叱曰：『吾乃皇帝假父也，寠人子何敢乃與我亢！』所與鬬者走，行白始皇。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a41",
    "book": "shiji",
    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p11",
    "annotator": "索隱",
    "text": "劉氏寠音其矩反。今俗本多作「屢」字，蓋相承錯耳，不近詞義。今按：說苑作「寠子」，言輕諸侍中，以爲窮寠家之子也。"
  },
