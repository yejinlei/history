    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p14",
    "annotator": "集解",
    "text": "徐廣曰：「一作『芷陽』。」"
  },
  {
    "id": "anno:shiji:shiji-呂不韋列傳第二十五:a48",
