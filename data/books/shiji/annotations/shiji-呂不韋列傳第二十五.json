    "chapter_id": "shiji-呂不韋列傳第二十五",
    "target_para_id": "text:shiji:shiji-呂不韋列傳第二十五:p12",
    "annotator": "集解",
    "text": "徐廣曰：「入南宮。」"
  },
  {
