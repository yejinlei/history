[
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a0",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "集解",
    "text": "孟康曰：「信交道曰任。」如淳曰：「相與信爲任，同是非爲俠。所謂『權行州里，力折公侯』者也。」或曰任，氣力也；俠，俜也。"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a1",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "索隱",
    "text": "任，而禁反。俠音協。如淳曰「相與爲任，同是非爲俠，權行州里，力折公侯者」，其說爲近。俜音普丁反，其義難喻。"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a2",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "集解",
    "text": "如淳曰：「窘，困也。」"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a3",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "集解",
    "text": "服虔曰：「東郡謂廣轍車爲『柳』。」鄧展曰：「皆棺飾也。載以喪車，欲人不知也。」李奇曰：「大牛車也。車上覆爲柳。」瓚曰：「茂陵書中有廣柳車，每縣數百乘，是今運轉大車是也。」"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a4",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "索隱",
    "text": "案服虔、臣瓚所據，云東郡謂廣轍車爲廣柳車，及茂陵書稱每縣廣柳車數百乘，則凡大車任載運者，通名廣柳車，然則柳爲車通名。鄧展所說「柳皆棺飾，載以喪車，欲人不知也」，事義相協，最爲通允。故禮曰「設柳翣，爲使人勿惡也」。鄭玄注周禮云「柳，聚也，諸飾所聚也」。則是喪車稱柳，後人通謂車爲柳也。"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a5",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "集解",
    "text": "徐廣曰：「馬車也。」"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a6",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p0",
    "annotator": "索隱",
    "text": "案謂輕車，一馬車也。"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a7",
    "book": "shiji",
    "chapter_id": "shiji-季布欒布列傳第四十",
    "target_para_id": "text:shiji:shiji-季布欒布列傳第四十:p2",
    "annotator": "索隱",
    "text": "使音如字。近音其靳反。因酒縱性謂之使酒，即酗酒也。"
  },
  {
    "id": "anno:shiji:shiji-季布欒布列傳第四十:a8",
