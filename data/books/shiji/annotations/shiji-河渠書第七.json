[
  {
    "id": "anno:shiji:shiji-河渠書第七:a0",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "索隱",
    "text": "抑音憶。抑者，遏也。洪水滔天，故禹遏之，不令害人也。漢書溝洫志作「堙」。堙，抑，皆塞也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a1",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "集解",
    "text": "徐廣曰：「橋，近遙反。一作『檋』。檋，直轅車也，音己足反。尸子曰『山行乘樏』。音力追反。又曰『行塗以楯，行險以撮，行沙以軌』。又曰『乘風車』。音去喬反。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a2",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "索隱",
    "text": "毳字亦作「橇」，同音昌芮反。注以撮，子芮反，又子絕反，與蕝音同。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a3",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "顏師古云：「通九州之道，及障遏其澤也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a4",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "度，田洛反。釋名云「山者，產也」。治水以志九州山澤所生物產，言於地所宜，商而度之，以制貢賦也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a5",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "在同州韓城縣北五十里，爲鑿廣八十步。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a6",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "華陰縣也。魏之陰晉，秦惠文王更名寧秦，漢高帝改曰華陰也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a7",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "厎柱山俗名三門山，在硤石縣東北五十里，在河之中也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a8",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "在洛州河陽縣南門外也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a9",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "孔安國云：「山再成曰邳。」按：在衞州黎陽縣南七里是也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a10",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "集解",
    "text": "韋昭曰：「湍，疾；悍，強也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a11",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "集解",
    "text": "漢書音義曰：「厮，分也。二渠，其一出貝丘西南二折者也，其一則漯川。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a12",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "索隱",
    "text": "厮，漢書作「灑」，史記舊本亦作「灑」，字從水。按：韋昭云「疏決爲釃」，字音疏跬反。厮，即分其流泄其怒是也。又按：二渠，其一即漯川，其二王莽時遂空也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a13",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "降水源出潞州屯留縣西南方山東北。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a14",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "大陸澤在邢州及趙州界，一名廣河澤，一名鉅鹿澤也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a15",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "正義",
    "text": "言過降水及大陸水之口，至冀州分爲九河。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a16",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p0",
    "annotator": "集解",
    "text": "瓚曰：「禹貢云『夾石碣石入于海』，然則河口之入海乃在碣石也。武帝元光二年，河徙東郡，更注勃海。禹之時不注勃海也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a17",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "索隱",
    "text": "楚漢中分之界，文穎云即今官渡水也。蓋爲二渠：一南經陽武，爲官渡水；一東經大梁城，即鴻溝，今之汴河是也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a18",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "集解",
    "text": "韋昭曰：「五湖，湖名耳，實一湖，今太湖是也，在吳西南。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a19",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "索隱",
    "text": "三江，按地理志北江從會稽毗陵縣北東入海，中江從丹陽蕪湖縣東北至會稽陽羨縣東入海，南江從會稽吳縣南東入海，故禹貢有北江、中江也。五湖者，郭璞江賦云具區、洮滆，彭蠡、青草、洞庭是也。又云太湖周五百里，故曰五湖。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a20",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "集解",
    "text": "漢書曰：「冰姓李。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a21",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "集解",
    "text": "晉灼曰：「古『堆』字也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a22",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "索隱",
    "text": "辟音避。沫音末。按：說文云「沫水出蜀西南徼外，與青衣合，東南入江」也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a23",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p1",
    "annotator": "正義",
    "text": "括地志云：「大江一名汶江，一名管橋水，一名清江，亦名水江，西南自溫江縣界流來。」又云：「郫江一名成都江，一名市橋江，亦名中日江，亦曰內江，西北自新繁縣界流來。二江並在益州成都縣界。任豫益州記云『二江者，郫江、流江也』。風俗通云『秦昭王使李冰爲蜀守，開成都縣兩江，溉田萬頃。神須取女二人以爲婦，冰自以女與神爲婚，徑至祠勸神酒，酒杯澹澹，因厲聲責之，因忽不見。良久，有兩蒼牛鬬於江岸，有閒，輙還，流汗謂官屬曰：「吾鬬疲極，不當相助耶？南向腰中正白者，我綬也。」主簿刺殺北面者，江神遂死』。華陽國志云『蜀時濯錦流江中，則鮮明也』。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a24",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p2",
    "annotator": "正義",
    "text": "括地志云：「漳水一名濁漳水，源出潞州長子縣西力黃山。地理志云濁漳水在長子鹿谷山，東至鄴，入清漳。」按：力黃、鹿谷二山，北鹿也。鄴，相州之縣也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a25",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "集解",
    "text": "如淳曰：「欲罷勞之，息秦伐韓之計。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a26",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "集解",
    "text": "韋昭曰：「鄭國能治水，故曰水工。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a27",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "索隱",
    "text": "小顏云「中音仲，即今九嵕山之東仲山是也。邸，至也」。瓠口即谷口，乃郊祀志所謂「寒門谷口」是也。與池陽相近，故曰「田於何所，池陽谷口」也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a28",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "正義",
    "text": "括地志云：「中山一名仲山，在雍州雲陽縣西十五里。又云焦穫藪，亦名瓠，在涇陽北城外也。」邸，至也。至渠首起雲陽縣西南二十五里，今枯也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a29",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "集解",
    "text": "徐廣曰：「出馮翊懷德縣。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a30",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "索隱",
    "text": "溝洫志鄭國云「臣爲韓延數歲之命，爲秦建萬代之功」是也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a31",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p3",
    "annotator": "索隱",
    "text": "溉音古代反。澤，一作「舄」，音昔，又並音尺。本或作「斥」，則如字讀之。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a32",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p4",
    "annotator": "正義",
    "text": "括地志云：「金隄一名千里隄，在白馬縣東五里。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a33",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p5",
    "annotator": "正義",
    "text": "括地志云：「鄲州鉅野縣東北大澤是。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a34",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p5",
    "annotator": "索隱",
    "text": "音輸。韋昭云「清河縣也」。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a35",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p5",
    "annotator": "正義",
    "text": "貝州縣也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a36",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p6",
    "annotator": "索隱",
    "text": "舊說，徐伯表水工姓名也。小顏以爲表者，廵行穿渠之處而表記之，若今竪標，表不是名也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a37",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p6",
    "annotator": "集解",
    "text": "徐廣曰：「一云『悉衆』。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a38",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "索隱",
    "text": "上音婆，又音潘。按：詩小雅云「番維司徒」，番，氏也。下音系也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a39",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "索隱",
    "text": "按：謂從山東運漕而西入關也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a40",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "正義",
    "text": "括地志云：「汾水源出嵐州靜樂縣北百三十里管涔山北，東南流，入并州，即西南流，入至絳州、蒲州入河也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a41",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "正義",
    "text": "括地志云：「皮氏故城在絳州龍門縣西百三十步。自秦、漢、魏、晉，皮氏縣皆治此。汾陰故城俗名殷湯城，在蒲汾陰縣北九里，漢汾陰縣是也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a42",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "集解",
    "text": "韋昭曰：「壖音而緣反。謂緣河邊地也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a43",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "索隱",
    "text": "又音人兗反。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a44",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "索隱",
    "text": "茭，乾草也。謂人收茭及牧畜於中也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a45",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "集解",
    "text": "如淳曰：「時越人有徙者，以田與之，其租稅入少府。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a46",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p7",
    "annotator": "索隱",
    "text": "其田旣薄，越人徙居者習水利，故與之，而稍少其稅，入之于少府。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a47",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "集解",
    "text": "韋昭曰：「裦中縣也。斜，谷名，音邪。」瓚曰：「裦，斜，二水名。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a48",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "正義",
    "text": "括地志云：「裦谷在梁州襃城縣北五十里。斜水源出裦城縣西北九十八里衙嶺山，與裦水同源而派流，漢書溝洫志云『裦水通沔，斜水通渭，皆以行船』是也。」按：裦城即裦中縣也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a49",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "正義",
    "text": "括地志云：「鳳州兩當縣，本漢故道縣也，在州西五十里。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a50",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "正義",
    "text": "南陽縣即今鄧州也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a51",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "正義",
    "text": "限，之言多也。山東，謂河南之東，山南之東及江南、淮南，皆經砥柱，主運，今並從沔，便於三門之漕也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a52",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p8",
    "annotator": "集解",
    "text": "徐廣曰：「湍，一本作『溲』。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a53",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "正義",
    "text": "括地志云：「同州本臨晉城也。一名大荔城，亦曰馮翊城。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a54",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "正義",
    "text": "洛，漆沮水也。括地志云：「重泉故城在同州蒲城縣東南四十五里，在同州西北亦四十五里。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a55",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "集解",
    "text": "應劭曰：「徵在馮翊。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a56",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "索隱",
    "text": "音懲，縣名也。小顏云即今之澄城也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a57",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "集解",
    "text": "服虔曰：「顏音崖。或曰商顏，山名也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a58",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "索隱",
    "text": "顏音崖，又如字。商顏，山名也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a59",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "集解",
    "text": "如淳曰：「洛水岸。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a60",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "正義",
    "text": "言商原之崖岸，土性疏，故善崩毀也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a61",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "集解",
    "text": "瓚曰：「下流曰穨。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a62",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p9",
    "annotator": "正義",
    "text": "括地志云：「伏龍祠在同州馮翊縣西北四十里。故老云漢時自徵穿渠引洛，得龍骨，其後立祠，因以伏龍爲名。今祠頗有靈驗也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a63",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p10",
    "annotator": "正義",
    "text": "括地志云：「萬里沙在華州鄭縣東北二十里也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a64",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p10",
    "annotator": "集解",
    "text": "晉灼曰：「衞之苑也。多竹篠。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a65",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p10",
    "annotator": "集解",
    "text": "如淳曰：「樹竹塞水決之口，稍稍布插接樹之，水稍弱，補令密，謂之楗。以草塞其裏，乃以土填之；有石，以石爲之。音建。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a66",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p10",
    "annotator": "索隱",
    "text": "楗音其免反。楗者，樹於水中，稍下竹及土石也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a67",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "如淳曰：「殫，盡也。」駰謂州閭盡爲河。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a68",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "徐廣曰：「東郡東阿有魚山，或者是乎？」駰按：如淳曰「恐水漸山使平也」。韋昭曰「鑿山以填河也」。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a69",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "如淳曰：「瓠子決，灌鉅野澤使溢也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a70",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "徐廣曰：「柏猶迫也，冬日行天邊，若與水相連矣。」駰按：漢書音義曰「鉅野滿溢，則衆魚沸鬱而滋長也。迫冬日乃止。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a71",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "徐廣曰：「延，一作『正』。」駰按：晉灼曰「言河道皆弛壞也」。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a72",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "索隱",
    "text": "言河之決，由其源道延長弛溢，故使其道皆離常流。故晉灼云「言河道皆弛壞」。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a73",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "瓚曰：「水還舊道，則羣害消除，神祐滂沛。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a74",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "張晏曰：「齧桑，地名也。」如淳曰：「邑名，爲水所浮漂。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a75",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "如淳曰：「搴，取也。茭，草也，音郊。一曰茭，芋也。取長芋樹之，用著石間，以塞決河。」瓚曰：「竹葦絙謂之茭，下所以引致土石者也。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a76",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "索隱",
    "text": "搴音己免反。茭一作「茇」，音廢，鄒氏又音紼也。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a77",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "如淳曰：「旱燒，故薪不足。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a78",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p11",
    "annotator": "集解",
    "text": "如淳曰：「河決，楗不能禁，故言菑。」韋昭曰：「楗，柱也。木立死曰菑。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a79",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p12",
    "annotator": "集解",
    "text": "如淳曰：「地理志盩厔有靈軹渠。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a80",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p12",
    "annotator": "索隱",
    "text": "按：溝洫志兒寬爲左內史，奏請穿六輔渠。小顏云「今尚謂之輔渠，亦曰六渠也」。"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a81",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p12",
    "annotator": "集解",
    "text": "徐廣曰：「一作『諸川』。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a82",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p12",
    "annotator": "集解",
    "text": "瓚曰：「鉅定，澤名。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a83",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p13",
    "annotator": "集解",
    "text": "徐廣曰：「一作『濕』。」"
  },
  {
    "id": "anno:shiji:shiji-河渠書第七:a84",
    "book": "shiji",
    "chapter_id": "shiji-河渠書第七",
    "target_para_id": "text:shiji:shiji-河渠書第七:p13",
    "annotator": "集解",
    "text": "徐廣曰：「溝洫志行田二百畝，分賦田與一夫二百畝，以田惡，故更歲耕之。」"
  }
]