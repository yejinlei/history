[
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a0",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "正義",
    "text": "漢書云：「大宛國去長安萬二千五百五十里，東至都護治，西南至大月氏，南亦至大月氏，北至康居。」括地志云：「率都沙郍國亦名蘇對沙郍國，本漢大宛國。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a1",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "音菀，又於袁反。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a2",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "陳壽益部耆舊傳云：「騫，漢中成固人。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a3",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "正義",
    "text": "氏音支。涼、甘、肅、瓜、沙等州，本月氏國之地。漢書云「本居敦煌、祈連閒」是也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a4",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "集解",
    "text": "韋昭曰：「飲器，椑榼也。單于以月氏王頭爲飲器。」晉灼曰：「飲器，虎子之屬也。或曰飲酒器也。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a5",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "椑音白迷反。榼音苦盍反。案：謂今之偏榼也。　義曰漢書匈奴傳云：「元帝遣車騎都尉韓昌、光祿大夫張猛與匈奴盟，以老上單于所破月氏王頭爲飲器者，共飲血盟。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a6",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "更，經也。音羹。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a7",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「堂邑氏，姓；胡奴甘父，字。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a8",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "案謂堂邑縣人家胡奴名甘父也。下云「堂邑父」者，蓋後史家從省，唯稱「堂邑父」而略「甘」字。甘，或其姓號。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a9",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p1",
    "annotator": "索隱",
    "text": "謂道經匈奴也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a10",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "索隱",
    "text": "謂大宛發遣騫西也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a11",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "索隱",
    "text": "爲發道驛抵康居。發道，謂發驛令人導引而至康居也。導音道。抵，至也。居音渠也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a12",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "正義",
    "text": "抵，至也。居，其居反。括地志云：「康居國在京西一萬六百里。其西北可二千里有奄蔡，酒國也。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a13",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "正義",
    "text": "此大月氏在大宛西南，於媯水北爲王庭。漢書云去長安萬一千六百里。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a14",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一云『夫人爲王』，夷狄亦或女主。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a15",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "索隱",
    "text": "案漢書張騫傳云「立其夫人爲王」也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a16",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "索隱",
    "text": "旣臣大夏而君之。謂月氏以大夏爲臣，而爲之作君也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a17",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "正義",
    "text": "旣，盡也。大夏國在媯水南。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a18",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "集解",
    "text": "漢書音義曰：「要領，要契。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a19",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p2",
    "annotator": "索隱",
    "text": "小顏以爲衣有要領。劉氏云「不得其要害」，然頗是其意，於文字爲疏者也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a20",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p3",
    "annotator": "正義",
    "text": "並，白浪反。南山即連終南山，從京南東至華山過河，東北連延至海，即中條山也。從京南連接至蔥嶺萬餘里，故云「並南山」也。西域傳云「其南山東出金城，與漢南山屬焉」。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a21",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p3",
    "annotator": "正義",
    "text": "說文云：「羌，西方牧羊人也。南方蠻閩從虫，北方狄從犬，東方貊從豸，西方羌從羊。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a22",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p3",
    "annotator": "集解",
    "text": "徐廣曰：「元朔三年。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a23",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p3",
    "annotator": "索隱",
    "text": "堂邑父之官號。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a24",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "索隱",
    "text": "案外國傳云「外國稱天下有三衆：中國人衆，大秦寶衆，月氏馬衆」。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a25",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "集解",
    "text": "漢書音義曰：「大宛國有高山，其上有馬，不可得，因取五色母馬置其下，與交，生駒汗血，因號曰天馬子。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a26",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "集解",
    "text": "徐廣曰：「漢紀曰拘彌國去于窴三百里。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a27",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "索隱",
    "text": "扜冞，國名也，音汙彌。窴音田，又音殿。漢紀謂荀悅所譔漢紀。拘音俱，彌即冞也，則拘彌與扜冞是一也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a28",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "索隱",
    "text": "鹽水也。太康地記云「河北得水爲河，塞外得水爲海」也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a29",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "正義",
    "text": "漢書云：「鹽澤去玉門、陽關三百餘里，廣袤三四百里。其水皆潛行地下，南出於積石山爲中國河。」括地志云：「蒲昌海一名泑澤，一名鹽澤，亦名輔日海，亦名穿蘭，亦名臨海，在沙州西南。玉門關在沙州壽昌縣西六里。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a30",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "索隱",
    "text": "案漢書西域傳云「河有兩源，一出蔥嶺，一出于窴」。山海經云「河出崑崙東北隅」。郭璞云「河出崑崙，潛行地下，至蔥嶺山于窴國，復分流岐出，合而東注泑澤，已而復行積石，爲中國河」。泑澤即鹽澤也，一名蒲昌海。西域傳云「一出于闐南山下」，與郭璞注山海經不同。廣志云「蒲昌海在蒲類海東」也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a31",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p6",
    "annotator": "正義",
    "text": "二國名。姑師即車師也。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a32",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p7",
    "annotator": "集解",
    "text": "徐廣曰：「不土著。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a33",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p9",
    "annotator": "正義",
    "text": "漢書解詁云：「奄蔡即闔蘇也。」魏略云：「西與大秦通，東南與康居接。其國多貂，畜牧水草，故時羈屬康居也。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a34",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p10",
    "annotator": "正義",
    "text": "萬震南州志云：「在天竺北可七千里，地高燥而遠。國王稱『天子』，國中騎乘常數十萬匹，城郭宮殿與大秦國同。人民赤白色，便習弓馬。土地所出，及奇瑋珍物，被服鮮好，天竺不及也。」康泰外國傳云：「外國稱天下有三衆：中國爲人衆，秦爲寶衆，月氏爲馬衆也。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a35",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p10",
    "annotator": "正義",
    "text": "初月氏居敦煌以東，祁連山以西。敦煌郡今沙州。祁連山在甘州西南。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a36",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p11",
    "annotator": "正義",
    "text": "地理志云：「安息國京西萬一千二百里。自西關西行三千四百里至阿蠻國，西行三千六百里至斯賔國，從斯賔南行度河，又西南行至于羅國九百六十里，安息西界極矣。自此南乘海乃通大秦國。」漢書云：「北康居，東烏弋山離，西條枝。國臨媯水。土著。以銀爲錢，如其王面，王死輙更錢，效王面焉。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a37",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p11",
    "annotator": "索隱",
    "text": "漢書云：「文獨爲王面，幕爲夫人面。」荀悅云：「幕音漫，無文面也。」張晏云：「錢之文面作人乘馬，錢之幕作人面形。」韋昭曰：「幕，錢背也，音漫。」包愷音慢。"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a38",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p11",
    "annotator": "集解",
    "text": "漢書音義曰：「橫行爲書記。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a39",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p11",
    "annotator": "索隱",
    "text": "畫音獲。小顏云：「革，皮之不柔者。」韋昭云：「外夷書皆旁行，今扶南猶中國，直下也。」"
  },
  {
    "id": "anno:shiji:shiji-大宛列傳第六十三:a40",
    "book": "shiji",
    "chapter_id": "shiji-大宛列傳第六十三",
    "target_para_id": "text:shiji:shiji-大宛列傳第六十三:p11",
    "annotator": "正義",
    "text": "上力奚反。下巨言反，又巨連反。後漢書云：「大秦一名犁鞬，在西海之西，東西南北各數千里。有城四百餘所。土多金銀奇寶，有夜光璧、明月珠、駭雞犀、火浣布、珊瑚、琥珀、琉璃、瑯玕、朱丹、青碧，珍怪之物，率出大秦。」康氏外國傳云：「其國城郭皆青水精爲礎，及五色水精爲壁。人民多巧，能化銀爲金。國土市買皆金銀錢。」萬震南州志云：「大家屋舍，以珊瑚爲柱，琉璃爲牆壁，水精爲礎舄。海中斯調洲上有木，冬月往剝取其皮，績以爲布，極細，手巾齊數匹，與麻焦布無異，色小青黑，若垢污欲浣之，則入火中，便更精潔，世謂之火浣布。秦云定重參問門樹皮也。」括地志云：「火山國在扶風南東大湖海中。其國中山皆火，然火中有白鼠皮及樹皮，績爲火浣布。魏略云大秦在安息、條支西大海之西，故俗謂之海西。從安息界乘船直載海西，遇風利時三月到，風遲或一二歲。其公私宮室爲重屋，郵驛亭置如中國。從安息繞海北陸到其國，人民相屬，十里一亭，三十里一置。無盜賊。其俗人長大平正，似中國人而胡服。宋膺異物志云秦之北附庸小邑，有羊羔自然生於土中，候其欲萌，築牆繞之，恐獸所食。其臍與地連，割絕則死。擊物驚之，乃驚鳴，臍遂絕，則逐水草爲羣。又大秦金二枚，皆大如瓜，植之滋息無極，觀之如用則真金也。」括地志云：「小人國在大秦南，人纔三尺。其耕稼之時，懼鶴所食，大秦衞助之。即焦僥國，其人穴居也。」"
  },
