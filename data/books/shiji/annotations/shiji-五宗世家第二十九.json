[
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a0",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p1",
    "annotator": "索隱",
    "text": "閼音遏。漢書無「于」字。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a1",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p1",
    "annotator": "索隱",
    "text": "姁音況羽反。兒姁，夫人名也。王皇后之妹也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a2",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p2",
    "annotator": "索隱",
    "text": "漢書云「大行令奏：溢法曰聦明睿智曰獻」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a3",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p2",
    "annotator": "集解",
    "text": "漢名臣奏：「杜業奏曰『河閒獻王經術通明，積德累行，天下雄俊衆儒皆歸之。孝武帝時，獻王朝，被服造次必於仁義。問以五策，獻王輙對無窮。孝武帝艴然難之，謂獻王曰：「湯以七十里，文王百里，王其勉之。」王知其意，歸即縱酒聽樂，因以終』。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a4",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p2",
    "annotator": "索隱",
    "text": "注「問以五策」。按：漢書詔策問三十餘事。「被服造次」。按：小顏云「被服，言常居處其中也；造次，謂所向所行皆法於儒者」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a5",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p2",
    "annotator": "索隱",
    "text": "漢書云授謚頃，音傾也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a6",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p4",
    "annotator": "索隱",
    "text": "服虔云「宮外之餘地」。顧野王云「牆外行馬內田」。音人椽反，又音軟，又音奴亂反。壖垣，牆外之短垣也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a7",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p4",
    "annotator": "索隱",
    "text": "按：祖者行神，行而祭之，故曰祖也。風俗通云「共工氏之子曰修，好遠遊，故祀爲祖神」。又崔浩云「黃帝之子累祖，好遠遊而死於道，因以爲行神」，亦不知其何據。蓋見其謂之祖，因以爲累祖，非也。據帝系及本紀皆言累祖黃帝妃，無爲行神之由也。又聘禮云「出祖釋軷，祭酒脯」而已。按：今祭禮，以軷壤土爲壇於道，則用黃羝或用狗，以其血釁左輪也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a8",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p4",
    "annotator": "正義",
    "text": "荊州圖副云：「漢臨江閔王榮始都江陵城，坐侵廟壖地爲宮，被徵，出城北門而車軸折。父老共流涕曰：『吾王不反矣！』旣而爲郅都所訊，懼而縊死。自此後北門存而不啟，蓋爲榮不以道終也。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a9",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p4",
    "annotator": "正義",
    "text": "顏師古云：「榮實最長，而傳居二王後者，以其從太子廢後乃爲王也。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a10",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p6",
    "annotator": "正義",
    "text": "晚節猶言末年時。嗇，貪恡也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a11",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p7",
    "annotator": "索隱",
    "text": "按：謚法「好更故舊曰易」也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a12",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p7",
    "annotator": "集解",
    "text": "蘇林曰：「淖音泥淖。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a13",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p7",
    "annotator": "索隱",
    "text": "鄭氏音卓，蘇林音「泥淖」之「淖」，女教反。淖，姓也，齊有淖齒是。又漢書云「建召易王所愛淖姬等十人，與姦服舍中」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a14",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p7",
    "annotator": "正義",
    "text": "淖，女孝反。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a15",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p7",
    "annotator": "索隱",
    "text": "漢書云建女弟徵臣爲蓋侯子婦，以易王喪來歸，建復與姦也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a16",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p8",
    "annotator": "索隱",
    "text": "按：廣周書謚法云「能優其德曰于」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a17",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p8",
    "annotator": "正義",
    "text": "委危反。不能御婦人。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a18",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p8",
    "annotator": "集解",
    "text": "蘇林曰：「爲無所訾錄，無所省錄。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a19",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p8",
    "annotator": "正義",
    "text": "顏師古云：「訾，財也。省，視也。言不能視錄資財。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a20",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p8",
    "annotator": "索隱",
    "text": "謂不置宿衞人。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a21",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p9",
    "annotator": "索隱",
    "text": "究者，窮也。故郭璞云「究謂窮盡也」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a22",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "謂刻害深，無仁恩也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a23",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "謂詭誑之辯，以中傷於人。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a24",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "謂彭祖自爲二千石埽除其舍，以迎之也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a25",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "集解",
    "text": "韋昭曰：「平會兩家買賣之賈也。榷者，禁他家，獨王家得爲之。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a26",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "榷音角。獨音榷，謂酤榷也。會音儈，古外反。謂爲賈人專榷買賣之賈，儈以取利，若今之和市矣。韋昭則訓榷爲平，其注解爲得。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a27",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "經者，常也。謂王家入多於國家常納之租稅也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a28",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "集解",
    "text": "服虔曰：「求福也。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a29",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "按：埤蒼云「禨，祅祥也」。列子云「荊人鬼，越人禨」。謂楚信鬼神而越信禨祥也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a30",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p11",
    "annotator": "索隱",
    "text": "上下孟反，下工弔反。徼是郊外之路，謂廵徼而伺察境界。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a31",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p12",
    "annotator": "正義",
    "text": "樂，五教反。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a32",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p12",
    "annotator": "索隱",
    "text": "按：漢書建元三年，濟川、中山王等來朝，聞樂而泣。天子問其故，王對以大臣內讒，肺腑日疏，其言甚雄壯，詞切而理文。天子加親親之好。可謂漢之英藩矣。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a33",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p12",
    "annotator": "索隱",
    "text": "漢書昆侈謚康王，子頃王輔嗣，至孫國除也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a34",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p14",
    "annotator": "索隱",
    "text": "姚氏按：釋名云「天子諸侯羣妾以次進御，有月事者止不御，更不口說，故以丹注面目旳旳爲識，令女史見之」。王察神女賦以爲「脫袿裳，免簪笄，施玄旳，結羽釵」。旳即釋名所云也。說文云「姅，女污也」。漢津云「見姅變，不得侍祠」。姅音半。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a35",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p14",
    "annotator": "集解",
    "text": "應劭曰：「景帝後二年，諸王來朝，有詔更前稱壽歌舞。定王但張袖小舉手。左右笑其拙，上怪問之，對曰：『臣國小地狹，不足迴旋。』帝以武陵、零陵、桂陽屬焉。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a36",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p14",
    "annotator": "集解",
    "text": "服虔曰：「鮈音拘。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a37",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p16",
    "annotator": "索隱",
    "text": "漢書齊謚繆王。謚法「傷人蔽賢曰繆」。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a38",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p16",
    "annotator": "索隱",
    "text": "按：漢書「又告中尉蔡彭祖」。子去嗣，坐暴虐勃亂，國除也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a39",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p16",
    "annotator": "正義",
    "text": "所忠，姓名。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a40",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "集解",
    "text": "應劭曰：「樓車，所以窺看敵國營壘之虛實也。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a41",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "索隱",
    "text": "左傳云「登樓車以窺宋人」，謂看敵國營壘之虛實也。李廵注爾雅「金鏃，以金爲箭鏑」。鏃，字林音子木反。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a42",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "集解",
    "text": "如淳曰：「窮治其辭，出此事。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a43",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "集解",
    "text": "徐廣曰：「其母武帝母妹。」"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a44",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "正義",
    "text": "寄母王夫人即王皇后之妹，於上爲從母，故寄於諸兄弟最爲親愛也。"
  },
  {
    "id": "anno:shiji:shiji-五宗世家第二十九:a45",
    "book": "shiji",
    "chapter_id": "shiji-五宗世家第二十九",
    "target_para_id": "text:shiji:shiji-五宗世家第二十九:p17",
    "annotator": "集解",
    "text": "徐廣曰：「他本亦作『慶』字，惟一本作『建』。不宜得與叔父同名，相承之誤。」"
