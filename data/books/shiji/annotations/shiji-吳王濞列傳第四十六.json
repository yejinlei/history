    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "徐廣曰：「吳芮之玄孫靖王著，以文帝七年卒，無嗣，國除。」駰案：如淳曰「吳芮後四世無子，國除。庶子二人爲列侯，不得嗣王，志將不滿，故誘與之反也」。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a44",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「故，事也。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a45",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "按專以僇辱諸侯爲事。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a46",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "詿音挂。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a47",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "音值。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a48",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "索隱",
    "text": "謂其境相接也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a49",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "如淳曰：「南越直長沙者，因王子定也。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a50",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "索隱",
    "text": "案謂南越之地與長沙地相接。值者，因長沙王子以定長沙以北也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a51",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "走音奏，向也。王子，長沙王子也。南越之地對長沙之南者，其民因王子卒而鎮定長沙以北，西向蜀及漢中，咸委王子定矣。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a52",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "如淳曰：「告東越使定之。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a53",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "越，東越也。又告東越、楚、淮南三王，與吳王共西面擊之。三王謂淮南、衡山、廬江也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a54",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "今蒲津關。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a55",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "索隱",
    "text": "摶音專。專謂專統領胡兵也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a56",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "正義",
    "text": "今名隴山關，在原州平涼縣界。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a57",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p8",
    "annotator": "集解",
    "text": "服虔曰：「封賜倍漢之常法。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a58",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p10",
    "annotator": "索隱",
    "text": "適音直革反，又音宅。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a59",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p10",
    "annotator": "正義",
    "text": "令盎爲太常，以示奉宗廟之指意。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a60",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p10",
    "annotator": "集解",
    "text": "徐廣曰：「名通，其父名廣。」駰案：漢書曰「吳王弟子德侯廣爲宗正」也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a61",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p10",
    "annotator": "正義",
    "text": "以親戚之意輔漢訓諭。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a62",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p11",
    "annotator": "正義",
    "text": "上音乘，下竹戀反。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a63",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p11",
    "annotator": "正義",
    "text": "言不自意洛陽得全，及見劇孟。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a64",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p11",
    "annotator": "正義",
    "text": "輕正反。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a65",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p11",
    "annotator": "正義",
    "text": "在曹州城武縣東北四十二里也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a66",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p12",
    "annotator": "集解",
    "text": "蘇林曰：「祿伯儻將兵降漢，自爲利己，於吳爲生患也。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a67",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p14",
    "annotator": "正義",
    "text": "地理志云城陽國，故齊，漢文帝二年別爲國，屬兗州。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a68",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p15",
    "annotator": "集解",
    "text": "如淳曰：「幣，錢也。以私錢淆亂天下錢也。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a69",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p15",
    "annotator": "集解",
    "text": "如淳曰：「鹵，抄掠也。宗廟在郡縣之物，皆爲御物。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a70",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p15",
    "annotator": "正義",
    "text": "顏師古曰：「御物，宗廟之服器也。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a71",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p15",
    "annotator": "正義",
    "text": "置，放釋也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a72",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "正義",
    "text": "在宋州寧陵縣西南七十里。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a73",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "集解",
    "text": "徐廣曰：「楚相張尚諫王而死。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a74",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "正義",
    "text": "按羽，尚弟也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a75",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "集解",
    "text": "徐廣曰：「屬梁國。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a76",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "正義",
    "text": "宋州碭山縣，本漢下邑縣。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a77",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "正義",
    "text": "東越傳云：「獨東甌受漢之購，殺吳王。」丹徒，潤州也。東甌即東越也。東越將兵從吳在丹徒也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a78",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "集解",
    "text": "韋昭曰：「啗音徒覽反。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a79",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "集解",
    "text": "孟康曰：「方言『戟謂之鏦』。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a80",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "索隱",
    "text": "鏦音七江反。謂以戈刺殺之。鄒氏又音舂。亦音「從容」之「從」，謂撞殺之也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a81",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "正義",
    "text": "括地志云：「漢吳王濞冢在潤州丹徒縣東練壁聚北，今入于江。吳錄云丹徒有吳王冢，在縣北，其處名爲相唐。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a82",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "集解",
    "text": "吳地記曰：「吳王濞葬武進縣南，地名相唐。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a83",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p16",
    "annotator": "索隱",
    "text": "張勃云「吳王濞葬丹徒縣南，其地名相唐」。今注本云「武進縣」，恐錯也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a84",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p17",
    "annotator": "集解",
    "text": "徐廣曰：「姓韓。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a85",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p17",
    "annotator": "集解",
    "text": "徐廣曰：「一云『自殺』。」"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a86",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p19",
    "annotator": "集解",
    "text": "言濞之王吳，由父代王被省封郃陽侯。省音所幸反。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a87",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p19",
    "annotator": "索隱",
    "text": "省音所景反。省者，減也。謂父仲從代王省封郃陽侯也。"
  },
  {
    "id": "anno:shiji:shiji-吳王濞列傳第四十六:a88",
    "book": "shiji",
    "chapter_id": "shiji-吳王濞列傳第四十六",
    "target_para_id": "text:shiji:shiji-吳王濞列傳第四十六:p19",
    "annotator": "索隱",
    "text": "謂與太子爭博爲爭技也。"
  }
]