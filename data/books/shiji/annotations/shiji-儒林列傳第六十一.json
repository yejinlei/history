    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p1",
    "annotator": "索隱",
    "text": "案謂學者課功著之於令，即今學令是也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a1",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p1",
    "annotator": "正義",
    "text": "鄭玄云：「魯哀公十一年。是時道衰樂廢，孔子還，修正之，故雅頌各得其所也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a2",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p1",
    "annotator": "索隱",
    "text": "後之記者失辭也。案家語等說，云孔子歷聘諸國，莫能用，謂周、鄭、齊、宋、曹、衞、陳、楚、杞、莒、匡等。縱歷小國，亦無七十餘君也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a3",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p1",
    "annotator": "集解",
    "text": "徐廣曰：「錄，一作『繆』。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a4",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "索隱",
    "text": "案子夏爲魏文侯師。子貢爲齊、魯聘吳、越，蓋亦卿也。而宰予亦仕齊爲卿。餘未聞也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a5",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "注",
    "text": "案仲尼弟子列傳子路死於衞，時孔子尚存也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a6",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "正義",
    "text": "今陳州。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a7",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "正義",
    "text": "今蘇州城南五里有澹臺湖，湖北有澹臺。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a8",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "正義",
    "text": "今汾州。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a9",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p2",
    "annotator": "正義",
    "text": "今青州。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a10",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p3",
    "annotator": "正義",
    "text": "顏云：「今新豐縣溫湯之處號愍儒鄉。溫湯西南三里有馬谷，谷之西岸有阬，古相傳以爲秦阬儒處也。衞宏詔定古文尚書序云『秦旣焚書，恐天下不從所改更法，而諸生到者拜爲郎，前後七百人，乃密種瓜於驪山陵谷中溫處，瓜實成，詔博士諸生說之。人言不同，乃令就視。爲伏機，諸生賢儒皆至焉，方相難不決，因發機，從上填之以土，皆壓，終乃無聲』也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a11",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p3",
    "annotator": "集解",
    "text": "徐廣曰：「孔子八世孫，名鮒字甲也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a12",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p3",
    "annotator": "索隱",
    "text": "適音丁革反。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a13",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p4",
    "annotator": "正義",
    "text": "顏云：「陳豨、盧綰、韓信、黥布之徒相次反叛，征討也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a14",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p4",
    "annotator": "正義",
    "text": "言孝文稍用文學之士居位。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a15",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "集解",
    "text": "徐廣曰：「一作『陪』。」韋昭曰：「培，申公名，音扶尤反。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a16",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "索隱",
    "text": "鄒氏音普來反也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a17",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "正義",
    "text": "申，轅，姓；培，固，名；公，生，其處號也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a18",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "索隱",
    "text": "韓嬰也。爲常山王太傅也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a19",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "索隱",
    "text": "按張華云名勝，漢紀云字子賤。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a20",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "索隱",
    "text": "謝承云「秦氏季代有魯人高堂伯」，則「伯」是其字。云「生」者，自漢已來儒者皆號「生」，亦「先生」省字呼之耳。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a21",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "索隱",
    "text": "毋音無。胡毋，姓。字子都。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a22",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p5",
    "annotator": "集解",
    "text": "徐廣曰：「一云『自齊爲天子三公』。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a23",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "正義",
    "text": "自此以下，皆弘奏請之辭。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a24",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "集解",
    "text": "漢書百官表孔臧也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a25",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "正義",
    "text": "校，教也。可教道蓺也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a26",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "正義",
    "text": "序，舒也。言舒禮教。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a27",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "正義",
    "text": "庠，詳也。言詳審經典。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a28",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "索隱",
    "text": "上時兩反。屬音燭。屬，委也。所二千石，謂於所部之郡守相。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a29",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "索隱",
    "text": "計，計吏也。偕，俱也。謂令與計吏俱詣太常也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a30",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "索隱",
    "text": "謂詔書文章雅正，訓辭深厚也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a31",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「一云『次治禮學掌故』。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a32",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "正義",
    "text": "案：左右內史後改爲左馮翊、右扶風。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a33",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p6",
    "annotator": "索隱",
    "text": "如淳云：「漢儀弟子射策，甲科百人補郎中，乙科二百人補太子舍人，皆秩比二百石；次郡國文學，秩百石也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a34",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "索隱",
    "text": "按漢書云「申公少與楚元王俱事齊人浮丘伯，受詩」。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a35",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "正義",
    "text": "括地志云：「泮宮在兗州曲阜縣西南二百里魯城內宮之內。鄭云泮之言半也，其制半於天子之璧雍。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a36",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "索隱",
    "text": "案漢書云「呂太后時，浮丘伯在長安，申公與元王郢客俱卒學」也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a37",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "集解",
    "text": "徐廣曰：「楚元王劉交以文帝元年薨，子夷王郢立，四歲薨，子戊立。郢以呂后二年封上邽侯，文帝元年立爲楚王。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a38",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "集解",
    "text": "徐廣曰：「腐刑。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a39",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "集解",
    "text": "徐廣曰：「魯恭王也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a40",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p7",
    "annotator": "索隱",
    "text": "謂申公不作詩傳，但教授，有疑則闕耳。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a41",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p8",
    "annotator": "集解",
    "text": "徐廣曰：「馬車。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a42",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p9",
    "annotator": "集解",
    "text": "徐廣曰：「孔鮒之弟子襄爲惠帝博士，遷爲長沙太傅，生忠，忠生武及安國。安國爲博士，臨淮太守。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a43",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p9",
    "annotator": "索隱",
    "text": "繆音亡救反。繆氏出蘭陵。一音穆。所謂穆生，爲楚元王所禮也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a44",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p9",
    "annotator": "集解",
    "text": "漢書音義曰：「姓闕門，名慶忌。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a45",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p10",
    "annotator": "正義",
    "text": "論衡云：「氣熱而毒盛，故食馬肝殺人。又盛夏馬行多渴死，殺氣爲毒也。」"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a46",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p11",
    "annotator": "索隱",
    "text": "此家人言耳。服虔云：「如家人言也。」案：老子道德篇近而觀之，理國理身而已，故言此家人之言也。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a47",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
    "target_para_id": "text:shiji:shiji-儒林列傳第六十一:p11",
    "annotator": "集解",
    "text": "徐廣曰：「司空，主刑徒之官也。」駰案：漢書音義曰「道家以儒法爲急，比之於律令」。"
  },
  {
    "id": "anno:shiji:shiji-儒林列傳第六十一:a48",
    "book": "shiji",
    "chapter_id": "shiji-儒林列傳第六十一",
