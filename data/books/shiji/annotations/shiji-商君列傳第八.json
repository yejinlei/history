[
  {
    "id": "anno:shiji:shiji-商君列傳第八:a0",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "正義",
    "text": "秦封於商，故號商君。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a1",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "索隱",
    "text": "公叔，氏；座，名也。座音在戈反。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a2",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "索隱",
    "text": "官名也。魏已置之，非自秦也。周禮夏官謂之「諸子」，禮記文王世子謂之「庶子」，掌公族也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a3",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "索隱",
    "text": "即魏侯之子，名罃，後徙大梁而稱梁也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a4",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "索隱",
    "text": "戰國策云衞庶子也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a5",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "索隱",
    "text": "疾重而悖亂也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a6",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p0",
    "annotator": "正義",
    "text": "悖音背。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a7",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p1",
    "annotator": "索隱",
    "text": "景姓，楚之族也。監音去聲平聲並通。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a8",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p1",
    "annotator": "正義",
    "text": "比，必寐反。說者以五帝三王之事比至孝公，以三代帝王之道方興。孝公曰「太久遠，吾不能」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a9",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p1",
    "annotator": "索隱",
    "text": "音稅"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a10",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p1",
    "annotator": "索隱",
    "text": "音悅。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a11",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "商君書「非」作「負」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a12",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "商君書作「必見驁於人」也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a13",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "正義",
    "text": "敖，五到反。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a14",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "言救弊爲政之術，所爲苟可以彊國，則不必要須法於故事也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a15",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "孝公之臣，甘姓，龍名也。甘氏出春秋時甘昭公王子帶後。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a16",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "言賢智之人作法更禮，而愚不肖者不明變通，而輙拘制不使之行，斯亦信然矣。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a17",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "商君書作「脩古」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a18",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p2",
    "annotator": "索隱",
    "text": "指殷紂、夏桀也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a19",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "劉氏云：「五家爲保，十保相連。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a20",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "正義",
    "text": "或爲十保，或爲五保。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a21",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "收司謂相糾發也。一家有罪而九家連舉發，若不糾舉，則十家連坐。恐變令不行，故設重禁。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a22",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "案：謂告姦一人則得爵一級，故云「與斬敵首同賞」也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a23",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "案律，降敵者誅其身，沒其家，今匿姦者，言當與之同罰也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a24",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "正義",
    "text": "民有二男不別爲活者，一人出兩課。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a25",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "集解",
    "text": "音律。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a26",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "末謂工商也。蓋農桑爲本，故上云「本業耕織」也。怠者，懈也。周禮謂之「疲民」。以言懈怠不事事之人而貧者，則糾舉而收錄其妻子，沒爲官奴婢，蓋其法特重於古也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a27",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "謂宗室若無軍功，則不得入屬籍。謂除其籍，則雖無功不及爵秩也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a28",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p3",
    "annotator": "索隱",
    "text": "謂各隨其家爵秩之班次，亦不使僭侈踰等也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a29",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p5",
    "annotator": "索隱",
    "text": "謂鞅新變之法令爲「初令」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a30",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p5",
    "annotator": "索隱",
    "text": "趨音七踰反。趨者，向也，附也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a31",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "索隱",
    "text": "即大上造也，秦之第十六爵名也。今云「良造」者，或後變其名耳。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a32",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "索隱",
    "text": "冀闕即魏闕也。冀，記也。出列教令，當記於此門闕。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a33",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "正義",
    "text": "南北曰阡，東西曰陌。按：謂驛塍也。疆音疆。封，聚土也；疆，界也：謂界上封記也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a34",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "集解",
    "text": "鄭玄曰：「音勇，今之斛也。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a35",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "索隱",
    "text": "音統，量器名。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a36",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p6",
    "annotator": "正義",
    "text": "音左故反。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a37",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "索隱",
    "text": "蓋即安邑之東，山領險阨之地，即今蒲州之中條已東，連汾、晉之嶮嶝也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a38",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "索隱",
    "text": "紀年曰：「梁惠王二十九年，秦衞鞅伐梁西鄙」，則徙大梁在惠王之二十九年也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a39",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "正義",
    "text": "從蒲州安邑徙汴州浚儀也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a40",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「弘農商縣也。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a41",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "索隱",
    "text": "於、商，二縣名，在弘農。紀年云秦封鞅在惠王三十年，與此文合。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a42",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p7",
    "annotator": "正義",
    "text": "於、商在鄧州內鄉縣東七里，古於邑也。商洛縣在商州東八十九里，本商邑，周之商國。案：十五邑近此三邑。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a43",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "戰國策云孝公行商君法十八年而死，與此文不同者，案此直云相秦十年耳，而戰國策乃云行商君法十八年，蓋連其未作相之年耳。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a44",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "孟蘭臯，人姓名也。言鞅前因蘭臯得與趙良相見也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a45",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "說音悅。與音予。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a46",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "謂守謙敬之人是爲自勝，若是者乃爲強。若爭名得勝，此非強之道。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a47",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "正義",
    "text": "以殷紂比商君。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a48",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "正義",
    "text": "百里奚，南陽宛人。屬楚，故云荊。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a49",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "謂立晉惠公、懷公、文公也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a50",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "十二諸侯年表，穆公二十八年會晉，救楚，朝周是也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a51",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "集解",
    "text": "韋昭曰：「款，叩也。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a52",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "正義",
    "text": "音躰。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a53",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "集解",
    "text": "鄭玄曰：「相謂送杵聲，以聲音自勸也。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a54",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "劉氏云：「教謂商鞅之令也，命謂秦君之命也。言人畏鞅甚於秦君。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a55",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "上謂鞅之處分。今謂秦君之令。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a56",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "左建謂以左道建立威權也。外易謂在外革易君命也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a57",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "注",
    "text": "所及反。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a58",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "集解",
    "text": "徐廣曰：「一作『尞』。屈盧之勁矛，干將之雄戟。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a59",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "闟，亦作「鈒」，同所及反。鄒誕音吐臈反。尞音遼。屈音九勿反。按：屈盧、干將並古良匠造矛戟者名。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a60",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "正義",
    "text": "顧野王云：「鋋也。」方言云：「矛，吳、揚、江、淮、南楚、五湖之閒謂之鋋。其柄謂之矜。」釋名云：「戟，格也。旁有格。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a61",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "此是周書之言，孔子所刪之餘。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a62",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "衞鞅所封商於二縣以爲國，其中凡有十五都，故趙良勸令歸之。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a63",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "正義",
    "text": "公孫鞅封商於十五邑，故云「十五都」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a64",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p8",
    "annotator": "索隱",
    "text": "謂鞅於秦無仁恩，故秦國之所以將收錄鞅者其效甚明，故云「豈其微哉」。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a65",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "索隱",
    "text": "走音奏。走，向也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a66",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「京兆鄭縣也。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a67",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "索隱",
    "text": "地理志京兆有鄭縣。秦本紀云「初縣杜、鄭」，按其地是鄭桓公友之所封。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a68",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「黽，或作『彭』。」"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a69",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "索隱",
    "text": "鄭黽池者，時黽池屬鄭故也。而徐廣云「黽或作彭」者，按鹽鐵論云「商君困於彭池」故也。黽音亡忍反。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a70",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p9",
    "annotator": "正義",
    "text": "黽池去鄭三百里，蓋秦兵至鄭破商邑兵，而商君東走至黽，乃擒殺之。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a71",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p10",
    "annotator": "索隱",
    "text": "謂天資其人爲刻薄之行。刻謂用刑深刻；薄謂弃仁義，不悃誠也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a72",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p10",
    "annotator": "索隱",
    "text": "說音如字。浮說即虛說也。謂鞅得用，刑政深刻，又欺魏將，是其天資自有狙詐，則初爲孝公論帝王之術，是浮說耳，非本性也。"
  },
  {
    "id": "anno:shiji:shiji-商君列傳第八:a73",
    "book": "shiji",
    "chapter_id": "shiji-商君列傳第八",
    "target_para_id": "text:shiji:shiji-商君列傳第八:p10",
    "annotator": "索隱",
    "text": "按商君書，開謂刑嚴峻則政化開，塞謂布恩賞則政化塞，其意本於嚴刑少恩。又爲田開阡陌，及言斬敵首賜爵，是耕戰書也。"
  }
]