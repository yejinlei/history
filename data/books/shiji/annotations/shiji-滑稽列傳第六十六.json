[
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a0",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p1",
    "annotator": "正義",
    "text": "言六蓺之文雖異，禮節樂和，導民立政，天下平定，其歸一揆。至於談言微中，亦以解其紛亂，故治一也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a1",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p3",
    "annotator": "索隱",
    "text": "髠音苦魂反。贅婿，女之夫也，比於子，如人疣贅，是餘剩之物也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a2",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p3",
    "annotator": "索隱",
    "text": "喜音許旣反。喜，好也。喜隱謂好隱語。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a3",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "索隱",
    "text": "案索訓盡，言冠纓盡絕也。孔衍春秋後語亦作「冠纓盡絕」也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a4",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "索隱",
    "text": "案謂爲田求福禳。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a5",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "集解",
    "text": "徐廣曰：「篝，籠也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a6",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "索隱",
    "text": "案甌窶猶杯樓也。窶音如婁，古字少耳。言豐年收掇易，可滿篝籠耳。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a7",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "正義",
    "text": "窶音樓。篝音溝，籠也。甌樓謂高地狹小之區，得滿篝籠也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a8",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "集解",
    "text": "司馬彪曰：「汙邪，下地田也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a9",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "索隱",
    "text": "即下田之中有薪，可滿車。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a10",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p4",
    "annotator": "正義",
    "text": "汙音烏。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a11",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "集解",
    "text": "徐廣曰：「帣，收衣褏也。褏，衿也。韝，臂捍也，音溝。鞠，曲也。𦜕音其紀反，又與『跽』同，謂小詭也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a12",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "索隱",
    "text": "帣音卷，紀免反，謂收袖也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a13",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "集解",
    "text": "徐廣曰：「眙，吐甑反，直視貌。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a14",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "索隱",
    "text": "眙音與「瞪」同，謂直視也，丑甑反，又音丑二反。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a15",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "索隱",
    "text": "案上云「五六斗徑醉矣」，則此爲樂亦甚，飲可八斗而未徑醉，故云「竊樂」。二參，言十有二參醉也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a16",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "集解",
    "text": "徐廣曰：「一本云『留髡坐，起送客』。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a17",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p5",
    "annotator": "正義",
    "text": "今鴻臚卿也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a18",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "案優者，倡優也。孟，字也。其優旃亦同，旃其字耳。優孟在楚，旃在秦者也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a19",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "集解",
    "text": "蘇林曰：「以木累棺外，木頭皆內向，故曰題湊。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a20",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "正義",
    "text": "楩，頻綿反。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a21",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "集解",
    "text": "楚莊王時，未有趙、韓、魏三國。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a22",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "案此辨說者之詞，後人所增飾之矣。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a23",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "皇覽亦說此事，以「壟竈」爲「礱突」也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a24",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "歷即釜鬲也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a25",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "古者食肉用薑棗，禮內則云「實棗於其腹中，屑桂與薑，以洒諸其上而食之」是也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a26",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p7",
    "annotator": "索隱",
    "text": "皇覽云：「火送之箸端，葬之腸中。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a27",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p8",
    "annotator": "索隱",
    "text": "案謂優孟語孫叔敖之子曰「汝無遠有所之，適他境，恐王後求汝不得」者也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a28",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p8",
    "annotator": "集解",
    "text": "戰國策曰：「蘇秦說趙王華屋之下，抵掌而言。」張載曰：「談說之容則也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a29",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p8",
    "annotator": "集解",
    "text": "徐廣曰：「在固始。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a30",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p8",
    "annotator": "正義",
    "text": "今光州固始縣，本寢丘邑也。呂氏春秋云：「楚孫叔敖有功於國，疾將死，戒其子曰：『王數欲封我，我辭不受。我死，必封汝。汝無受利地，荊楚閒有寢丘者，其爲地不利，而前有妒谷，後有戾丘，其名惡，可長有也。』其子從之。楚功臣封二世而收，唯寢丘不奪也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a31",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p10",
    "annotator": "正義",
    "text": "御覽反。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a32",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p11",
    "annotator": "正義",
    "text": "今岐州雍縣及陳倉縣也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a33",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p15",
    "annotator": "索隱",
    "text": "案東武，縣名；侯，乳母姓。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a34",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p15",
    "annotator": "正義",
    "text": "高祖功臣表云東武侯郭家，高祖六年封。子他，孝景六年弃市，國除。蓋他母常養武帝。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a35",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p15",
    "annotator": "索隱",
    "text": "謂武帝罰謫譖乳母之人也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a36",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p16",
    "annotator": "索隱",
    "text": "仲長統云遷爲滑稽傳，序優旃事，不稱東方朔，非也。朔之行事，豈直旃、孟之比哉。而桓譚亦以遷爲是，又非也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a37",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p16",
    "annotator": "正義",
    "text": "漢書云：「平原厭次人也。」輿地志云：「厭次，宜是富平縣之鄉聚名也。」括地志云：「富平故城在倉州陽信縣東南四十里，漢縣也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a38",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p16",
    "annotator": "索隱",
    "text": "按東方朔亦多博觀外家之語，則外家非正經，即史傳雜說之書也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a39",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p16",
    "annotator": "正義",
    "text": "百官表云衞尉屬官有公車司馬。漢儀注云：「公車司馬掌殿司馬門，夜徼宮，天下上事及闕下，凡所徵召皆總領之。秩六百石。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a40",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p16",
    "annotator": "索隱",
    "text": "司馬彪云：「謂無水而沈也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a41",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p17",
    "annotator": "索隱",
    "text": "案謂朔設詞對之，即下文是答對之難也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a42",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p18",
    "annotator": "正義",
    "text": "在長安縣西北二十里故城中。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a43",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p18",
    "annotator": "索隱",
    "text": "重音逐龍反，櫟音歷。重櫟，欄楯之下有重欄處也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a44",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p18",
    "annotator": "索隱",
    "text": "騶音鄒。此方朔以意自立名而偶中也。以有九牙齊等，故謂之騶牙，猶騶騎然也。"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a45",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
    "target_para_id": "text:shiji:shiji-滑稽列傳第六十六:p20",
    "annotator": "集解",
    "text": "徐廣曰：「衞青傳曰子夫之弟也。」"
  },
  {
    "id": "anno:shiji:shiji-滑稽列傳第六十六:a46",
    "book": "shiji",
    "chapter_id": "shiji-滑稽列傳第六十六",
