[
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a0",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p0",
    "annotator": "索隱",
    "text": "沫音亡葛反。左傳、穀梁並作「曹劌」，然則沫宜音劌，沫劌聲相近而字異耳。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a1",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p0",
    "annotator": "索隱",
    "text": "左傳「齊人滅遂」，杜預云「遂國在濟北蛇丘縣東北也」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a2",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p0",
    "annotator": "正義",
    "text": "故城在兗州龔丘縣西北七十六里也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a3",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p1",
    "annotator": "索隱",
    "text": "杜預云：「濟北東阿，齊之柯邑，猶祝柯今爲祝阿也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a4",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p1",
    "annotator": "索隱",
    "text": "匕音比。劉氏云「短劔也」。鹽鐵論以爲長尺八寸，其頭類匕，故云「匕首」也。此事約公羊爲說，然彼無其名，直云「曹子」而已。且左傳魯莊十年，戰于長勺，用曹劌謀敗齊，而無劫桓公之事。十三年盟于柯，公羊始論曹子。穀梁此年惟云「曹劌之盟，信齊侯也」，又記不具行事之時。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a5",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p1",
    "annotator": "索隱",
    "text": "公羊傳曰：「管子進曰：『君何求？』」何休注云：「桓公卒不能應，管仲進爲言之也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a6",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p1",
    "annotator": "索隱",
    "text": "齊魯鄰接，今齊數侵魯，魯之城壞，即壓近齊之境也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a7",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p1",
    "annotator": "索隱",
    "text": "倍音佩也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a8",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p3",
    "annotator": "索隱",
    "text": "「專」字亦作「剸」，音同。左傳作「鱄設諸」。地理志臨淮有堂邑縣也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a9",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p3",
    "annotator": "索隱",
    "text": "言其將有內難弒君之志，且對外事生文。吳世家曰「知光有他志」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a10",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p4",
    "annotator": "索隱",
    "text": "祭音側界反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a11",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p4",
    "annotator": "索隱",
    "text": "亡葛反。公羊作「餘末」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a12",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p5",
    "annotator": "索隱",
    "text": "春秋昭二十六年「楚子居卒」是也。吳世家云「十二年」，此云「九年」，並誤。據表乃左傳合在僚之十一年也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a13",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p5",
    "annotator": "索隱",
    "text": "屬音燭。二子，僚之弟也。左傳作掩餘、屬庸。掩蓋義同，屬燭字相亂耳。事在魯昭二十七年。地理志廬江有灊縣，天柱山在南。音潛。杜預左傳注云「灊，楚邑，在廬江六縣西南也」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a14",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p5",
    "annotator": "正義",
    "text": "灊故城在壽州霍山縣東二百步。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a15",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p5",
    "annotator": "索隱",
    "text": "左傳直云「王可殺也，母老子弱，是無若我何」。則是專設諸度僚可殺，言其少援救，故云「無奈我何」。太史公採其意，且據上文，因復加以兩弟將兵外困之辭。而服虔、杜預見左氏下文云「我爾身也」，「以其子爲卿」，遂彊解「是無如我何」猶言「我無若是，謂專諸欲以老弱託光」，義非允愜。王肅之說，亦依史記也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a16",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "集解",
    "text": "徐廣曰：「窟，一作『空』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a17",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "索隱",
    "text": "僚之十二年夏也，吳系家以爲十三年，非也。左氏經傳唯言「夏四月」，公羊、穀梁無其文，此與吳系家皆稱「丙子」，當有所據，不知出何書。左傳云「伏甲於窟室」，杜預謂掘地爲室也，所以下文云「出其伏甲以攻王」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a18",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "集解",
    "text": "音披。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a19",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "索隱",
    "text": "兵器也。劉逵吳都賦注「鈹，兩刃小刀」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a20",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "索隱",
    "text": "詳音陽，爲如字。左傳曰「光偽足疾」，此之詳即偽也。或讀「爲」音偽，非也。豈詳偽重言耶？"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a21",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "集解",
    "text": "徐廣曰：「炙，一作『炮』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a22",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "正義",
    "text": "炙，者夜反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a23",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p6",
    "annotator": "索隱",
    "text": "刺音七賜反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a24",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p7",
    "annotator": "集解",
    "text": "徐廣曰：「闔閭元年至三晉滅智伯六十二年。豫讓一作『襄』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a25",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "案此傳所說，皆約戰國策文。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a26",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "案左傳范氏謂昭子吉射也。自士會食邑於范，後因以邑爲氏。中行氏，中行文子荀寅也。自荀林父將中行後，因以官爲氏。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a27",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "案智伯，襄子荀瑤也。襄子，林父弟荀首之後。范、中行、智伯事已具趙系家。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a28",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "謂初則醉以酒，後又率韓、魏水灌晉陽，城不沒者三板，故怨深也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a29",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "案大宛傳曰「匈奴破月氐王，以其頭爲飲器」。裴氏注彼引韋昭云「飲器，椑榼也」。晉灼曰「飲器，虎子也」。皆非。椑榼所以盛酒耳，非用飲者。晉氏以爲褻器者，以韓子、呂氏春秋並云襄子漆智伯頭爲溲杅，故云。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a30",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "正義",
    "text": "劉云：「酒器也，每賔會設之，示恨深也。」按：諸先儒說恐非。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a31",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p8",
    "annotator": "索隱",
    "text": "卒音足律反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a32",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "集解",
    "text": "音賴。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a33",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "索隱",
    "text": "賴，惡瘡病也。凡漆有毒，近之多患瘡腫，若賴病然，故豫讓以漆塗身，令其若癩耳。然厲賴聲相近，古多假「厲」爲「賴」，今之「癩」字從「疒」，故楚有賴鄉，亦作「厲」字，戰國策說此亦作「厲」字。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a34",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "索隱",
    "text": "啞音烏雅反。謂瘖病。戰國策云：「漆身爲厲，滅鬚去眉，以變其容，爲乞食人。其妻曰：『狀貌不似吾夫，何其音之甚相類也？』讓遂吞炭以變其音也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a35",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "索隱",
    "text": "欲謂因得殺襄子。顧，反也。耶，不定之辭。反不易耶，言其易也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a36",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "索隱",
    "text": "劉氏云：「謂今爲癘啞也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a37",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p9",
    "annotator": "索隱",
    "text": "言寧爲厲而自刑，不可求事襄子而行殺，則恐傷人臣之義而近賊，非忠也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a38",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p10",
    "annotator": "正義",
    "text": "汾橋下架水，在并州晉陽縣東一里。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a39",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p10",
    "annotator": "索隱",
    "text": "戰國策曰：「衣盡出血。襄子迴車，車輪未周而亡。」此不言衣出血者，太史公恐涉怪妄，故略之耳。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a40",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p11",
    "annotator": "集解",
    "text": "自三晉滅智伯至殺俠累，五十七年。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a41",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p12",
    "annotator": "索隱",
    "text": "地理志河內有軹縣。深井，軹縣之里名也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a42",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p12",
    "annotator": "正義",
    "text": "在懷州濟源縣南三十里。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a43",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "高誘曰：「嚴遂，字仲子。」案表聶政殺俠累在列侯三年。列侯生文侯，文侯生哀侯，凡更三代，哀侯六年爲韓嚴所殺。今言仲子事哀侯，恐非其實。且太史公聞疑傳疑，事難旳據，欲使兩存，故表、傳各異。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a44",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "俠音古挾反，累音力追反。案戰國策俠累名傀也。韓傀相韓，嚴遂重於君，二人相害也。嚴遂舉韓傀之過，韓傀叱之於朝，嚴遂拔劔趨之，以救解。是有郤之由也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a45",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "集解",
    "text": "徐廣曰：「一作『賜』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a46",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "案戰國策作「觴」，近爲得也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a47",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "正義",
    "text": "數，色吏反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a48",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "集解",
    "text": "此芮反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a49",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "鄒氏音脆，二義相通也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a50",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "正義",
    "text": "糲猶麤米也，脫粟也。韋昭云：「古者名男子爲丈夫，尊婦嫗爲夫人。漢書宣元六王傳『王過夫人益誦，爲夫人乞骸去』。按夫人，憲王外祖母。古詩云『三日斷五疋，夫人故言遲』是也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a51",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "言其心志與身本應高絜，今乃卑下其志，屈辱其身。論語孔子謂「柳下惠降志辱身」是也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a52",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p13",
    "annotator": "索隱",
    "text": "禮記云：「父母存，不許友以死。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a53",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p14",
    "annotator": "正義",
    "text": "古者相聚汲水，有物便賣，因成市，故云「市井」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a54",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p14",
    "annotator": "索隱",
    "text": "高誘曰：「韓都潁川陽翟，衞都東郡濮陽，故曰『閒不遠』也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a55",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p14",
    "annotator": "索隱",
    "text": "戰國策作「無生情」，言所將人多，或生異情，故語泄。此云「生得」，言將多人往殺俠累後，又被生擒而事泄，亦兩俱通也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a56",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p14",
    "annotator": "集解",
    "text": "徐廣曰：「一作『難』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a57",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p14",
    "annotator": "索隱",
    "text": "戰國策譙周亦同。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a58",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p15",
    "annotator": "集解",
    "text": "徐廣曰：「韓烈侯三年三月，盜殺韓相俠累。俠累名傀。戰國策曰『有東孟之會』，又云『聶政刺韓傀，兼中哀侯』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a59",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p15",
    "annotator": "索隱",
    "text": "戰國策曰：「政直入，上階刺韓傀，傀走而抱哀侯，聶政刺之，兼中哀侯。」高誘曰：「東孟，地名也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a60",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p15",
    "annotator": "索隱",
    "text": "皮面謂以刀割其面皮，欲令人不識。決眼謂出其眼睛。戰國策作「抉眼」，此「決」亦通，音烏穴反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a61",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p16",
    "annotator": "正義",
    "text": "暴，蒲酷反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a62",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "集解",
    "text": "一作「嫈」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a63",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "索隱",
    "text": "榮，其姊名也。戰國策無「榮」字。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a64",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "索隱",
    "text": "劉氏云：「煩冤愁苦。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a65",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "索隱",
    "text": "爾雅云「恙，憂也」。楚詞云「還及君之無恙」。風俗通云「恙，病也。凡人相見及通書，皆云『無恙』。」又易傳云，上古之時，草居露宿。恙，齧蟲也，善食人心，俗悉患之，故相勞云「無恙」。恙非病也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a66",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "索隱",
    "text": "案察謂觀察有志行乃舉之。劉氏云察猶選也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a67",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "集解",
    "text": "徐廣曰：「恐其姊從坐而死。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a68",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "索隱",
    "text": "重音持用反。重猶復也。爲人報讎死，乃以妾故復自刑其身，令人不識也。從音蹤，古字少，假借無旁「足」，而徐氏以爲從坐，非也。劉氏亦音足松反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a69",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p17",
    "annotator": "正義",
    "text": "重，直龍反。自刑作「刊」。說文云「刊，剟也」。按：重猶愛惜也。本爲嚴仲子報仇訖，愛惜其事，不令漏泄，以絕其蹤跡。其姊妄云爲己隱，誤矣。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a70",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p18",
    "annotator": "索隱",
    "text": "濡，潤也。人性溼潤則能含忍，故云「濡忍」也。若勇躁則必輕死也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a71",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p18",
    "annotator": "索隱",
    "text": "重難並如字。重猶惜也，言不惜暴骸之爲難也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a72",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p19",
    "annotator": "集解",
    "text": "徐廣曰：「聶政至荊軻百七十年爾。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a73",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p19",
    "annotator": "索隱",
    "text": "徐氏據六國年表而言，則謂此傳率略而言二百餘年，亦當時爲不能細也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a74",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p19",
    "annotator": "正義",
    "text": "按年表從始皇二十三年至韓景侯三百七十年，若至哀侯六年，六百四十三年也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a75",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p20",
    "annotator": "索隱",
    "text": "按贊論稱「公孫季功、董生爲余道之」，則此傳雖約戰國策而亦別記異聞。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a76",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p20",
    "annotator": "索隱",
    "text": "軻先齊人，齊有慶氏，則或本姓慶。春秋慶封，其後改姓賀。此下亦至衞而改姓荊。荊慶聲相近，故隨在國而異其號耳。卿者，時人尊重之號，猶如相尊美亦稱「子」然也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a77",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p21",
    "annotator": "集解",
    "text": "呂氏劔技曰：「持短入長，倏忽從橫。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a78",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p21",
    "annotator": "正義",
    "text": "懷州河內縣。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a79",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p22",
    "annotator": "正義",
    "text": "并州縣也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a80",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p22",
    "annotator": "索隱",
    "text": "蓋音古臘反。蓋，姓；聶，名。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a81",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p22",
    "annotator": "索隱",
    "text": "攝猶整也。謂不稱己意，因怒視以攝整之也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a82",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p22",
    "annotator": "正義",
    "text": "攝猶視也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a83",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p23",
    "annotator": "索隱",
    "text": "魯，姓；句踐，名也。與越王同，或有意義。俗本「踐」作「賤」，非。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a84",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p24",
    "annotator": "索隱",
    "text": "筑似琴，有弦，用竹擊之，取以爲名。漸音如字，正義音子廉反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a85",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p24",
    "annotator": "集解",
    "text": "徐廣曰：「飲酒之人。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a86",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p25",
    "annotator": "索隱",
    "text": "鞠音麴，又如字，人姓名也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a87",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p25",
    "annotator": "正義",
    "text": "以北謂燕國也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a88",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p25",
    "annotator": "集解",
    "text": "批音白結反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a89",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p25",
    "annotator": "索隱",
    "text": "批謂觸擊之。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a90",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p26",
    "annotator": "索隱",
    "text": "凡人寒甚則心戰，恐懼亦戰。今以懼譬寒，言可爲心戰。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a91",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p26",
    "annotator": "索隱",
    "text": "振，救也。言禍及天下，不可救之。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a92",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p26",
    "annotator": "索隱",
    "text": "戰國策「購」作「講」。講，和也。今讀購與「爲燕媾」同，媾亦合也。漢、史媾講兩字常雜，今欲北與連和。陳軫傳亦曰「西購於秦」也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a93",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p26",
    "annotator": "正義",
    "text": "惛音昏。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a94",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p27",
    "annotator": "集解",
    "text": "徐廣曰：「蔽，一作『撥』，一作『拔』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a95",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p27",
    "annotator": "索隱",
    "text": "蔽音疋結反。蔽猶拂也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a96",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p27",
    "annotator": "正義",
    "text": "燕丹子云：「田光答曰：『竊觀太子客無可用者：夏扶血勇之人，怒而面赤；宋意脈勇之人，怒而面青；武陽骨勇之人，怒而面白。光所知荊軻，神勇之人，怒而色不變。』」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a97",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p27",
    "annotator": "正義",
    "text": "挽音俯。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a98",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p28",
    "annotator": "索隱",
    "text": "案無父稱孤。時燕王尚在，而丹稱孤者，或記者失辭，或諸侯嫡子時亦僭稱孤也。又劉向云「丹，燕王喜之太子」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a99",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p28",
    "annotator": "索隱",
    "text": "闚，示也。言以利誘之。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a100",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p28",
    "annotator": "索隱",
    "text": "絕句。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a101",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p28",
    "annotator": "索隱",
    "text": "燕丹子曰「軻與太子遊東宮池，軻拾瓦投•，太子捧金丸進之。又共乘千里馬，軻曰『千里馬肝美』，即殺馬進肝。太子與樊將軍置酒於華陽臺，出美人能鼓琴，軻曰『好手也』，斷以玉盤盛之。軻曰『太子遇軻甚厚』」是也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a102",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p29",
    "annotator": "集解",
    "text": "徐廣曰：「方城縣有督亢亭。」駰案：劉向別錄曰「督亢，膏腴之地」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a103",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p29",
    "annotator": "索隱",
    "text": "地理志廣陽國有薊縣。司馬彪郡國志曰「方城有督亢亭」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a104",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p29",
    "annotator": "正義",
    "text": "督亢坡在幽州范陽縣東南十里。今固安縣南有督亢陌，幽州南界。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a105",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p30",
    "annotator": "集解",
    "text": "徐廣曰：「椹音張鴆切。一作『抗』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a106",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p30",
    "annotator": "索隱",
    "text": "椹謂以劔刺其胸也。又云一作「抗」。抗音苦浪反，言抗拒也，其義非。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a107",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p30",
    "annotator": "集解",
    "text": "徐廣曰：「捥一作『捾』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a108",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p30",
    "annotator": "索隱",
    "text": "搤音烏革反。捥音烏亂反。勇者奮厲，必先以左手扼右捥也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a109",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p30",
    "annotator": "索隱",
    "text": "切齒，齒相磨切也。爾雅曰：「治骨曰切」。腐音輔，亦爛也。猶今人事不可忍云「腐爛」然，皆奮怒之意也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a110",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p31",
    "annotator": "集解",
    "text": "徐廣曰：「徐，一作『陳』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a111",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p31",
    "annotator": "索隱",
    "text": "徐，姓；夫人，名。謂男子也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a112",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p31",
    "annotator": "索隱",
    "text": "焠，染也，音怱潰反。謂以毒藥染劔鍔也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a113",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p31",
    "annotator": "集解",
    "text": "言以匕首試人，人血出，足以沾濡絲縷，便立死也"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a114",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p31",
    "annotator": "索隱",
    "text": "忤者，逆也，音五故反。不敢逆視，言人畏之甚也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a115",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p32",
    "annotator": "正義",
    "text": "易州在幽州歸義縣界。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a116",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p32",
    "annotator": "正義",
    "text": "徵，知雉反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a117",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "正義",
    "text": "劉云：「設文物大備，即謂九賔，不得以周禮九賔義爲釋。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a118",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "正義",
    "text": "三輔黃圖云：「秦始兼天下，都咸陽，因北陵營宮殿，則紫宮象帝宮，渭水貫都以象天漢，橫橋南度以法牽牛也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a119",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "匣音戶甲反。匣亦函也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a120",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "室謂鞘也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a121",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "正義",
    "text": "燕丹子云：「左手揕其胸。秦王曰：『今日之事，從子計耳。乞聽瑟而死。』召姬人鼓琴，琴聲曰『羅縠單衣，可裂而絕；八尺屏風，可超而越；鹿盧之劔，可負而拔』。王於是奮袖超屏風走之。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a122",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "諸郎中若今宿衞之官。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a123",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "且音即餘反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a124",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "正義",
    "text": "提，姪帝反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a125",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "王劭曰：「古者帶劔上長，拔之不出室，欲王推之於背，令前短易拔，故云『王負劔』。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a126",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "索隱",
    "text": "擿與「擲」同，古字耳，音持益反。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a127",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "正義",
    "text": "燕丹子云：「荊軻拔匕首擲秦王，決耳入銅柱，火出。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a128",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p33",
    "annotator": "集解",
    "text": "漢鹽鐵論曰：「荊軻懷數年之謀而事不就者，尺八匕首不足恃也。秦王操於不意，列斷賁、育者，介七尺之利也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a129",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p34",
    "annotator": "索隱",
    "text": "水名，在遼東。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a130",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "集解",
    "text": "徐廣曰：「縣名也，今屬鉅鹿。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a131",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "欒布傳曰「賣庸於齊，爲酒家人」，漢書作「酒家保」。案：謂庸作於酒家，言可保信，故云「庸保」。鶡冠子曰「伊尹保酒」也。徐注云「縣名，屬鉅鹿」者，據地理志而知也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a132",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "正義",
    "text": "宋子故城在趙州平棘縣北三十里。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a133",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "謂主人家之左右也。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a134",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "劉氏云：「謂主人翁也。」又韋昭云：「古者名男子爲丈夫，尊婦嫗爲丈人。故漢書宣元六王傳所云丈人，謂淮陽憲王外王母，即張博母也。故古詩曰『三日斷五疋，丈人故言遲』是也。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a135",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "約謂貧賤儉約。旣爲庸保，常畏人，故云「畏約」。所以論語云「不可以久處約」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a136",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "集解",
    "text": "徐廣曰：「互以爲客。」"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a137",
    "book": "shiji",
