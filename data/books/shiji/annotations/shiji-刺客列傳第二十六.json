    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "案劉氏云「鉛爲挺著筑中，令重，以擊人」。"
  },
  {
    "id": "anno:shiji:shiji-刺客列傳第二十六:a140",
    "book": "shiji",
    "chapter_id": "shiji-刺客列傳第二十六",
    "target_para_id": "text:shiji:shiji-刺客列傳第二十六:p35",
    "annotator": "索隱",
    "text": "朴音普卜反。朴，擊也。"
  },
