[
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a0",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p0",
    "annotator": "索隱",
    "text": "名橫，考烈王完之父。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p0",
    "annotator": "正義",
    "text": "竟陵屬江夏郡也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p0",
    "annotator": "正義",
    "text": "今陳州也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "謂兩虎鬬乃受弊於駑犬也。劉氏云受猶承也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "正義",
    "text": "至，極也，極則反也。冬至，陰之極；夏至，陽之極。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「致，或作『安』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "正義",
    "text": "言極東西。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "音腰。以言山東從，韓、魏是其腰。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "秦使盛橋守事於韓，亦如楚使召滑相趙然也。並內行章義之難。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "信音申。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「秦始皇五年，取酸棗、燕、虛。蘇代曰『決宿胥之口，魏無虛、頓丘』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「燕縣有桃城。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「平臯有邢丘。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "正義",
    "text": "邢丘在懷州武德縣東南二十里。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「蘇秦云『北有河外、卷、衍』。長垣縣有蒲鄉。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "此蒲在衞之長垣蒲鄉也。衍在河南，與卷相近。首蓋牛首，垣即長垣，非河東之垣也。垣音圓。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「屬陳留。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "仁及平丘二縣名。謂以兵臨此二縣，則黃及濟陽等自嬰城而守也。地理志平丘屬陳留；仁闕。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「蘇代云『決白馬之口，魏無黃、濟陽』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "正義",
    "text": "故黃城在曹州考城縣東。濟陽故城在曹州宛句縣西南。嬰城，未詳。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「濮水北於鉅野入濟。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "地名，蓋地近濮也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a22",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "正義",
    "text": "劉伯莊云：「言秦得魏地，楚趙之絕從。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a23",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「單，亦作『殫』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a24",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p1",
    "annotator": "索隱",
    "text": "單音丹。單者，盡也。言王之威盡行矣。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a25",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "言狐惜其尾，每涉水，舉尾不令濕，比至極困，則濡之。譬不可力臣之。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a26",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "索隱",
    "text": "智伯敗於榆次也。地理志屬太原，有梗陽鄉。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a27",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "榆次，并州縣也。注水經云：「榆次縣南洞渦水側有鑿臺。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a28",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "索隱",
    "text": "干隧，吳之敗處，地名。干，水邊也。隧，道路也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a29",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "干隧，吳地名也。出萬安山西南一里太湖，即吳王夫差自剄處，在蘇州西北四十里。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a30",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "索隱",
    "text": "謂智伯及吳王沒伐趙及伐齊之利於前，而自易其患於後。後即榆次、干隧之難也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a31",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "索隱",
    "text": "從音絕用反。劉氏云：「從猶領也。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a32",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "艾山在兗州博縣南六十里也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a33",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "集解",
    "text": "戰國策曰「三江之浦」。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a34",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "吳俗傳云：「越軍得子胥夢，從東入伐吳，越王即從三江北岸立壇，殺白馬祭子胥，杯動酒盡，乃開渠曰示浦，入破吳王於姑蘇，敗干隧也。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a35",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "正義",
    "text": "并州城。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a36",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「鑿臺在榆次。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a37",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "正義",
    "text": "言大軍不遠跋涉攻伐。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a38",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "集解",
    "text": "韓嬰章句曰：「趯趯，往來貌。獲，得也。言趯趯之毚兔。謂狡兔數往來逃匿其跡，有時遇犬得之。」毛傳曰：「毚兔，狡兔也。」鄭玄曰：「遇犬，犬之馴者，謂田犬。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a39",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "索隱",
    "text": "「趯」作「躍」。躍，天歷反。毚音讒。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a40",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "索隱",
    "text": "大國謂秦也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a41",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "索隱",
    "text": "重世猶再世也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a42",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "集解",
    "text": "徐廣曰：「一作『顛』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a43",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p3",
    "annotator": "索隱",
    "text": "摺音拉，頤音夷。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a44",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p4",
    "annotator": "正義",
    "text": "惡音烏。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a45",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p4",
    "annotator": "索隱",
    "text": "楚都陳，隨水之右壤蓋在隨之西，即今鄧州之西，其地多山林者矣。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a46",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p5",
    "annotator": "正義",
    "text": "徐州西，宋州東，兗州南，並故宋地。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a47",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p5",
    "annotator": "正義",
    "text": "此時徐、泗屬齊也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a48",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p5",
    "annotator": "索隱",
    "text": "若秦楚構兵不休，則魏盡故宋，齊取泗上，是使齊魏獨攻伐而得其利也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a49",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p5",
    "annotator": "索隱",
    "text": "校音教。謂足以與秦爲敵也。一云校者，報也，言力能報秦。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a50",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p5",
    "annotator": "索隱",
    "text": "言齊一年之後，未即能爲帝，而能禁秦爲帝有餘力矣。然「禁」字作「楚」者，誤也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a51",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "集解",
    "text": "徐廣曰：「遲，一作『還』。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a52",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "索隱",
    "text": "遲音值。值猶乃也。令音力呈反。韓、魏重齊，令歸帝號，此秦之計失。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a53",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "索隱",
    "text": "注謂以兵裁之也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a54",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "正義",
    "text": "右壤謂濟州之南北也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a55",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "索隱",
    "text": "西海至東海皆是秦地。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a56",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p6",
    "annotator": "正義",
    "text": "廣言橫度中國東西也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a57",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「三十六年。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a58",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p9",
    "annotator": "正義",
    "text": "然四君封邑檢皆不獲，唯平原有地，又非趙境，並蓋號謚，而孟嘗是謚。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a59",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p9",
    "annotator": "正義",
    "text": "墟音虛。闔閭今蘇州也。於城內小城西北別築城居之，今圮毀也。又大內北瀆，四從五橫，至今猶存。又改破楚門爲昌門。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a60",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p11",
    "annotator": "索隱",
    "text": "年表云八年取魯，封魯君於莒，十四年而滅也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a61",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p14",
    "annotator": "集解",
    "text": "徐廣曰：「始皇六年。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a62",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p15",
    "annotator": "正義",
    "text": "觀音館。今魏州觀城縣也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a63",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p15",
    "annotator": "正義",
    "text": "黽隘之塞在申州。黽音盲也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a64",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p15",
    "annotator": "集解",
    "text": "徐廣曰：「在許東南。」"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a65",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p15",
    "annotator": "正義",
    "text": "濮、滑州兼河北置東郡。濮州本衞都，而徙野王也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a66",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "正義",
    "text": "無望謂不望而忽至也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a67",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "索隱",
    "text": "周易有无妄卦，其義殊也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a68",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "正義",
    "text": "謂生死无常。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a69",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "正義",
    "text": "謂喜怒不節也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a70",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "正義",
    "text": "謂吉凶忽爲。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a71",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p18",
    "annotator": "索隱",
    "text": "言園是春申之仇也。戰國策作「君之舅也」，謂爲王之舅，意異也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a72",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p19",
    "annotator": "正義",
    "text": "壽州城門。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a73",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p19",
    "annotator": "正義",
    "text": "楚考烈王二十五年，秦始皇九年。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a74",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p19",
    "annotator": "索隱",
    "text": "按楚捍有母弟猶，猶有庶兄負芻及昌平君，是楚君完非無子，而上文云考烈王無子，誤也。"
  },
  {
    "id": "anno:shiji:shiji-春申君列傳第十八:a75",
    "book": "shiji",
    "chapter_id": "shiji-春申君列傳第十八",
    "target_para_id": "text:shiji:shiji-春申君列傳第十八:p21",
    "annotator": "集解",
    "text": "徐廣曰：「旄音耄。」"
  }
]