[
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a0",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p0",
    "annotator": "索隱",
    "text": "康，畿內國名。宋忠曰：「康叔從康徙封衞，衞即殷墟定昌之地。畿內之康，不知所在。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a1",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p1",
    "annotator": "索隱",
    "text": "集猶和也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a2",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p1",
    "annotator": "索隱",
    "text": "成周，洛陽。其時周公相成王，營洛邑，猶居西周鎬京。管、蔡欲搆難，先攻成周，於是周公東居洛邑，伐管、蔡。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a3",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p1",
    "annotator": "索隱",
    "text": "宋忠曰：「今定昌也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a4",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p2",
    "annotator": "正義",
    "text": "若梓人爲材，君子觀爲法則也。梓，匠人也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a5",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p3",
    "annotator": "集解",
    "text": "左傳曰：「分康叔以大路、大旂、少帛、綪茷、旃旌、大呂。」賈逵曰：「大路，全路也。少帛，雜帛也。綪茷，大赤也。通帛爲旃，析羽爲旌。大呂，鍾名。」鄭衆曰：「綪茷，旆名也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a6",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p4",
    "annotator": "索隱",
    "text": "系本康伯名髡。宋忠曰：「即王孫牟也，事周康王爲大夫。」按：左傳所稱王孫牟父是也。牟髡聲相近，故不同耳。譙周古史考無康伯，而云子牟伯立，蓋以不宜父子俱謚康，故因其名云牟伯也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a7",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p4",
    "annotator": "注",
    "text": "史記音隱曰：「音捷。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a8",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p4",
    "annotator": "索隱",
    "text": "系本作「摯伯」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a9",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p4",
    "annotator": "索隱",
    "text": "系本作「箕伯」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a10",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p5",
    "annotator": "索隱",
    "text": "按：康誥稱命爾侯于東土，又云「孟侯，朕其弟，小子封」，則康叔初封已爲侯也。比子康伯即稱伯者，謂方伯之伯耳，非至子即降爵爲伯也。故孔安國曰「孟，長也。五侯之長，謂方伯」。方伯，州牧也，故五代孫祖恆爲方伯耳。至頃侯德衰，不監諸侯，乃從本爵而稱侯，非是至子即削爵，及頃侯賂夷王而稱侯也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a11",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p7",
    "annotator": "索隱",
    "text": "羨音延。延，墓道。又音以戰反。恭伯名餘也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a12",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p7",
    "annotator": "索隱",
    "text": "和殺恭伯代立，此說蓋非也。按：季札美康叔、武公之德。又國語稱武公年九十五矣，猶箴誡於國，恭恪于朝，倚几有誦，至于沒身，謂之叡聖。又詩著衞世子恭伯蚤卒，不云被殺。若武公殺兄而立，豈可以爲訓而形之于國史乎？蓋太史公採雜說而爲此記耳。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a13",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p9",
    "annotator": "索隱",
    "text": "女弟，戴媯也。子桓公完爲州吁所殺，戴媯歸陳，詩燕燕于飛之篇是。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a14",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p9",
    "annotator": "索隱",
    "text": "子之，謂養之爲子也。齊女即莊姜也。詩碩人篇美之是也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a15",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p9",
    "annotator": "集解",
    "text": "賈逵曰：「石碏，衞上卿。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a16",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p10",
    "annotator": "集解",
    "text": "服虔曰：「右宰醜，衞大夫。濮，陳地。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a17",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p10",
    "annotator": "索隱",
    "text": "賈逵曰：「濮，陳地。」按：濮水首受河，又受汴，汴亦受河。東北至離狐分爲二，俱東北至鉅野入濟。則濮在曹衞之閒，賈言陳地，非也。若據地理志陳留封丘縣濮水受泲，當言陳留水也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a18",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p10",
    "annotator": "集解",
    "text": "賈逵曰：「邢，周公之胤，姬姓國。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a19",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p12",
    "annotator": "集解",
    "text": "杜預曰：「左右媵之子，因以爲號。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a20",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p12",
    "annotator": "正義",
    "text": "左傳云衞宣公使太子伋之齊，「使盜待諸莘，將殺之」。杜預云「莘，衞地」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a21",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p16",
    "annotator": "正義",
    "text": "括地志云：「故鶴城在滑州匡城縣西南十五里。左傳云『衞懿公好鶴，有乘軒者。狄伐衞，公欲戰，國人受甲者皆曰「使鶴，鶴實有祿位，余焉能戰」！』俗傳懿公養鶴於此城，因名也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a22",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p18",
    "annotator": "正義",
    "text": "括地志云：「城武縣有楚丘亭。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a23",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p18",
    "annotator": "注",
    "text": "賈誼書曰：「衞侯朝於周，周行人問其名，答曰衞侯辟疆，周行人還之，曰啟疆辟疆，天子之號，諸侯弗得用。衞侯更其名曰燬，然後受之。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a24",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p18",
    "annotator": "正義",
    "text": "燬音毀。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a25",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p20",
    "annotator": "索隱",
    "text": "輕賦稅，平斷刑也。平，或作「卒」。卒謂士卒也。罪字連下讀，蓋亦一家之義耳"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a26",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "集解",
    "text": "服虔曰：「南河，濟南之東南流河也。」杜預曰：「從汲郡南度，出衞南。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a27",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "索隱",
    "text": "奔楚。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a28",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "正義",
    "text": "咺，況逺反。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a29",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "索隱",
    "text": "按：左傳「衞侯聞楚師敗，懼，出奔楚，遂適陳」是。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a30",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "索隱",
    "text": "按：私謂賂之也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a31",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "索隱",
    "text": "是元咺所立者，成公入而殺之，故僖三十年經云「衞殺其大夫元咺及公子瑕」。此言「奔」，非也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a32",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "索隱",
    "text": "邴歜與左氏同，而齊系家作「邴戎」者，蓋邴歜掌御戎車，故號邴戎。邴音丙。歜亦作「𨞕」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a33",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "集解",
    "text": "世本曰：「成公徙濮陽。」宋忠曰：「濮陽，帝丘，地名。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a34",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p22",
    "annotator": "正義",
    "text": "遬音速。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a35",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "賈逵曰：「師曹，樂人。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a36",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "服虔曰：「孫文子，林父也。甯惠子，甯殖也。敕戒二子，欲共晏食，皆服朝衣待命。旰，晏也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a37",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "服虔曰：「從公於囿。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a38",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "左傳曰：「不釋皮冠。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a39",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "服虔曰：「孫文子邑也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a40",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "索隱",
    "text": "左傳作「戚」，此亦音戚也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a41",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "左傳曰文子子即孫蒯也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a42",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "杜預曰：「巧言，詩小雅也。其卒章曰：『彼何人斯？居河之麋。無拳無勇，職爲亂階。』公欲以譬文子居河上而爲亂。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a43",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "賈逵曰：「伯玉，衞大夫。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a44",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "集解",
    "text": "徐廣曰：「班氏云獻公弟焱。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a45",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p24",
    "annotator": "索隱",
    "text": "左傳作「剽」，古今人表作「焱」，蓋音相亂，字易改耳。音方遙反，又匹妙反。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a46",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p29",
    "annotator": "集解",
    "text": "服虔曰：「衞卿孔烝鉏。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a47",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p32",
    "annotator": "集解",
    "text": "賈逵曰：「南子，宋女。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a48",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p32",
    "annotator": "集解",
    "text": "賈逵曰：「戲陽遫，太子家臣。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a49",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p32",
    "annotator": "正義",
    "text": "戲音羲。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a50",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p32",
    "annotator": "正義",
    "text": "呼，火故反。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a51",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p33",
    "annotator": "集解",
    "text": "賈逵曰：「僕，御也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a52",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p33",
    "annotator": "集解",
    "text": "服虔曰：「郢自謂己無德，不足立，以污辱社稷。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a53",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p34",
    "annotator": "集解",
    "text": "服虔曰：「衰絰，爲若從衞來迎太子也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a54",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "杜預曰：「軒，大夫車也。三死，死罪三。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a55",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "正義",
    "text": "杜預云：三罪，紫衣、袒裘、帶劔也。紫衣，君服也。熱，故偏袒，不敬也。衞侯求令名者與之食焉，太子請使良夫，良夫紫衣狐裘，不釋劔而食，太子使牽退，數之罪而殺之。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a56",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「圃，園。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a57",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「二人謂良夫、太子。蒙衣，爲婦人之服，以巾蒙其頭而共乘也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a58",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「家臣稱老。問其姓名。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a59",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "賈逵曰：「婚姻家妾也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a60",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「入孔氏家，適伯姬所居。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a61",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「先至孔悝所。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a62",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "賈逵曰：「介，被甲也。輿猳豚，欲以盟故也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a63",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「於衞臺上召衞羣臣。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a64",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「季路爲孔氏邑宰，故告之。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a65",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「召護，衞大夫。駕乘車，不駕兵車也，言無距父之意。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a66",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「欒甯使召季路，乃行爵食炙。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a67",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p37",
    "annotator": "集解",
    "text": "服虔曰：「召護奉衞侯。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a68",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "賈逵曰：「子羔，衞大夫。高柴，孔子弟子也。將出，奔。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a69",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "杜預曰：「且欲至門。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a70",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "賈逵曰：「言家臣憂不及國，不得踐履其難。」鄭衆曰：「是時輙已出，不及事，不當踐其難。子羔言不及，以爲季路欲死國也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a71",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "服虔曰：「言食悝之祿，欲救悝之難，此明其不死國也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a72",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "服虔曰：「公孫敢，衞大夫。言輙已出，無爲復入。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a73",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "王肅曰：「必有繼續其後攻太子。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a74",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "服虔曰：「二子，蒯聵之臣。敵，當也。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a75",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "正義",
    "text": "燔音煩。舍音捨。黶音乙減反。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a76",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "集解",
    "text": "服虔曰：「不使冠在地。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a77",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p38",
    "annotator": "正義",
    "text": "纓，冠緌也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a78",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p41",
    "annotator": "集解",
    "text": "賈逵曰：「戎州，戎人之邑。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a79",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p41",
    "annotator": "索隱",
    "text": "左傳曰「戎州人攻之」是也。隱二年「公會戎于潛」，杜預云「陳留濟陽縣東南有戎城」。濟陽與衞相近，故莊公登臺望見戎州。又七年云「戎伐凡伯于楚丘」，是戎近衞。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a80",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p41",
    "annotator": "索隱",
    "text": "：左傳，莊公本由晉趙氏納之，立而背晉，晉伐衞，衞人出莊公，立公子般師。晉師退，莊公復入，般師出奔。初，公登城見戎州己氏之妻髮美，髡之以爲夫人髢。又欲翦戎州，兼逐石圃，故石圃攻莊公。莊公懼，踰北牆折股，入己氏，己氏殺之。今系家不言莊公復入及死己氏，直云出奔，亦其疏也。又左傳云衞復立般師，齊伐衞，立公子起，執般師。明年，衞石圃逐其君起，起奔齊，出公輙復歸。是左氏詳而系家略也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a81",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p41",
    "annotator": "集解",
    "text": "左傳曰：「斑師，襄公之孫。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a82",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p41",
    "annotator": "集解",
    "text": "服虔曰：「起，靈公子。」"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a83",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p42",
    "annotator": "索隱",
    "text": "左傳作「石圃」，此尃音圃。穀梁作曼姑，尃或音姑。諸本多無「曼」字。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a84",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p42",
    "annotator": "索隱",
    "text": "按：出公初立十二年，亡在外四年，復入九年卒，是立二十一年。自即位至卒，凡經二十五年而卒于越。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a85",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p43",
    "annotator": "索隱",
    "text": "按：紀年云「四年卒于越」。系本名虔。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a86",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p43",
    "annotator": "集解",
    "text": "世本云敬公費也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a87",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p43",
    "annotator": "索隱",
    "text": "系本「弗」作「費」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a88",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p43",
    "annotator": "索隱",
    "text": "系本云敬公生橈公舟，非也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a89",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p43",
    "annotator": "正義",
    "text": "屬趙也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a90",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p44",
    "annotator": "正義",
    "text": "音尾。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a91",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p44",
    "annotator": "索隱",
    "text": "音的。按：系本「適」作「虔」。虔，悼公也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a92",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p44",
    "annotator": "索隱",
    "text": "訓亦作「馴」，同休運反。系本作「聖公馳」。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a93",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p44",
    "annotator": "索隱",
    "text": "音速。系本作「不逝」。按：上穆公已名遫，不可成侯更名，則系本是。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a94",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p45",
    "annotator": "索隱",
    "text": "按：秦本紀云孝公元年鞅入秦，又按年表，成侯與秦孝公同年，然則「十一年」當爲「元年」，字誤耳。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a95",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p46",
    "annotator": "索隱",
    "text": "按：樂資據紀年，以嗣君即孝襄侯也。"
  },
  {
    "id": "anno:shiji:shiji-衞康叔世家第七:a96",
    "book": "shiji",
    "chapter_id": "shiji-衞康叔世家第七",
    "target_para_id": "text:shiji:shiji-衞康叔世家第七:p47",
    "annotator": "集解",
