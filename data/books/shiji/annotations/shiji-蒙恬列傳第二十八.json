[
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a0",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p0",
    "annotator": "索隱",
    "text": "驁音敖。又鄒氏音五到反。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p0",
    "annotator": "索隱",
    "text": "謂恬嘗學獄法，遂作獄官，典文學。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p1",
    "annotator": "正義",
    "text": "謂靈、勝等州。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「屬隴西。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p1",
    "annotator": "正義",
    "text": "遼東郡在遼水東，始皇築長城東至遼水，西南至海之上。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「五原西安陽縣北有陰山。陰山在河南，陽山在河北。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「爲宦者。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p2",
    "annotator": "索隱",
    "text": "劉氏云：「蓋其父犯宮刑，妻子沒爲官奴婢，妻後野合所生子皆承趙姓，並宮之，故云『兄弟生隱宮』。謂『隱宮』者，宦之謂也。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「敦，一作『敏』。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p3",
    "annotator": "正義",
    "text": "九原郡，今勝州連谷縣是。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p3",
    "annotator": "正義",
    "text": "宮在雍州。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p4",
    "annotator": "索隱",
    "text": "並音白浪反。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p4",
    "annotator": "索隱",
    "text": "走音奏。走猶向也。鄒氏音趨，趨亦向義，於字則乖。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p6",
    "annotator": "索隱",
    "text": "愈一作俞，俞即踰也，音臾。謂知太子賢而踰久不立，是不忠也。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p6",
    "annotator": "正義",
    "text": "今代州也。因禱山川至代而繫之。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「一無此字。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p8",
    "annotator": "索隱",
    "text": "曲，姓；宮，名。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p8",
    "annotator": "索隱",
    "text": "蒙毅言己少事始皇，順意因蒙幸，至始皇沒世，可謂知上意。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p8",
    "annotator": "索隱",
    "text": "言其惡聲狼籍，布於諸國。而劉氏曰「諸侯皆記其惡於史籍」，非也。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p9",
    "annotator": "索隱",
    "text": "參謂三卿，伍即五大夫。欲參伍更議。"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「一作『辭』。」"
  },
  {
    "id": "anno:shiji:shiji-蒙恬列傳第二十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-蒙恬列傳第二十八",
    "target_para_id": "text:shiji:shiji-蒙恬列傳第二十八:p9",
    "annotator": "索隱",
    "text": "此「故曰」者，必先志有此言，蒙恬引之以成說也，今不知出何書耳。振者，救也。然語亦倒，以言前人受諫可覺，則其過乃可救。"
  }
]