[
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a0",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p1",
    "annotator": "集解",
    "text": "音善。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a1",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p1",
    "annotator": "索隱",
    "text": "古「禪」字，音巿戰反。三嬗，謂陳涉、項氏、漢高祖也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a2",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p1",
    "annotator": "索隱",
    "text": "音己力反。亟訓急也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a3",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p2",
    "annotator": "集解",
    "text": "韋昭曰：「謂舜受禪，在璇璣玉衡以齊七政。」"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a4",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p2",
    "annotator": "索隱",
    "text": "後乃放殺。殺音弒，謂湯放桀，武王討紂也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a5",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p2",
    "annotator": "索隱",
    "text": "即契、后稷及秦襄公、文公、穆公也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a6",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p2",
    "annotator": "索隱",
    "text": "謂湯、武及始皇。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a7",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "集解",
    "text": "徐廣曰：「一作『鍉』。」"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a8",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "索隱",
    "text": "鏑音的。注「鍉」字亦音的。案：秦銷鋒鏑，作金人十二，以弱天下之兵也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a9",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "索隱",
    "text": "維訓度，謂計度令萬代安也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a10",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "索隱",
    "text": "鄉秦之禁適足資賢者。鄉音向，許亮反。謂秦前時之禁兵及不封樹諸侯，適足以資後之賢者，即高帝也。言驅除患難耳。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a11",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "索隱",
    "text": "指漢高祖。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a12",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "集解",
    "text": "白虎通曰：「聖人無土不王，使舜不遭堯，　當如夫子老於闕里也。」"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a13",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p3",
    "annotator": "索隱",
    "text": "言高祖起布衣，卒傳之天位，實所謂大聖。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a14",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p5",
    "annotator": "集解",
    "text": "徐廣曰：「壬辰。」"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a15",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p5",
    "annotator": "正義",
    "text": "七月，陳涉起陳。八月，武臣起趙。九月，項梁起吳，田儋起齊，沛公初起，韓廣起燕。十二月，魏咎起魏，陳王立之。三年六月，韓成起韓，項梁立之也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a16",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p22",
    "annotator": "集解",
    "text": "徐廣曰：「泗水屬東海。」"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a17",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p27",
    "annotator": "索隱",
    "text": "二世二年正月也。秦諱正，故云端月也。"
  },
  {
    "id": "anno:shiji:shiji-秦楚之際月表第四:a18",
    "book": "shiji",
    "chapter_id": "shiji-秦楚之際月表第四",
    "target_para_id": "text:shiji:shiji-秦楚之際月表第四:p97",
    "annotator": "集解",
    "text": "徐廣曰歲在乙未"
  }
]