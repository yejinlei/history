[
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a0",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p0",
    "annotator": "正義",
    "text": "年表云都彭城。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a1",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p0",
    "annotator": "集解",
    "text": "徐廣曰：「一作『父』。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a2",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p0",
    "annotator": "索隱",
    "text": "按：漢書作「同父」。言同父者，以明異母也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a3",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "集解",
    "text": "徐廣曰：「漢書云丘嫂也。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a4",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "索隱",
    "text": "漢書作「丘」。應劭云「丘，姓也」。孟康云「丘，空也。兄亡，空有嫂也」。今此作「巨」，巨，大也，謂長嫂也。劉氏云「巨，一作『丘』。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a5",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "索隱",
    "text": "櫟音歷。謂以杓歷釜旁，使爲聲。漢書作「轑」，音勞。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a6",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "集解",
    "text": "徐廣曰：「羹頡侯以高祖七年封，封十三年，高后元年，有罪，削爵一級，爲關內侯。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a7",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "索隱",
    "text": "羹頡，爵號耳，非縣邑名，以其櫟釜故也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a8",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "正義",
    "text": "括地志云：「羹頡山在媯州懷戎縣東南十五里。」按：高祖取其山名爲侯號者，怨故也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a9",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p1",
    "annotator": "集解",
    "text": "徐廣曰：「次兄名喜，字仲，以六年立爲代王，其年罷。卒謚頃王。有子曰濞。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a10",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p2",
    "annotator": "索隱",
    "text": "漢書云楚王王薛郡、東海、彭城三十六縣也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a11",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p2",
    "annotator": "索隱",
    "text": "漢書名郢客。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a12",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p3",
    "annotator": "索隱",
    "text": "漢書云「私姦服舍中」。姚察云「姦於服舍，非必宮中」。又按：集注服虔云「私姦中人」。蓋以罪重，故至削郡也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a13",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p3",
    "annotator": "正義",
    "text": "括地志云：「大棘故城在宋州寧陵縣西七十里，即梁棘壁。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a14",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p3",
    "annotator": "正義",
    "text": "括地志云：「有梁丘故城在曹州成武縣東北三十二里」也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a15",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p4",
    "annotator": "集解",
    "text": "徐廣曰：「德侯名廣，吳王濞之弟也。其父曰仲。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a16",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p5",
    "annotator": "集解",
    "text": "徐廣曰：「純立十七年卒，謚節王。子延壽立，十九年死。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a17",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p5",
    "annotator": "索隱",
    "text": "按：太史公唯記王純爲國人告反，國除。蓋延壽後更封，至十九年又謀反誅死，故不同也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a18",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p5",
    "annotator": "正義",
    "text": "漢書云王純嗣十六年，子延壽嗣，與趙何齊謀反，延壽自殺，立三十二年國除。與此不同。地節是宣帝年號，去天漢四年二十九年，仍隔昭帝世。言到地節二年以下者，蓋褚先生誤也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a19",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p6",
    "annotator": "正義",
    "text": "年表云都邯鄲。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a20",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p7",
    "annotator": "索隱",
    "text": "音壁強二音，又音闢疆。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a21",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p7",
    "annotator": "正義",
    "text": "河閒，今瀛州也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a22",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p8",
    "annotator": "索隱",
    "text": "建德，其相名，史先失姓也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a23",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p8",
    "annotator": "正義",
    "text": "邯鄲，洺州縣也。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a24",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p9",
    "annotator": "索隱",
    "text": "漢書申公名培，王戊胥靡之。"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a25",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p9",
    "annotator": "注",
    "text": "趙堯傳曰：「趙人防與公也。」"
  },
  {
    "id": "anno:shiji:shiji-楚元王世家第二十:a26",
    "book": "shiji",
    "chapter_id": "shiji-楚元王世家第二十",
    "target_para_id": "text:shiji:shiji-楚元王世家第二十:p9",
    "annotator": "索隱",
    "text": "此及漢書雖不見趙不用防與公，蓋當時猶知事跡，或別有所見，故太史公明引以結其贊。"
  }
]