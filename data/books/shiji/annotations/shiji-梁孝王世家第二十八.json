[
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a0",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "漢書「勝」作「揖」。又云「諸姬生代孝王參、梁懷王揖」。言諸姬者，衆妾卑賤，史不書姓，故云諸姬也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「都中都。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "括地志云：「中都故城在汾州平遙縣西十二里。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「都晉陽。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "括地志云：「并州太原地名大明城，即古晉陽城。智伯與韓魏攻趙襄子於晉陽，即此城是也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「都睢陽。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "索隱",
    "text": "漢書梁王名揖，蓋是矣。按：景帝子中山靖王名勝，是史記誤耳。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "括地志云：「宋州宋城縣在州南二里外城中，本漢之睢陽縣也。漢文帝封子武於大梁，以其卑溼，徙睢陽，故改曰梁也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「都陳。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "即古陳國城也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「都清陽。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p1",
    "annotator": "正義",
    "text": "括地志云：「清陽故城在貝州清陽縣西北八里也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p2",
    "annotator": "索隱",
    "text": "謂自文帝二年初封代，後徙淮陽，又徙梁，通數文帝二年至十二年徙梁爲十一年也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "集解",
    "text": "文穎曰：「地名。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "索隱",
    "text": "按：左傳宣公二年，宋華元戰于大棘。杜預云在襄邑東南，蓋即棘壁是也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "正義",
    "text": "括地志云：「大棘故城在宋州寧陵縣西南七十里。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "集解",
    "text": "漢書音義曰：「梁所虜吳楚之捷，略與漢等。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "集解",
    "text": "徐廣曰：「在陳留圉縣。」駰案：司馬彪曰「圉有高陽亭」也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p4",
    "annotator": "索隱",
    "text": "圉縣屬陳留。高陽，鄉名也。注引司馬彪者，出續漢書郡國志也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "築謂建也。白虎通云：「苑所以東者何？蓋以東方生物故也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "蓋言其奢，非實辭。或者梁國封域之方。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "正義",
    "text": "括地志云：「兔園在宋州宋城縣東南十里。葛洪西京雜記云『梁孝王苑中有落猿巖、栖龍岫、鴈池、鶴洲、鳧島。諸宮觀相連，奇果佳樹，瑰禽異獸，靡不畢備』。俗人言梁孝王竹園也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a22",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "蘇林云：「廣其徑也。」太康地理記云：「城方十三里，梁孝王築之，鼓倡節杵而後下和之者，稱睢陽曲。今踵以爲故，所以樂家有睢陽曲，蓋釆其遺音也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a23",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "集解",
    "text": "徐廣曰：「睢陽有平臺里。」駰案：如淳曰「在梁東北，離宮所在也」。晉灼曰「或說在城中東北角」。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a24",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "如淳云：「在梁東北，離宮所在」者，按今城東二十里臨新河，有故臺址，不甚高，俗云平臺，又一名脩竹苑。西京雜記云「有落猿巖、鳧洲、鴈渚，連亙七十餘里」是也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a25",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "漢官儀曰：「天子法駕三十六乘，大駕八十一乘，皆備千乘萬騎而出也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a26",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "漢舊儀云：「皇帝輦動稱警，出殿則傳蹕，止人清道。」言出入者，互文耳，入亦有蹕。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a27",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "周禮「有奇邪之人」，鄭玄云「奇邪，譎怪非常也，奇音紀宜反，邪音斜」也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a28",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p5",
    "annotator": "索隱",
    "text": "如淳云：「巨亦大，與大百萬同也。」韋昭云：「大百萬，今萬萬。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a29",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p6",
    "annotator": "集解",
    "text": "鄧展曰：「但將駟馬往。」瓚曰：「稱乘輿駟馬，則車馬皆往，言不駕六馬耳。天子副車駕駟馬。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a30",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p6",
    "annotator": "正義",
    "text": "著，竹略反。籍謂名簿也，若今通引出入門也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a31",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p7",
    "annotator": "索隱",
    "text": "袁盎云「漢家法周道立子」，是有所關涉之說於帝也。一云關者，隔也。引事而關隔，其說不得行也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a32",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p7",
    "annotator": "集解",
    "text": "如淳曰：「攱閣不得下。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a33",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p7",
    "annotator": "索隱",
    "text": "張晏云「格，止也」。服虔云「格謂格鬬不行」。蘇林音閣。周成雜字「攱閣也」。通俗文云「高置立攱棚云攱閣」。字林音紀，又音詭也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a34",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p8",
    "annotator": "索隱",
    "text": "謂意疑梁刺之。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a35",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p8",
    "annotator": "正義",
    "text": "姓軒丘，名豹也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a36",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p9",
    "annotator": "集解",
    "text": "漢書音義曰：「茅蘭，孝王臣。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a37",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p9",
    "annotator": "集解",
    "text": "張晏曰：「布車，降服，自比喪人。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a38",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p10",
    "annotator": "索隱",
    "text": "漢書作「梁山」。述征記云「良山際清水」。今壽張縣南有良山，服虔云是此山也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a39",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p10",
    "annotator": "正義",
    "text": "括地志云「梁山在鄆州壽張縣南三十五里」，即獵處也。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a40",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p10",
    "annotator": "索隱",
    "text": "張晏云：「足當處下，所以輔身也；今出背上，象孝王背朝以干上也。北者，陰也。又在梁山，明爲梁也。牛者，丑之畜，衝在六月。北方數六，故六月六日薨也。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a41",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p10",
    "annotator": "索隱",
    "text": "述征記：「碭有梁孝王之冢。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a42",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p11",
    "annotator": "索隱",
    "text": "長子買，梁共王。子明，濟川王。子彭離，濟東王。子定，山陽王。子不識，濟陰王。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a43",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p15",
    "annotator": "索隱",
    "text": "漢書作「讓」。"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a44",
    "book": "shiji",
    "chapter_id": "shiji-梁孝王世家第二十八",
    "target_para_id": "text:shiji:shiji-梁孝王世家第二十八:p15",
    "annotator": "集解",
    "text": "鄭德曰：「上蓋刻爲雲雷象。」"
  },
  {
    "id": "anno:shiji:shiji-梁孝王世家第二十八:a45",
