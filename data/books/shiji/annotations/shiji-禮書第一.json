[
  {
    "id": "anno:shiji:shiji-禮書第一:a0",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p1",
    "annotator": "索隱",
    "text": "音羊。洋洋，美盛貌。鄒誕生音翔。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a1",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p1",
    "annotator": "正義",
    "text": "言天地宰制萬物，役使羣品，順四時而動，咸有成功，豈藉人力營爲哉，是美善盛大衆多之德也。故孔子曰「四時行焉，百物生焉」。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a2",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p1",
    "annotator": "索隱",
    "text": "大行，秦官，主禮儀。漢景帝改曰大鴻臚。鴻臚，掌九賓之儀也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a3",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "正義",
    "text": "時證反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a4",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "周禮王之五路有金路。鄭玄曰：「以金飾諸末。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a5",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "索隱",
    "text": "錯鏤衡扼爲文飾也。詩曰「約軧錯衡」，毛傳云「錯衡，文衡也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a6",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "正義",
    "text": "爲，于偽反。錯作「鏓」，七公反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a7",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "周禮曰：「羞用百有二十品。」鄭玄曰：「羞出于牲及禽獸，以備其滋味，謂之庶羞。」鄭衆曰：「羞者，進也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a8",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "服虔曰：「大路，祀天車也。越席，結括草以爲席也。」王肅曰：「不緣也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a9",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "正義",
    "text": "按：括草，蒲草。越，戶括反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a10",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "周禮曰：「王視朝則皮弁之服。」鄭玄曰：「皮弁之服，十五升白布衣，積素爲裳也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a11",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "正義",
    "text": "以鹿子皮爲弁也。按：襞積素布而爲裳也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a12",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "鄭玄曰：「朱弦，練朱絲弦也。越，瑟底孔。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a13",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "鄭玄曰：「大羹，肉湆不調以鹽菜也。玄酒，水也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a14",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "索隱",
    "text": "彫謂彫飾也。言彫飾是奢侈之弊也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a15",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p2",
    "annotator": "集解",
    "text": "孔安國曰：「禘祫之禮，爲序昭穆也，故毀廟之主及羣廟之主皆合食于太祖。灌者，酌鬱鬯，灌于太祖，以降神也。既灌之後，列尊卑，序昭穆。而魯逆祀，躋僖公，亂昭穆，故不欲觀之。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a16",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p3",
    "annotator": "集解",
    "text": "包氏曰：「三歸，娶三姓女也。婦人謂嫁曰歸。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a17",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p3",
    "annotator": "索隱",
    "text": "言子夏是孔子門人之中高弟者，謂才優而品第高也，故論語四科有「文學子游、子夏」是。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a18",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p3",
    "annotator": "集解",
    "text": "論語曰：「子路曰『衞君待子而爲政，子將奚先』？子曰『必也正名乎』！」馬融曰：「正百事之名。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a19",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p3",
    "annotator": "正義",
    "text": "論語云大師摯適齊，亞飯干適楚，鼓方叔入于河，少師陽、擊磬襄入于海。魯哀公時，禮壞樂崩，人皆去也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a20",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "正義",
    "text": "秦采擇六國禮儀，尊君抑臣，朝廷濟濟，依古以來典法行之。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a21",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "集解",
    "text": "應劭曰：「抵，至也。」瓚曰：「抵，歸也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a22",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "索隱",
    "text": "按：大抵猶大略也。臣瓚以抵訓爲歸，則是大略大歸，其義通也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a23",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "正義",
    "text": "稱，尺證反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a24",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "正義",
    "text": "孝文本紀云上身衣弋綈，所幸慎夫人令衣不曳地，幃帳不得文繡，治霸陵皆以瓦器。是躬化節儉，謂何嫌耳，不須繁禮飾貌也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a25",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "正義",
    "text": "吳、楚、趙、菑川、濟南、膠西爲六國也。齊孝王狐疑城守，三國兵圍齊，齊使路中大夫告天子，故不言七國也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a26",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p4",
    "annotator": "正義",
    "text": "上紀買反，下乃憚反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a27",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p5",
    "annotator": "正義",
    "text": "辨音遍。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a28",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p5",
    "annotator": "集解",
    "text": "應劭曰：「初用夏正，以正月爲歲首，改年爲太初。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a29",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "正義",
    "text": "音諍。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a30",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "正義",
    "text": "屈，羣物反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a31",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "索隱",
    "text": "音止，又昌改反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a32",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "集解",
    "text": "服虔曰：「簀謂之笫。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a33",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "索隱",
    "text": "疏謂窻也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a34",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p6",
    "annotator": "正義",
    "text": "疏謂窻也。笫，側里反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a35",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "謂蒲草爲席，既絜且柔，絜可以祀神，柔可以養體也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a36",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "劉氏云：「側，特也。臭，香也。茝，香草也。言天子行，特得以香草自隨也，其餘則否。」臭爲香者，山海經云「臭如蘪蕪」，易曰「其臭如蘭」，是臭爲草之香也。今以側爲邊側，載者置也，言天子之側常置芳香於左右。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a37",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "詩云：「約軧錯衡。」毛傳云：「錯衡，文衡也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a38",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "鄭玄曰：「和，鸞，皆鈴也，所以爲車行節也。韓詩內傳曰鸞在衡，和在軾前，升車則馬動，馬動則鸞鳴，鸞鳴則和應。」服虔曰：「鸞在鑣，和在衡。續漢書輿服志曰鸞雀立衡也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a39",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "皇偘云：「鸞，以金爲鸞，懸鈴其中，於衡上，以爲遲疾之節，所以正威儀行舒疾也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a40",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "鄭玄曰：「武，武王樂也。象，武舞也。韶，舜樂也。濩，湯樂也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a41",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "步猶緩。緩車則和鸞之音中於武象，驟車中於韶濩也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a42",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "周禮曰：「交龍爲旂。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a43",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "斿音旒。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a44",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "按：以兕牛皮爲席。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a45",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "兕音似。爾雅云兕似牛。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a46",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "持虎者，以猛獸皮文飾倚較及伏軾，故云持虎。劉氏云「畫之於旍竿及楯仗等」，以今所見爲說也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a47",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "徐廣曰：「鮫魚皮可以飾服器，音交。韅者，當馬腋之革，音呼見反。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a48",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "以鮫魚皮飾韅。韅，馬腹帶也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a49",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "集解",
    "text": "徐廣曰：「乘輿車金薄璆龍爲輿倚較，文虎伏軾，龍首銜軛。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a50",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "彌亦音弭，謂金飾衡枙爲龍。此皆王者服御崇飾，所以示威武，故云「所以養威」也。此文皆出大戴禮，蓋是荀卿所說。劉氏云：「薄猶飾也。璆然，龍貌。璆音虬。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a51",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "索隱",
    "text": "言人誰知夫志士推誠守死，要立名節。仍是養生安身之本，故下云「人苟生之爲見，若者必死」，是解上意，言人苟以貪生之爲見，不能見危致命，若者必死。若猶如也，言執心爲見，如此者必刑戮及身，故云「必死」。下文皆放此也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a52",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "夫音扶。要音腰。孰知猶審知也。出死猶處死也。審知志士推誠處死，要立名節，若曹沬、茅焦，所以養生命也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a53",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "費音芳味反。輕猶薄。言審知尟薄費用則能畜聚，所以養財貨也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a54",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "言審知恭敬辭讓所以養體安身。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a55",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p7",
    "annotator": "正義",
    "text": "言審知禮義文章道理所以養其情性。此四科，是儒者有禮義，故兩得之也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a56",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "正義",
    "text": "苟，且；若，如此也。言平凡好生之人，且見操節之士，以禮義處死，養得其生有效，如此者必死也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a57",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "正義",
    "text": "言平凡好利之人，且見利義之士，以輕省費用，養得其財有效，如此者必害身也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a58",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "正義",
    "text": "惰，徒臥反。言平凡怠惰之人，且見有禮之士，以恭敬禮讓，養得安樂有效，如此者必危亡也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a59",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "索隱",
    "text": "覆解上「禮義文理之所以養情也」。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a60",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "正義",
    "text": "勝音叔證反。言平凡好勝之人，且見利義之士，禮義文理，養得其情性有效，如此者必滅亡也。此四科，是墨者無禮義，故兩失之也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a61",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "索隱",
    "text": "墨者不尚禮義而任儉嗇，無仁恩，故使人兩失之。易曰「悅以使人，人忘其死」是也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a62",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p8",
    "annotator": "正義",
    "text": "分，扶問反。分猶等也。若儒等者是治辨之極，彊固之本，威行之道，功名之總，則天下歸之矣。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a63",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "自此已下，皆是儒分之功也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a64",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "固，堅固也。言國以禮義，四方欽仰，無有攻伐，故爲彊而且堅固之本也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a65",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "以禮義導天下，天下伏而歸之，故爲威行之道也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a66",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "以禮義率天下，天下咸遵之，故爲功名之總。總，合也，聚也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a67",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "言由禮義也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a68",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "覆上「功名之總也」。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a69",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "集解",
    "text": "徐廣曰：「大剛曰鉅。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a70",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "宛城，今鄧州南陽縣城是也。音於元反。鉅，剛鐵也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a71",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "鑽謂矛刃及矢鏃也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a72",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "上匹妙反，下音速。剽遫，疾也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a73",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "卒，村忽反。熛，必遙反。熛風，疾也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a74",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "集解",
    "text": "許慎曰：「垂涉，地名也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a75",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "蹻音其略反，楚將之名。言其起兵亂後楚遂分爲四。按漢志，滇王，莊蹻之後也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a76",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "以「起」字爲絕句。或曰楚莊王苗裔也。按：括地志云「師州、黎州在京西南五千六百七十里。戰國楚威王時，莊蹻王滇，則爲滇國之地」。楚昭王徙都鄀，楚襄王徙都陳，楚考烈王徙都壽春，咸被秦逼，乃四分也。然昭王雖在莊蹻之前，故荀卿兼言之也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a77",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "參者，驗也。言驗是，楚豈無利兵哉。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a78",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "參，七含反。言蹻、楚國豈無堅甲利兵哉，爲其不由禮義，故衆分也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a79",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "括地志云：「汝水源出汝州魯山縣西伏牛山，亦名猛山。汝水至豫州郾城縣名濆水。爾雅云『河有澭，汝有濆』，亦汝之別名。潁水源出洛州嵩高縣東南三十五里陽乾山，俗名潁山。地理志高陵山，汝出，東南至新蔡縣入淮；陽乾山潁水出，東至下蔡入淮也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a80",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "江即岷江，從蜀入，楚在荊州南。漢江從漢中東南入江。四水爲楚之險固也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a81",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "集解",
    "text": "山海經曰：「夸父與日逐走，日入，渴，欲得飲，飲於渭河；不足，北飲大澤；未至，道渴而死。弃其杖，化爲鄧林。」駰謂鄧林後遂爲林名。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a82",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "按：裴氏引山海經，以爲夸父弃杖爲鄧林，其言北飲大澤，蓋非在中國也。劉氏以爲今襄州南鳳林山是古鄧祁侯之國，在楚之北境，故云阻以鄧林也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a83",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "括地志云：「方城，房州竹山縣東南四十一里。其山頂上平，四面險峻，山南有城，長十餘里，名爲方城，即此山也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a84",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "振，動也，擊也。槁，乾葉也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a85",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "正義",
    "text": "鄢音郾。括地志云：「故城在襄州安養縣北三里，古郾子之國，鄧之南鄙也。又率道縣南九里有故郾城，漢惠帝改曰宜城也。郢城，荊州江陵縣東北六里，即吳公子光伐楚，楚平王恐，城郢者也。又楚武王始都郢，紀南故城是也，在江陵北十五里也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a86",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p9",
    "annotator": "索隱",
    "text": "言無人必保其性命。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a87",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p10",
    "annotator": "集解",
    "text": "徐廣曰：「試，一作『誡』也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a88",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p10",
    "annotator": "正義",
    "text": "詘，丘勿反。試，用也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a89",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p10",
    "annotator": "正義",
    "text": "求勿反，又求厥反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a90",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p10",
    "annotator": "正義",
    "text": "分，扶問反。言明儒墨之分，使禮義均等，則下應之如影響耳。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a91",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p10",
    "annotator": "正義",
    "text": "事君以禮義，民有不由禮義者，然後待之以刑，則民知罪伏刑矣。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a92",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p11",
    "annotator": "正義",
    "text": "類，種類也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a93",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p11",
    "annotator": "正義",
    "text": "惡音烏。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a94",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p11",
    "annotator": "索隱",
    "text": "鄒音遍。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a95",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p11",
    "annotator": "正義",
    "text": "偏，疋然反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a96",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "毛詩敍曰：「文武之功起於后稷，故推以配天焉。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a97",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "索隱",
    "text": "懷，思也。言諸侯不敢思以太祖配天而食也。又一解，王之子孫爲諸侯，不思祀其父祖，故禮云「諸侯不敢祖天子」，蓋與此同意。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a98",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "禮記曰：「別子爲祖，繼別爲宗。百世不遷者，謂別子之後也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a99",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "索隱",
    "text": "疇，類也。天子類得郊天，餘並不合祭，今大戴禮作「郊止乎天子」是也。止或作「疇」，因誤耳。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a100",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "索隱",
    "text": "言天子已下至諸侯得立社。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a101",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "音含。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a102",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "索隱",
    "text": "啗音含。含謂包容。諸侯已下至士大夫得祭社，故禮云「大夫成羣立社曰置社」，亦曰里社也。鄒誕生音啗徒濫反，意義亦通，但不見古文，各以意爲音耳。今按：大戴禮作「導及士大夫」，導亦通也。今此爲「啗」者，當以導與蹈同，後「足」字失「止」，唯有「口」存，故使解者穿鑿也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a103",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "鄭玄曰：「古者方十里，其中六十四井出兵車一乘，此兵法之賦。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a104",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "穀梁傳曰：「天子至于士皆有廟，天子七，諸侯五，大夫三，士二。始封之者必爲其太祖。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a105",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p12",
    "annotator": "集解",
    "text": "禮記曰：「庶人祭於寢。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a106",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "鄭玄曰：「大饗，祫祭先王，以腥魚爲俎實，不臑孰之也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a107",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "鄭玄曰：「嚌，至齒。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a108",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "貴本親用，兩者合而成文，以歸太一。太一者，天地之本也。得禮之文理，是合於太一也。隆者，盛也，高也。得禮文理，歸于太一，是禮之盛者也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a109",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "正義",
    "text": "皇侃云：「玄酒，水也。上古未有酒，而始之祭但酌水用之，至晚世雖有酒，存古禮，尚用水代酒也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a110",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "尊之上玄尊，俎之上生魚，豆之先大羹，三者如一，皆是本，故云一也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a111",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "鄭玄曰：「啐，入口也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a112",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "按：儀禮祭畢獻，祝西面告成，是爲利爵。祭初未行無算爵，故不啐入口也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a113",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "成事卒哭之祭，故記曰「卒哭曰成事」。既是卒哭之祭，始從吉祭，故受胙爵而不嘗俎也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a114",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "禮，祭必立侑以勸尸食，至三飯而後止。每飯有侑一人，故有三侑。既是勸尸，故不相食也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a115",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "廢齊，謂昏禮父親醮子而迎之前，故曲禮云「齋戒以告鬼神」，是昏禮有齊也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a116",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "此五者皆禮之初始，質而未備，亦是貴本之義，故云一也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a117",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "禮記曰：「乘素車，貴其質也。」鄭玄曰：「素車，殷輅也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a118",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "幬音稠。謂車蓋以素帷，亦質也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a119",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "周禮曰：「王祀昊天上帝，服大裘而冕。」論語曰：「麻冕，禮也。」孔安國曰：「冕，緇布冠。古者績麻三十升布以爲之。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a120",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "正義",
    "text": "絻音免。亦作「冕」。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a121",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "儀禮士喪禮曰：「始死，主人散帶，垂之三尺。」禮記曰：「大功已上散帶也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a122",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "大路已下，三事相似如一，故云一也。散麻取其質無文飾，亦貴本也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a123",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "禮記曰：「斬衰之哭，若往而不反。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a124",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "鄭玄曰：「清廟謂作樂歌清廟。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a125",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "鄭玄曰：「倡，發歌句者。三歎，三人從歎。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a126",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "集解",
    "text": "徐廣曰：「一作『搏膈』。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a127",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "縣一鍾尚拊隔。隔，懸鍾格。拊音撫。拊隔，不擊其鐘而拊其格，不取其聲，亦質也。鄒氏隔音膊，蓋依大戴禮也。而鄭禮注云搏，拊柷敔也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a128",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p13",
    "annotator": "索隱",
    "text": "大瑟而練朱其弦，又通其下孔，使聲濁且遲，上質而貴本，不取其聲文。自「三年」已下四事，皆不取其聲也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a129",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "索隱",
    "text": "脫猶疏略也。始，初也。言禮之初尚疏略也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a130",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "索隱",
    "text": "言禮成就有文飾。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a131",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "集解",
    "text": "徐廣曰：「一作『悅』。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a132",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "索隱",
    "text": "音悅。言禮終卒和悅人情也。大戴禮作「終於隆」，隆謂盛也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a133",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "集解",
    "text": "徐廣曰：「古『情』字或假借作『請』，諸子中多有此比。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a134",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "正義",
    "text": "言情文俱盡，乃是禮之至備也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a135",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "索隱",
    "text": "音昇，又尸證反。或文勝情，或情勝文，是情文更代相勝也。大戴禮作「迭興」也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a136",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "索隱",
    "text": "言其次情文俱失，歸心渾沌天地之初，復禮之本，是歸太一也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a137",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p14",
    "annotator": "正義",
    "text": "自「天地」以下八事，大禮之備，情文俱盡，故用爲下則順，用爲上則明也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a138",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "索隱",
    "text": "已下亦是太史公取荀卿禮論之意，極言禮之損益，以結禮書之論也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a139",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "索隱",
    "text": "謂禮之盛，文理合以歸太一，至禮之殺，復情以歸太一。隆殺皆歸太一者，是本末相順也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a140",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "索隱",
    "text": "禮始於脫略，終於稅，稅亦殺也，殺與脫略，是始終相應也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a141",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "正義",
    "text": "應，乙陵反，當也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a142",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "索隱",
    "text": "言禮之至文，能辨尊卑貴賤，故云有以辨也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a143",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "索隱",
    "text": "言禮之至察，有以明隆殺損益，委曲情文，足以悅人心，故云有以說也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a144",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p15",
    "annotator": "正義",
    "text": "小人猶庶人也。則，法也。言天下士以上至于帝王，能從禮者則治安，不能從禮者則危亂，庶人據於事，不能法禮也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a145",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "有本作「懇誠」者，非也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a146",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "言禮之貌信深厚矣，雖有鄒子堅白同異之辯明察，入於禮義之中，自然懦弱敗壞之禮也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a147",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "言擅作典制及褊陋之說。入焉，謂入禮則自嗛望知其失。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a148",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "言禮之貌信廣大矣，雖有擅作典制褊陋之說，文辭入於禮義之中，自然成淫俗褊陋之言。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a149",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "恣睢猶毀訾也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a150",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "言訾毀禮者自取墬滅也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a151",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "言禮之貌信尊高矣，雖有暴慢恣睢輕俗以爲高之屬，入於禮義之中，自然成墜落暴慢輕俗之人。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a152",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "集解",
    "text": "鄭玄曰：「誠猶審也。陳，設也，謂彈畫也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a153",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "集解",
    "text": "鄭玄曰：「衡，稱也。縣謂錘也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a154",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "縣音玄。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a155",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "錯，置也。規，車也。矩，曲尺也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a156",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "錯，七故反。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a157",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "詐偽謂堅白同異，擅作典制，暴戾恣睢自高也。故陳繩，曲直定；懸衡，輕重分；錯規矩，方員□；審禮，詐偽自消滅矣。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a158",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "集解",
    "text": "鄭玄曰：「方猶道也。」"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a159",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "索隱",
    "text": "索，求也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a160",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "易謂輕易也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a161",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "好，火到反。言人以得禮之中，又能思審索求其禮，謂之能思慮；又不輕易其禮，謂之能堅固。能慮，能固其禮，更加好之，乃聖人矣。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a162",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p16",
    "annotator": "正義",
    "text": "道謂禮義也。言人有禮義，則爲聖人，比於天地日月，廣大之極也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a163",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "隆猶厚也。殺猶薄也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a164",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "言文飾情用，表裏外內，合於儒墨，是得禮情之中，而流行不息也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a165",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "中謂情文也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a166",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "騖音務。言君子之人，上存文飾，下務減省，而合情文，處得其中，縱有戰陣殺戮邪惡，則不弃於禮義矣。三皇步，五帝驟，三王馳，五伯騖也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a167",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "言君子之性守正不慢遠行，如常守宮庭也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a168",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "宮庭，聽朝處。喻君子心內常守禮義，若宮庭焉。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a169",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "域，居也。言君子之行，非人居亦弗居也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a170",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "處平凡人域之中，能知禮義之域限，即爲士及君子也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a171",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "外謂人域之外，非人所居之地。以喻禮義之外，別爲它行，即是小人，故云外是人也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a172",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "房音旁。旁皇猶徘徊也。周浹猶周帀。言徘徊周浹，委曲得禮之序，動不失中，則是聖人之行也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a173",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "索隱",
    "text": "言君子聖人有厚大之德，則爲禮之所積益弘廣也，故曰「甘受和，白受采，忠信之人可以學禮，苟無忠信，則禮不虛道」。然此文皆荀卿禮論也。"
  },
  {
    "id": "anno:shiji:shiji-禮書第一:a174",
    "book": "shiji",
    "chapter_id": "shiji-禮書第一",
    "target_para_id": "text:shiji:shiji-禮書第一:p17",
    "annotator": "正義",
    "text": "言君子內守其禮，德厚大積廣，至於高尊明禮，則是禮之終竟也。此書是褚先生取荀卿禮論兼爲之。"
  }
]