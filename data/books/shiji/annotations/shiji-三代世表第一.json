[
  {
    "id": "anno:shiji:shiji-三代世表第一:a0",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p1",
    "annotator": "索隱",
    "text": "案此表依帝繫及系本。其實敘五帝、三代，而篇唯名三代系表者，以三代代系長遠，宜以名篇；且三代皆出自五帝，故敘三代要從五帝而起也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a1",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p1",
    "annotator": "索隱",
    "text": "劉氏云：「尚猶久古也。『尚矣』之文元出大戴禮，彼文云『黃帝尚矣』。」"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a2",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p1",
    "annotator": "正義",
    "text": "譜，布也。列其事也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a3",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p2",
    "annotator": "索隱",
    "text": "諜音牒。牒者，紀系謚之書也。下云「稽諸曆諜」，謂歷代之譜。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a4",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p2",
    "annotator": "索隱",
    "text": "音轉。謂帝王更王，以金木水火土之五德傳次相承，終而復始，故云終始五德之傳也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a5",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p2",
    "annotator": "索隱",
    "text": "案：大戴禮有五帝德及帝繫篇，蓋太史公取此二篇之諜及尚書，集而紀黃帝以來爲系表也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a6",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p3",
    "annotator": "索隱",
    "text": "褚先生名少孫，元成閒爲博士。張夫子，未詳也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a7",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p3",
    "annotator": "索隱",
    "text": "案上契及后稷皆帝嚳子，此云「黃帝子」者，謂是黃帝之子孫耳。案：嚳是黃帝曾孫，而契、弃是玄孫，故云也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a8",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "索隱",
    "text": "有娀氏女曰簡狄，浴於玄丘水，出詩緯。殷本紀云玄鳥翔水遺卵，娀簡狄取而吞之也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a9",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "集解",
    "text": "詩云「土」。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a10",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "索隱",
    "text": "有郃氏之女也。韋昭云「姜，姓；嫄，字也」。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a11",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "集解",
    "text": "抱，普茅反。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a12",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "索隱",
    "text": "抱，普交反，又如字。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a13",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p4",
    "annotator": "索隱",
    "text": "言太伯之讓季歷居吳不反者，欲使傳文王、武王撥亂反正，成周道，遂天下生生之源本也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a14",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "索隱",
    "text": "案系本蜀無姓，相承云黃帝後。且黃帝二十五子，分封賜姓，或於蠻夷，蓋當然也。蜀王本紀云朱提有男子杜宇從天而下，自稱望帝，亦蜀王也。則杜姓出唐杜氏，蓋陸終氏之胤，亦黃帝之後也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a15",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "正義",
    "text": "譜記普云蜀之先肇於人皇之際。黃帝與子昌意娶蜀山氏女，生帝俈，立，封其支庶於蜀，歷虞夏商。周衰，先稱王者蠶叢，國破，子孫居姚、巂等處。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a16",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "索隱",
    "text": "案系本云霍國，真姓後。周武王封其弟叔處於霍。是姬姓亦黃帝後。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a17",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "集解",
    "text": "蓋謂五行讖緯之說，若今之童謠言。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a18",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "正義",
    "text": "一作「白彘」。案：霍光，平陽人。平陽今晉州霍邑，本秦時霍伯國，漢爲彘縣，後漢改彘曰永安，隋又改爲霍邑。徧檢記傳，無「白燕」之名，疑「白彘」是鄉之名。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a19",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "索隱",
    "text": "謂昭帝也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a20",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "索隱",
    "text": "言霍光持政擅權，逼帝令如卻行車，使不前也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a21",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "正義",
    "text": "謂年老爲方士最功也。"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a22",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "集解",
    "text": "西京賦曰：「族亭五里。」薛綜曰：「旗亭，市樓也。立旗於上，故取名焉。」"
  },
  {
    "id": "anno:shiji:shiji-三代世表第一:a23",
    "book": "shiji",
    "chapter_id": "shiji-三代世表第一",
    "target_para_id": "text:shiji:shiji-三代世表第一:p6",
    "annotator": "索隱",
    "text": "褚先生蓋腐儒也。設主客，引詩傳，云契、弃無父，及據帝系皆帝嚳之子，是也。而末引蜀王、霍光，竟欲證何事？而言之不經，蕪穢正史，輙云「豈不偉哉」，一何誣也！"
  }
]