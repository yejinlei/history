[
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a0",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "索隱",
    "text": "單音丹。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a1",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "集解",
    "text": "徐廣曰：「今之東安平也，在青州臨菑縣東十九里。古紀之酅邑，齊改爲安平，秦滅齊，改爲東安平縣，屬齊郡，以定州有安平，故加『東』字。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a2",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "索隱",
    "text": "地理志東安平屬淄川國也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a3",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "集解",
    "text": "徐廣曰：「傅音附。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a4",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "索隱",
    "text": "斷音都緩反。斷其軸，恐長相撥也。以鐵裹軸頭，堅而易進也。傅者截其軸與轂齊，以鐵鍱附軸末，施轄於鐵中以制轂也。又方言曰「車轊，齊謂之籠」。郭璞云「車軸也」。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a5",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "集解",
    "text": "徐廣曰：「轊，車軸頭也。音衞。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a6",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p0",
    "annotator": "集解",
    "text": "徐廣曰：「多作『悼齒』也。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a7",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p2",
    "annotator": "正義",
    "text": "故郎反。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a8",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p3",
    "annotator": "索隱",
    "text": "操音七高反。插音初洽反。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a9",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p3",
    "annotator": "正義",
    "text": "古之軍行，常負版插也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a10",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p4",
    "annotator": "索隱",
    "text": "齊之北界，近河東，蓋齊舊地也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a11",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p5",
    "annotator": "索隱",
    "text": "以單初起安平，故以爲號。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a12",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "集解",
    "text": "魏武帝曰：「先出合戰爲正，後出爲奇也。正者當敵，奇兵擊不備。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a13",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "索隱",
    "text": "奇謂權詐也。注引魏武，蓋亦軍令也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a14",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "索隱",
    "text": "兵不厭詐，故云「善之」。出奇無窮謂權變多也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a15",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "正義",
    "text": "猶當合也。言正兵當陣，張左右翼掩其不備，則奇正合敗敵也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a16",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "索隱",
    "text": "言用兵之術，或用正法，或用奇計，使前敵不可測量，如尋環中不知端際也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a17",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "集解",
    "text": "徐廣曰：「適音敵。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a18",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "索隱",
    "text": "言兵之始，如處女之軟弱，則敵人輕侮，開戶不爲備也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a19",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "正義",
    "text": "敵人謂燕軍也。言燕軍被田單反閒，易將及劓卒燒壟墓，而令齊卒甚怒，是敵人爲單開門戶也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a20",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "集解",
    "text": "魏武帝曰：「如女示弱，脫兔往疾也。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a21",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p6",
    "annotator": "索隱",
    "text": "言克敵之後，卷甲而趨，如兔之得脫而走疾也。敵不及距者，若脫兔忽過，而敵忘其所距也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a22",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p7",
    "annotator": "正義",
    "text": "嬓音皎。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a23",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p8",
    "annotator": "集解",
    "text": "劉熙曰：「齊西南近邑。畫音獲。」"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a24",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p8",
    "annotator": "索隱",
    "text": "畫，一音獲，又音胡卦反。劉熙云：「齊西南近邑。」蠋音觸，又音歜。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a25",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p8",
    "annotator": "正義",
    "text": "括地志云：「戟里城在臨淄西北三十里，春秋時棘邑，又云澅邑。」蠋所居即此邑，因澅水爲名也。"
  },
  {
    "id": "anno:shiji:shiji-田單列傳第二十二:a26",
    "book": "shiji",
    "chapter_id": "shiji-田單列傳第二十二",
    "target_para_id": "text:shiji:shiji-田單列傳第二十二:p8",
    "annotator": "索隱",
    "text": "經猶繫也。何休云：「脰，頸，齊語也。音豆。」"
  }
]