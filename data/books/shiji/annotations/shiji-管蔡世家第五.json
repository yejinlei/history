[
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a0",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "鮮音仙。括地志云：「鄭州管城縣，今州外城即管國城也，是叔鮮所封國也。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a1",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "國語云：「杞、繒二國，姒姓，夏禹之後，太姒之家。太姒，文王之妃，武王之母。」列女傳云：「太姒者，武王之母，禹後姒氏之女也。在郃之陽，在渭之涘。仁而明道，文王嘉之，親迎于渭，造舟爲梁。及入，太姒思媚太姜、太任，旦夕勤勞，以進婦道。太姒號曰文母。文王理外，文母治內。太姒生十男，教誨自少及長，未嘗見邪僻之事，言常以正道持之也。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a2",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "括地志云：「在濮州雷澤縣東南九十一里，漢郕陽縣。古郕伯，姬姓之國，其後遷於成之陽。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a3",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "處，昌汝反。括地志云：「晉州霍邑縣本漢彘縣也。鄭玄注周禮云霍山在彘，本春秋時霍伯國地。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a4",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "索隱",
    "text": "孔安國曰：「康，畿內國名，地闕。叔，字也。封，叔名。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a5",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "冉作丹，音奴甘反。或作「郍」，音同。丹國名也。季載，人名也。伯邑考最長，所以加「伯」。諸中子咸言「叔」，以載最少，故言季載。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a6",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "集解",
    "text": "徐廣曰：「文王之子爲侯者十有六國。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a7",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p0",
    "annotator": "正義",
    "text": "左右並去聲。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a8",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p1",
    "annotator": "集解",
    "text": "杜預曰：「管在滎陽京縣東北。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a9",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p1",
    "annotator": "集解",
    "text": "世本曰：「居上蔡。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a10",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p1",
    "annotator": "索隱",
    "text": "按：春秋隱五年「衞師入郕」。杜預曰「東平剛父縣有郕鄉」。後漢郡國志以爲成本國。又地理志廩丘縣南有成故城。應劭云「武王封弟季載於成」，是古之成邑，應仲逺誤云季載封耳。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a11",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p1",
    "annotator": "索隱",
    "text": "春秋閔元年晉滅霍。地理志河東彘縣，霍太山在東北，是霍叔之所封。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a12",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p2",
    "annotator": "索隱",
    "text": "馴如字，音廵。馴，善也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a13",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p2",
    "annotator": "索隱",
    "text": "事見定四年左傳。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a14",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p3",
    "annotator": "索隱",
    "text": "按：尚書云蔡仲克庸祗德，周公以爲卿士，叔卒，乃命諸王，封之蔡，元無仕魯之文。又伯禽居魯乃是七年致政之後，此言乃說居攝政之初，未知史遷何憑而有斯言也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a15",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p3",
    "annotator": "集解",
    "text": "宋忠曰：「胡徙居新蔡。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a16",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p3",
    "annotator": "索隱",
    "text": "管叔、蔡叔、成叔、曹叔、霍叔。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a17",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p6",
    "annotator": "正義",
    "text": "周幽王爲犬戎所殺，平王東徙洛邑，秦襄公以兵救，因送平王至洛，故平王封襄公。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a18",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p8",
    "annotator": "集解",
    "text": "杜預曰：「息國，汝南新息縣。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a19",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p9",
    "annotator": "索隱",
    "text": "弟，女弟，即蕩舟之姬。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a20",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p11",
    "annotator": "正義",
    "text": "醳音釋。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a21",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p13",
    "annotator": "正義",
    "text": "郟，紀洽反。敖，五高反。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a22",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p13",
    "annotator": "索隱",
    "text": "招或作「昭」，或作「韶」，並時遙反。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a23",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p13",
    "annotator": "正義",
    "text": "故申城在鄧州。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a24",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p13",
    "annotator": "正義",
    "text": "蔡之大夫也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a25",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p14",
    "annotator": "集解",
    "text": "宋忠曰：「平侯徙下蔡。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a26",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p14",
    "annotator": "索隱",
    "text": "今系本無者，近脫耳。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a27",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p14",
    "annotator": "集解",
    "text": "世本曰：「平侯者，靈侯般之孫，太子友之子。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a28",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "集解",
    "text": "服虔曰：「載書使蔡在衞上。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a29",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "集解",
    "text": "杜預曰：「汝南平輿縣北有邥亭。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a30",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "正義",
    "text": "質音致。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a31",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "索隱",
    "text": "州來在淮南下蔡縣。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a32",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "索隱",
    "text": "案：利，賊名也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a33",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p16",
    "annotator": "集解",
    "text": "徐廣曰：「或作『景』。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a34",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p18",
    "annotator": "索隱",
    "text": "魯哀十七年楚滅陳，其楚滅蔡絕其祀，又在滅陳之後三十三年，即在春秋後二十三年。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a35",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p21",
    "annotator": "索隱",
    "text": "按：上文「叔振鐸，其後爲曹，有系家言」，則曹亦合題系家，今附管蔡之末而不出題者，蓋以曹微小而少事跡，因附管蔡之末，不別題篇爾。且又管叔雖無後，仍是蔡、曹之兄，故題管、蔡而略曹也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a36",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p21",
    "annotator": "集解",
    "text": "宋忠曰濟陰定陶縣。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a37",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p23",
    "annotator": "集解",
    "text": "孫檢曰：「兕音徐子反。曹惠伯或名雉，或名弟，或復名弟兕也。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a38",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p23",
    "annotator": "索隱",
    "text": "按：年表作「惠公伯雉」，注引孫檢，未詳何代，或云齊人，亦恐其人不注史記。今以王儉七志、阮孝緒七錄並無，又不知是裴駰所錄否？"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a39",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p24",
    "annotator": "集解",
    "text": "孫檢云：「一作『終湦』。湦音生。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a40",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p25",
    "annotator": "索隱",
    "text": "上音亦。即射姑也，同音亦。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a41",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p27",
    "annotator": "集解",
    "text": "韋昭曰：「駢者，并幹也。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a42",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p27",
    "annotator": "正義",
    "text": "駢，白邊反。脅，許業反。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a43",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p27",
    "annotator": "正義",
    "text": "釐音僖，曹大夫。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a44",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p27",
    "annotator": "索隱",
    "text": "按左傳，宣公名廬。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a45",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p28",
    "annotator": "索隱",
    "text": "按：左傳成十五年，晉厲公執負芻，歸于京師。晉立宣公弟子臧，子臧曰「聖達節，次守節，下失節。爲君非吾節也」。遂逃奔宋。曹人請于晉。晉人謂子臧「反國，吾歸而君」。子臧反，晉於是歸負芻。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a46",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p30",
    "annotator": "索隱",
    "text": "按：譙周云春秋無其事。今檢系本及春秋，悼伯卒，弟露立，謚靖公，實無聲公、隱公，蓋是彼文自疏也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a47",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p31",
    "annotator": "集解",
    "text": "賈逵曰：「社宮，社也。」鄭衆曰：「社宮，中有室屋者。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a48",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p31",
    "annotator": "索隱",
    "text": "離即罹。罹，被也。"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a49",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
    "target_para_id": "text:shiji:shiji-管蔡世家第五:p31",
    "annotator": "集解",
    "text": "賈逵曰：「以小加大。」"
  },
  {
    "id": "anno:shiji:shiji-管蔡世家第五:a50",
    "book": "shiji",
    "chapter_id": "shiji-管蔡世家第五",
