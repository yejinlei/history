[
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a0",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "穰苴，田氏之族，爲大司馬，故曰司馬穰苴也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a1",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "穰音若羊反。苴音子徐反。田穰苴爲司馬官，主兵。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a2",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "按：阿、甄皆齊邑。晉太康地記曰「阿即東阿也」。地理志云甄城縣屬濟陰也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a3",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "河上，黃河南岸地，即滄德二州北界。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a4",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "謂命之爲將，以將軍也。將音即匠反。遂以將軍爲官名。故尸子曰「十萬之師，無將軍則亂」。六國時有其官。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a5",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "按旦日謂明日。日中時期會於軍門也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a6",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "按：立表謂立木爲表以視日景，下漏謂下漏水以知刻數也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a7",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "己音紀。監，甲暫反。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a8",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "仆音赴。按：仆者，卧其表也。決漏謂決去壼中漏水。以賈失期，過日中故也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a9",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "援音袁，枹音孚。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a10",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "援，作「操」。枹音孚，謂鼓挺也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a11",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "集解",
    "text": "魏武帝曰：「苟便於事，不拘君命。」"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a12",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "索隱",
    "text": "謂斬其使者僕車之左駙，又斬其馬之左驂，以御者在左故也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a13",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "軵音附。劉伯莊云：「駙者，箱外之立木，承重校者。」徇，行示也。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a14",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "比作卑，必耳反。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a15",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p0",
    "annotator": "正義",
    "text": "度黃河水北去而解。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a16",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p1",
    "annotator": "索隱",
    "text": "田乞，田僖子也。豹亦僖子之族。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a17",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p1",
    "annotator": "索隱",
    "text": "按此文誤也，當云田和自立，至其孫，因號爲齊威王。故系家云田和自立，號太公，其孫因齊，號爲威王。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a18",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p1",
    "annotator": "正義",
    "text": "放，方往反。"
  },
  {
    "id": "anno:shiji:shiji-司馬穰苴列傳第四:a19",
    "book": "shiji",
    "chapter_id": "shiji-司馬穰苴列傳第四",
    "target_para_id": "text:shiji:shiji-司馬穰苴列傳第四:p3",
    "annotator": "索隱",
    "text": "按謂司馬法說行兵，揖讓有三代之法，而齊區區小國，又當戰國之時，故云「亦少襃矣」。"
  }
]