    "book": "shiji",
    "chapter_id": "shiji-律書第三",
    "target_para_id": "text:shiji:shiji-律書第三:p24",
    "annotator": "正義",
    "text": "言萬物受神妙之氣，不能知覺，及神去來，亦不能識其往復也。"
  },
  {
    "id": "anno:shiji:shiji-律書第三:a103",
    "book": "shiji",
    "chapter_id": "shiji-律書第三",
    "target_para_id": "text:shiji:shiji-律書第三:p24",
    "annotator": "正義",
    "text": "言聖人畏神妙之理難識，而欲常存之；唯欲常存之，故其神亦存也。"
  },
  {
    "id": "anno:shiji:shiji-律書第三:a104",
    "book": "shiji",
    "chapter_id": "shiji-律書第三",
    "target_para_id": "text:shiji:shiji-律書第三:p24",
    "annotator": "正義",
    "text": "言平凡之人欲得精神存者，故亦莫如貴神之妙焉。"
  },
