[
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a0",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p0",
    "annotator": "集解",
    "text": "徐廣曰：「今樂安臨濟縣也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p0",
    "annotator": "正義",
    "text": "淄州高苑縣西北北狄故縣城。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p0",
    "annotator": "索隱",
    "text": "儋子市，從弟榮，榮子廣，榮弟橫，各遞爲王。榮并王三齊。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p1",
    "annotator": "集解",
    "text": "服虔曰：「古殺奴婢皆當告官。儋欲殺令，故詐縛奴而以謁也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「二世元年九月也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p2",
    "annotator": "集解",
    "text": "徐廣曰「二年六月。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p4",
    "annotator": "集解",
    "text": "徐廣曰：「二年八月。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "集解",
    "text": "應劭曰：「蝮一名虺，螫人手足，則割去其肉，不然則致死。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "索隱",
    "text": "蝮音芳伏反。螫音臛，又音釋。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "正義",
    "text": "按：蝮，毒蛇，長二三丈，嶺南北有之。虺長一二尺，頭腹皆一徧。說文云「虺博三寸，首大如擘」。擘，手大指也，音步歷反。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "集解",
    "text": "文穎曰：「言將亡身，非手足憂也。」瓚曰：「於楚、趙非手足之親。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "集解",
    "text": "如淳曰：「齮齕猶齚齧。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "索隱",
    "text": "齮音蟻。齕音紇。齮齕，側齒齩也。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p5",
    "annotator": "正義",
    "text": "按秦重得志，非但辱身，墳墓亦發掘矣，若子胥鞭荊平王墓。一云墳墓，言死也。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p7",
    "annotator": "索隱",
    "text": "田市王膠東，田都王齊，田安王濟北。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「三年正月。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "正義",
    "text": "平原，德州也。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「立故王田假也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「假走楚，楚殺之。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "正義",
    "text": "城陽，濮州雷澤是。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「四月。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "集解",
    "text": "徐廣曰：「高，一作『假』。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "集解",
    "text": "徐廣曰：「四年十一月。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "集解",
    "text": "晉灼曰：「泰山嬴縣也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "正義",
    "text": "故嬴城在兗州博城縣東北百里。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "正義",
    "text": "千乘故城在淄州高苑縣北二十五里。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p9",
    "annotator": "集解",
    "text": "徐廣曰：「二月也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p10",
    "annotator": "集解",
    "text": "韋昭曰：「海中山曰島。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p10",
    "annotator": "正義",
    "text": "按海州東海縣有島山，去岸八十里。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p10",
    "annotator": "集解",
    "text": "如淳曰：「四馬下足爲乘傳。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p11",
    "annotator": "集解",
    "text": "應劭曰：「尸鄉在偃師。」瓚曰：「廄置，置馬以傳驛也。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p11",
    "annotator": "正義",
    "text": "奉音捧。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p11",
    "annotator": "正義",
    "text": "齊田橫墓在偃師西十五里。崔豹古今注云：「薤露、蒿里，送哀歌也，出田橫門人。橫自殺，門人傷之而作悲歌，言人命如薤上露，易晞滅。至李延年乃分爲二曲，薤露送王公貴人，蒿里送士大夫庶人，使挽逝者歌之，俗呼爲挽歌。」"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p13",
    "annotator": "集解",
    "text": "韓信、田橫。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p13",
    "annotator": "索隱",
    "text": "言欲令此事長，則長說之；欲令此事短，則短說之：故戰國策亦名曰「短長書」是也。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p13",
    "annotator": "集解",
    "text": "漢書曰：「號爲雋永。」永，一作「求」。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a36",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p13",
    "annotator": "索隱",
    "text": "書名也。雋音松兗反。"
  },
  {
    "id": "anno:shiji:shiji-田儋列傳第三十四:a37",
    "book": "shiji",
    "chapter_id": "shiji-田儋列傳第三十四",
    "target_para_id": "text:shiji:shiji-田儋列傳第三十四:p13",
    "annotator": "索隱",
    "text": "言天下非無善畫之人，而不知圖畫田橫及其黨慕義死節之事，何故哉？歎畫人不知畫此也。"
  }
]