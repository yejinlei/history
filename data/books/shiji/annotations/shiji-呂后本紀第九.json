[
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a0",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "集解",
    "text": "徐廣曰：「呂后父呂公，漢元年爲臨泗侯，四年卒，高后元年追謚曰呂宣王。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a1",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「諱雉。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a2",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "索隱",
    "text": "諱雉，字娥姁也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a3",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "集解",
    "text": "漢書音義曰：「諱盈。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a4",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "集解",
    "text": "如淳曰：「姬音怡，衆妾之總稱也。漢官儀曰『姬妾數百』。」蘇林曰：「清河國有妃里，而題門作『姬』。」瓚曰：「漢秩祿令及茂陵書姬，內官也，秩比二千石，位次婕妤下，在七子、八子之上。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a5",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "索隱",
    "text": "如淳音怡，非也。茂陵書曰「姬是內官」，是矣，然官號及婦人通稱姬者，姬，周之姓，所以左傳稱伯姬、叔姬，以言天子之宗女，貴於他姓，故遂以姬爲婦人美號。故詩曰「雖有姬姜，不弃憔悴」是也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a6",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "索隱",
    "text": "上其紀反，又音祈也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a7",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "索隱",
    "text": "張良、叔孫通等。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a8",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p1",
    "annotator": "索隱",
    "text": "令太子卑詞安車，以迎四皓也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a9",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「名澤，高祖八年卒，謚令武侯，追謚曰悼武王。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a10",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p2",
    "annotator": "索隱",
    "text": "鄭氏、鄒誕並音怡，蘇林音胎。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a11",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「酈，一作『鄜』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a12",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「台弟也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a13",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「惠帝二年卒，謚康王。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a14",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p3",
    "annotator": "索隱",
    "text": "母曰曹姬也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a15",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p4",
    "annotator": "集解",
    "text": "如淳曰：「列女傳云周宣王姜后脫簪珥待罪永巷，後改爲掖庭。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a16",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p4",
    "annotator": "索隱",
    "text": "永巷，別宮名，有長巷，故名之也。後改爲掖庭。按：韋昭云以爲在掖門內，故謂之掖庭也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a17",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p4",
    "annotator": "集解",
    "text": "應劭曰：「酖鳥食蝮，以其羽畫酒中，飲之立死。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a18",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p4",
    "annotator": "集解",
    "text": "徐廣曰：「犂猶比也。諸言犂明者，將明之時。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a19",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p4",
    "annotator": "索隱",
    "text": "令音齡。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a20",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "索隱",
    "text": "音捧泛也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a21",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "集解",
    "text": "徐廣曰：「一作『出』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a22",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "集解",
    "text": "如淳曰：「公羊傳曰『天子嫁女於諸侯，必使諸侯同姓者主之』，故謂之公主。百官表列侯所食曰國，皇后、公主所食曰邑，諸侯王女曰公主。」蘇林曰：「公，五等尊爵也。春秋聽臣子以稱君父，婦人稱主，有『主孟啗我』之比，故云公主。」瓚曰：「天子女雖食湯沐之邑，不君其民。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a23",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "索隱",
    "text": "啗音徒濫反。按：主是謂里克妻，即優施之語，事見國語。孟者，且也，言且啗我物，我教汝婦事夫之道。此即婦人稱主之意耳。比音必二反。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a24",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "集解",
    "text": "如淳曰：「張敖子偃爲魯王，故公主得爲太后。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a25",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "正義",
    "text": "漢法，諸侯各起邸第於京師。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a26",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p5",
    "annotator": "索隱",
    "text": "按：漢宮闕疏「四年築東面，五年築北面」。漢舊儀「城方六十三里，經緯各十二里」。三輔舊事云「城形似北斗」也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a27",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p6",
    "annotator": "集解",
    "text": "皇甫謐曰：「帝以秦始皇三十七年生，崩時年二十三。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a28",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p6",
    "annotator": "集解",
    "text": "應劭曰：「入侍天子，故曰侍中。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a29",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p6",
    "annotator": "正義",
    "text": "解，紀賣反。言哭解惰，有所思也。又音戶賣反。解，節解也。又紀買反，謂解說也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a30",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p6",
    "annotator": "正義",
    "text": "毋音無。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a31",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p6",
    "annotator": "集解",
    "text": "漢書云：「葬安陵。」皇覽曰：「山高三十二丈，廣袤百二十步，居地六十畝。」皇甫謐曰：「去長陵十里，在長安北三十五里。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a32",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p7",
    "annotator": "索隱",
    "text": "啑，鄒音使接反。又云或作「喢」，音丁牒反。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a33",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p7",
    "annotator": "集解",
    "text": "應劭曰：「古官。傅者，覆也。」瓚曰：「大戴禮云『傅之德義』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a34",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p7",
    "annotator": "索隱",
    "text": "按：韋昭云信都之縣名。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a35",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「姓馮。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a36",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "正義",
    "text": "括地志云：「兗州博城，本漢博城縣城。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a37",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "索隱",
    "text": "虛音墟，琅邪縣也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a38",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "正義",
    "text": "括地志云：「朱虛故城在青州臨朐縣東六十里，漢朱虛也。十三州志云丹朱遊故虛，故云朱虛也。」虛猶丘也。朱猶丹也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a39",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「姓齊。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a40",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「姓陽成也。延以軍匠起，作宮築城也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a41",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「釋之之子也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a42",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "正義",
    "text": "括地志云：「徐州沛縣古城也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a43",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「呂后姊子也。母字長姁。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a44",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "正義",
    "text": "括地志云：「扶柳故城在冀州信都縣西三十里，漢扶柳縣也。有澤，澤中多柳，故曰扶柳。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a45",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p8",
    "annotator": "集解",
    "text": "徐廣曰：「其父越人，爲高祖騎將。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a46",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "集解",
    "text": "韋昭曰：「今陳留郡。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a47",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "括地志云：「常山故城在恆州真定縣南八里，本漢東垣邑也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a48",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "索隱",
    "text": "按：下文更名義，又改名弘農。漢書襄城侯唯云名弘，蓋史省文耳。按志，襄城屬潁川也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a49",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "索隱",
    "text": "按：韋昭云河內有軹縣，音紙也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a50",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "括地志云：「故軹城在懷州濟源縣東南十三里，七國時魏邑。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a51",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "初呂台爲呂王，後呂產王梁，更名梁曰呂。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a52",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "集解",
    "text": "徐廣曰：「釋之少子。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a53",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "胡陵，縣名，屬山陽，章帝改曰胡陸。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a54",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "集解",
    "text": "漢書云：「秋，星晝見。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a55",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "索隱",
    "text": "他音陀。俞音輸。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a56",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "括地志云：「故鄃城在德州平原縣西南三十里，本漢鄃縣，呂他邑也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a57",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "集解",
    "text": "徐廣曰：「表云呂后昆弟子淮陽丞相呂勝爲贅其侯。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a58",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "索隱",
    "text": "按表作「臨淮」也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a59",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "正義",
    "text": "括地志云：「故呂城在鄧州南陽縣西三十里，呂尚先祖封。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a60",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p9",
    "annotator": "集解",
    "text": "徐廣曰：「中邑侯朱通、山都侯王恬開、松茲侯徐厲、滕侯呂更始、醴陵侯越。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a61",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p10",
    "annotator": "正義",
    "text": "劉伯莊云：「諸美人元幸呂氏，懷身而入宮生子。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a62",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p10",
    "annotator": "集解",
    "text": "徐廣曰：「一無此字。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a63",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p10",
    "annotator": "索隱",
    "text": "韋昭云：「東萊縣。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a64",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p11",
    "annotator": "集解",
    "text": "徐廣曰：「舉，一作『與』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a65",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p13",
    "annotator": "索隱",
    "text": "韋昭云：「樊噲妻，封林光侯。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a66",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p17",
    "annotator": "集解",
    "text": "徐廣曰：「呂后兄子也。前封胡陵侯，蓋號曰武信。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a67",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p17",
    "annotator": "集解",
    "text": "如淳曰：「功大者位在上，功臣侯表有第一第二之次也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a68",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p18",
    "annotator": "正義",
    "text": "祓，芳弗反，又音廢。後同。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a69",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p18",
    "annotator": "集解",
    "text": "徐廣曰：「音戟。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a70",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p19",
    "annotator": "集解",
    "text": "徐廣曰：「食細陽之池陽鄉。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a71",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p19",
    "annotator": "集解",
    "text": "徐廣曰：「一云張釋卿。」駰案：如淳曰「百官表『謁者掌賔贊受事』，灌嬰爲中謁者。後常以奄人爲之，諸官加『中』者多奄人也」。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a72",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p19",
    "annotator": "集解",
    "text": "徐廣曰：「呂后昆弟子。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a73",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p19",
    "annotator": "集解",
    "text": "如淳曰：「列侯出關就國，關內侯但爵其身，有加異者，與關內之邑，食其租稅也。風俗通義曰『秦時六國未平，將帥皆家關中，故稱關內侯』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a74",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p20",
    "annotator": "集解",
    "text": "蔡邕曰：「皇子封爲王者，其實古諸侯也。加號稱王，故謂之諸侯王。王子弟封爲侯者，謂之諸侯。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a75",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p21",
    "annotator": "集解",
    "text": "皇甫謐曰：「合葬長陵。」皇覽曰：「高帝、呂后，山各一所也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a76",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p23",
    "annotator": "索隱",
    "text": "比音如字。比猶頻也。趙隱王如意，趙幽王友，趙王恢，是三趙王也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a77",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p24",
    "annotator": "索隱",
    "text": "猶，鄒音以獸反。與音預，又作「豫」。崔浩云「猶，蝯類也。卬鼻，長尾，性多疑」。又說文云「猶，獸名，多疑」，故比之也。按：狐性亦多疑，度冰而聽水聲，故云「狐疑」也。今解者又引老子「與兮若冬涉川，猶兮若畏四鄰」，故以爲「猶與」是常語。且按狐聽冰，而此云「若冬涉川」，則與是狐類不疑。「猶兮若畏四鄰」，則猶定是獸，自不保同類，故云「畏四鄰」也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a78",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p25",
    "annotator": "索隱",
    "text": "吳，楚，齊，淮南，琅邪，代，常山王朝，淮陽王武，濟川王太，是九也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a79",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p25",
    "annotator": "索隱",
    "text": "梁王產、趙王祿、燕王通也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a80",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p25",
    "annotator": "索隱",
    "text": "顏師古以爲言見誅滅，無處所也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a81",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p27",
    "annotator": "集解",
    "text": "徐廣曰：「姓紀。」張晏曰：「紀信字也。尚，主也。今符節令。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a82",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p27",
    "annotator": "索隱",
    "text": "張晏云：「紀信子。」又晉灼云：「信被楚燒死，不見有後。按功臣表襄平侯紀通，父成以將軍定三秦，死事，子侯。」則通非信子，張說誤矣。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a83",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p27",
    "annotator": "集解",
    "text": "漢書百官表曰：「典客，秦官也，掌諸侯、歸義蠻夷也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a84",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p27",
    "annotator": "集解",
    "text": "徐廣曰：「音況，字也。名寄。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a85",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p28",
    "annotator": "集解",
    "text": "徐廣曰：「訟，一作『公』。」駰按：韋昭曰「訟猶公也」。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a86",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p28",
    "annotator": "索隱",
    "text": "按：韋昭以訟爲公，徐廣又云一作「公」，蓋公爲得。然公言猶明言也。又解者云訟，誦說也。"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a87",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p28",
    "annotator": "集解",
    "text": "如淳曰：「百官表郎中令掌宮殿門戶，故其府在宮中，後轉爲光祿勳也。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a88",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p30",
    "annotator": "集解",
    "text": "張晏曰：「備漢朝有變，欲馳還也。或曰傳車六乘。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a89",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p30",
    "annotator": "集解",
    "text": "文穎曰：「即閏九月也。時律曆廢，不知閏，謂之『後九月』也。以十月爲歲首，至九月則歲終，後九月則閏月。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a90",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p31",
    "annotator": "集解",
    "text": "徐廣曰：「掊音仆。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a91",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p31",
    "annotator": "集解",
    "text": "蔡邕曰：「律曰『敢盜乘輿服御物』。天子至尊，不敢渫瀆言之，故託於乘輿也。乘猶載也，輿猶車也。天子以天下爲家，不以京師宮室爲常處，則當乘車輿以行天下，故羣臣託輿以言之也，故或謂之『車駕』。」"
  },
  {
    "id": "anno:shiji:shiji-呂后本紀第九:a92",
    "book": "shiji",
    "chapter_id": "shiji-呂后本紀第九",
    "target_para_id": "text:shiji:shiji-呂后本紀第九:p31",
    "annotator": "集解",
    "text": "蔡邕曰：「天子有大駕、小駕、法駕。法駕上所乘，曰金根車，駕六馬，有五時副車，皆駕四馬，侍中參乘，屬車三十六乘。」"
  }
]