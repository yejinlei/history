    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "集解",
    "text": "徐廣曰：「在汝潁之閒也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "索隱",
    "text": "漢書地理志云縣名，屬陳留。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "正義",
    "text": "括地志云：「成安故城在汝州梁縣東二十三里。」地理志云成安屬潁川郡。陳留郡又有成安縣，亦屬梁，未知孰是也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "正義",
    "text": "今宋州宋城。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "索隱",
    "text": "案安國學韓子及雜家說於騶縣田生之所。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p0",
    "annotator": "索隱",
    "text": "將音醬，扞音汗。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「景帝姊。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "索隱",
    "text": "案即館陶公主。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "正義",
    "text": "如淳云：「景帝妹也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "索隱",
    "text": "省音仙井反。省者，察也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "正義",
    "text": "謂關中也。又云京師在天下之中。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "索隱",
    "text": "案謂苛細小禮以責之。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p1",
    "annotator": "集解",
    "text": "徐廣曰：「侘，一作『絎』也。」駰案：侘音丑亞反，誇也。漢書作「嫮」，音火亞反。絎音寒孟反。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p2",
    "annotator": "集解",
    "text": "蒙，縣名。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p2",
    "annotator": "索隱",
    "text": "抵音丁禮反。蒙，縣名，屬梁國也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p2",
    "annotator": "索隱",
    "text": "案謂不足與繩持之。治音持也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p4",
    "annotator": "索隱",
    "text": "此語見國語。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p4",
    "annotator": "集解",
    "text": "如淳曰：「景帝嘗屬諸姬，太子母栗姬言不遜，由是廢太子，栗姬憂死。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p4",
    "annotator": "索隱",
    "text": "悅，漢書作「訹」。說文云「訹，誘也」。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p6",
    "annotator": "索隱",
    "text": "案晉灼云「不內屬於漢爲人」。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p6",
    "annotator": "集解",
    "text": "許慎曰：「魯之縞尤薄。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p7",
    "annotator": "集解",
    "text": "張晏曰：「豪猶帥也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a22",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p7",
    "annotator": "索隱",
    "text": "聶，姓也；翁壹，名也。漢書云「聶壹」。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a23",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「在鴈門。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a24",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p7",
    "annotator": "索隱",
    "text": "崔浩云「今平城直西百里有武州城」是也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a25",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "集解",
    "text": "漢書曰：「北貉燕人來致驍騎。」應劭曰：「驍，健也。」張晏曰：「驍，勇也，若六博之梟矣。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a26",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "正義",
    "text": "司馬續漢書云：「輕車，古之戰車。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a27",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "正義",
    "text": "李奇云：「監主諸屯。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a28",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "正義",
    "text": "臣瓚云：「材官，騎射之官。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a29",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "正義",
    "text": "釋名云：「輜，廁也。所載衣服雜廁其中。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a30",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p8",
    "annotator": "正義",
    "text": "幾音祈。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a31",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「禔，一作『祇』也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a32",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p9",
    "annotator": "集解",
    "text": "漢書音義曰：「逗，曲行避敵也；橈，顧望。軍法語也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a33",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p9",
    "annotator": "索隱",
    "text": "案如淳云「軍法，行而逗留畏橈者，腰斬」。逗音豆，又音住，逗留也。橈，屈弱也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a34",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p10",
    "annotator": "索隱",
    "text": "案：出者，去也。言安國爲人無忠厚之行。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a35",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p10",
    "annotator": "索隱",
    "text": "郅音質，他徒河反。謂三人姓名也，壺遂也，臧固也，郅他也。若漢書則云「至他」，言至於他處，亦舉名士也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a36",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p10",
    "annotator": "集解",
    "text": "如淳曰：「爲天子導引而墮車，跛足。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a37",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p11",
    "annotator": "集解",
    "text": "徐廣曰：「元光六年也。」"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a38",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p11",
    "annotator": "集解",
    "text": "蘢音龍。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a39",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p11",
    "annotator": "正義",
    "text": "幽州縣。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a40",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p11",
    "annotator": "正義",
    "text": "幽州漁陽縣東南七十七里北平城，即漢右北平也。"
  },
  {
    "id": "anno:shiji:shiji-韓長孺列傳第四十八:a41",
    "book": "shiji",
    "chapter_id": "shiji-韓長孺列傳第四十八",
    "target_para_id": "text:shiji:shiji-韓長孺列傳第四十八:p13",
    "annotator": "集解",
    "text": "徐廣曰：「一云『廉正忠厚』。」"
  }
]