[
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a0",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "索隱",
    "text": "韋昭云屬潁川，地理志云屬汝南。不同者，按郡縣之名隨代分割。蓋陽城舊屬汝南，史遷云今爲汝陰，後又分隸潁川，韋昭據以爲說，故其不同。他皆放此。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "正義",
    "text": "即河南陽城縣也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "索隱",
    "text": "夏音賈。韋昭云：「淮陽縣，後屬陳。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "正義",
    "text": "括地志云：「陳州太康縣，本漢陽夏縣也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "索隱",
    "text": "廣雅云：「傭，役也。」按：謂役力而受雇直也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p1",
    "annotator": "索隱",
    "text": "尸子云「鴻鵠之𪅏，羽翼未合，而有四海之心」是也。按：鴻鵠是一鳥，若鳳皇然，非謂鴻鴈與黃鵠也。鵠音戶酷反。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「在沛郡蘄縣。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "閭左謂居閭里之左也。秦時復除者居閭左。今力役凡在閭左者盡發之也。又云，凡居以富強爲右，貧弱爲左。秦役戍多，富者役盡，兼取貧弱者也。適音直革反，又音磔。故漢書有七科適。戍者，屯兵而守也。地理志漁陽縣名，在漁陽郡也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "正義",
    "text": "括地志云：「漁陽故城在檀州密雲縣南十八里，在漁水之陽也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "謂欲經營圖國，假使不成而敗，猶愈爲戍卒而死也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "姚氏按：隱士遺章邯書云「李斯爲二世廢十七兄而立今王」，則二世是始皇第十八子也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "如淳云「扶蘇自殺，故人不知其死」。或以爲不知何坐而死，故天下冤二世殺之，其意亦得。今宜依文而解，直是扶蘇爲二世所殺，而百姓未知，故欲詐自稱之也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "漢書作「倡」，倡謂先也。說文云：「倡，首也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "行者，先也。一云行，往也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "集解",
    "text": "蘇林曰：「狐鳴祠中則是也。」瓚曰：「假託鬼神以威衆也，故勝、廣曰『此教我威衆也』。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "裴注引蘇林、臣瓚義亦當矣。而李奇又云「卜者戒曰『所卜事雖成，當死爲鬼』，惡指斥言之，而勝失其旨，反依鬼神起怪」，蓋亦得本旨也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "念者，思也。謂思念欲假鬼神事耳。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "集解",
    "text": "漢書音義曰：「罾音曾。」文穎曰：「罾，魚網也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "集解",
    "text": "張晏曰：「戍人所止處也。叢，鬼所憑焉。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "服虔云「閒音『中閒』之『閒』」。鄭氏云「閒謂竊令人行也」。孔文祥又云「竊伺閒隙，不欲令衆知之也」。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "次，師所次舍處也。墨子云「建國必擇木之修茂者以爲叢位」。高誘注戰國策云「叢祠，神祠也。叢，樹也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「或作『帶』也。篝者，籠也，音溝。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a22",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p2",
    "annotator": "索隱",
    "text": "篝音溝。漢書作「搆」。郭璞云：「篝，籠也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a23",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "官也。漢舊儀「大縣二人，其尉將屯九百人」，故云將尉也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a24",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "集解",
    "text": "徐廣曰：「挺猶脫也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a25",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "徐廣云「挺，奪也」。按：奪即脫也。說文云「挺，拔也」。案：謂尉拔劔而廣因奪之，故得殺尉。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a26",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "集解",
    "text": "服虔曰：「藉，假也。弟，次弟也。」應劭曰：「藉，吏士名藉也。今失期當斬，就使藉弟幸得不斬，戍死者固十六七。此激怒其衆也。」蘇林曰：「弟，且也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a27",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "蘇林云「藉第，假借。且令失期不斬，則戍死者固十七八」。然弟一音「次第」之「第」。又小顏云「弟，但也」；劉氏云「藉音子夜反」；應劭讀如字，云「藉，吏士之名藉也」。各以意言，蘇說爲近之也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a28",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "大名謂大名稱也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a29",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "蘄音機，又音祈，縣名，屬沛郡。下者，降也。謂以兵臨而即降也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a30",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "韋昭云：「符離屬沛郡。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a31",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "集解",
    "text": "李奇云：「徇，略也。音辭峻反。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a32",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "集解",
    "text": "徐廣曰：「苦、柘屬陳，餘皆在沛也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a33",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "地理志陳縣屬淮陽。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a34",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "正義",
    "text": "今陳州城也。本楚襄王築，古陳國城也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a35",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "張晏云「郡守及令皆不在」，非也。按：地理志云秦三十六郡並無陳郡，則陳止是縣。言守令，則守非官也，與下守丞同也，則「皆」字是衍字。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a36",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "蓋謂陳縣之城門，一名麗譙，故曰譙門中，非上譙縣之門也。譙縣守已下訖故也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a37",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p3",
    "annotator": "索隱",
    "text": "按：李奇云「欲張大楚國，故稱張楚也」。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a38",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "索隱",
    "text": "地理志屬九江。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a39",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "正義",
    "text": "括地志云：「東城故城在濠州定遠縣東南五十里也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a40",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "索隱",
    "text": "三川，今洛陽也。地有伊、洛、河，故曰三川。秦曰三川，漢曰河南郡。李由，李斯子也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a41",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "集解",
    "text": "漢書音義曰：「房君，官號也，姓蔡，名賜。」瓚曰：「房邑君也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a42",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "索隱",
    "text": "房，邑也。爵之於房，號曰房君，蔡賜其姓名。晉灼按張耳傳，言「相國房君」者，蓋誤耳。涉始號楚，因楚有柱國之官，故以官蔡賜。蓋其時草創，亦未置相國之官也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a43",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p5",
    "annotator": "正義",
    "text": "豫州吳房縣，本房子國，是所封也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a44",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "集解",
    "text": "文穎曰：「即周章。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a45",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "集解",
    "text": "如淳曰：「視日時吉凶舉動之占也。司馬季主爲日者。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a46",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "正義",
    "text": "即京東戲亭也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a47",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "集解",
    "text": "服虔曰：「家人之產奴也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a48",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "索隱",
    "text": "按：漢書無「生」字，小顏云「猶今言家產奴也」。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a49",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "索隱",
    "text": "晉灼云：「亭名也，在弘農東十二里。」小顏云「曹水之陽也。其水出陝縣西南峴頭山，北流入河。魏武帝謂之好陽」也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a50",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "正義",
    "text": "括地志云：「曹陽故亭亦名好陽亭，在陝州桃林縣東南十四里。崔浩云『曹陽，阬名，自南出，北通於河』。按：魏武帝改曰好陽也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a51",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "正義",
    "text": "澠池，河南府縣是也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a52",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "集解",
    "text": "徐廣曰：「十一月。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a53",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p6",
    "annotator": "索隱",
    "text": "越系家「句踐使罪人三行，屬劔於頸，曰『不敢逃刑』，乃自剄」。郭璞注三蒼，以爲剄，刺也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a54",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p7",
    "annotator": "正義",
    "text": "成都，蜀郡縣，涉遙封之。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a55",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p7",
    "annotator": "索隱",
    "text": "趣音促。促謂催促也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a56",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p7",
    "annotator": "注",
    "text": "亟音棘。亟，急也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a57",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「今之臨濟。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a58",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p9",
    "annotator": "集解",
    "text": "應劭曰：「魏之諸公子，名咎。欲立六國後以樹黨。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a59",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p9",
    "annotator": "索隱",
    "text": "晉灼云「今在梁國也」。按：今梁國有寧陵縣是也，字轉異耳。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a60",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p9",
    "annotator": "正義",
    "text": "括地志云：「宋州寧陵縣城，古甯陵城也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a61",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p10",
    "annotator": "索隱",
    "text": "遣作遺，遺謂留餘也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a62",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p11",
    "annotator": "索隱",
    "text": "地理志陽城縣屬潁川。說音悅，凡人名皆音悅。郯音談。小顏云「東海之縣名」，非也。按：章邯軍此時未至東海，此郯別是地名。或恐「郯」當作「郟」，郟是郟鄏之地，或見下有東海郯，故誤。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a63",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p11",
    "annotator": "正義",
    "text": "屬海州，疑「郯」當作「郟」，音紀洽反。郟即春秋時郟地，楚郟敖葬之，今汝州郟城縣是。鄧悅是陽城人，陽城河南府縣，與郟城縣相近，又走陳，蓋「郟」字誤作「郯」耳。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a64",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p11",
    "annotator": "集解",
    "text": "徐廣曰：「一作『逢』。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a65",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p11",
    "annotator": "索隱",
    "text": "地理志銍，縣名，屬沛。伍徐，漢書作「伍逢」也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a66",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p11",
    "annotator": "正義",
    "text": "括地志云：「許州許昌縣，本漢許縣。地理志云許縣故國，姜姓，四岳之後，大叔所封，二十四君，爲楚所滅，漢以爲縣。魏文帝即位，改許曰許昌也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a67",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p12",
    "annotator": "集解",
    "text": "地理志泗水國有陵縣也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a68",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p12",
    "annotator": "索隱",
    "text": "地理志縣名，屬臨淮。音秋閭二音。取，又音子臾反。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a69",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p12",
    "annotator": "正義",
    "text": "今海州。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a70",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p12",
    "annotator": "集解",
    "text": "張晏曰：「畔，名也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a71",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p14",
    "annotator": "集解",
    "text": "張晏曰：「秦之臘月，夏之九月。」瓚曰：「建丑之月也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a72",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p14",
    "annotator": "索隱",
    "text": "臣瓚云：「建丑之月也。」顏游秦云：「按史記表『二世二年十月，誅葛嬰，十一月，周文死，十二月，陳涉死』是也。」宗懍荊楚記云：「臘節在十二月，故因是謂之臘月也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a73",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p14",
    "annotator": "索隱",
    "text": "按：舊以陳王從汝陰還至城父縣，因降之，故云「還至下城父」。又顧氏按郡國志，山乘縣有下城父聚，在城父縣東，下讀如字。其說爲得之。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a74",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p14",
    "annotator": "正義",
    "text": "音唐。今宋州碭山縣是。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a75",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "集解",
    "text": "應劭曰：「涓人，如謁者。將軍姓呂名臣也。」晉灼曰：「呂氏春秋『荊柱國莊伯令謁者駕，令涓人取冠』。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a76",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "索隱",
    "text": "涓音公玄反。服虔云：「給涓通也，如今謁者。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a77",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "集解",
    "text": "徐廣曰：「在汝南也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a78",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "索隱",
    "text": "韋昭云：「軍皆著青帽。故曰倉頭。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a79",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "正義",
    "text": "括地志云：「新陽故城在豫州真陽縣西南四十二里，漢新陽縣城。應劭云在新水之陽也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a80",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p15",
    "annotator": "索隱",
    "text": "爲，如字讀。謂又以陳地爲楚國。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a81",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p17",
    "annotator": "集解",
    "text": "徐廣曰：「正月，嘉爲上將軍。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a82",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p17",
    "annotator": "正義",
    "text": "房預二音。方與，兗州縣也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a83",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p17",
    "annotator": "正義",
    "text": "今曹州也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a84",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p18",
    "annotator": "索隱",
    "text": "按：即左右校尉軍也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a85",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p18",
    "annotator": "集解",
    "text": "鄱音婆。英布居江中爲羣盜，陳勝之起，布歸番君吳芮，故謂之「鄱盜」者也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a86",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p18",
    "annotator": "集解",
    "text": "漢書音義曰：「地名也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a87",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "集解",
    "text": "晉灼曰：「數音『朋友數，斯疏矣』。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a88",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "索隱",
    "text": "一音疏主反。謂自辯說，數與涉有故舊事驗也。又音朔。數謂自辯往數與涉有故。此數猶「朋友數」之「數」也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a89",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "集解",
    "text": "應劭曰：「沈沈，宮室深邃之貌也。沈音長含反。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a90",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "索隱",
    "text": "服虔云：「楚人謂多爲夥。」按：又言「頤」者，助聲之辭也。謂涉爲王，宮殿帷帳庶物夥多，驚而偉之，故稱夥頤也。應劭以爲沈沈，宮室深邃貌，故音長含反。而劉伯莊以「沈沈」猶「談談」，謂故人呼爲「沈沈」者，猶俗云「談談漢」是。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a91",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "索隱",
    "text": "顧氏引孔叢子云：「陳勝爲王，妻之父兄往焉。勝以衆賔待之。妻父怒云：『怙強而傲長者，不能久焉。』不辭而去。」是其事類也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a92",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p19",
    "annotator": "索隱",
    "text": "謂朱房、胡武等以素所不善者，即自驗問，不往下吏。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a93",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p21",
    "annotator": "集解",
    "text": "徐廣曰：「一作『太史公』。」駰案：班固奏事云「太史遷取賈誼過秦上下篇以爲秦始皇本紀、陳涉世家下贊文」，然則言「褚先生」者，非也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a94",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p21",
    "annotator": "索隱",
    "text": "徐廣與裴駰據所見別本及班彪奏事，皆云合作「太史公」。今據此是褚先生述史記，加此贊首地形險阻數句，然後始稱賈生之言，因即改太史公之目，而自題己位號也。已下義並已見始皇之本紀訖。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a95",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p22",
    "annotator": "集解",
    "text": "韋昭曰：「殽謂二殽。函，函谷關也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a96",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p23",
    "annotator": "正義",
    "text": "音聚。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a97",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p23",
    "annotator": "正義",
    "text": "邵，作「昭」。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a98",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p23",
    "annotator": "索隱",
    "text": "仰字亦作「卬」，並音仰。謂秦地形高，故並仰向關門而攻秦。有作「叩」字，非也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a99",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p23",
    "annotator": "索隱",
    "text": "九國者，謂六國之外，更有宋、衞、中山。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a100",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p23",
    "annotator": "索隱",
    "text": "說文云：「櫓，大楯也。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a101",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p25",
    "annotator": "索隱",
    "text": "臣瓚云：「短曰敲，長曰朴。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a102",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p25",
    "annotator": "索隱",
    "text": "貫音烏還反，又如字。貫謂上弦也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a103",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p25",
    "annotator": "集解",
    "text": "徐廣曰：「一作『鏑』。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a104",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p25",
    "annotator": "索隱",
    "text": "各重千石，坐高二丈，號曰「翁仲」。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a105",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p25",
    "annotator": "索隱",
    "text": "音呵，亦「何」字，猶今廵更問何誰。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a106",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p26",
    "annotator": "集解",
    "text": "徐廣曰：「田民曰甿。音亡更反。」"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a107",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p26",
    "annotator": "索隱",
    "text": "仟佰謂千人百人之長也，音千百。漢書作「阡陌」，如淳云「時皆僻屈在阡陌之中」。陌音貊。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a108",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p27",
    "annotator": "索隱",
    "text": "鉏耰謂鉏木也。論語曰「耰而不輟」是也。棘，戟也。矜，戟柄也，音勤。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a109",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p27",
    "annotator": "索隱",
    "text": "鄉音香亮反。鄉時猶往時也。蓋謂孟嘗、信陵、蘇秦、陳軫之比也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a110",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p27",
    "annotator": "索隱",
    "text": "絜音下結反。謂如結束知其大小也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a111",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p27",
    "annotator": "索隱",
    "text": "謂秦強而抑八州使朝己也。漢書作「招八州」，亦通也。"
  },
  {
    "id": "anno:shiji:shiji-陳涉世家第十八:a112",
    "book": "shiji",
    "chapter_id": "shiji-陳涉世家第十八",
    "target_para_id": "text:shiji:shiji-陳涉世家第十八:p27",
    "annotator": "索隱",
    "text": "施音式豉反。言秦虎狼之國，其仁義不施及於天下，故亡也。"
  }
]