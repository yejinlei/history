[
  {
    "id": "anno:shiji:shiji-三皇本紀:a0",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p1",
    "annotator": "集解",
    "text": "按伏犧風姓，出國語。其華胥已下，出帝王世紀。然雷澤，澤名，即舜所漁之地，在濟陰。成紀亦地名，按天水有成紀縣。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a1",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p1",
    "annotator": "集解",
    "text": "按譙周古史考，伏犧制嫁娶，以儷皮爲禮也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a2",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p1",
    "annotator": "集解",
    "text": "按事出漢書歷志。宓，音伏。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a3",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p1",
    "annotator": "集解",
    "text": "按位在東方，象日之明，故稱太皡。皡，明也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a4",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p1",
    "annotator": "集解",
    "text": "按皇甫謐，伏犧葬南郡，或曰冢在山陽高平之西也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a5",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p2",
    "annotator": "集解",
    "text": "按禮明堂位及系本，皆云女媧作簧。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a6",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p2",
    "annotator": "集解",
    "text": "按其事出淮南子也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a7",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p3",
    "annotator": "集解",
    "text": "按三皇記者不同，譙周以燧人爲皇，宋均以祝融爲皇，而鄭玄依春秋緯，以女媧爲皇，承伏犧，皇甫謐亦同，今依之爲說也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a8",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p3",
    "annotator": "集解",
    "text": "按國語，炎帝，黃帝皆少典之子，其母又皆有媧氏之女。據諸子及古史考，炎帝之後，凡八代，五百餘年，軒轅氏代之。豈炎帝、黃帝，是昆弟而同母氏乎？皇甫謐以爲少典有媧氏諸侯國號，然則姜姬二帝，同出少典氏，黃帝之母，又是神農母氏之後代女，所同是有媧氏之女也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a9",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p3",
    "annotator": "集解",
    "text": "按今淮陽有神農井。又左傳，魯有大庭氏之庫是也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a10",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p3",
    "annotator": "集解",
    "text": "按鄭玄云，厲山，神農所起，亦曰有烈山。皇甫謐曰，厲山今隨之厲鄉也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a11",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p4",
    "annotator": "集解",
    "text": "按神農之後凡八代，事見帝王代紀及古史考。然古典亡矣，況譙皇二氏，皆前聞君子，考按古書而爲此說。豈至今鑿空乎？此紀示據以爲說。其易稱，神農氏沒，即榆罔，榆罔猶襲神農之號也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a12",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p6",
    "annotator": "注",
    "text": "盖天地初立，神人首出行化，故其年世長久也。然言十二頭者，非謂一人之身有十二頭，盖古質，比之鳥獸頭數故也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a13",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p6",
    "annotator": "注",
    "text": "天皇已下，皆出河圖及三五曆也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a14",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p7",
    "annotator": "注",
    "text": "五龍氏，兄弟五人，並乘龍上下，故曰五龍氏也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a15",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p7",
    "annotator": "集解",
    "text": "按其君鑽燧出火，教人熟食，在伏犧氏前，譙周以爲三皇之首也。"
  },
  {
    "id": "anno:shiji:shiji-三皇本紀:a16",
    "book": "shiji",
    "chapter_id": "shiji-三皇本紀",
    "target_para_id": "text:shiji:shiji-三皇本紀:p7",
    "annotator": "集解",
    "text": "按皇甫謐以爲大庭以下一十五君，皆襲庖犧之號。事不經見，難可依從。然按古封太山者，首有無懷氏，乃在太昊之前，豈得如謐所說？"
  }
]