[
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a0",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "索隱",
    "text": "韋昭云「留，今屬彭城」。按：良求封留，以始見高祖於留故也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a1",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "正義",
    "text": "括地志云：「故留城在徐州沛縣東南五十五里。今城內有張良廟也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a2",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "索隱",
    "text": "漢書云字子房。按：王符、皇甫謐並以良爲韓之公族，姬姓也。秦索賊急，乃改姓名。而韓先有張去疾乃張譴，恐非良之先代。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a3",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "索隱",
    "text": "良旣歷代相韓，故知其先韓人。顧氏按：後漢書云「張良出於城父」，城父縣屬潁川也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a4",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "正義",
    "text": "括地志云：「城父在汝州郟城縣東三十里，韓里也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a5",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "集解",
    "text": "應劭曰：「大父，祖父。開地，名。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a6",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "注",
    "text": "韓系家及系本作桓惠王。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a7",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p0",
    "annotator": "索隱",
    "text": "謂大父及父相韓五王，故云五世。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a8",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "正義",
    "text": "今陳州也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a9",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "集解",
    "text": "如淳曰：「秦郡縣無倉海。或曰東夷君長。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a10",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "索隱",
    "text": "姚察以武帝時東夷穢君降，爲倉海郡，或因以名，蓋得其近也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a11",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "正義",
    "text": "漢書武帝紀云「元年，東夷穢君南閭等降，爲倉海郡，今貊穢國」，得之。太史公修史時已降爲郡，自書之。括地志云：「穢貊在高麗南，新羅北，東至大海西。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a12",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "集解",
    "text": "服虔曰：「狙，伺候也。」應劭曰：「狙，七預反，伺也。」徐廣曰：「伺候也，音千恕反。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a13",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "索隱",
    "text": "按：應劭云「狙，伺也。」一曰狙，伏伺也，音七豫反。謂狙之伺物，必伏而候之，故今云「狙候」是也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a14",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "索隱",
    "text": "服虔云「地在陽武南」。按：今浚儀西北四十里有博浪城。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a15",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "正義",
    "text": "晉地理記云「鄭陽武縣有博浪沙」。按：今當官道也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a16",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p1",
    "annotator": "索隱",
    "text": "按：漢官儀天子屬車三十六乘。屬車即副車，而奉車郎御而從後。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a17",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「圯，橋也，東楚謂之圯。音怡。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a18",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "索隱",
    "text": "嘗訓經也。閒，閑字也。從容，閒暇也。從容謂從任其容止，不矜莊也。邳，被眉反。按：地理志下邳縣屬東海。又云邳在薛，後徙此。有上邳，故此曰下邳也。李奇云「下邳人謂橋爲圯，音怡」。文穎曰「沂水上橋也」。應劭云「沂水之上也」。姚察見史記本有作土旁者，乃引今會稽東湖大橋名爲靈圯。圯亦音夷，理或然也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a19",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "索隱",
    "text": "崔浩云「直猶故也」，亦恐不然。直言正也，謂至良所正墮其履也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a20",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一云『良怒，欲罵之』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a21",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "索隱",
    "text": "毆音烏后反。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a22",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "索隱",
    "text": "業猶本先也。謂良心先已爲取履，故遂跪而履之。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a23",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一曰『爲其老，強忍，下取履，因進之。父以足受，笑而去。良殊大驚。父去里所，復還』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a24",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "集解",
    "text": "徐廣曰：「編，一作『篇』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a25",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "正義",
    "text": "括地志云：「穀城山一名黃山，在濟州東阿縣東。濟州，故濟北郡。孔文祥云『黃石公鬚眉皆白狀，杖丹黎，履赤舄』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a26",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p2",
    "annotator": "正義",
    "text": "七錄云：「太公兵法一袠三卷。太公，姜子牙，周文王師，封齊侯也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a27",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p3",
    "annotator": "集解",
    "text": "漢書音義曰：「官名。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a28",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p3",
    "annotator": "索隱",
    "text": "殆訓近也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a29",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p4",
    "annotator": "集解",
    "text": "徐廣曰：「即司徒耳，但語音訛轉，故字亦隨改。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a30",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p5",
    "annotator": "集解",
    "text": "徐廣曰：「嶢音堯。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a31",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p5",
    "annotator": "集解",
    "text": "徐廣曰：「五，一作『百』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a32",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p5",
    "annotator": "索隱",
    "text": "旗幟音其試二音。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a33",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p5",
    "annotator": "索隱",
    "text": "謂卒將離心而懈怠。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a34",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p6",
    "annotator": "集解",
    "text": "徐廣曰：「一本『噲諫曰：「沛公欲有天下邪？將欲爲富家翁邪？」沛公曰：「吾欲有天下。」噲曰：「今臣從入秦宮，所觀宮室帷帳珠玉重寶鍾鼓之飾，奇物不可勝極，入其後宮，美人婦女以千數，此皆秦所以亡天下也。願沛公急還霸上，無留宮中。」沛公不聽』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a35",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p6",
    "annotator": "集解",
    "text": "晉灼曰：「資，藉也。欲沛公反秦奢泰，服儉素以爲藉也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a36",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p6",
    "annotator": "索隱",
    "text": "按：此語見孔子家語。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a37",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p7",
    "annotator": "集解",
    "text": "徐廣曰：「呂靜曰鯫，魚也，音此垢反。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a38",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p7",
    "annotator": "索隱",
    "text": "呂靜云「鯫，魚也，謂小魚也，音此垢反」。臣瓚按：楚漢春秋鯫生本姓解。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a39",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p8",
    "annotator": "集解",
    "text": "如淳曰：「本但與巴蜀，故請漢中地。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a40",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p8",
    "annotator": "正義",
    "text": "括地志云：「襃谷在梁州襃城縣北五十里南中山。昔秦欲伐蜀，路無由入，乃刻石爲牛五頭，置金於後，偽言此牛能屎金，以遺蜀。蜀侯貪，信之，乃令五丁共引牛，塹山堙谷，致之成都。秦遂尋道伐之，因號曰石牛道。蜀賦以石門在漢中之西，襃中之北是。」又云：「斜水源出襃城縣西北衙嶺山，與襃水同源而流派。漢書溝洫志示襃水通沔，斜水通渭，皆以行船。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a41",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "集解",
    "text": "張晏曰：「求借所食之箸用指畫也。或曰前世湯武箸明之事，以籌度今時之不若也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a42",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "索隱",
    "text": "按：崔浩云「表者，標榜其里門也」。商容，紂時賢人也。韓詩外傳曰「商容執羽籥馮於馬徒，欲以化紂而不能，遂去，伏於太行山。武王欲以爲三公，固辭不受」。餘解在商紀。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a43",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "集解",
    "text": "徐廣曰：「釋，一作『式』。拘，一作『囚』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a44",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "集解",
    "text": "如淳曰：「革者，革車也；軒者，赤黻乘軒也。偃武備而治禮樂也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a45",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "索隱",
    "text": "蘇林云：「革者，兵車也；軒者，朱軒皮軒也。謂廢兵車而用乘車也。」說文云：「軒，曲周屏車。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a46",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "索隱",
    "text": "按：晉灼云「在弘農閺鄉南谷中」。應劭曰十三州記「弘農有桃丘聚，古桃林也」。山海經云「夸父之山，北有桃林，廣三百里」也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a47",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "集解",
    "text": "漢書音義曰：「唯當使楚無彊，彊則六國弱從之。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a48",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "索隱",
    "text": "按：荀悅漢紀說此事云「獨可使楚無彊，若彊，則六國屈橈而從之」。又韋昭云「今無彊楚者，言六國立必復屈橈從楚」。是二說意同也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a49",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p11",
    "annotator": "索隱",
    "text": "高祖罵酈生爲豎儒，謂此儒生豎子耳。幾音祈。幾者，殆近也。而公，高祖自謂也。漢書作「乃公」，乃亦汝也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a50",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p14",
    "annotator": "集解",
    "text": "如淳曰：「復音複。上下有道，故謂之復道。」韋昭曰：「閣道。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a51",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p14",
    "annotator": "集解",
    "text": "徐廣曰：「多作『生平』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a52",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p14",
    "annotator": "集解",
    "text": "漢書音義曰：「未起時有故怨。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a53",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p14",
    "annotator": "索隱",
    "text": "地理志縣名，屬廣漢。什音十。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a54",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p14",
    "annotator": "正義",
    "text": "括地志云：「雍齒城在益州什邡縣南四十步。漢什邡縣，漢初封雍齒爲侯國。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a55",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "正義",
    "text": "殽，二殽山也，在洛州永寧縣西北二十八里。函谷關在陝州桃林縣西南十二里。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a56",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "正義",
    "text": "隴山南連蜀之岷山，故云右隴蜀也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a57",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "索隱",
    "text": "崔浩云：「苑馬牧外接胡地，馬生於胡，故云胡苑之利。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a58",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "正義",
    "text": "博物志云「北有胡苑之塞」。按：上郡、北地之北與胡接，可以牧養禽獸，又多致胡馬，故謂胡苑之利也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a59",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "索隱",
    "text": "按：此言「謂」者，皆是依憑古語。言秦有四塞之國，如金城也。故淮南子云「雖有金城，非粟不守」。又蘇秦說秦惠王云「秦地勢形便，所謂天府」。是所憑也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a60",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p15",
    "annotator": "索隱",
    "text": "按：周禮「二曰詢國遷」，乃爲大事。高祖即日西遷者，蓋謂其日即定計耳，非即日遂行也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a61",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p16",
    "annotator": "集解",
    "text": "漢書音義曰：「服辟穀之藥，而靜居行氣。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a62",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p17",
    "annotator": "索隱",
    "text": "四人，四皓也，謂東園公、綺里季、夏黃公、角里先生。按：陳留志云「園公姓庾，字宣明，居園中，因以爲號。夏黃公姓崔名廣，字少通，齊人，隱居夏里修道，故號曰夏黃公。角里先生，河內軹人，太伯之後，姓周名術，字元道，京師號曰霸上先生，一曰角里先生」。又孔安國祕記作「祿里」。此皆王劭據崔氏、周氏系譜及陶元亮四八目而爲此說。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a63",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "索隱",
    "text": "此語出韓子。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a64",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "集解",
    "text": "徐廣曰：「夷猶儕也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a65",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "索隱",
    "text": "如淳云：「等夷，言等輩。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a66",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "集解",
    "text": "晉灼曰：「鼓行而西，言無所畏也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a67",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "集解",
    "text": "司馬彪曰：「長安縣東有曲郵聚。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a68",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p18",
    "annotator": "索隱",
    "text": "郵音尤。按：司馬彪漢書郡國志長安有曲郵聚。今在新豐西，俗謂之郵頭。漢書舊儀云「五里一郵，郵人居閒，相去二里半」。按：郵乃今之候也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a69",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p19",
    "annotator": "集解",
    "text": "如淳曰：「調護猶營護也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a70",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p19",
    "annotator": "集解",
    "text": "韋昭曰：「繳，弋射也。其矢曰矰。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a71",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p19",
    "annotator": "索隱",
    "text": "馬融注周禮云：「矰者，繳繫短矢謂之矰。」一說云矰，一弦，可以仰高射，故云矰也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a72",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p19",
    "annotator": "索隱",
    "text": "音曲穴反，謂曲終也。說文曰：「闋，事也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a73",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "集解",
    "text": "徐廣曰：「一云『出奇計下馬邑』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a74",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "集解",
    "text": "漢書音義曰：「何時未爲相國，良勸高祖立之。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a75",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "索隱",
    "text": "春秋緯云：「舌在口，長三寸，象斗玉衡。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a76",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "索隱",
    "text": "赤松子，神農時雨師，能入火自燒崑崙山上，隨風雨上下也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a77",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "集解",
    "text": "徐廣曰：「一云『乃學道引，欲輕舉』也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a78",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p20",
    "annotator": "索隱",
    "text": "辟音賔亦反。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a79",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p21",
    "annotator": "集解",
    "text": "徐廣曰：「文成侯立十六年卒，子不疑代立。十年，坐與門大夫吉謀殺故楚內史，當死，贖爲城旦，國除。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a80",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p22",
    "annotator": "集解",
    "text": "徐廣曰：「史記珍寶字皆作『葆』。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a81",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p22",
    "annotator": "正義",
    "text": "括地志云：「漢張良墓在徐州沛縣東六十五里，與留城相近也。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a82",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p24",
    "annotator": "索隱",
    "text": "按：物謂精怪及藥物也。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a83",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p24",
    "annotator": "索隱",
    "text": "按：詩緯云「風后，黃帝師，又化爲老子，以書授張良」。亦異說。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a84",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p24",
    "annotator": "集解",
    "text": "應劭曰：「魁梧，丘虛壯大之意。」"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a85",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p24",
    "annotator": "索隱",
    "text": "蘇林云「梧音忤」。蕭該云「今讀爲吾，非也」。小顏云「言其可驚悟」。"
  },
  {
    "id": "anno:shiji:shiji-留侯世家第二十五:a86",
    "book": "shiji",
    "chapter_id": "shiji-留侯世家第二十五",
    "target_para_id": "text:shiji:shiji-留侯世家第二十五:p24",
    "annotator": "索隱",
    "text": "子羽，澹臺滅明字也。仲尼弟子傳云「狀貌甚惡」。又韓子云「子羽有君子之容，而行不稱其貌」，與史記文相反。"
  }
]