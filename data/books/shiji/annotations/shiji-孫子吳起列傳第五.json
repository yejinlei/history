[
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a0",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p0",
    "annotator": "正義",
    "text": "魏武帝云：「孫子者，齊人。事於吳王闔閭，爲吳將，作兵法十三篇。」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a1",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p0",
    "annotator": "正義",
    "text": "七錄云孫子兵法三卷。案：十三篇爲上卷，又有中下二卷。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a2",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p0",
    "annotator": "索隱",
    "text": "上音徒對反。下音竹兩反。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a3",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p0",
    "annotator": "索隱",
    "text": "趣音促，謂急也。下「使」音色吏反。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a4",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p1",
    "annotator": "集解",
    "text": "越絕書曰：「吳縣巫門外大冢，孫武冢也，去縣十里。」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a5",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p1",
    "annotator": "索隱",
    "text": "按：越絕書云是子貢所著，恐非也。其書多記吳越亡後土地，或後人所錄。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a6",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p1",
    "annotator": "正義",
    "text": "七錄云越絕十六卷，或云伍子胥撰。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a7",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p1",
    "annotator": "索隱",
    "text": "臏，頻忍反。龐，皮江反。涓，古玄反。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a8",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p2",
    "annotator": "正義",
    "text": "今汴州。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a9",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p2",
    "annotator": "索隱",
    "text": "弟，但也。重射謂好射也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a10",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p2",
    "annotator": "正義",
    "text": "射音石。隨逐而射賭千金。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a11",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p2",
    "annotator": "索隱",
    "text": "按：質猶對也。將欲對射之時也。一云質謂堋，非也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a12",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p3",
    "annotator": "索隱",
    "text": "謂事之雜亂紛糾也。解雜亂紛糾者，當善以手解之，不可控捲而擊之。捲即拳也。劉氏云「控，綜；捲，縮」，非也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a13",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p3",
    "annotator": "索隱",
    "text": "博戟二音。按：謂救鬬者當善撝解之，無以手助相搏撠，則其怒益熾矣。按：撠，以手撠刺人。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a14",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p3",
    "annotator": "索隱",
    "text": "批音白結反。亢音苦浪反。按：批者，相排批也。音白滅反。亢者，敵人相亢拒也。擣者，擊也，衝也。虛者，空也。按：謂前人相亢，必須批之。彼兵若虛，則衝擣之。欲令擊梁之虛也。此當是古語，故孫子以言之也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a15",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p3",
    "annotator": "索隱",
    "text": "謂若批其相亢，擊擣彼虛，則是事形相格而其勢自禁止，則彼自爲解兵也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a16",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p3",
    "annotator": "索隱",
    "text": "謂齊今引兵據大梁之衝，是衝其方虛之時，梁必釋趙而自救，是一舉釋趙而斃魏。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a17",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p4",
    "annotator": "索隱",
    "text": "王劭按紀年云「梁惠王十七年，齊田忌敗梁于桂陵，至二十七年十二月，齊田肦敗梁於馬陵」，計相去無十五歲也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a18",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p4",
    "annotator": "注",
    "text": "集解魏武帝曰：「蹶猶挫也。」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a19",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p4",
    "annotator": "索隱",
    "text": "蹶音巨月反。劉氏云：「蹶猶斃也。」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a20",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p4",
    "annotator": "索隱",
    "text": "豎子謂孫臏。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a21",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p7",
    "annotator": "索隱",
    "text": "按王劭云：「此李克言吳起貪。下文云『魏文侯知起廉，盡能得士心』，又公叔之僕稱起『爲人節廉』，豈前貪而後廉，何言之相反也？」今按：李克言起貪者，起本家累千金，破產求仕，非實貪也；蓋言貪者，是貪榮名耳，故母死不赴，殺妻將魯是也。或者起未委質於魏，猶有貪跡，及其見用，則盡廉能，亦何異乎陳平之爲人也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a22",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p8",
    "annotator": "索隱",
    "text": "吮，鄒氏音弋軟反，又才軟反。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a23",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p10",
    "annotator": "集解",
    "text": "瓚曰：「今河南城爲直之。」皇甫謐曰：「壺關有羊腸阪，在太原晉陽西北九十里。」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a24",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p10",
    "annotator": "索隱",
    "text": "劉氏按：紂都朝歌，今孟山在其西。今言左，則東邊別有孟門也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a25",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p10",
    "annotator": "集解",
    "text": "楊子法言曰：「美哉言乎！使起之用兵每若斯，則太公何以加諸！」"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a26",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p11",
    "annotator": "索隱",
    "text": "按：呂氏春秋作「商文」。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a27",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p12",
    "annotator": "索隱",
    "text": "韓之公族。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a28",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p13",
    "annotator": "索隱",
    "text": "楚系家悼王名疑也。"
  },
  {
    "id": "anno:shiji:shiji-孫子吳起列傳第五:a29",
    "book": "shiji",
    "chapter_id": "shiji-孫子吳起列傳第五",
    "target_para_id": "text:shiji:shiji-孫子吳起列傳第五:p13",
    "annotator": "索隱",
    "text": "肅王臧也。"
  }
]