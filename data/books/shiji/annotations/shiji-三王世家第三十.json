[
  {
    "id": "anno:shiji:shiji-三王世家第三十:a0",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p0",
    "annotator": "索隱",
    "text": "霍去病也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a1",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p0",
    "annotator": "索隱",
    "text": "按；明堂月令云「季夏月，可以封諸侯，立大官」是也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a2",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "按：奏狀有尚書令官位，而史先闕其名耳。丞非者，或尚書左右丞，非其名也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a3",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "莊青翟也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a4",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "張湯。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a5",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "蓋趙充也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a6",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "李息。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a7",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "索隱",
    "text": "任安也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a8",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "正義",
    "text": "公孫賀。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a9",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p1",
    "annotator": "集解",
    "text": "徐廣曰：「一作『閞』。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a10",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p2",
    "annotator": "索隱",
    "text": "左傳曰「天生蒸民，立君以司牧之」，是言生人爲立君長司牧之耳，非天爲君而生人也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a11",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一作『敦』，一作『勖』，一作『觀』也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a12",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p2",
    "annotator": "索隱",
    "text": "謂皇子等並未習教義也。皇子未習教義，而彊使爲諸侯王，以君連城之人，則大臣何有所勸？"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a13",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "蕭何謚文終也。按：蕭何初封沛之酇，音贊。後其子續封南陽之酇，音嵯。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a14",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "公孫弘平津侯。平津，高成之鄉名。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a15",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "正義",
    "text": "公孫弘所封平津鄉，在滄州鹽山南四十二里也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a16",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "謂武帝廣推恩之詔，分王諸侯王子弟，故有百餘國。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a17",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "謂諸侯王子已爲列侯，而今又家皇子爲列侯，是尊卑相踰越矣。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a18",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "齊王也，王夫人子。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a19",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "燕王也。漢書云李姬子。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a20",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p3",
    "annotator": "索隱",
    "text": "廣陵王也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a21",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p4",
    "annotator": "集解",
    "text": "公羊傳曰：「魯祭周公，牲用白牡，魯公用騂剛。」何休曰：「白牡，殷牲也。騂剛，赤脊，周牲也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a22",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p4",
    "annotator": "集解",
    "text": "何休曰：「不毛，不純色也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a23",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "集解",
    "text": "鄭玄曰：「春秋變周之文，從殷之質，合伯、子、男以爲一，則殷爵三等者，公、侯、伯也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a24",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "索隱",
    "text": "春秋公羊傳文。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a25",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "索隱",
    "text": "謂王與列侯。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a26",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "正義",
    "text": "匈奴傳云霍去病伐匈奴，北臨翰海。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a27",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "正義",
    "text": "溱音臻。氏音支。至月氏。月氏，西戎國名，在蔥嶺之西也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a28",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "集解",
    "text": "詩云：「元戎十乘，以先啟行。」韓嬰章句曰：「元戎，大戎，謂兵車也。車有大戎十乘，謂車縵輪，馬被甲，衡扼之上盡有劔戟，名曰陷軍之車，所以冒突先啟敵家之行伍也。」毛傳曰：「夏后氏曰鉤車，先正也。殷曰寅車，先疾也。周曰元戎，先良也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a29",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "索隱",
    "text": "謂立膠東王子慶爲六安王，常山王子平爲真定王，子商爲泗水王是也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a30",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p5",
    "annotator": "索隱",
    "text": "時諸王稱「國」，列侯稱「家」也，故云「家皇子」爲尊卑失序。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a31",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p6",
    "annotator": "集解",
    "text": "徐廣曰：「蕭何之玄孫酇侯壽成，後爲太常也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a32",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p6",
    "annotator": "索隱",
    "text": "謂地爲「輿」者：天地有覆載之德，故謂天爲「蓋」，謂地爲「輿」，故地圖稱「輿地圖」。疑自古有此名，非始漢也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a33",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p9",
    "annotator": "集解",
    "text": "徐廣曰：「一云元狩。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a34",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p10",
    "annotator": "索隱",
    "text": "此封齊王策文也。又按武帝集，此三王策皆武帝手製。於戲音嗚呼。戲或音羲。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a35",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p10",
    "annotator": "集解",
    "text": "張晏曰：「王者以五色土爲太社，封四方諸侯，各以其方色土與之，苴以白茅，歸以立社。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a36",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p10",
    "annotator": "索隱",
    "text": "蔡邕獨斷云：「皇子封爲王，受天子太社之土，若封東方諸侯，則割青土，藉以白茅，授之以立社，謂之『茅土』。」齊在東方，故云青社。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a37",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p10",
    "annotator": "索隱",
    "text": "謂若不圖於義，則君子懈怠，無歸附心。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a38",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p10",
    "annotator": "集解",
    "text": "徐廣曰：「立八年，無後，絕。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a39",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "褚先生解云：「維者，度也。稽者，當也。言當順古道也。」魏高貴鄉公云：「稽，同也。古，天也。謂堯能同天。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a40",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "按：匈奴傳曰「其國貴壯賤老，壯者食肥美，老者食其餘」，是虐老也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a41",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "邊甿。韋昭云：「甿，民也。」三倉云：「邊人云甿。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a42",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "集解",
    "text": "張晏曰：「時所獲三十二帥也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a43",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "集解",
    "text": "如淳曰：「偃其旗鼓而來降。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a44",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "漢書「君」作「帥」，「期」作「旗」。而服虔云以三十二軍中之將，下旗去之也。如淳云即昆邪王偃旗鼓降時也。若如此意，則三十二君非軍將，蓋戎狄酋帥時有三十二君來降也。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a45",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "集解",
    "text": "張晏曰：「匈奴徙東也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a46",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "注",
    "text": "臣瓚曰：「綏，安也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a47",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "集解",
    "text": "徐廣曰：「俷，一作『菲』。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a48",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "無菲德。蘇林云：「菲，廢也。本亦作『俷』，俷，敗也。」孔文祥云：「菲，薄也。」漢書作「棐」。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a49",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "正義",
    "text": "俷音符味反。"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a50",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "褚先生解云：「言無乏武備，常備匈奴也。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a51",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "集解",
    "text": "張晏曰：「士不素習，不應召。」"
  },
  {
    "id": "anno:shiji:shiji-三王世家第三十:a52",
    "book": "shiji",
    "chapter_id": "shiji-三王世家第三十",
    "target_para_id": "text:shiji:shiji-三王世家第三十:p12",
    "annotator": "索隱",
    "text": "韋昭云：「士非素教習，不得從軍徵發。故孔子曰『不教人戰，是謂弃之』是也。」褚先生解云：「非習禮義，不得在其側也。」"
