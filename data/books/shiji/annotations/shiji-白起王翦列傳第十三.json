    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "郿音眉，岐州縣。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a1",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "索隱",
    "text": "在河南也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a2",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "今洛州伊闕。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a3",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "今洛州南十九里伊闕山，號曰龍門是也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a4",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "言太尉。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a5",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "集解",
    "text": "徐廣曰：「音干。」駰案：郭璞曰：「今河東聞喜縣東北有乾河口，因名乾河里，但有故溝處，無復水也。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a6",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "索隱",
    "text": "魏以安邑入秦，然安邑以東至乾河皆韓故地，故云取韓安邑。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a7",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "集解",
    "text": "徐廣曰：「河東垣縣。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a8",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "索隱",
    "text": "地理志不載光狼城，蓋屬趙國。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a9",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "光狼故城在澤州高平縣西二十五里也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a10",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "集解",
    "text": "徐廣曰：「昭王二十八年。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a11",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "鄢鄧二邑在襄州。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a12",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "夷陵，今峽州郭下縣。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a13",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "故城在郢州長壽縣南百五十里，今復州亦是其地也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a14",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "陘庭故城在曲沃縣西北二十里，在絳州東北三十五里也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a15",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "集解",
    "text": "徐廣曰：「此南陽，河內脩武是也。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a16",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p0",
    "annotator": "正義",
    "text": "案：南陽屬韓，秦攻之，則韓太行羊腸道絕矣。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a17",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p1",
    "annotator": "索隱",
    "text": "地理志野王縣屬河內，在太行東南。孟康曰「古邢國也」。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a18",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p1",
    "annotator": "集解",
    "text": "徐廣曰：「河南新鄭，韓之國都是也。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a19",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p1",
    "annotator": "索隱",
    "text": "鄭國即韓之都，在河南。秦伐野王，是上黨歸韓之道絕也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a20",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p1",
    "annotator": "索隱",
    "text": "平陽君未詳何人。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a21",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p1",
    "annotator": "正義",
    "text": "常山一名華陽，解在趙世家。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a22",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p2",
    "annotator": "集解",
    "text": "徐廣曰：「屬潁川。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a23",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p2",
    "annotator": "索隱",
    "text": "今其地闕。西河別有藺縣也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a24",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p2",
    "annotator": "正義",
    "text": "按檢諸地記，潁川無藺。括地志云：「洛州嵩縣本夏之綸國也，在緱氏東南六十里。」地埋志云：「綸氏屬潁川郡。」按：旣攻緱氏、藺，二邑合相近，恐綸藺聲相似，字隨音而轉作「藺」。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a25",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "集解",
    "text": "音紇。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a26",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "集解",
    "text": "徐廣曰：「在泫氏。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a27",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "地理志泫氏今在上黨郡也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a28",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "長平故城在澤州高平縣西二十一里也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a29",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "謂屯兵長平，以據援上黨。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a30",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "謂犯秦之斥候兵也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a31",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "音加，裨將名也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a32",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "鄣，堡城。尉，官也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a33",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "括地志云：「趙鄣故城一名都尉城，今名趙東城，在澤州高平縣西二十五里。又有故穀城。此二城即二鄣也。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a34",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "集解",
    "text": "徐廣曰：「一作『乘』。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a35",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "趙西壘在澤州高平縣北六里是也。即廉頗堅壁以待秦，王齕奪趙西壘壁者。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a36",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "數音朔。挑，田鳥反。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a37",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "紀莧反。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a38",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "詳音羊。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a39",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "秦壁一名秦壘，今亦名秦長壘。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a40",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "趙壁今名趙東壘，亦名趙東長壘，在澤州高平縣北五里，即趙括築壁敗處。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a41",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "正義",
    "text": "時已屬秦，故發其兵。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a42",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p3",
    "annotator": "索隱",
    "text": "時已屬秦，故發其兵。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a43",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "索隱",
    "text": "秦前攻趙已破上黨，今迴兵復定其郡，其餘城猶屬趙也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a44",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "正義",
    "text": "故城在絳州龍門縣西一里。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a45",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "正義",
    "text": "太原，趙地，秦定取也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a46",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "正義",
    "text": "鄢在襄州率道縣南九里。郢在荊州江陵縣東六里。漢中，今梁州之地。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a47",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "集解",
    "text": "徐廣曰：「平臯有邢丘。」"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a48",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "正義",
    "text": "邢丘，今懷州武德縣東南二十里平臯縣城是也。"
  },
  {
    "id": "anno:shiji:shiji-白起王翦列傳第十三:a49",
    "book": "shiji",
    "chapter_id": "shiji-白起王翦列傳第十三",
    "target_para_id": "text:shiji:shiji-白起王翦列傳第十三:p5",
    "annotator": "集解",
    "text": "徐廣曰：「亡音無也。」"
  },
