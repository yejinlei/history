[
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a0",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p0",
    "annotator": "集解",
    "text": "漢書音義曰：「諱啟。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a1",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p0",
    "annotator": "正義",
    "text": "謚法曰：「繇義而濟曰景。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a2",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "集解",
    "text": "徐廣曰：漢書亦作「係」。鄒誕生本作「傒」，音奚。又按：漢書功臣表及蕭何傳皆云孫嘉，疑其人有二名。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a3",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "索隱",
    "text": "註同。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a4",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "索隱",
    "text": "音附。荀悅云：「傅，正卒也。」小顏云舊法二十三而傅，今改也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a5",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "索隱",
    "text": "薄太后也。亦葬芷陽西，曰少陵也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a6",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "索隱",
    "text": "廣川王彭祖、長沙王發皆景帝子，遣就國也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a7",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "正義",
    "text": "雨，于付反。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a8",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "集解",
    "text": "徐廣曰：「地理志云文帝七年置。」駰按：地理志、百官表南陵縣文帝置也。分內史爲左右，及祋祤爲縣，皆景帝二年，不得皆如徐所云。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a9",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p2",
    "annotator": "索隱",
    "text": "鄒誕生祋音都會反，又音丁活反。祤音羽，又音詡。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a10",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "集解",
    "text": "徐廣曰：「漢志無。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a11",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "集解",
    "text": "徐廣曰：「雒，一作『淮』。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a12",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "索隱",
    "text": "雒陽漢書作「淮陽」。災，故徙王於魯也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a13",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "音匹備反。高祖兄仲子，故漢高祖十二年封，三十三年反。年表云都吳，其實在江都也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a14",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "高祖弟楚王交孫，嗣二十一年反，都彭城。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a15",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "高祖孫，幽王友子，嗣二十六年反，都邯鄲。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a16",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "卬，五郎反。高祖孫，齊悼惠王子，故平昌侯，十年反，都密州高密縣。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a17",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "辟音壁。高祖孫，齊悼惠王子，故扐侯，立十一年反。括地志云：「濟南故城在淄川長山縣西北三十里。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a18",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "高祖孫，齊悼惠王子，故武城侯，立十一年反，都劇。括地志云：「菑州縣也。故劇城在青州壽光縣南三十一里，故紀國。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a19",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "高祖孫，齊悼惠王子，故白石侯，立十一年反，都即墨。括地志云：「即墨故城在密州膠水縣東南六十里，即膠東國也。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a20",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "梁孝王都睢陽，今宋州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a21",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "蓺，魚曳反。字亦作「藝」，音同。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a22",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "地理志云魏其屬琅邪。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a23",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "索隱",
    "text": "韋昭云：「平陸，西河縣。禮即向之從曾祖王父也。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a24",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "應劭云：「平陸，西河縣。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a25",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "濟，子禮反。濟北國今濟州盧縣，即濟北王所都。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a26",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "淮陽國今陳州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a27",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "魯今兗州曲阜縣。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a28",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "汝南國今豫州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a29",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "江都國今揚州也。吳王濞所都，反，誅，景帝改爲江都國，封皇子非也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a30",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "索隱",
    "text": "悼惠王之孫，齊王襄之子。廬，漢書作「閭」。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a31",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "正義",
    "text": "齊國，青州臨淄也。將廬，齊悼惠王之孫，襄王之子，年表云。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a32",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "索隱",
    "text": "劉澤之子。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a33",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p3",
    "annotator": "集解",
    "text": "徐廣曰：「表云五年薨。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a34",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p4",
    "annotator": "正義",
    "text": "括地志云：「漢景帝陵也，在雍州咸陽縣東三十里。」按：豫作壽陵也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a35",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p4",
    "annotator": "集解",
    "text": "應劭曰：「文帝十二年，除關，無用傳，至此復置傳，以七國新反，備非常也。」張晏曰：「傳，信也，若今過所也。」如淳曰：「傳音『檄傳』之『傳』，兩行書繒帛，分持其一，出入關，合之乃得過，謂之傳。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a36",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p4",
    "annotator": "索隱",
    "text": "傳音丁戀反。如今之過所。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a37",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p4",
    "annotator": "集解",
    "text": "地理志趙國景帝以爲邯鄲郡。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a38",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p5",
    "annotator": "索隱",
    "text": "景帝豫作壽陵也。按：趙系家趙肅侯十五年起壽陵，後代遂因之也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a39",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p5",
    "annotator": "索隱",
    "text": "音林閭。避殤帝諱改之。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a40",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "正義",
    "text": "括地志云：「建陵故縣在沂州承縣界。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a41",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「姓程。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a42",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "正義",
    "text": "括地志云：「平曲縣故城在瀛州文安縣北七十里。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a43",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「姓蘇。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a44",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "集解",
    "text": "徐廣曰：「殖，一作『填』。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a45",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p6",
    "annotator": "正義",
    "text": "按：馳道，天子道，秦始皇作之，三丈而樹。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a46",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p7",
    "annotator": "正義",
    "text": "臨江，忠州縣。雖王臨江而都江陵。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a47",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p7",
    "annotator": "正義",
    "text": "條，田彫反。字亦作「蓧」，音同。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a48",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p7",
    "annotator": "索隱",
    "text": "按系家，太后槐里人，父仲。兄信，封蓋侯。后故金氏妻女弟姁兒也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a49",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p8",
    "annotator": "索隱",
    "text": "周昌之兄。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a50",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p8",
    "annotator": "集解",
    "text": "徐廣曰：「一作『應』。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a51",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p9",
    "annotator": "集解",
    "text": "文穎曰：「楚相張尚，太傅趙夷吾，趙相建德，內史王悍。此四人各諫其王，無使反，不聽，皆殺之，故封其子。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a52",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p9",
    "annotator": "索隱",
    "text": "韋昭云：「張尚子當居，趙夷吾子周，建德子橫，王悍子弃也。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a53",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p10",
    "annotator": "正義",
    "text": "漢書表云中三年，安陵侯子軍、桓侯賜、遒侯陸彊、容城侯徐盧、易侯僕日、范陽侯代、翕侯邯鄲七人，以匈奴王降，皆封爲列侯。按：紀言二人者是匈奴二王爲首降。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a54",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p10",
    "annotator": "集解",
    "text": "按：三輔黃圖東出北頭第一門曰宣平門，外曰東都門。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a55",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p10",
    "annotator": "索隱",
    "text": "按：三輔黃圖云東出北第一門曰宣平門，外曰東都門。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a56",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p11",
    "annotator": "集解",
    "text": "瓚曰：「是景帝廟也，帝自作之，諱不言廟，故言宮。西京故事云景帝廟爲德陽宮。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a57",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p12",
    "annotator": "正義",
    "text": "惠景閒年表云亞谷侯盧他之、隆盧侯陳蟜、乘氏侯劉買、桓邑侯劉明、蓋侯王信。按：其五人是中元五年封，餘檢不獲。中元三年，匈奴王二人降，封爲列侯。惠景閒表云匈奴王降爲侯者有七人，疑其五人是十侯之數。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a58",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "都睢陽，今宋州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a59",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "城陽，今濮州雷澤縣，古城陽也。共音恭。謚法「嚴敬故事曰恭」。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a60",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "表云分梁置也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a61",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "表云分梁置也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a62",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "地理志云景帝中六年別爲山陽國，屬兗州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a63",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "正義",
    "text": "地理志云景帝中六年別爲濟陰國，屬兗州。按：今曹州是也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a64",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "漢書百官表曰：「主爵中尉，秦官，掌列侯。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a65",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "漢書百官表曰：「詹事，秦官，掌皇后太子家。」應劭曰：「詹，省也，給也。」瓚曰：「茂陵書詹事秩二千石。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a66",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "張晏曰：「以太后所居宮爲名。長信宮則曰長信少府，長樂宮則曰長樂少府。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a67",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "漢書百官表曰：「將行，秦官。」應劭曰：「長秋，皇后卿。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a68",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "服虔曰：「天子死未有謚，稱大行。」晉灼曰：「禮有大行、小行，主謚官，故以此名之。」如淳曰：「不反之辭也。」瓚曰：「大行是官名，掌九儀之制，以賔諸侯。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a69",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "索隱",
    "text": "按：鄭玄曰「命者五，謂公、侯、伯、子、男，爵者四，孤、卿、大夫、士，是九也。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a70",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "漢書百官表曰：「奉常，秦官，掌宗廟禮儀。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a71",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "索隱",
    "text": "韋昭云：「大行，官名，秦時云典客，景帝初改云大行，後更名大鴻臚，武帝因而不改，故漢書景紀有大鴻臚。百官表又云武帝改名大鴻臚。鴻，聲也。臚，附皮。以言其掌四夷賔客，若皮臚之在外附於身也。復有大行令，故諸侯薨，大鴻臚奏謚，列侯薨，則大行奏誄」。按：此大行令即鴻臚之屬官也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a72",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "漢書百官表曰：「治粟內史，秦官，掌穀貨也。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a73",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "集解",
    "text": "韋昭曰：「大內，京師府藏。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a74",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p13",
    "annotator": "索隱",
    "text": "主天子之私財物曰少內。少內屬大內也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a75",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p14",
    "annotator": "正義",
    "text": "漢書百官表云：「衞尉，秦官，掌宮闈門衞屯兵。景帝初，更命中大夫，分後元年，復爲衞尉。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a76",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p14",
    "annotator": "集解",
    "text": "徐廣曰：「丙，一作『甲』。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a77",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p14",
    "annotator": "索隱",
    "text": "姓衞也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a78",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "正義",
    "text": "郅，真栗反。郅都傳云匈奴刻木爲郅都而射，不中。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a79",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "索隱",
    "text": "七緵，蓋今七升布，言其粗，故令衣之也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a80",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "正義",
    "text": "衣，於旣反。緵，祖工反。緵，八十縷也。與布相似。七升布用五百六十縷。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a81",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "索隱",
    "text": "止人爲馬舂粟，爲歲不登故也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a82",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "集解",
    "text": "晉灼曰：「文紀遣列侯之國，今又省之。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a83",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p15",
    "annotator": "正義",
    "text": "衡山國，今衡州。河東，今蒲州。雲中郡，今勝州。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a84",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "集解",
    "text": "徐廣曰：「一作『雷』字，又作『圖』字，實所未詳。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a85",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "索隱",
    "text": "天庭即龍星右角也。按：石氏星傳曰「龍在左角曰天田，右角曰天廷」。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a86",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "集解",
    "text": "皇甫謐曰：「帝以孝惠七年生，年四十八。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a87",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "集解",
    "text": "漢書云：「二月癸酉，帝葬陽陵。」皇甫謐曰：「陽陵山方百二十步，高十四丈，去長安四十五里。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a88",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "集解",
    "text": "蘇林曰：「蚡音鼢。」"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a89",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p16",
    "annotator": "索隱",
    "text": "蚡音扶粉反。按：外戚世家皇太后母臧氏初嬪王氏，生子信而寡，更嫁長陵田氏，生蚡及勝也。"
  },
  {
    "id": "anno:shiji:shiji-孝景本紀第十一:a90",
    "book": "shiji",
    "chapter_id": "shiji-孝景本紀第十一",
    "target_para_id": "text:shiji:shiji-孝景本紀第十一:p17",
    "annotator": "索隱",
    "text": "主父偃上言，今天子下推恩之令，令諸侯各得分邑其子弟，於是遂弱，卒以安也。"
  }
]