[
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a0",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p0",
    "annotator": "正義",
    "text": "楚州淮陰縣也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a1",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p0",
    "annotator": "集解",
    "text": "李奇曰：「無善行可推舉選擇。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a2",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p0",
    "annotator": "集解",
    "text": "張晏曰：「下鄉，縣，屬淮陰也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a3",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p0",
    "annotator": "索隱",
    "text": "案楚漢春秋作「南昌作新昌」。亭長者，主亭之吏也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a4",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p0",
    "annotator": "集解",
    "text": "張晏曰：「未起而床蓐中食。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a5",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p1",
    "annotator": "正義",
    "text": "淮陰城北臨淮水，昔信去下鄉而釣於此。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a6",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p1",
    "annotator": "集解",
    "text": "韋昭曰：「以水擊絮爲漂，故曰漂母。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a7",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p1",
    "annotator": "正義",
    "text": "音寺。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a8",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p1",
    "annotator": "集解",
    "text": "蘇林曰：「如言公子也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a9",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p1",
    "annotator": "索隱",
    "text": "劉德曰：「秦末多失國，言王孫、公子，尊之也。」張晏云「字王孫」，非也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a10",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p2",
    "annotator": "集解",
    "text": "徐廣曰：「袴，一作『胯』。胯，股也，音同。」又云漢書作「跨」，同耳。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a11",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p2",
    "annotator": "索隱",
    "text": "胯音枯化反。然尋此文作「袴」，欲依字讀，何爲不通？袴下即胯下也，亦何必須作「胯」下。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a12",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p2",
    "annotator": "正義",
    "text": "俛音俯。伏，蒲北反。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a13",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p3",
    "annotator": "集解",
    "text": "徐廣曰：「戲，一作『麾』。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a14",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p3",
    "annotator": "集解",
    "text": "徐廣曰：「典客也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a15",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p3",
    "annotator": "索隱",
    "text": "李奇云：「楚官名。」張晏云：「司馬也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a16",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p4",
    "annotator": "集解",
    "text": "文穎曰：「事猶業也。」張晏曰：「無事用信。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a17",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "集解",
    "text": "晉灼曰：「廢，不收也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a18",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "索隱",
    "text": "喑於鴆反，噁烏路反。叱昌栗反，咤卓嫁反。「咤」或作「吒」。喑噁，懷怒氣。叱咤，發怒聲。孟康曰：「廢，伏也。」張晏曰「廢，偃也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a19",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "集解",
    "text": "音凶于反。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a20",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "索隱",
    "text": "嘔音吁。嘔嘔猶區區也。漢書作「姁姁」。鄧展曰「姁姁，和好貌也」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a21",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "集解",
    "text": "漢書音義曰：「不忍授。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a22",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "索隱",
    "text": "劉氏云：「用東歸之兵擊東方之敵，此敵無不散敗也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a23",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "索隱",
    "text": "案豪秋乃成。王逸注楚詞云「銳毛爲豪，夏落秋生也」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a24",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p5",
    "annotator": "索隱",
    "text": "案說文云「檄，二尺書也」。此云「傳檄」，謂爲檄書以責所伐者。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a25",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p6",
    "annotator": "正義",
    "text": "漢王從關北出岐州陳倉縣。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a26",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p6",
    "annotator": "正義",
    "text": "出函谷關。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a27",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "正義",
    "text": "兵敗散彭城而却退。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a28",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "索隱",
    "text": "今蒲津關。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a29",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "索隱",
    "text": "塞音先得反。臨晉，縣名，在河東之東岸，對舊關也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a30",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "集解",
    "text": "漢書音義曰：「益張旍旗，以疑敵者。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a31",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "索隱",
    "text": "劉氏云：「陳船，地名，在舊關之西，今之朝邑是也。」案：京兆有船司空縣，不名「陳船」。陳船者，陳列船艘欲渡河也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a32",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "集解",
    "text": "徐廣曰：「缻，一作『缶』。」服虔曰：「以木押縛罌缻以渡。」韋昭曰：「以木爲器如罌缻，以渡軍。無船，且尚密也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a33",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "正義",
    "text": "按韓信詐陳列船艘於臨晉，欲渡河，即此從夏陽木押罌缻渡軍，襲安邑。臨晉，同州東朝邑界。夏陽在同州北渭城界。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a34",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "正義",
    "text": "安邑故城在絳州夏縣東北十五里。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a35",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "索隱",
    "text": "劉氏云「夏陽舊無船，豹不備之，而防臨晉耳。今安邑被襲，故豹遂降也」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a36",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "正義",
    "text": "今安邑縣故城。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a37",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "集解",
    "text": "徐廣曰：「音余。」駰案：李奇曰「夏說，代相也」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a38",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "索隱",
    "text": "司馬彪郡國志上黨沾縣有閼與聚。閼音曷，又音嫣。與音余，又音預。沾音他廉反。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a39",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p7",
    "annotator": "正義",
    "text": "閼與聚城在潞州銅鞮縣西北二十里。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a40",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p8",
    "annotator": "索隱",
    "text": "案地理志常山石邑縣，井陘山在西。又穆天子傳云「至于陘山之隧，升于三道之磴」是也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a41",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p8",
    "annotator": "正義",
    "text": "井陘故關在并州石艾縣東十八里，即井陘口。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a42",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p8",
    "annotator": "索隱",
    "text": "喋，舊音歃，非也。案：陳湯傳「喋血萬里之外」，如淳云「殺人血流滂沱也」。韋昭音徒協反。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a43",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「樵，取薪也。蘇，取草也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a44",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "正義",
    "text": "引兵入井陘狹道，出趙。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a45",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "集解",
    "text": "漢書音義曰：「傳令軍中使發。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a46",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "集解",
    "text": "如淳曰：「萆音蔽。依山自覆蔽。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a47",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "索隱",
    "text": "案謂令從閒道小路向前，望見陳餘軍營即住，仍須隱山自蔽，勿令趙軍知也。蔽者，蓋覆也。楚漢春秋作「卑山」，漢書作「箄山」。說文云「箄，蔽也，從竹卑聲」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a48",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "集解",
    "text": "徐廣曰：「音飡也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a49",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "索隱",
    "text": "如淳曰：「小飯曰飡。謂立駐傳飡，待破趙乃大食也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a50",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "集解",
    "text": "服虔曰：「立駐傳飡食也。」如淳曰：「小飯曰飡。言破趙後乃當共飽食也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a51",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "正義",
    "text": "綿蔓水，一名阜將，一名回星，自并州流入井陘界，即信背水陣陷之死地，即此水也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a52",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p9",
    "annotator": "正義",
    "text": "恆州鹿泉縣，即六國時趙壁也"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a53",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p11",
    "annotator": "索隱",
    "text": "如淳曰：「效，致也。」晉灼云：「效，數也。」鄭玄注禮「效猶呈見也」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a54",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "集解",
    "text": "李奇曰：「鄗音臛。今高邑是。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a55",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "索隱",
    "text": "此之西河當馮翊也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a56",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "正義",
    "text": "即同州龍門河，從夏陽度者。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a57",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "索隱",
    "text": "褕，鄒氏音踰，美也。恐滅亡不久，故廢止作業而事美衣甘食，一曰偷苟且也，慮不圖久故也。漢書作「靡衣媮食」也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a58",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "集解",
    "text": "如淳曰：「恐滅亡不久故也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a59",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "集解",
    "text": "魏都賦曰：「肴醳順時。」劉逵曰：「醳酒也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a60",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "索隱",
    "text": "劉氏依劉逵作醳酒，謂以酒食養兵士也。案：史記古「釋」字皆如此作，豈亦謂以酒食醳兵士，故字從酉乎？"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a61",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "正義",
    "text": "首音狩，向也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a62",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "正義",
    "text": "咫尺，八寸。言其簡牘或長尺也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a63",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p12",
    "annotator": "正義",
    "text": "暴音僕。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a64",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p13",
    "annotator": "正義",
    "text": "宛在鄧州。葉在許州。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a65",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p13",
    "annotator": "集解",
    "text": "文穎曰：「謂趙人未嘗見發者。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a66",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p14",
    "annotator": "正義",
    "text": "懷州有平原津。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a67",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p14",
    "annotator": "集解",
    "text": "韋昭曰：「軾，今小車中隆起者。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a68",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p14",
    "annotator": "集解",
    "text": "徐廣曰：「濟南歷城縣。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a69",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p15",
    "annotator": "正義",
    "text": "近其室家，懷顧望也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a70",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p15",
    "annotator": "集解",
    "text": "徐廣曰：「出東莞而東北流，至北海都昌縣入海。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a71",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p15",
    "annotator": "索隱",
    "text": "濰音維。地理志濰水出琅邪箕縣東北，至都昌入海。徐廣云「出東莞而東北流入海」，蓋據水經而說，少不同耳。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a72",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p15",
    "annotator": "正義",
    "text": "城陽雷澤縣是也，在濮州東南九十一里。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a73",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p16",
    "annotator": "集解",
    "text": "張晏曰：「發信使者所齎書。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a74",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p16",
    "annotator": "集解",
    "text": "徐廣曰：「四年二月。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a75",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p17",
    "annotator": "集解",
    "text": "張華曰：「武涉墓在盱眙城東十五里。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a76",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p17",
    "annotator": "正義",
    "text": "數，色庾反。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a77",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p17",
    "annotator": "集解",
    "text": "張晏曰：「郎中，宿衞執戟之人也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a78",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p18",
    "annotator": "集解",
    "text": "張晏曰：「背畔則大貴。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a79",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p18",
    "annotator": "集解",
    "text": "張晏曰：「折，衄敗也。北，奔北。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a80",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p18",
    "annotator": "集解",
    "text": "張晏曰：「於成臯傷胸也。」臣瓚曰：「謂軍折傷。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a81",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p18",
    "annotator": "正義",
    "text": "鄉音向。齊國在東，故曰西向也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a82",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p18",
    "annotator": "正義",
    "text": "止楚漢之戰鬬，士卒不死亡，故云「請命」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a83",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "集解",
    "text": "晉灼曰：「楊雄方言『海岱之閒名罌爲儋』。石，斗石也。」蘇林曰：「齊人名小罌爲儋。石，如今受鮐魚石罌，不過一二石耳。一說，一儋與一斛之餘。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a84",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "索隱",
    "text": "儋音都濫反。石，斗也。蘇林解爲近之。鮐音胎。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a85",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "正義",
    "text": "音適。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a86",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "集解",
    "text": "徐廣曰：「跼，一作『蹢』也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a87",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "索隱",
    "text": "吟，鄭氏音拒蔭反，又音琴。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a88",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "集解",
    "text": "徐廣曰：「一本『遂不用蒯通，蒯通曰：「夫迫於細苛者，不可與圖大事；拘於臣虜者，固無君王之意。」說不聽，因去詳狂』也。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a89",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p20",
    "annotator": "索隱",
    "text": "案漢書及戰國策皆有此文。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a90",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p21",
    "annotator": "集解",
    "text": "徐廣曰：「以齊爲平原、千乘、東萊、齊郡。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a91",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p22",
    "annotator": "集解",
    "text": "張華曰漂母冢在泗口南岸。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a92",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p23",
    "annotator": "集解",
    "text": "徐廣曰：「東海朐縣有伊廬鄉。」駰案：韋昭曰「今中廬縣」。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a93",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p23",
    "annotator": "索隱",
    "text": "徐注出司馬彪郡國志。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a94",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p23",
    "annotator": "正義",
    "text": "括地志云：「中廬在義清縣北二十里，本春秋時廬戎之國也，秦謂之伊廬，漢爲中廬縣。項羽之將鍾離眛冢在。」韋昭及括地志云皆說之也。"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a95",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p23",
    "annotator": "集解",
    "text": "張晏曰：「狡猶猾。」"
  },
  {
    "id": "anno:shiji:shiji-淮陰侯列傳第三十二:a96",
    "book": "shiji",
    "chapter_id": "shiji-淮陰侯列傳第三十二",
    "target_para_id": "text:shiji:shiji-淮陰侯列傳第三十二:p23",
    "annotator": "索隱",
    "text": "吳越春秋作「郊兔」，亦通。漢書作「狡兔」。戰國策曰「東郭逡，海內狡兔也」。"
  },
  {
