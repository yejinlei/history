[
  {
    "id": "anno:shiji:shiji-平準書第八:a0",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "索隱",
    "text": "天子駕駟馬，其色宜齊同。今言國家貧，天子不能具鈞色之駟馬。漢書作「醇駟」，醇與純同，純一色也。或作「騂」，非也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a1",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "集解",
    "text": "如淳曰：「齊等無有貴賤，故謂之齊民。若今言『平民』矣。」晉灼曰：「中國被教之民也。」蘇林曰：「無物可蓋藏也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a2",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "索隱",
    "text": "顧氏按：古今注云「秦錢半兩，徑一寸二分，重十二銖」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a3",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "集解",
    "text": "漢書食貨志曰：「鑄榆莢錢。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a4",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "索隱",
    "text": "食貨志云「鑄莢錢」。按：古今注云榆莢錢重三銖，錢譜云文爲「漢興」也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a5",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "索隱",
    "text": "按：如淳云「時以錢爲貨，黃金一斤直萬錢」，非也。又臣瓚下注云「秦以一溢爲一金，漢以一斤爲一金」，是其義也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a6",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "集解",
    "text": "李奇曰：「稽，貯滯也。」如淳曰：「稽，考也。考校市物價，貴賤有時。」晉灼曰：「踊，甚也。言計市物賤而豫益蓄之也。物貴而出賣，故使物甚騰也。漢書『糶』字作『躍』。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a7",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "索隱",
    "text": "李奇云「稽，貯滯」。韋昭云「稽，留待也」。稽字當如李韋二釋。晉灼及馬融訓稽爲計及考，於義爲疏。如淳云「踊騰猶低昂也。低昂者，乍賤乍貴也」。今按：漢書「糶」字作「躍」者，謂物踊貴而價起，有如物之騰躍而起也。然糶者出賣之名，故食貨志云「大熟則上糶三而舍一」是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a8",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p1",
    "annotator": "集解",
    "text": "瓚曰：「秦以一溢爲一金，漢以一斤爲一金。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a9",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p2",
    "annotator": "正義",
    "text": "古人未有市及井，若朝聚井汲水，便將貨物於井邊貨賣，故言市井也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a10",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p2",
    "annotator": "索隱",
    "text": "按：經訓常。言封君已下皆以湯沐邑爲私奉養，故不領入天子之常稅，爲一年之費也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a11",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p2",
    "annotator": "索隱",
    "text": "按：中都猶都內也，皆天子之倉府。以給中都官者，即今太倉以畜官儲是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a12",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p3",
    "annotator": "集解",
    "text": "如淳曰：「如榆莢也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a13",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p3",
    "annotator": "索隱",
    "text": "按：即訓就。就山鑄錢，故下文云「銅山」是也。一解，即山，山名也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a14",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p3",
    "annotator": "集解",
    "text": "徐廣曰：「埒者，際畔。言鄰接相次也。」駰按：孟康曰「富與天子等而微減也。或曰埒，等也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a15",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p4",
    "annotator": "索隱",
    "text": "按：漢書食貨志云文帝用晁錯言，「令人入粟邊六百石，爵上造；稍增至四千石，爲五大夫；萬二千石，爲大庶長；各以多少爲差」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a16",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p5",
    "annotator": "索隱",
    "text": "謂增益苑囿，造廄而養馬以廣用，則馬是軍國之用也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a17",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "集解",
    "text": "韋昭曰：「巨萬，今萬萬。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a18",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "集解",
    "text": "如淳曰：「校，數也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a19",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "集解",
    "text": "漢書音義曰：「皆乘父馬，有牝馬閒其閒則相踶齧，故斥不得出會同。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a20",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "集解",
    "text": "如淳曰：「時無事，吏不數轉，至于子孫長大而不轉職任。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a21",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "集解",
    "text": "如淳曰：「倉氏、庾氏是也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a22",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "索隱",
    "text": "注「倉氏庾氏」，按出食貨志。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a23",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p6",
    "annotator": "索隱",
    "text": "謂鄉曲豪富無官位，而以威勢主斷曲直，故曰武斷也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a24",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "正義",
    "text": "烏侯反。今台州永寧是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a25",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "正義",
    "text": "南越及閩越。南越，今廣州南海也。閩越，今建州建安也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a26",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "索隱",
    "text": "人姓名。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a27",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "索隱",
    "text": "彭吳始開其道而滅之也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a28",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "索隱",
    "text": "按：三蒼音五官反。鄒氏又五亂反。按：抏者，秏也，消秏之名。言百姓貧獘，故行巧抵之法也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a29",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p7",
    "annotator": "集解",
    "text": "韋昭曰：「桑弘羊、孔僅之屬。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a30",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "正義",
    "text": "謂靈、夏三州地，取在元朔二年。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a31",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "正義",
    "text": "今夏州也。括地志云：「夏州，秦上郡，漢分置朔方郡，魏不改，隋置夏州也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a32",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "集解",
    "text": "漢書音義曰：「鐘六石四斗。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a33",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "索隱",
    "text": "應劭云：「臨卭屬蜀，僰屬犍爲。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a34",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "索隱",
    "text": "吏發興誅之。謂發軍興以誅之也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a35",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "集解",
    "text": "韋昭曰：「更，續也。或曰更，償也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a36",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "集解",
    "text": "服虔曰：「入穀於外縣，受錢於內府也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a37",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p8",
    "annotator": "索隱",
    "text": "按：說文云「漕，水轉穀也」。一云車運曰轉，水運曰漕也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a38",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「元朔五年也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a39",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "集解",
    "text": "韋昭曰：「陳，久也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a40",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "索隱",
    "text": "留墆無所食。墆音迭，謂貯也。韋昭音滯，謂積也。又按：古今字詁「墆」今「滯」字，則墆與滯同。按：謂富人貯滯積穀，則貧者無所食也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a41",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "集解",
    "text": "瓚曰：「茂陵中書有武功爵：一級曰造士，二級曰閑輿衞，三級曰良士，四級曰元戎士，五級曰官首，六級曰秉鐸，七級曰千夫，八級曰樂卿，九級曰執戎，十級曰左庶長，十一級曰軍衞。此武帝所制以寵軍功。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a42",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "索隱",
    "text": "大顏云「一金，萬錢也。計十一級，級十七萬，合百八十七萬金」。而此云「三十餘萬金」，其數必有誤者。顧氏按：或解云初一級十七萬，自此已上每級加二萬，至十一級，合成三十七萬也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a43",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "索隱",
    "text": "官首，武功爵第五也，位稍高，故得試爲吏，先除用也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a44",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "索隱",
    "text": "千夫，武功爵第七；五大夫，二十爵第九也。言千夫爵秩比於五大夫二十爵第九，故楊僕以千夫爲吏是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a45",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「爵名也。」駰案：漢書音義曰「十爵左庶長以至十八爵爲大庶長也，名樂卿。樂卿者，朝位從九卿，加『樂』者，別正卿。又十九爵爲樂公，食公卿祿而無職也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a46",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p9",
    "annotator": "索隱",
    "text": "按：此言武功置爵惟得至於樂卿也。臣瓚所引茂陵書，蓋後人記其爵失次耳。今注稱十爵至十八庶長爲樂卿，十九至二十爲樂公，乃以舊二十爵釋武功爵，蓋亦臆說，非也。大顏亦以爲然。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a47",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p10",
    "annotator": "集解",
    "text": "張晏曰：「吏見知不舉劾爲故縱。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a48",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p10",
    "annotator": "集解",
    "text": "如淳曰：「廢格天子文法，使不行也。誹謂非上所行，若顏異反脣之比也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a49",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p10",
    "annotator": "索隱",
    "text": "格音閣，亦如字。沮音才緒反。誹音非。按：謂廢格天子之命而不行，及沮敗誹謗之者，皆被窮治，故云廢格沮誹之獄用矣。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a50",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p13",
    "annotator": "集解",
    "text": "徐廣曰：「觀，縣名也。屬東郡，光武改曰衞，公國。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a51",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p15",
    "annotator": "集解",
    "text": "徐廣曰：「音膾。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a52",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p15",
    "annotator": "集解",
    "text": "服虔曰：「地名，在北方千里。」如淳曰：「長安已北，朔方已南。」瓚曰：「秦逐匈奴以收河南地，徙民以實之，謂之新秦。今以地空，故復徙民以實之。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a53",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "漢書音義曰：「蹛，停也。一曰貯也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a54",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "索隱",
    "text": "蕭該按：字林云「貯，塵也，音佇」。此謂居積停滯塵久也。或作「貯」，子貢發貯鬻財是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a55",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "李奇曰：「車也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a56",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "徐廣曰：「廢居者，貯畜之名也。有所廢，有所畜，言其乘時射利也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a57",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "索隱",
    "text": "劉氏云：「廢，出賣；居，停蓄也。」是出賣於居者爲廢，故徐氏云「有所廢，有所畜」是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a58",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "注",
    "text": "駰按：服虔曰「居穀於邑也」。如淳曰「居賤物於邑中，以待貴也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a59",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "索隱",
    "text": "服虔云「居穀於邑中」是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a60",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "晉灼曰：「低音抵距。」服虔曰：「仰給於商賈。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a61",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "索隱",
    "text": "按：服虔云「仰給於商賈」，是也。而劉伯莊以爲「封君及大商皆低首營私以自給，不佐天子」，非也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a62",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "如淳曰：「磨錢取鋊故也。」瓚曰：「鑄錢者多，故錢輕。輕亦賤也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a63",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "如淳曰：「但鑄作錢，不作餘物。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a64",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "漢書音義曰：「白金，銀也。赤金，丹陽銅也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a65",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "索隱",
    "text": "說文云：「銅，赤金也。」注云「丹陽銅」者，神異經云西方金山有丹陽銅也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a66",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "韋昭曰：「文爲半兩，實重四銖。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a67",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "徐廣曰：「音容。」呂靜曰：「冶器法謂之鎔。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a68",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p16",
    "annotator": "集解",
    "text": "徐廣曰：「藻，一作『紫』也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a69",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "集解",
    "text": "如淳曰：「雜鑄銀錫爲白金也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a70",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "易云行天莫如龍也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a71",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "易云行地莫如馬也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a72",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "禮曰「諸侯以龜爲寶」也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a73",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "顧氏案：錢譜「其文爲龍，隱起，肉好皆圜，文又作雲霞之象」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a74",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "名白選。蘇林曰：「選音『選擇』之『選』。」包愷及劉氏音息戀反。尚書大傳云：「夏后氏不殺不刑，死罪罰二千饌。」馬融云：「饌，六兩。」漢書作「撰」，音同。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a75",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "晉灼按：黃圖直三千二百。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a76",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "謂以八兩荖爲三品，此重六兩，下小隋重四兩也。云「以重荖小」者，謂半兩爲重，故荖小重六兩，而其形方也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a77",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "錢譜：「肉好皆方，隱起馬形。肉好之下又是連珠文也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a78",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "復小隋之。湯果反。爾雅注「隋者，狹長也」。謂長而方，去四角也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a79",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p17",
    "annotator": "索隱",
    "text": "錢譜：「肉圓好方，爲隱起龜甲文。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a80",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p18",
    "annotator": "索隱",
    "text": "東郭，姓；咸陽，名也。按：風俗通東郭牙，齊大夫，咸陽其後也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a81",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p18",
    "annotator": "索隱",
    "text": "按：言百物毫芒至秋皆美細。今言弘羊等三人言利事纖悉，能分析其秋毫也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a82",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p19",
    "annotator": "集解",
    "text": "韋昭曰：「欲令出馬，無馬者令伐棘。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a83",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p19",
    "annotator": "索隱",
    "text": "故吏皆適伐棘。謂故吏先免者，皆適令伐棘上林，不謂無馬者。韋說非也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a84",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p19",
    "annotator": "索隱",
    "text": "按：黃圖云「昆明池周四十里，以習水戰」。又荀悅云「昆明子居滇河中，故習水戰以伐之也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a85",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p20",
    "annotator": "集解",
    "text": "徐廣曰：「元狩四年也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a86",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "韋昭云：「天子私所賜經用也。公用屬大司農也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a87",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "集解",
    "text": "如淳曰：「牢，廩食也。古名廩爲牢也。盆者，煮鹽之盆也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a88",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "予牢盆。按：蘇林云「牢，價直也。今代人言『雇手牢盆』」。晉灼云蘇說是。樂產云「牢乃盆名」，其說異。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a89",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "奇，包愷音羈。諸侯也，非農工之儔，故言奇也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a90",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "集解",
    "text": "張晏曰：「若人執倉庫之管籥。或曰管，固。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a91",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "擅筦。音管。上音善。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a92",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "弋戰反。羨，饒也，與「衍」同義。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a93",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "沮，止也。僅等言山海之藏宜屬大農，奇人欲擅利，必有沮止之議，此不可聽許也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a94",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "注",
    "text": "史記音隱曰：「釱音徒計反。」韋昭曰：「釱，以鐵爲之，著左趾以代刖也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a95",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "索隱",
    "text": "按：三蒼云「釱，踏腳鉗也」。字林徒計反。張斐漢晉律序云「狀如跟衣，著足，足下重六斤，以代臏，至魏武改以代刖也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a96",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p22",
    "annotator": "注",
    "text": "鄧展曰：「鑄故鐵。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a97",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "集解",
    "text": "李奇曰：「齊，皆也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a98",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "異時猶昔時也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a99",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "說文云：「軺，小車也。」傅子云：「漢代賤乘軺，今則貴之。」言筭軺車者，有軺車使出稅一筭二筭也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a100",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "注",
    "text": "李斐曰：「緡，絲也，以貫錢也。一貫千錢，出二十筭也。詩云『維絲伊緡』。」如淳曰：「胡公名錢爲緡者，詩云『氓之蚩蚩，抱布貿絲』，故謂之緡也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a101",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "緡音旻。緡者，絲繩以貫錢者。千錢出二十筭也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a102",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "稽者，停也，留也，即上文所謂「廢居居邑」也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a103",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "按：郭璞云「占，自隱度也」。謂各自隱度其財物多少，爲文簿送之官也。若不盡，皆沒入於官。音之贍反。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a104",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "集解",
    "text": "瓚曰：「此緡錢爲是儲緡錢也，故隨其用所施，施於利重者其筭亦多。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a105",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "集解",
    "text": "如淳曰：「以手力所作而賣之。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a106",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "集解",
    "text": "如淳曰：「非吏而得與吏比者，官謂三老、北邊騎士也。樓船令邊郡選富者爲車騎士。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a107",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "集解",
    "text": "如淳曰：「商賈有軺車，使出二筭，重其賦也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a108",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "悉，盡也，具也。若通家財不周悉盡者，罰戍邊一歲。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a109",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "謂賈人有市籍，不許以名占田也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a110",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p23",
    "annotator": "索隱",
    "text": "若賈人更占田，則沒其田及僮僕，皆入之於官也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a111",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p25",
    "annotator": "集解",
    "text": "漢書音義曰：「外繇謂戍邊也。一人出三百錢，謂之過更。式歲得十二萬錢也。一說，在繇役之外得復除四百人。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a112",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p26",
    "annotator": "集解",
    "text": "韋昭曰：「屩，草屝。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a113",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p27",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎二年，時丙寅歲也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a114",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p27",
    "annotator": "集解",
    "text": "孟康曰：「謂諸當所輸於官者，皆令輸其土地所饒，平其所在時價，官更於他處賣之。輸者旣便而官有利。漢書百官表大司農屬官有均輸令。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a115",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p29",
    "annotator": "索隱",
    "text": "抵音氐。抵，歸也。劉氏云「大抵猶大略也」。案：大抵無慮者，謂言大略歸於鑄錢，更無他事從慮。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a116",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p29",
    "annotator": "集解",
    "text": "服虔曰：「分曹職案行。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a117",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p30",
    "annotator": "集解",
    "text": "徐廣曰：「元狩四年，時壬戌歲也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a118",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p30",
    "annotator": "集解",
    "text": "李奇曰：「異與客語，道詔令初下，有不便處也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a119",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p32",
    "annotator": "索隱",
    "text": "謂多姦巧，雜以鉛錫也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a120",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p32",
    "annotator": "集解",
    "text": "如淳曰：「以赤銅爲其郭也。今錢見有赤側者，不知作法云何。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a121",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p32",
    "annotator": "索隱",
    "text": "鍾官掌鑄赤側之錢。韋昭云「側，邊也」，故晉灼云「以赤銅爲郭。今錢見有赤側者」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a122",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p32",
    "annotator": "集解",
    "text": "漢書音義曰：「俗所謂紫紺錢也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a123",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p33",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎三年。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a124",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p33",
    "annotator": "索隱",
    "text": "樂產云：「諸所廢興，附上困下，皆自湯，故人不思之也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a125",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p34",
    "annotator": "集解",
    "text": "漢書百官表：「水衡都尉，武帝元鼎二年初置，掌上林苑，屬官有上林均輸、鍾官、辨銅令。」然則上林三官，其是此三令乎？"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a126",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p35",
    "annotator": "集解",
    "text": "瓚曰：「商賈居積及伎巧之家，非桑農所生出，謂之緡。茂陵中書有緡田奴婢是也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a127",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p35",
    "annotator": "索隱",
    "text": "姓楊，名可。如淳云：「告緡者，令楊可告占緡之不盡者也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a128",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p35",
    "annotator": "集解",
    "text": "如淳曰：「治匿緡之罪，其獄少有反者。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a129",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p35",
    "annotator": "索隱",
    "text": "反音番。反謂反使從輕也。案：劉德爲京兆尹，每行縣，多所平反是也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a130",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p35",
    "annotator": "索隱",
    "text": "如淳云：「曹，輩也。謂分曹輩而出爲使也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a131",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p36",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎三年，丁卯歲，徙函谷關於新安東界。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a132",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p37",
    "annotator": "索隱",
    "text": "布謂泉布。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a133",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p37",
    "annotator": "集解",
    "text": "韋昭曰：「戰鬬馳逐也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a134",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p37",
    "annotator": "索隱",
    "text": "蓋始穿昆明池，欲與滇王戰，今乃更大修之，將與南越呂嘉戰逐，故作樓船，於是楊僕有將軍之號。又下云「因南方樓船卒二十餘萬擊南越」也。昆明池有豫章館。豫章，地名，以言將出軍於豫章也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a135",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p38",
    "annotator": "索隱",
    "text": "比昔所沒入之田也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a136",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p38",
    "annotator": "集解",
    "text": "如淳曰：「水衡、少府、太僕、司農皆有農官，是爲多。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a137",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p38",
    "annotator": "索隱",
    "text": "樂產云：「度猶運也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a138",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p38",
    "annotator": "索隱",
    "text": "按：謂天子所給廩食者多，故官自糴乃足也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a139",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p39",
    "annotator": "索隱",
    "text": "人姓名。服虔云「掌故官，取書於司馬相如者，封禪書公孫卿因所忠言寶鼎是也」。唯姚察獨以爲「所患」，非也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a140",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p39",
    "annotator": "集解",
    "text": "如淳曰：「世世有祿秩家。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a141",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p39",
    "annotator": "索隱",
    "text": "晉灼云：「中國被教整齊之人也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a142",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p39",
    "annotator": "集解",
    "text": "應劭曰：「株，根本也。送，引也。」如淳曰：「株，根蔕也。諸坐博戲事決爲徒者，能入錢得補郎也。或曰，先至者爲根。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a143",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p39",
    "annotator": "索隱",
    "text": "李奇云：「先至者爲魁株。」應劭云：「株，根本也。送，當作『選』。選，引也。」應、李二音是。先至之人令之相引，似若得其株本，則枝葉自窮，故曰「株送徒」。又文穎曰：「凡鬬雞勝者爲株。」傳云：「陽溝之雞，三歲爲株。」今則鬬雞走馬者用之。因其鬬雞本勝時名，故云株送徒者也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a144",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p40",
    "annotator": "集解",
    "text": "應劭曰：「燒草，下水種稻，草與稻並生，高七八寸，因悉芟去，復下水灌之，草死，獨稻長，所謂火耕水耨也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a145",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p41",
    "annotator": "集解",
    "text": "漢書音義曰：「踰，度也。卒，倉卒也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a146",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p41",
    "annotator": "集解",
    "text": "如淳曰：「徼，亦卒求盜之屬也。」晉灼曰：「徼，塞也。」瓚曰：「旣無亭候，又不徼循，無衞邊之備也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a147",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p41",
    "annotator": "集解",
    "text": "漢書音義曰：「令民得畜牧於邊縣也。」瓚曰：「先是，新秦中千里無民，畏寇不敢畜牧，令設亭徼，故民得畜牧也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a148",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p41",
    "annotator": "集解",
    "text": "李奇曰：「邊有官馬，今令民能畜官母馬者，滿三歲歸之也。及有蕃息，與當出緡筭者，皆復令居新秦中，又充仞之也。謂與民母馬，令得爲馬種；令十母馬還官一駒，此爲息什一也。」瓚曰：「前以邊用不足，故設告緡之令，設亭徼，邊民無警，皆得田牧。新秦中已充，故除告緡，不復取於民也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a149",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p42",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎四年立后土，五年立泰畤。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a150",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p43",
    "annotator": "索隱",
    "text": "令音零，姚氏音連。韋昭云：「金城縣。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a151",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p43",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎六年。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a152",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p43",
    "annotator": "集解",
    "text": "如淳曰：「塞候斥卒。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a153",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p44",
    "annotator": "索隱",
    "text": "劉氏言其多以百而數，故坐酎金失侯者一百六人。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a154",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p44",
    "annotator": "集解",
    "text": "如淳曰：「省視諸侯金有輕有重也。或曰，至嘗酎飲宗廟時，少府視其金多少也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a155",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p44",
    "annotator": "集解",
    "text": "如淳曰：「漢儀注王子爲侯，侯歲以戶口酎黃金於漢廟，皇帝臨受獻金以助祭。大祀日飲酎，飲酎受金。金少不如斤兩，色惡，王削縣，侯免國。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a156",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p44",
    "annotator": "集解",
    "text": "徐廣曰：「元鼎六年。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a157",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p45",
    "annotator": "集解",
    "text": "瓚曰：「謂作鐵器，民患苦其不好。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a158",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p45",
    "annotator": "索隱",
    "text": "鹽旣苦而器又惡，故買賣貴也。苦又音古，言器苦窳不好。凡病之器云苦窳。窳音庾，語見本紀。苦如字讀亦通。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a159",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p46",
    "annotator": "集解",
    "text": "徐廣曰：「南越爲九郡。」駰案：晉灼曰「元鼎六年，定越地，以爲南海、蒼梧、鬱林、合浦、交趾、九真、日南、珠崖、儋耳郡；定西南夷，以爲武都、䍧牱、越巂、沈犂、汶山郡；及地理志、西南夷傳所置犍爲、零陵、益州郡，凡十七也」。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a160",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p46",
    "annotator": "索隱",
    "text": "比音鼻。謂南陽、漢中已往之郡，各以其地比近給初郡。初郡，即西南夷初所置之郡。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a161",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p46",
    "annotator": "索隱",
    "text": "扶用反，包氏同。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a162",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p46",
    "annotator": "集解",
    "text": "徐廣曰：「擅，一作『經』。經，常也。惟取用足耳，不暇顧經常法則也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a163",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p47",
    "annotator": "索隱",
    "text": "不償其僦。服虔云：「雇載云僦，言所輸物不足償其雇載之費也。僦音子就反。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a164",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p47",
    "annotator": "集解",
    "text": "如淳曰：「牟，取也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a165",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p48",
    "annotator": "索隱",
    "text": "謂他郡能入粟，輸所在急要之處也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a166",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p49",
    "annotator": "索隱",
    "text": "坐市列。謂吏坐市肆行列之中。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a167",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "集解",
    "text": "徐廣曰：「時，一作『衰』。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a168",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "集解",
    "text": "管子有輕重之法。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a169",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "索隱",
    "text": "即下「或黃，或赤、白」。黃，黃金也；白，白銀也；赤，赤銅也：並見食貨志。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a170",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "集解",
    "text": "如淳曰：「布於民閒也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a171",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "集解",
    "text": "如淳曰：「名錢爲刀者，以其利於民也。」"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a172",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "索隱",
    "text": "按：錢本名泉，言貨之流如泉也，故周有泉府之官。及景王乃鑄大錢。布者，言貨流布，故周禮有二夫之布。食貨志貨布首長八分，足支八分。刀者，錢也。食貨志有契刀、錯刀，形如刀，長二寸，直五千。以其形如刀，故曰刀，以其利於人也。又古者貨貝寶龜，食貨志有十朋五貝，皆用爲貨，其各有多少，元龜直十貝，故直二千一百六十，已下各有差也。"
  },
  {
    "id": "anno:shiji:shiji-平準書第八:a173",
    "book": "shiji",
    "chapter_id": "shiji-平準書第八",
    "target_para_id": "text:shiji:shiji-平準書第八:p50",
    "annotator": "集解",
    "text": "孟康曰：「二十兩爲溢。」"
  }
]