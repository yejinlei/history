[
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a0",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "正義",
    "text": "言文之蔽，小人以僿。謂細碎苛法亂政。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a1",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "正義",
    "text": "譏，非言也。儒敝亂法，俠盛犯禁，二道皆非，而學士多稱於世者，故太史公引韓子，欲陳游俠之美。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a2",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "索隱",
    "text": "案春秋謂國史也。以言人臣有功名則見記于其國之史，是俱著春秋者也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a3",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "集解",
    "text": "徐廣曰：「仲尼弟子傳曰公皙哀字季次，未嘗仕，孔子稱之。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a4",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "索隱",
    "text": "行音下孟反。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a5",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "正義",
    "text": "莊子云「原憲處居環堵之室，蓬戶不完。以桑爲樞而甕牖，上漏下溼，獨坐而弦歌」也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a6",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "索隱",
    "text": "不饜。饜，飽也，於豔反。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a7",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p1",
    "annotator": "索隱",
    "text": "阨音厄。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a8",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p2",
    "annotator": "集解",
    "text": "徐廣曰：「在廣川。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a9",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p2",
    "annotator": "正義",
    "text": "尉繚子云太公望行年七十，賣食棘津云。古亦謂之石濟津，故南津。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a10",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p3",
    "annotator": "索隱",
    "text": "已音以。饗音享，受也。言已受其利則爲有德，何知必仁義也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a11",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p3",
    "annotator": "索隱",
    "text": "以言小竊則爲盜而受誅也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a12",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p3",
    "annotator": "索隱",
    "text": "言人臣委質於侯王門，則須存于仁義。若游俠輕健，亦何必肯存仁義也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a13",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p4",
    "annotator": "索隱",
    "text": "言拘學守義之士或抱咫尺纖微之事，遂久以當代，孤負我志，而不若卑論儕俗以取榮寵也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a14",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p5",
    "annotator": "集解",
    "text": "徐廣曰：「代郡亦有延陵縣。」駰案：韓子云「趙襄子召延陵生，令車騎先至晉陽」。襄子時趙已并代，可有延陵之號，但未詳是此人非耳。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a15",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p5",
    "annotator": "索隱",
    "text": "施音以豉反。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a16",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p5",
    "annotator": "索隱",
    "text": "扞即捍也。違扞當代之法網，謂犯於法禁也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a17",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p6",
    "annotator": "集解",
    "text": "徐廣曰：「音雊。」駰案：漢書音義曰「小牛」。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a18",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p6",
    "annotator": "索隱",
    "text": "軥音古豆反。案：大牛當軶，小爲軥牛。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a19",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p6",
    "annotator": "索隱",
    "text": "陰脫季將軍之厄。案：季布爲漢所購求，朱家以布髡鉗爲奴，載以廣柳車而出之，及尊貴而不見之，亦高介至義之士。然布竟不見報朱家之恩。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a20",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p7",
    "annotator": "索隱",
    "text": "好六博之戲也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a21",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p8",
    "annotator": "索隱",
    "text": "瞷音閒。案：爲郅都所誅。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a22",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p8",
    "annotator": "索隱",
    "text": "陳國人，姓周名庸。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a23",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p8",
    "annotator": "集解",
    "text": "徐廣曰：「陝，疑當作『郟』字，潁川有郟縣。南越傳曰『郟壯士韓千秋』也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a24",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p8",
    "annotator": "索隱",
    "text": "代，代郡。人有白氏，豪俠非一，故言「諸」。梁，梁國人，韓姓，無辟名。辟音避。陝當爲「郟」。陝音如冉反，郟音紀洽反。漢書作「寒孺」。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a25",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "索隱",
    "text": "漢書云河內軹人也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a26",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "索隱",
    "text": "以內心忍害。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a27",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "索隱",
    "text": "案謂亡命也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a28",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "索隱",
    "text": "蘇林云：「言性喜爲俠也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a29",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "索隱",
    "text": "負，恃也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a30",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "集解",
    "text": "徐廣曰：「音子妙反，盡酒也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a31",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p9",
    "annotator": "集解",
    "text": "徐廣曰：「遣使去。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a32",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p10",
    "annotator": "索隱",
    "text": "案謂吾心中所急，言情切急之謂。漢書作「重」也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a33",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p10",
    "annotator": "集解",
    "text": "如淳曰：「更有三品，有卒更，有踐更，有過更。古有正卒無常人，皆當迭爲之，一月一更，是爲卒更也。貧者欲得顧更錢者，次直者出錢顧之，月二千，是爲踐更也。律說卒更、踐更者，居縣中五月乃更也。後從尉律，卒踐更一月休十一月也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a34",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p10",
    "annotator": "索隱",
    "text": "數音朔，謂頻免之也。又音色主反，數亦頻也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a35",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p11",
    "annotator": "索隱",
    "text": "色具反。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a36",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p11",
    "annotator": "索隱",
    "text": "謂屈曲聽解也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a37",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p11",
    "annotator": "索隱",
    "text": "漢書作「無庸」。蘇林曰「且無使用吾言，待我去，令洛陽豪居其閒也」。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a38",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p12",
    "annotator": "索隱",
    "text": "如淳云：「解多藏亡命者，故喜事年少與解同志者，知亡命者多歸解，故多將車來，欲爲解迎亡者而藏之者也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a39",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p13",
    "annotator": "索隱",
    "text": "案貲不滿三百萬已上爲不中。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a40",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p14",
    "annotator": "集解",
    "text": "徐廣曰：「屬馮翊。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a41",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p14",
    "annotator": "正義",
    "text": "故城在同州韓城縣南二十里，漢夏陽也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a42",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p14",
    "annotator": "正義",
    "text": "故城在同州馮翊縣西南二里。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a43",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "集解",
    "text": "徐廣曰：「敖，倨也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a44",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "集解",
    "text": "徐廣曰：「鴈門有鹵城也。」"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a45",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "索隱",
    "text": "漢書作「魯公孺」。魯，姓也，與徐廣之說不同也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a46",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "索隱",
    "text": "漢書作「陳君孺」。然陳田聲相近，亦本同姓。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a47",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "正義",
    "text": "其東陽蓋貝州歷亭縣者，爲近齊故也。"
  },
  {
    "id": "anno:shiji:shiji-游俠列傳第六十四:a48",
    "book": "shiji",
    "chapter_id": "shiji-游俠列傳第六十四",
    "target_para_id": "text:shiji:shiji-游俠列傳第六十四:p15",
    "annotator": "索隱",
