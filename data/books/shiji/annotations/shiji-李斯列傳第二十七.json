[
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a0",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p0",
    "annotator": "索隱",
    "text": "地理志汝南上蔡縣，云「古蔡國，周武王弟叔度所封，至十八代平侯徙新蔡」。二蔡皆屬汝南。後二代至昭侯，徙下蔡，屬沛，六國時爲楚地，故曰楚上蔡。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a1",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p0",
    "annotator": "索隱",
    "text": "郡一作鄉。劉氏云「掌鄉文書」。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a2",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "索隱",
    "text": "言萬乘爭雄之時，游說者可以立功成名，當得典主事務也。劉氏云「游歷諸侯，當覓彊主以事之」，於文紆迴，非也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a3",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "正義",
    "text": "言秋時萬物成熟，今爭彊時，亦說士成熟時。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a4",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "索隱",
    "text": "禽鹿猶禽獸也，言禽獸但知視肉而食之。莊子及蘇子曰：「人而不學，譬之視肉而食。」楊子法言曰：「人而不學，如禽何異？」言不能游說取榮貴，即如禽獸，徒有人面而能彊行耳。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a5",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "正義",
    "text": "詬呼后反，恥辱也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a6",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "正義",
    "text": "言譏世富貴，惡其榮利，自託於無爲者，非士人之情，實力不能致此也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a7",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p1",
    "annotator": "索隱",
    "text": "非者，譏也。所謂處士橫議也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a8",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "索隱",
    "text": "胥人猶胥吏，小人也。去猶失也。幾者，動之微。以言君子見幾而作，不俟終日；小人不識動微之會，故每失時也。劉氏解幾爲彊，非也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a9",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "正義",
    "text": "胥，相也。幾謂察也。言關東六國與秦相敵者，君臣機密，並有瑕釁，可成大功，而遂忍之也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a10",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "索隱",
    "text": "言因諸侯有瑕釁，則忍心而翦除，故我將說秦以并天下。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a11",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "正義",
    "text": "秦孝公，惠文公，武王，昭王，孝文王，莊襄王。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a12",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "集解",
    "text": "徐廣曰：「騷音埽。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a13",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p2",
    "annotator": "索隱",
    "text": "言秦欲并天下，若炊婦埽除竈上之不淨，不足爲難。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a14",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p3",
    "annotator": "正義",
    "text": "鄭國渠首起雍州雲陽縣西南二十五里，自中山西邸瓠口爲渠，傍北山，東注洛，三百餘里以溉田。又曰韓苦秦兵，而使水工鄭國閒秦作注溉渠，令費人工，不東伐也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a15",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p3",
    "annotator": "索隱",
    "text": "一切猶一例，言盡逐之也。言切者，譬若利刀之割，一運斤無不斷者。解漢書者以一切爲權時義，亦未爲得也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a16",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p3",
    "annotator": "正義",
    "text": "在始皇十年。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a17",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "秦本紀云「晉獻公以百里奚爲秦穆公夫人媵於秦，奚亡走宛，楚鄙人執之」是也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a18",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "新序云：「百里奚，楚宛人，仕於虞，虞亡入秦，號五羖大夫也。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a19",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "秦紀又云「百里奚謂穆公曰：『臣不如臣友蹇叔，蹇叔賢而代莫知。』穆公厚幣迎之，以爲上大夫」。今云「於宋」，未詳所出。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a20",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "括地志云：「蹇叔，岐州人也。時游宋，故迎之於宋。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a21",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "丕豹自晉奔秦，左氏傳有明文。公孫支，所謂子桑也，是秦大夫，而云自晉來，亦未見所出。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a22",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "括地志云：「公孫支，岐州人，游晉，後歸秦。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a23",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "秦本紀穆公用由余謀，伐戎王，益國十二，開地千里，遂霸西戎。此都言五子之功，故云「并國二十」；或易爲「十二」，誤也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a24",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "案惠王時張儀爲相，請伐韓，下兵三川以臨二周。司馬錯請伐蜀，惠王從之，果滅蜀。儀死後，武王欲通車三川，令甘茂拔宜陽。今並云張儀者，以儀爲秦相，雖錯滅蜀，茂通三川，皆歸功於相，又三川是儀先請伐故也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a25",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "惠王十年，魏納上郡十五縣。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a26",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "惠王十三年，攻楚漢中，取地六百里。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a27",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "九夷即屬楚之夷也。地理志南郡江陵縣云「故楚郢都」，又宜城縣云「故鄢」也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a28",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "夷謂并巴蜀，收上郡，取漢中，伐義渠、丹犁是也。九夷本東夷九種，此言者，文體然也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a29",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "正義",
    "text": "河南府氾水縣也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a30",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "集解",
    "text": "徐廣曰：「華，一作『葉』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a31",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p4",
    "annotator": "索隱",
    "text": "高誘注淮南子云：「蠶食，盡無餘也。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a32",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "正義",
    "text": "昆岡在于闐國東北四百里，其岡出玉。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a33",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "正義",
    "text": "括地志云：「濆山一名崑山，一名斷蛇丘，在隨州隨縣北二十五里。說苑云『昔隨侯行遇大蛇中斷，疑其靈，使人以藥封之，蛇乃能去，因號其處爲斷蛇丘。歲餘，蛇銜明珠，徑寸，絕白而有光，因號隨珠』。」卞和璧，始皇以爲傳國璽也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a34",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "集解",
    "text": "見蘇秦傳。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a35",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "集解",
    "text": "徐廣曰：「纖離，蒲梢，皆駿馬名。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a36",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "徐氏據孫卿子而爲說。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a37",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "集解",
    "text": "鄭玄注月令云：「鼉皮可以冒鼓。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a38",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "駃音決，騠音提。周書曰「正北以駃騠爲獻」。廣雅曰「馬屬也」。郭景純注上林賦云「生三日而超其母也」。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a39",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "下陳猶後列也。晏子曰「有二女，願得入身於下陳」是也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a40",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "宛音於阮反。傅音附。宛謂以珠宛轉而裝其簪。傅璣者，以璣傅著於珥。珥者，瑱也。璣是珠之不圓者。或云宛珠，隨珠也。隨在漢水之南，宛亦近漢，故云宛。傅璣者，女飾也，言女傅之珥，以璣爲之，並非秦所有物也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a41",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "集解",
    "text": "徐廣曰：「齊之東阿縣，繒帛所出。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a42",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "集解",
    "text": "徐廣曰：「隨俗，一作『修使』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a43",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "謂閑雅變化而能通俗也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a44",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "說文云：「甕，汲缾也。於貢反。缶，瓦器也；秦人鼓之以節樂。」缻音甫有反。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a45",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p5",
    "annotator": "索隱",
    "text": "昭作韶。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a46",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p6",
    "annotator": "索隱",
    "text": "管子云：「海不辭水，故能成其大；泰山不辭土石，故能成其高。」文子曰：「聖人不讓負薪之言，以廣其名。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a47",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p6",
    "annotator": "索隱",
    "text": "資猶給也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a48",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p6",
    "annotator": "索隱",
    "text": "藉音積夜反。齎音子奚反。說文曰：「齎，持遺也。」齎或爲「資」，義亦通。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a49",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p8",
    "annotator": "集解",
    "text": "新序曰：「斯在逐中，道上上諫書，達始皇，始皇使人逐至驪邑，得還。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a50",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p9",
    "annotator": "索隱",
    "text": "重音逐用反。重者，再也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a51",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p9",
    "annotator": "索隱",
    "text": "劉氏云：「前時國異政，家殊俗，人造私語，莫辨其真，今乃分別白黑也。」秦始皇并六國，定天下，海內共尊立一帝，故云定一尊。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a52",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p9",
    "annotator": "正義",
    "text": "六國制令不同，今令同之。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a53",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p10",
    "annotator": "索隱",
    "text": "稅駕猶解駕，言休息也。李斯言己今日富貴已極，然未知向後吉凶止泊在何處也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a54",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p11",
    "annotator": "正義",
    "text": "今沂州。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a55",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p11",
    "annotator": "正義",
    "text": "上郡故城在綏州上縣東南五十里。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a56",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p11",
    "annotator": "集解",
    "text": "辯士隱姓名，遺秦將章邯書曰「李斯爲秦王死，廢十七兄而立今王」也。然則二世是秦始皇第十八子。此書在善文中。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a57",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p12",
    "annotator": "正義",
    "text": "沙丘臺在邢州。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a58",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p12",
    "annotator": "集解",
    "text": "徐廣曰：「一作『輜車』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a59",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p12",
    "annotator": "集解",
    "text": "文穎曰：「轀輬車如今喪轜車也。」孟康曰：「如衣車，有窗牖，閉之則溫，開之則涼，故名之『轀輬車』也。」如淳曰：「轀輬車，其形廣大，有羽飾也。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a60",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p13",
    "annotator": "集解",
    "text": "史記音隱宰顯反。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a61",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p13",
    "annotator": "索隱",
    "text": "劉氏音將淺反，則譾亦淺義。古人語自有重輕，所以文字有異。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a62",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "索隱",
    "text": "斯言忠臣之節，本不避死。言己今日亦庶幾盡忠不避死也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a63",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "索隱",
    "text": "水搖者，謂冰泮而水動也，是春時而萬物皆生也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a64",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "正義",
    "text": "謂廢申生，立奚齊也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a65",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "正義",
    "text": "謂小白與公子糾。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a66",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "正義",
    "text": "謂殺比干，囚箕子。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a67",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p14",
    "annotator": "索隱",
    "text": "言我今日猶是人，人道守順，豈能爲逆謀。故文「安足爲謀」也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a68",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p16",
    "annotator": "集解",
    "text": "徐廣曰：「屬上郡。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a69",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p16",
    "annotator": "正義",
    "text": "陽周，寧州羅川縣之邑也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a70",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p18",
    "annotator": "集解",
    "text": "史記音隱曰：「矺音貯格反。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a71",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p18",
    "annotator": "索隱",
    "text": "矺音宅，與「磔」同，古今字異耳。磔謂裂其支體而殺之。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a72",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "集解",
    "text": "徐廣曰：「采，一名櫟。一作『柞』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a73",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "索隱",
    "text": "采，木名，即今之櫟木。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a74",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "索隱",
    "text": "粢音資。糲音郎葛反。粢者，稷也。糲者，麄粟飯也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a75",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "集解",
    "text": "徐廣曰：「一作『溜』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a76",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "集解",
    "text": "音刑。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a77",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "集解",
    "text": "徐廣曰：「觳音學。觳，一作『轂』，推也。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a78",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "索隱",
    "text": "爾雅「觳，盡也」。言監門下人飯猶不盡此。若徐氏云「一作『轂』。轂，推也」，則字宜作「較」。鄒氏音角。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a79",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "正義",
    "text": "謂河之九曲，別爲隄防。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a80",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "集解",
    "text": "徐廣曰：「致，一作『放』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a81",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p20",
    "annotator": "注",
    "text": "胈，膚毳皮。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a82",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p21",
    "annotator": "索隱",
    "text": "督者，察也。察其罪，責之以刑罰也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a83",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p22",
    "annotator": "索隱",
    "text": "恣音資二反，雎音呼季反。恣睢猶放縱也。謂肆情縱恣也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a84",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p22",
    "annotator": "正義",
    "text": "言有天下不能自縱恣督責，乃勞身於天下若堯、禹，即以天下爲桎梏於身也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a85",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "索隱",
    "text": "格，彊扞也。虜，奴隸也。言嚴整之家本無格扞奴僕也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a86",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "正義",
    "text": "弃灰於道者黥也。韓子云：「殷之法，弃灰於衢者刑。子貢以爲重，問之。仲尼曰：『灰弃於衢必燔，人必怒，怒則鬬，鬬則三族，雖刑之可也。』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a87",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "索隱",
    "text": "尋常，以言其少也。庸人弗釋者，謂庸人見則取之而不釋，以其罪輕，故下云「罰不必行，則庸人弗釋尋常」是也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a88",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "索隱",
    "text": "爾雅云「鑠，美也」。言百溢之美金在於地，雖有盜跖之行亦不取者，爲財多而罪重也，故下云「搏必隨手刑，盜跖不搏」也。搏猶攫也，取也。凡鳥翼擊物曰搏，足取曰攫，故人取物亦謂之搏。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a89",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "集解",
    "text": "許慎曰：「樓季，魏文侯之弟。」王孫子曰：「樓季之兄也。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a90",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "集解",
    "text": "詩云：「䍧羊墳首。」毛傳曰：「牝曰䍧。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a91",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "索隱",
    "text": "陗，峻也，高也，七笑反。壍音漸。以言峭峻則難登，故樓季難五丈之限；平壍則易涉，故跛䍧牧於泰山也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a92",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p23",
    "annotator": "索隱",
    "text": "舍猶廢也，止也。言爲人主不能行聖人督責之術，則已廢止，何爲勤身苦心，爲天下所役，是何哉？「可不哀邪」，言其非也。"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a93",
    "book": "shiji",
    "chapter_id": "shiji-李斯列傳第二十七",
    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p24",
    "annotator": "索隱",
    "text": "拂音扶弗反。磨音莫何反。拂世，蓋言與代情乖戾。磨俗，言磨礪於俗使從己。"
  },
  {
