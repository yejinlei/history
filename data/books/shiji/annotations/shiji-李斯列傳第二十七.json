    "target_para_id": "text:shiji:shiji-李斯列傳第二十七:p26",
    "annotator": "集解",
    "text": "徐廣曰：「通，或宜作『照』。」"
  },
  {
    "id": "anno:shiji:shiji-李斯列傳第二十七:a95",
    "book": "shiji",
