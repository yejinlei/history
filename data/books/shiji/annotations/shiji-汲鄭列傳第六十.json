    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p16",
    "annotator": "集解",
    "text": "徐廣曰：「算音先管反，竹器。」"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a35",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p16",
    "annotator": "索隱",
    "text": "算謂竹器，以言無銅漆也。漢書作「具器食」。"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a36",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p17",
    "annotator": "集解",
    "text": "如淳曰：「治行謂莊嚴也。」"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a37",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p17",
    "annotator": "集解",
    "text": "徐廣曰：「一作『入』。一云賔客爲大農僦人，僦人蓋興生財利，如今方宜矣。」駰案：晉灼曰「當時爲大農，而任使其賔客辜較任僦也」。瓚曰「任人謂保任見舉者」。"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a38",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p17",
    "annotator": "索隱",
    "text": "僦音即就反。辜較音姑角。按：謂當時作大農，任賔客就人取庸直也。或者貰物以應官取庸，故下云「多逋負」。「辜較」字亦作「酤榷」。榷者，獨也。言國家獨榷酤也。此云「辜較」，亦謂令賔客任人專其利，故云辜較也。"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a39",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p17",
    "annotator": "集解",
    "text": "如淳曰：「丞相長史。」"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a40",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p18",
    "annotator": "索隱",
    "text": "落猶零落，謂散也。"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a41",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p19",
    "annotator": "集解",
    "text": "徐廣曰：「邽，一作『邳』。」"
  },
  {
    "id": "anno:shiji:shiji-汲鄭列傳第六十:a42",
    "book": "shiji",
    "chapter_id": "shiji-汲鄭列傳第六十",
    "target_para_id": "text:shiji:shiji-汲鄭列傳第六十:p19",
    "annotator": "索隱",
    "text": "邽音圭，縣名，屬京兆。"
  }
]