    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p2",
    "annotator": "正義",
    "text": "說苑云：「孫叔敖爲令尹，一國吏民皆來賀。有一老父衣麤衣，冠白冠，後來，弔曰：『有身貴而驕人者，民亡之；位已高而擅權者，君惡之；祿已厚而不知足者，患處之。』叔敖再拜，敬受命，願聞餘教。父曰：『位已高而意益下，官益大而心益小，祿已厚而慎不取。君謹守此三者，足以治楚。』」"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a1",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p2",
    "annotator": "集解",
    "text": "徐廣曰：「乘多水時而出材竹。」"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a2",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p4",
    "annotator": "索隱",
    "text": "庳，下也，音婢。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a3",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p4",
    "annotator": "索隱",
    "text": "音口本反。梱，門限也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a4",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p5",
    "annotator": "集解",
    "text": "皇覽曰：「孫叔敖冢在南郡江陵故城中白土里。民傳孫叔敖曰『葬我廬江陂，後當爲萬戶邑』。去故楚都郢城北三十里所。或曰孫叔敖激沮水作雲夢大澤之池也。」"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a5",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "索隱",
    "text": "案鄭系家云子產，鄭成公之少子。事簡公、定公。簡公封子產以六邑，子產受其半。子產不事昭君，亦無徐摯作相之事。蓋別有所出，太史記異耳。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a6",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "索隱",
    "text": "子期亦鄭之公子也。左傳、國語亦無其說。案：系家鄭相子駟、子孔與子產同時，蓋亦子期之兄弟也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a7",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "索隱",
    "text": "賈音價。謂臨時評其貴賤，不豫定也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a8",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "集解",
    "text": "徐廣曰：「一作『閉』。」"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a9",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "正義",
    "text": "言士民無一尺方板之籍書。什伍，什伍相保也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a10",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "集解",
    "text": "皇覽曰：「子產冢在河南新鄭，城外大冢是也。」"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a11",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p6",
    "annotator": "索隱",
    "text": "案左傳及系家云子產死，孔子泣曰「子產，古之遺愛也」。又韓詩稱子產卒，鄭人耕者輟耒，婦人捐其佩玦也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a12",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p11",
    "annotator": "正義",
    "text": "理，獄官也。"
  },
  {
    "id": "anno:shiji:shiji-循吏列傳第五十九:a13",
    "book": "shiji",
    "chapter_id": "shiji-循吏列傳第五十九",
    "target_para_id": "text:shiji:shiji-循吏列傳第五十九:p11",
    "annotator": "索隱",
    "text": "言能聽察微理，以決疑獄。故周禮司寇以五聽察獄，詞氣色耳目也。又尚書曰「服念五六日，至于旬時」是也。"
  }
]