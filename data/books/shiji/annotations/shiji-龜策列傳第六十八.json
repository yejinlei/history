[
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a0",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p2",
    "annotator": "集解",
    "text": "徐廣曰：「一作『革』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a1",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p3",
    "annotator": "集解",
    "text": "徐廣曰：「攘，一作『襄』。襄，除也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a2",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "集解",
    "text": "徐廣曰：「摓音逢。一作『達』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a3",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "索隱",
    "text": "摓謂兩手執蓍分而扐之，故云摓策。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a4",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "集解",
    "text": "左傳曰遇黃帝戰于阪泉之兆。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a5",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "集解",
    "text": "左傳曰：「靈王卜，曰『余尚得天下』，不吉。投龜詬天而呼曰：『是區區者而不余畀，余必自取之。』」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a6",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "索隱",
    "text": "詬音火候反。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a7",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p4",
    "annotator": "索隱",
    "text": "悖音倍，背音佩。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a8",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p5",
    "annotator": "集解",
    "text": "徐廣曰：「蓮，一作『領』。領與蓮聲相近，或假借字也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a9",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p5",
    "annotator": "集解",
    "text": "徐廣曰：「劉向云龜千歲而靈，蓍百年而一本生百莖。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a10",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "索隱",
    "text": "此傳即太卜所得古占龜之說也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a11",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "索隱",
    "text": "擣音逐留反。按：即稠也。擣蓍即藂蓍，擣是古「稠」字也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a12",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「簼，籠也。蓋然火而籠罩其上也。音溝。陳涉世家曰『夜簼火』也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a13",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「一無『不』字。許氏說淮南以爲滋潤鍾於明珠，致令岸枯也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a14",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "集解",
    "text": "徐廣曰：「許氏說淮南云蚗龍，龍屬也。音決。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a15",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p7",
    "annotator": "索隱",
    "text": "蚗當爲「蛟」。蠪音龍，注音決，誤也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a16",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「臑音乃毛反。臑，臂。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a17",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "索隱",
    "text": "臑音乃高反。臑，臂也。一音乃導反。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a18",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "索隱",
    "text": "按萬畢術中有石朱方，方中說嘉林中，故云傳曰。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a19",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「子，一作『于』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a20",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「正，長也。爲有土之官長。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a21",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「一孤反。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a22",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "索隱",
    "text": "按林名白蛇蟠杅林，龜藏其中。杅音烏。謂白蛇嘗蟠杅此林中也。譺音嶷。言求龜者齋戒以待，常譺然也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a23",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "集解",
    "text": "徐廣曰：「佗，一作『被』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a24",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p9",
    "annotator": "索隱",
    "text": "佗音徒我反。謂被髮也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a25",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p12",
    "annotator": "索隱",
    "text": "且音子余切。泉陽人，網元龜者。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a26",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p12",
    "annotator": "索隱",
    "text": "宋元君之臣也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a27",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p12",
    "annotator": "集解",
    "text": "徐廣曰：「式音敕。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a28",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p12",
    "annotator": "索隱",
    "text": "今昔猶昨夜也。以今日言之，謂昨夜爲今昔。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a29",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p12",
    "annotator": "正義",
    "text": "漢，天河。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a30",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p13",
    "annotator": "集解",
    "text": "莊子曰得白龜圓五尺。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a31",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「誕，一作『訑』，音吐和反。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a32",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "索隱",
    "text": "誕音田爛反；謾音漫，又並如字。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a33",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「一作『病』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a34",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "正義",
    "text": "說文云「衣服歌謠草木之怪謂之妖，禽獸蟲蝗之怪謂之㜸」也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a35",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「音憂。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a36",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "正義",
    "text": "耰，覆種也。說文云：「耰，摩田器。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a37",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「耨，除草也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a38",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "正義",
    "text": "說文云：「圓者謂之囷，方者謂之廩。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a39",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「隻，一作『雙』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a40",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "集解",
    "text": "徐廣曰：「鐫音子旋反。拌音判。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a41",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p19",
    "annotator": "索隱",
    "text": "判，割也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a42",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "集解",
    "text": "禮記曰：「目巧之室。」鄭玄曰：「但用目巧善意作室，不由法度。」許慎曰：「象牙郎。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a43",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "索隱",
    "text": "箸音持慮反，則箸是筯，爲與羹連，則或非箸，樽也。記曰「羹之有菜者用梜」。梜者，箸也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a44",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "注",
    "text": "胻音衡，腳脛也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a45",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "索隱",
    "text": "按「殺周太子歷」文在「囚文王昌」之上，則近是季歷。季歷不被紂誅，則其言近妄，無容周更別有太子名歷也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a46",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "集解",
    "text": "徐廣曰：「兢，一作『竟』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a47",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "索隱",
    "text": "陰，姓；兢，名。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a48",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "集解",
    "text": "徐廣曰：「天子之居，名曰宣室。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a49",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "集解",
    "text": "徐廣曰：「涫音館。一作『沸』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a50",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p20",
    "annotator": "索隱",
    "text": "涫，沸也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a51",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p21",
    "annotator": "集解",
    "text": "世本曰：「昆吾作陶。」張華博物記亦云「桀作瓦」。蓋是昆吾爲桀作也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a52",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p21",
    "annotator": "索隱",
    "text": "按灼謂燔也。燒絲以當薪，務費人也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a53",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p22",
    "annotator": "索隱",
    "text": "蓋欲神之以謝天也。天之質闇，日者天之光明，著見者莫過也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a54",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p22",
    "annotator": "正義",
    "text": "音瘡。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a55",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p22",
    "annotator": "集解",
    "text": "徐廣曰：「福音副，藏也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a56",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p22",
    "annotator": "集解",
    "text": "徐廣曰：「牛革桐爲鼓也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a57",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "集解",
    "text": "新序曰：「楚雄渠子夜行，見伏石當道，以爲虎而射之，應弦沒羽。」淮南子曰：「射者重以逢門子之巧。」劉歆七略有蠭門射法也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a58",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "正義",
    "text": "凡龜其骨空中而枯也。直，語發聲也，今河東亦然。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a59",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "集解",
    "text": "郭璞曰：「蝟能制虎，見鵲仰地。」淮南萬畢曰：「鵲令蝟反腹者，蝟憎其意而心惡之也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a60",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "集解",
    "text": "郭璞曰：「騰蛇，龍屬也。蝍蛆，似蝗，大腹，食蛇腦也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a61",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "正義",
    "text": "即，津日反。且，則餘反。即吳公也，狀如蚰蜒而大，黑色。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a62",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "集解",
    "text": "甲乙謂之日，子丑謂之辰。六甲孤虛法：甲子旬中無戌亥，戌亥即爲孤，辰巳即爲虛。甲戌旬中無申酉，申酉爲孤，寅卯即爲虛。甲申旬中無午未，午未爲孤，子丑即爲虛。甲午旬中無辰巳，辰巳爲孤，戌亥即爲虛。甲辰旬中無寅卯，寅卯爲孤，申酉即爲虛。甲寅旬中無子丑，子丑爲孤，午未即爲虛。劉歆七略有風后孤虛二十卷。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a63",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "正義",
    "text": "按歲月日時孤虛，並得上法也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a64",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "集解",
    "text": "徐廣曰：「一云爲屋成，欠三瓦而棟之也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a65",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "索隱",
    "text": "劉氏云：「陳猶居也。」注作「棟」，音都貢反。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a66",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "正義",
    "text": "言爲屋不成，欠三瓦以應天，猶陳列而居之。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a67",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p23",
    "annotator": "正義",
    "text": "言萬物及日月天地皆不能全，喻龜之不全也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a68",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "正義",
    "text": "言正月、二月、三月右轉周環終十二月者，日月之龜，腹下十二黑點爲十二月，若二十八宿龜也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a69",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "注",
    "text": "中關內高外下。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a70",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "正義",
    "text": "此等下至「首俛大」者，皆卜兆之狀也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a71",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "索隱",
    "text": "音魚兩反。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a72",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "正義",
    "text": "謂兆首仰起。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a73",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "索隱",
    "text": "音琴。肣謂兆足斂也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a74",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "索隱",
    "text": "俛音免，兆首伏也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a75",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p25",
    "annotator": "正義",
    "text": "俛音免，謂兆首伏而大。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a76",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "索隱",
    "text": "徼音叫。謂徼繞不明也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a77",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "索隱",
    "text": "祓音廢，又音拂。拂洗之以水，雞卵摩之而呪。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a78",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "正義",
    "text": "以常月朝清水洗之，以雞卵摩而祝之。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a79",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "集解",
    "text": "徐廣曰：「一作『視』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a80",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "索隱",
    "text": "祖，法也。言以爲常法。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a81",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "集解",
    "text": "徐廣曰：「一作『十一』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a82",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "索隱",
    "text": "按：古之灼龜，取生荊枝及生堅木燒之，斬斷以灼龜。按：「土」字合依劉氏說當連下句。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a83",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "正義",
    "text": "言卜不中，以土爲卵，三度指之，三周繞之，用厭不祥也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a84",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "索隱",
    "text": "粱，米也。卵，雞子也。焍，灼龜木也，音「次第」之「第」。言燒荊枝更遞而灼，故有焍名。一音梯，言灼之以漸，如有階梯也。黃者，以黃絹裹粱卵以祓龜也。必以黃者，中之色，主土而信，故用雞也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a85",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p26",
    "annotator": "正義",
    "text": "焍音題。焍，焦也。言以粱米雞卵祓去龜之不祥，令灼之不焦不黃。若色焦及黃，卜之不中也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a86",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "集解",
    "text": "徐廣曰：「造音竈也。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a87",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "索隱",
    "text": "造謂燒荊之處。物若木也。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a88",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "集解",
    "text": "徐廣曰：「一作『止』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a89",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "索隱",
    "text": "尊神龜而爲之作號。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a90",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "集解",
    "text": "徐廣曰：「音策。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a91",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "索隱",
    "text": "數，所具反；𠞁音近策，或𠞁是策之別名。此卜筮之書，其字亦無可覈，皆放此。"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a92",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p27",
    "annotator": "集解",
    "text": "徐廣曰：「行，一作『身』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a93",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p33",
    "annotator": "集解",
    "text": "徐廣曰：「一作『簡』。」"
  },
  {
    "id": "anno:shiji:shiji-龜策列傳第六十八:a94",
    "book": "shiji",
    "chapter_id": "shiji-龜策列傳第六十八",
    "target_para_id": "text:shiji:shiji-龜策列傳第六十八:p97",
    "annotator": "索隱",
    "text": "按褚先生所取太卜雜占卦體及命兆之辭，義蕪，辭重，殆無足採，凡此六十七條別是也。"
  }
]