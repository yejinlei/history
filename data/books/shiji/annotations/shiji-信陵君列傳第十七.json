[
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a0",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p0",
    "annotator": "索隱",
    "text": "地理志無信陵，或是鄉邑名也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a1",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p2",
    "annotator": "集解",
    "text": "文穎曰：「作高木櫓，櫓上作桔槔，桔槔頭兜零，以薪置其中，謂之烽。常低之，有寇即火然舉之以相告。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a2",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p2",
    "annotator": "正義",
    "text": "爲，于偽反。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a3",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p3",
    "annotator": "索隱",
    "text": "音盈。又曹植音「羸瘦」之「羸」。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a4",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p3",
    "annotator": "索隱",
    "text": "俾音浦計反，倪音五計反。鄒誕云俾音疋未反，倪音五弟反。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a5",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p3",
    "annotator": "正義",
    "text": "不正視也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a6",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p3",
    "annotator": "索隱",
    "text": "徧音遍。贊，告也。謂以侯生徧告賔客。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a7",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p3",
    "annotator": "集解",
    "text": "徐廣曰：「爲，一作『羞』。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a8",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p5",
    "annotator": "索隱",
    "text": "魏將姓名也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a9",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p6",
    "annotator": "索隱",
    "text": "閒音閑。謂靜語也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a10",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p6",
    "annotator": "索隱",
    "text": "舊解資之三年謂服齊衰也。今案：資者，畜也。謂欲爲父復讎之資畜於心已得三年矣。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a11",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p7",
    "annotator": "集解",
    "text": "上音烏百反，下音莊白反。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a12",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p7",
    "annotator": "索隱",
    "text": "上烏白反，下爭格反。案：嚄唶謂多詞句也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a13",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p7",
    "annotator": "正義",
    "text": "聲類云：「嚄，大笑。唶，大呼。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a14",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p8",
    "annotator": "集解",
    "text": "呂忱曰：「韊盛弩矢。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a15",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p8",
    "annotator": "索隱",
    "text": "韊音蘭。謂以盛矢，如今之胡簏而短也。呂姓，忱名，作字林者。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a16",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p9",
    "annotator": "集解",
    "text": "禮記曰：「主人就東階，客就西階。客若降等，則就主人之階。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a17",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p9",
    "annotator": "索隱",
    "text": "負音佩。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a18",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p9",
    "annotator": "索隱",
    "text": "鄗音霍，趙邑名，屬常山。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a19",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p10",
    "annotator": "集解",
    "text": "徐廣曰：「漿，一作『醪』。」"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a20",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p10",
    "annotator": "索隱",
    "text": "徐按別錄云。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a21",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p10",
    "annotator": "索隱",
    "text": "謂豪者舉之。舉亦音據也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a22",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p11",
    "annotator": "索隱",
    "text": "史失其名。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a23",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p12",
    "annotator": "索隱",
    "text": "抑音憶。按：抑謂以兵蹙之。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a24",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p12",
    "annotator": "集解",
    "text": "劉歆七略有魏公子兵法二十一篇，圖七卷。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a25",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p12",
    "annotator": "索隱",
    "text": "言公子所得進兵法而必稱其名，以言其恕也。"
  },
  {
    "id": "anno:shiji:shiji-信陵君列傳第十七:a26",
    "book": "shiji",
    "chapter_id": "shiji-信陵君列傳第十七",
    "target_para_id": "text:shiji:shiji-信陵君列傳第十七:p14",
    "annotator": "索隱",
    "text": "魏王名假。"
  }
]