  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a53",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "集解",
    "text": "鏤，錄于反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a54",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "幾音祈。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a55",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "器謂棺也，以吳必亡也。左傳云：「樹吾墓檟，檟可材也，吳其亡乎！」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a56",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "索隱",
    "text": "烏穴反。抉亦決也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a57",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "東門，䲕門，謂䱐門也，今名葑門。䲕音普姑反。䱐音覆浮反。越軍開示浦，子胥濤盪羅城，開此門，有䲕䱐隨濤入，故以名門。顧野王云「䲕魚一名江豚，欲風則涌」也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a58",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "集解",
    "text": "應劭曰：「取馬革爲鴟夷，鴟夷，榼形。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a59",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "盛音成。榼，古曷反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a60",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「魯哀公十一年。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a61",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "案年表云吳王夫差十一年也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a62",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "吳地記曰：「越軍於蘇州東南三十里三江口，又向下三里，臨江北岸立壇，殺白馬祭子胥，杯動酒盡，後因立廟於此江上。今其側有浦名上壇浦。至晉會稽太守麋豹，移廟吳郭東門內道南，今廟見在。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a63",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "集解",
    "text": "張晏曰：「胥山在太湖邊，去江不遠百里，故云江上。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a64",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p18",
    "annotator": "正義",
    "text": "吳地記云：「胥山，太湖邊胥湖東岸山，西臨胥湖，山有古丞胥二王廟。」按：其廟不干子胥事，太史誤矣，張注又非。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a65",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p19",
    "annotator": "索隱",
    "text": "音拓臯二音。杜預云：「地名，在淮南逡遒縣東南。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a66",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p19",
    "annotator": "正義",
    "text": "橐臯故縣在廬州巢縣西北五十六里。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a67",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p19",
    "annotator": "正義",
    "text": "在汴州封丘縣南七里。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a68",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p19",
    "annotator": "索隱",
    "text": "左傳太子名友。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a69",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p19",
    "annotator": "正義",
    "text": "紀鼻二音。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a70",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p20",
    "annotator": "正義",
    "text": "上式涉反。杜預云：「子高，沈諸梁。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a71",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p20",
    "annotator": "集解",
    "text": "徐廣曰：「潁川鄢陵是。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a72",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p20",
    "annotator": "正義",
    "text": "鄢音偃。括地志云：「故郾城在豫州郾城縣南五里，與襃信白亭相近。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a73",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p20",
    "annotator": "集解",
    "text": "徐廣曰：「汝南襃信縣有白亭。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a74",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p20",
    "annotator": "正義",
    "text": "括地志云：「白亭在豫州襃信縣南四十二里，又有白公故城。又許州扶溝縣北四十五里北又有白亭也。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a75",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p21",
    "annotator": "索隱",
    "text": "左傳作「子期之子平見曰『王孫何自礪也』」。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a76",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "索隱",
    "text": "左傳作「子期」也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a77",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "索隱",
    "text": "杜預云：「楚之別府也。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a78",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "集解",
    "text": "徐廣曰：「一作『惠王從者屈固』。楚世家亦云『王從者』。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a79",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "索隱",
    "text": "按：徐廣曰一作「惠王從者屈固」，蓋此本爲得。而左傳云「石乞尹門，圉公陽穴宮，負王以如昭夫人之宮」，則公陽是楚之大夫，王之從者也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a80",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "索隱",
    "text": "昭王夫人即惠王母，越女也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a81",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p22",
    "annotator": "正義",
    "text": "左傳云白公奔而縊。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a82",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p23",
    "annotator": "索隱",
    "text": "窘音求殞反。"
  }
]