[
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a0",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p0",
    "annotator": "索隱",
    "text": "按舉直諫，見左氏、楚系家。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a1",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p1",
    "annotator": "索隱",
    "text": "按左傳作「費無極」。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a2",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p2",
    "annotator": "集解",
    "text": "地理志潁川有城父縣。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a3",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p2",
    "annotator": "索隱",
    "text": "本陳邑，楚伐陳而有之。地理志潁川有城父縣。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a4",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p3",
    "annotator": "索隱",
    "text": "奮揚城父司馬之姓名也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a5",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p4",
    "annotator": "集解",
    "text": "音火候反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a6",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p4",
    "annotator": "索隱",
    "text": "鄒氏云：「一作『詬』，罵也，音逅。」劉氏音火候反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a7",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p4",
    "annotator": "集解",
    "text": "貫，烏還反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a8",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p4",
    "annotator": "索隱",
    "text": "劉氏音貫爲彎，又音古患反。貫謂滿張弓。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a9",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p5",
    "annotator": "索隱",
    "text": "春秋昭二十年，宋華亥、向寧、華定與君爭而出奔是也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a10",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p5",
    "annotator": "索隱",
    "text": "其關在江西、乃吳楚之境也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a11",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p5",
    "annotator": "集解",
    "text": "張勃曰：「子胥乞食處在丹陽溧陽縣。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a12",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p5",
    "annotator": "索隱",
    "text": "按：張勃，晉人，吳鴻臚嚴之子也，作吳錄，裴氏注引之是也。溧音栗，水名也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a13",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p6",
    "annotator": "索隱",
    "text": "二邑，楚縣也。按：鍾離縣在六安，古鍾離子之國，系本謂之「終犂」，嬴姓之國。居巢亦國也。桀奔南巢，其國蓋遠。尚書序「巢伯來朝」，蓋因居之於淮南楚地也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a14",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p6",
    "annotator": "索隱",
    "text": "左傳謂之「專設諸」。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a15",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p8",
    "annotator": "集解",
    "text": "徐廣曰：「伯州犂者，晉伯宗之子也。伯州犂之子曰郤宛，郤宛之子曰伯嚭。宛亦姓伯，又別氏郤。楚世家云殺郤宛，宛之宗姓伯氏子曰嚭。吳世家云楚誅伯州犂，其孫伯嚭奔吳也。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a16",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p8",
    "annotator": "索隱",
    "text": "公子燭庸及蓋餘也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a17",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "集解",
    "text": "六，古國，臯陶之後所封。灊縣有天柱山。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a18",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "索隱",
    "text": "六，古國也，臯陶之後所封。灊縣有天柱山。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a19",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "集解",
    "text": "案：左傳楚公子貞字子囊，其孫名瓦，字子常。此言公子，又兼稱囊瓦，誤也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a20",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "索隱",
    "text": "按：左氏楚公子貞字子囊，其孫名瓦，字子常。此言公子，又兼稱囊瓦，蓋誤。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a21",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "集解",
    "text": "豫章在江南。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a22",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p9",
    "annotator": "索隱",
    "text": "按：杜預云「昔豫章在江北，蓋分後徙之於江南也」。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a23",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p10",
    "annotator": "索隱",
    "text": "概音古賚反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a24",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p10",
    "annotator": "集解",
    "text": "子常，公孫瓦。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a25",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p10",
    "annotator": "索隱",
    "text": "公孫瓦也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a26",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p10",
    "annotator": "集解",
    "text": "郢，楚都。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a27",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p10",
    "annotator": "索隱",
    "text": "郢，楚都也。音以正反，又一音以井反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a28",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p11",
    "annotator": "集解",
    "text": "音云，國名。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a29",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p11",
    "annotator": "索隱",
    "text": "奏雲二音。走，向也。鄖，國名。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a30",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p11",
    "annotator": "正義",
    "text": "今有楚昭王故城，昭王奔隨之處，宮之北城即是。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a31",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "正義",
    "text": "申包胥言聞人衆者雖一時凶暴勝天，及天降其凶，亦破於彊暴之人。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a32",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "索隱",
    "text": "按倒音丁老反。施音如字。子胥言志在復讎，常恐且死，不遂本心，今幸而報，豈論理乎！譬如人行，前途尚遠，而日勢已莫，其在顛倒疾行，逆理施事，何得責吾順理乎！"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a33",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "集解",
    "text": "稷丘，地名，在郊外。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a34",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "索隱",
    "text": "按左傳作「稷丘」。杜預云「稷丘，地名，在郊外」。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a35",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "集解",
    "text": "徐廣曰：「在慎縣。」駰案：地理志汝南有吳房縣。應劭曰「夫概奔楚，封於堂谿，本房子國，以封吳，故曰吳房」，然則不得在慎縣也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a36",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p12",
    "annotator": "正義",
    "text": "案今豫州吳房縣在州西北九十里。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a37",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p13",
    "annotator": "集解",
    "text": "音普寒反，又音婆。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a38",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p13",
    "annotator": "索隱",
    "text": "音普寒反，又音婆。蓋鄱陽也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a39",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p13",
    "annotator": "集解",
    "text": "楚地，音若。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a40",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p13",
    "annotator": "索隱",
    "text": "音若。鄀，楚地，今闕。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a41",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "正義",
    "text": "姑蘇當作「檇李」，乃文誤也。左傳云「戰檇李，傷將指，卒於陘」是也。解在吳世家。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a42",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "集解",
    "text": "楚良反。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a43",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "集解",
    "text": "音椒。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a44",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "索隱",
    "text": "音椒，又如字。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a45",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "正義",
    "text": "太湖中椒山也。解在吳世家。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a46",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "正義",
    "text": "土地名，在越州會稽縣東南十二里。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a47",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "索隱",
    "text": "劉氏云「大夫姓，種名」，非也。按：今吳南有文種埭，則種姓文，爲大夫官也。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a48",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p15",
    "annotator": "正義",
    "text": "高誘云：「大夫種，姓文氏，字子禽，楚之郢人。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a49",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p16",
    "annotator": "正義",
    "text": "括地志云：「艾山在兗州博城縣南百六十里，本齊博邑。」"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a50",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
    "target_para_id": "text:shiji:shiji-伍子胥列傳第六:p16",
    "annotator": "正義",
    "text": "鄒君居兗州鄒縣。魯，曲阜縣。"
  },
  {
    "id": "anno:shiji:shiji-伍子胥列傳第六:a51",
    "book": "shiji",
    "chapter_id": "shiji-伍子胥列傳第六",
