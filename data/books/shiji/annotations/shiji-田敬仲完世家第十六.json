[
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a0",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p0",
    "annotator": "索隱",
    "text": "他音徒何反。此系家以他爲厲公，而左傳厲公名躍，陳系家又有利公躍，利即厲也，是厲公名躍。蓋他是厲公之兄，立未踰年，無謚。今此云「厲公他」，非也。他一名五父，故經云「蔡人殺陳他」，傳又云「蔡人殺五父」是也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a1",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p0",
    "annotator": "正義",
    "text": "杜預云：「姜姓之先，爲堯四嶽也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a2",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p0",
    "annotator": "正義",
    "text": "陳湣公，周敬王四十一年爲楚惠王滅。齊簡公，周敬王三十九年被田常所殺。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a3",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p2",
    "annotator": "正義",
    "text": "工巧之長，若將作大匠。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a4",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p3",
    "annotator": "索隱",
    "text": "系本作「夷孟思」。蓋穉是名，孟夷字也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a5",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p3",
    "annotator": "集解",
    "text": "徐廣曰：「應劭云始食菜地於田，由是改姓田氏。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a6",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p3",
    "annotator": "索隱",
    "text": "據如此云，敬仲奔齊，以陳田二字聲相近，遂以爲田氏。應劭云「始食菜於田」，則田是地名，未詳其處。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a7",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p3",
    "annotator": "正義",
    "text": "案：敬仲旣奔齊，不欲稱本國故號，故改陳字爲田氏。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a8",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p4",
    "annotator": "集解",
    "text": "徐廣曰：「一作『芷』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a9",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p4",
    "annotator": "索隱",
    "text": "系本作「閩孟克」。芷，昌改反。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a10",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p5",
    "annotator": "索隱",
    "text": "音盈。史記多作「逞」字。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a11",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p7",
    "annotator": "正義",
    "text": "釐音僖。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a12",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p9",
    "annotator": "集解",
    "text": "徐廣曰：「一作『粥子』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a13",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p9",
    "annotator": "索隱",
    "text": "音舒。又如字。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a14",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p9",
    "annotator": "索隱",
    "text": "名夏。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a15",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p9",
    "annotator": "索隱",
    "text": "名張。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a16",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p10",
    "annotator": "索隱",
    "text": "橐音託。橐中謂皮橐之中。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a17",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p10",
    "annotator": "正義",
    "text": "音臺，又音台。賈逵云：「齊地也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a18",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p12",
    "annotator": "集解",
    "text": "監，一作「闞」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a19",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p12",
    "annotator": "索隱",
    "text": "上音如字，又音苦濫反。監，姓也。名止。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a20",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p12",
    "annotator": "索隱",
    "text": "言嫗之采芑菜皆歸入於田成子，以刺齊國之政將歸陳。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a21",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p12",
    "annotator": "索隱",
    "text": "御，官也；鞅，名也。亦田氏之族。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a22",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p13",
    "annotator": "索隱",
    "text": "案：齊系家云「子我夕」，賈逵云「即監止也」。尋其文意，當是監止。今云「宗人」，蓋太史誤也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a23",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p13",
    "annotator": "正義",
    "text": "在青州臨淄縣東北一里。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a24",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p13",
    "annotator": "索隱",
    "text": "需音須。需者，疑也。疑必致難，故云事之賊也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a25",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p14",
    "annotator": "索隱",
    "text": "徐音舒。徐州，齊邑，薛縣是也，非九州之徐。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a26",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p14",
    "annotator": "正義",
    "text": "齊之西北界上地名，在勃海郡東平縣也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a27",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p16",
    "annotator": "集解",
    "text": "徐廣曰：「安平在北海。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a28",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p16",
    "annotator": "索隱",
    "text": "案：司馬彪郡國志「北海東安平，六國時曰安平」，則徐廣云在北海是。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a29",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p16",
    "annotator": "正義",
    "text": "括地志云：「安平城在青州臨淄縣東十九里，古紀國之酅邑。」青州即北海郡也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a30",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p16",
    "annotator": "正義",
    "text": "琅邪，沂州也。從安平已東，萊、登、沂、密等州皆自爲田常封邑也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a31",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p17",
    "annotator": "索隱",
    "text": "案：鮑昱云「陳成子有數十婦，生男百餘人」，與此亦異。然譙允南案春秋，陳恆爲人，雖志大負殺君之名，至於行事亦脩整，故能自保，固非苟爲禽獸之行。夫成事在德，雖有姦子七十，祇以長亂，事豈然哉？言其非實也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a32",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p18",
    "annotator": "集解",
    "text": "徐廣曰：「盤，一作『塈』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a33",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p18",
    "annotator": "索隱",
    "text": "徐廣云一作「塈」。音許旣反。系本作「班」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a34",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p19",
    "annotator": "集解",
    "text": "徐廣曰：「宣公之三年時也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a35",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p20",
    "annotator": "索隱",
    "text": "系本名伯。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a36",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p20",
    "annotator": "正義",
    "text": "括地志云：「故黃城在魏州冠氏縣南十里。陽狐郭在魏州元城縣東北三十二里也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a37",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p20",
    "annotator": "正義",
    "text": "括地志云：「故魯城在許昌縣南四十里，本魯朝宿邑。長葛故城在許州長葛縣北十三里，鄭之葛邑也。鄢陵故城在許州鄢陵縣西北十五里。李奇云六國時爲安陵也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a38",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p21",
    "annotator": "索隱",
    "text": "案：紀年「齊宣公十五年，田莊子卒。明年，立田悼子。悼子卒，乃次立田和」。是莊子後有悼子。蓋立年無幾，所以作系本及記史者不得錄也。而莊周及鬼谷子亦云「田成子殺齊君，十二代而有齊國」。今據系本、系家，自成子至王建之滅，唯祇十代；若如紀年，則悼子及侯剡即有十二代，乃與莊子、鬼谷說同，明紀年亦非妄。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a39",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p21",
    "annotator": "正義",
    "text": "音城。括地志云：「故郕城在兗州泗水縣西北五十里。說文云『郕，魯孟氏邑』是也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a40",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p21",
    "annotator": "索隱",
    "text": "毌音貫，古國名，衞之邑。今作「毌」者，字殘缺耳。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a41",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p21",
    "annotator": "正義",
    "text": "括地志云：「故貫城即古貫國，今名蒙澤城，在曹州濟陰縣南五十六里也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a42",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p21",
    "annotator": "索隱",
    "text": "紀年「宣公五十一年，公孫會以廩丘叛於趙。十二月，宣公薨」。於周正爲明年二月。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a43",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p22",
    "annotator": "集解",
    "text": "徐廣曰：「十一年，伐魯，取最。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a44",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p22",
    "annotator": "索隱",
    "text": "貸音土代反。最音祖外反。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a45",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p22",
    "annotator": "集解",
    "text": "徐廣曰東平平陸。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a46",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p22",
    "annotator": "正義",
    "text": "兗州縣也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a47",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p23",
    "annotator": "集解",
    "text": "徐廣曰：「康公之十六年。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a48",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p23",
    "annotator": "索隱",
    "text": "徐廣云「康公十六年」，蓋依年表爲說，而不省此上文「貸立十四年」，又云「明年會平陸」，「又三年會濁澤」，則是十八年，表及此注並誤也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a49",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "集解",
    "text": "徐廣曰：「伐魯，破之。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a50",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "索隱",
    "text": "紀年「齊康公五年，田侯午生。二十二年，田侯剡立。後十年，齊田午弒其君及孺子喜而爲公」。春秋後傳亦云「田午弒田侯及其孺子喜而兼齊，是爲桓侯」。與此系家不同也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a51",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "索隱",
    "text": "謂騶忌、段干朋。如戰國策威王二十六年邯鄲之役有此謀臣耳。又南梁之難在宣王二年，有騶子、田忌、孫臏之謀。戰國策又有張田。其辭前後交互，是記史者所取各異，故不同耳。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a52",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "索隱",
    "text": "段干，姓；朋，名也。戰國策作「段干綸」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a53",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "索隱",
    "text": "戰國策作「田期思」，紀年謂之徐州子期，蓋即田忌也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a54",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p24",
    "annotator": "正義",
    "text": "括地志云：「桑丘故城俗名敬城，在易州遂城縣。」爾時齊伐燕桑丘，魏、趙來救之。魏、趙世家並云「伐齊至桑丘」，皆是易州。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a55",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p25",
    "annotator": "索隱",
    "text": "案紀年，梁惠王十二年當齊桓公十八年，後威王始見，則桓公十九年而卒，與此不同。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a56",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p26",
    "annotator": "正義",
    "text": "靈丘，河東蔚州縣。案：靈丘此時屬齊，三晉因喪伐之。韓、魏、趙世家云「伐齊至靈丘」，皆是蔚州。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a57",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p26",
    "annotator": "集解",
    "text": "徐廣曰：「在鉅平。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a58",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p26",
    "annotator": "正義",
    "text": "括地志云：「魯陽關故城在兗州博城縣南二十九里，西臨汶水也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a59",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p26",
    "annotator": "正義",
    "text": "在濟州西界也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a60",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p26",
    "annotator": "正義",
    "text": "音絹。即濮州甄城縣也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a61",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p27",
    "annotator": "正義",
    "text": "萊州膠水縣南六十里即墨故城是也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a62",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p28",
    "annotator": "集解",
    "text": "琴操曰：「大弦者，君也，寬和而溫。小弦者，臣也，清廉而不亂。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a63",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p28",
    "annotator": "索隱",
    "text": "大弦濁以溫者君也。案：春秋後語「溫」字作「春」，春氣溫，義亦相通也。蔡邕曰：「凡弦以緩急爲清濁。琴，緊其弦則清，縵其弦則濁。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a64",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p28",
    "annotator": "集解",
    "text": "徐廣曰：「以爪持弦也。攫音己足反。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a65",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p28",
    "annotator": "集解",
    "text": "徐廣曰：「一作『舒』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a66",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p28",
    "annotator": "索隱",
    "text": "醳音釋，與下文舍字並同。愉音舒也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a67",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "案：得全，謂人臣事君之禮全具無失，故云得全也。全昌者，謂若無失則身名獲昌，故云全昌也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a68",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "謂佩服此言，常無離心目之前。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a69",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "狶膏，豬脂也。棘軸，以棘木爲車軸，至滑而堅也。然而穿孔若方，則不能運轉，言逆理反經也。故下忌曰「請謹事左右」，言每事須順從。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a70",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "集解",
    "text": "徐廣曰：「一作『乾』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a71",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "音孤捍反。昔，久舊也。幹，弓幹也。徐廣又曰一作「乾」。考工記作「㭊幹」，則㭊昔音相近。言作弓之法，以膠被昔幹而納諸檠中，則是以勢令合耳。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a72",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "傅音附。罅音五嫁反。以言膠幹可以勢暫合，而久亦不能常傅合於疏罅隙縫。以言人臣自宜彌縫得所，豈待拘以禮制法式哉。故下云「請自附於萬人」是也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a73",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "索隱",
    "text": "較者，校量也。言有常制，若大車不較，則車不能載常任，琴不能成五音也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a74",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p29",
    "annotator": "集解",
    "text": "新序曰：「齊稷下先生喜議政事。騶忌旣爲齊相，稷下先生淳于髠之屬七十二人皆輕騶忌，以爲設以微辭，騶忌必不能及，乃相與俱往見騶忌。淳于髠之徒禮倨，騶忌之禮卑。淳于髠等稱辭，騶忌知之如應響，淳于髡等辭詘而去，騶忌之禮倨，淳于髠之禮卑。故所以尚干將、莫邪者，貴其立斷也。所以尚騏驥者，爲其立至也。必且歷日曠久，則系氂能挈石，駑馬亦能致逺。是以聦明捷敏，人之美材也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a75",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p30",
    "annotator": "索隱",
    "text": "案：韓嬰詩外傳以爲齊宣王，其說異也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a76",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p30",
    "annotator": "索隱",
    "text": "檀子，齊臣。檀，姓；子，美稱，大夫皆稱子。肦子，田肦也。黔夫及種首皆臣名。事悉具戰國策也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a77",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p30",
    "annotator": "索隱",
    "text": "邾、莒、宋、魯之比。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a78",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p30",
    "annotator": "集解",
    "text": "賈逵曰：「齊之北門西門也。言燕、趙之人畏見侵伐，故祭以求福。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a79",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p31",
    "annotator": "正義",
    "text": "襄陵故城在兗州鄒縣也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a80",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p32",
    "annotator": "索隱",
    "text": "戰國策作「公孫閎」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a81",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p32",
    "annotator": "索隱",
    "text": "在威王二十六年。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a82",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p32",
    "annotator": "正義",
    "text": "在曹州乘氏縣東北二十一里。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a83",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p33",
    "annotator": "集解",
    "text": "徐廣曰：「一作『夫人』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a84",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p33",
    "annotator": "索隱",
    "text": "牟辛，大夫姓字也。徐廣曰一作「夫人」。案：年表亦作「夫人」。王劭案紀年云「齊桓公十一年殺其君母。宣王八年殺王后」。然則夫人之字，或如紀年之說。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a85",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p34",
    "annotator": "索隱",
    "text": "案：戰國策田忌前敗魏於馬陵，因被構，不得入齊，非是居齊歷十年乃出奔也。是時齊都臨淄，且孟嘗列傳云「田忌襲齊之邊邑」，其言爲得，即與系家不同也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a86",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "索隱",
    "text": "晉太康地記曰：「戰國謂梁爲南梁者，別之於大梁、少梁也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a87",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "正義",
    "text": "括地志云：「故梁在汝州西南二百步。晉太康地記云『戰國時謂南梁者，別之於大梁、少梁也』。古蠻子邑也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a88",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "索隱",
    "text": "案：紀年威王十四年，田朌伐梁，戰馬陵。戰國策南梁之難，有張田對曰「蚤救之」。此云鄒忌者，王劭云「此時鄒忌死已四年，又齊威時未稱王，故戰國策謂之田侯。今此以田侯爲宣王，又橫稱鄒忌，皆謬矣」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a89",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "索隱",
    "text": "孫臏也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a90",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "集解",
    "text": "徐廣曰：「嬰，一作『肦』。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a91",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "索隱",
    "text": "在宣王二年"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a92",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "正義",
    "text": "括地志云：「博望故城在鄧州向城縣東南四十五里。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a93",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p37",
    "annotator": "集解",
    "text": "徐廣曰：「表曰三年，與趙會博望伐魏。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a94",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p38",
    "annotator": "正義",
    "text": "沛郡平阿縣也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a95",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p38",
    "annotator": "索隱",
    "text": "明年，梁惠王卒。案紀年，梁惠王乃是齊湣王爲東帝，秦昭王爲西帝時。此時梁惠王改元稱一年，未卒也。而系家以其後即爲魏襄王之年，又以此文當齊宣王時，實所不能詳考。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a96",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "正義",
    "text": "贅聓，齊之稷下先生也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a97",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "正義",
    "text": "白眠反。藝文志云田駢，齊人，遊稷下，號天口駢，作田子二十五篇也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a98",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "正義",
    "text": "齊人。藝文志云接予二篇，在道家流。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a99",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "正義",
    "text": "趙人，戰國時處士。藝文志作慎子四十二篇也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a100",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "正義",
    "text": "楚人。孟子傳云環淵著書上下篇也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a101",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "集解",
    "text": "劉向別錄曰：「齊有稷門，城門也。談說之士期會於稷下也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a102",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p39",
    "annotator": "索隱",
    "text": "劉向別錄曰「齊有稷門，齊城門也。談說之士期會於其下」。齊地記曰「齊城西門側，系水左右有講室，趾往往存焉」。蓋因側系水出，故曰稷門，古側稷音相近耳。又虞喜曰「齊有稷山，立館其下以待游士」，亦異說也。春秋傳曰「莒子如齊，盟于稷門」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a103",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p40",
    "annotator": "索隱",
    "text": "系本名遂。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a104",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "集解",
    "text": "徐廣曰：「在陽翟，屬韓。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a105",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "集解",
    "text": "徐廣曰：「韓之公仲侈也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a106",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "集解",
    "text": "徐廣曰：「在濟陰宛朐。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a107",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "能猶勝也。言不勝其拔，故聽齊拔之耳。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a108",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "逐，隨也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a109",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "集解",
    "text": "徐廣曰：「音專。專猶并合制領之謂也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a110",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "摶音團，團謂握領也。徐作「專」，亦通。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a111",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "正義",
    "text": "屈丐，楚將，爲秦所敗，今更欲乘之。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a112",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "韓也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a113",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "公謂陳軫。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a114",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "正義",
    "text": "施，張設也。言秦王於天子都張設迫脅也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a115",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "集解",
    "text": "徐廣曰：「楚王欲得魏來事己，而不欲與韓地也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a116",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "正義",
    "text": "蘇代謂陳軫，今秦韓之兵不戰伐而得地，陳軫於秦韓豈不有大恩德。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a117",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "索隱",
    "text": "券，要也。左，不正也。言我以右執其左而責之。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a118",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p42",
    "annotator": "正義",
    "text": "左券下，右券上也。蘇代說陳軫以上券令秦韓不用兵得地，而以券責秦韓卻韓馮、張儀以徇服魏，故秦韓善陳軫而惡張儀多取矣。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a119",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p43",
    "annotator": "集解",
    "text": "徐廣曰：「表曰與秦擊楚，使公子將，大有功。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a120",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p43",
    "annotator": "集解",
    "text": "徐廣曰：「孟嘗君爲相。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a121",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p43",
    "annotator": "集解",
    "text": "徐廣曰：「三十年，田甲劫王，相薛文走。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a122",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "集解",
    "text": "左思齊都賦注曰：「齊小城北門也。」而此言東門，不知爲是一門非邪？"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a123",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "正義",
    "text": "括地志云：「齊城章華之東有閭門、武鹿門也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a124",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "集解",
    "text": "宋世家云：「宋王偃，諸侯皆曰桀宋也。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a125",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "集解",
    "text": "陽地，濮陽之地。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a126",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "正義",
    "text": "案：衞此時河南獨有濮陽也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a127",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "正義",
    "text": "阿，東阿也。爾時屬趙，故云東國危。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a128",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "正義",
    "text": "淮北，徐、泗也。東國謂下相、僮、取慮也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a129",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p44",
    "annotator": "正義",
    "text": "陶，定陶，今曹州也。平陸，兗州縣也，縣在大梁東界。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a130",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p45",
    "annotator": "正義",
    "text": "括地志云：「新城故城在宋州宋城縣界。陽晉故城在曹州乘氏縣西北三十七里。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a131",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p45",
    "annotator": "正義",
    "text": "年表云秦昭王二十一年，魏納安邑及河內。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a132",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p45",
    "annotator": "索隱",
    "text": "戰國策作「宋地不安」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a133",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p45",
    "annotator": "索隱",
    "text": "軼音姪。軼者，車轍也，言車轍往還如結也。戰國策作「結靷」。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a134",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p45",
    "annotator": "正義",
    "text": "懷州有溫城。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a135",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p47",
    "annotator": "集解",
    "text": "徐廣曰：「案其餘諸傳無楚伐齊事。年表云楚取淮北。」"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a136",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p47",
    "annotator": "索隱",
    "text": "淖音女教反。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a137",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p47",
    "annotator": "正義",
    "text": "鹵掠齊寶器也。"
  },
  {
    "id": "anno:shiji:shiji-田敬仲完世家第十六:a138",
    "book": "shiji",
    "chapter_id": "shiji-田敬仲完世家第十六",
    "target_para_id": "text:shiji:shiji-田敬仲完世家第十六:p48",
    "annotator": "集解",
