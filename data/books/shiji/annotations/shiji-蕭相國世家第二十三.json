[
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a0",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p0",
    "annotator": "索隱",
    "text": "按春秋緯「蕭何感昴精而生，典獄制律」。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a1",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p0",
    "annotator": "集解",
    "text": "漢書音義曰：「文無害，有文無所枉害也。律有無害都吏，如今言公平吏。一曰，無害者如言『無比』，陳留閒語也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a2",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p0",
    "annotator": "索隱",
    "text": "按：裴注已列數家，今更引二說。應劭云「雖爲文吏，而不刻害也」。韋昭云「爲有文理，無傷害也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a3",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p0",
    "annotator": "索隱",
    "text": "漢書云「何爲主吏」。主吏，功曹也。又云「何爲沛掾」，是何爲功曹掾也。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a4",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p1",
    "annotator": "索隱",
    "text": "說文云：「護，救視也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a5",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p1",
    "annotator": "集解",
    "text": "李奇曰：「或三百，或五百也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a6",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p1",
    "annotator": "索隱",
    "text": "奉音扶用反。謂資俸之。如字讀，謂奉送之也。錢三百，謂他人三百，何獨五百也。劉氏云：「時有重者一當百，故有送錢三者。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a7",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p2",
    "annotator": "集解",
    "text": "張晏曰：「何與共事修辨明，何素有方略也。」蘇林曰：「辟何與從事也。秦時無刺史，以御史監郡。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a8",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p2",
    "annotator": "索隱",
    "text": "按：何與御史從事常辨明，言稱職也。故張晏曰「何與共事修辨明，何素有方略」是也。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a9",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p2",
    "annotator": "集解",
    "text": "徐廣曰：「沛縣有泗水亭。又秦以沛爲泗水郡。」駰按：文穎曰「何爲泗水郡卒史」。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a10",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p2",
    "annotator": "索隱",
    "text": "如淳按：律，郡卒史書佐各十人也。卒，祖忽反。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a11",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p2",
    "annotator": "索隱",
    "text": "按：謂課最居第一也。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a12",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p3",
    "annotator": "索隱",
    "text": "謂高祖起沛，令何爲丞，常監督庶事也。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a13",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p3",
    "annotator": "索隱",
    "text": "音奏。奏者，趨向之。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a14",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p4",
    "annotator": "集解",
    "text": "應劭曰：「上來還，乃以所爲聞之。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a15",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p4",
    "annotator": "索隱",
    "text": "轉，劉氏音張戀反。漕，水運。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a16",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p6",
    "annotator": "集解",
    "text": "文穎曰：「音贊。」瓚曰：「今南鄉酇縣也。孫檢曰『有二縣，音字多亂。其屬沛郡者音嵯，屬南陽者音讚』。按茂陵書，蕭何國在南陽，宜呼讚。今多呼嵯，嵯舊字作『䣜』，今皆作『酇』，所由亂也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a17",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p6",
    "annotator": "索隱",
    "text": "鄒氏云：「屬沛郡音嵯，屬南陽音贊。」又臣瓚按茂陵書：「蕭何國在南陽，則字當音贊，今多呼爲嵯也。」注：「瓚曰今南鄉酇縣。」顧氏云：「南鄉，郡名也。太康地理志云『魏武帝建安中分南陽立南鄉郡，晉武帝又曰順陽郡也』。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a18",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p7",
    "annotator": "集解",
    "text": "應劭曰：「橈，屈也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a19",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p7",
    "annotator": "索隱",
    "text": "音女教反。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a20",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p7",
    "annotator": "索隱",
    "text": "按功臣表，鄂君即鄂千秋，封安平侯。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a21",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p8",
    "annotator": "集解",
    "text": "徐廣曰：「以謁者從定諸侯有功，秩舉蕭何功，故因侯二千戶。封九年卒。至玄孫但，坐與淮南王安通，弃市，國除。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a22",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p8",
    "annotator": "正義",
    "text": "括地志云：「澤州安平縣，本漢安平縣。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a23",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p8",
    "annotator": "索隱",
    "text": "謂人皆三，何獨五，所以爲贏二也。音盈。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a24",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p10",
    "annotator": "正義",
    "text": "貰音世。又食夜反，賒也。下天得反。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a25",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p11",
    "annotator": "索隱",
    "text": "謂相國取人田宅以爲利，故云「乃利人」也。所以令相國自謝之。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a26",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p11",
    "annotator": "索隱",
    "text": "苗子還種田人，留稿入官。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a27",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p11",
    "annotator": "集解",
    "text": "如淳曰：「百官公卿表衞尉王氏，無名字。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a28",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p11",
    "annotator": "索隱",
    "text": "按：上文李斯歸惡而自予，是分過。"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a29",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p11",
    "annotator": "集解",
    "text": "韋昭曰：「用意淺。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a30",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p14",
    "annotator": "集解",
    "text": "東觀漢記云：「蕭何墓在長陵東司馬門道北百步。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a31",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p14",
    "annotator": "正義",
    "text": "括地志云：「蕭何墓在雍州咸陽縣東北三十七里。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a32",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p14",
    "annotator": "集解",
    "text": "徐廣曰：「功臣表蕭何以客初起從也。」"
  },
  {
    "id": "anno:shiji:shiji-蕭相國世家第二十三:a33",
    "book": "shiji",
    "chapter_id": "shiji-蕭相國世家第二十三",
    "target_para_id": "text:shiji:shiji-蕭相國世家第二十三:p16",
    "annotator": "索隱",
    "text": "錄音祿。"
  }
]