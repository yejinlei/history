    "concepts": [
      {
        "id": "C001",
        "name": "太岁纪年",
        "note": "以岁星运行对应十二辰的纪年法，柔兆执徐为丙辰，著雍敦牂为戊午，本卷起丙辰尽戊午凡三年。",
        "evidence": [
          "p1"
        ]
      },
      {
        "id": "C002",
        "name": "洪范五行鼓妖",
        "note": "《洪范五行传》所载灾异之一，听之不聪则生鼓妖，有声无形，李寻据以对殿中钟鸣之异。",
        "evidence": [
          "p8"
        ]
      },
      {
        "id": "C003",
        "name": "包元太平经",
        "note": "甘忠可伪造之书，凡十二卷，言汉家逢天地之大终当更受命于天，为西汉末年再受命说之始。",
        "evidence": [
          "p15"
        ]
      },
      {
        "id": "C004",
        "name": "更受命",
        "note": "谓天命转移、汉当再受命，夏贺良等据此请改元易号，哀帝一度从之改元太初、号陈圣刘太平皇帝。",
        "evidence": [
          "p15",
          "p17"
        ]
      },
      {
        "id": "C005",
        "name": "漏刻",
        "note": "计时之器，昼夜共百刻；夏贺良等建言增益漏刻，以百二十为度。",
        "evidence": [
          "p15"
        ]
      },
      {
        "id": "C006",
        "name": "初陵",
        "note": "帝王生前预营之陵，哀帝以渭城西北原上永陵亭部为初陵。",
        "evidence": [
          "p16"
        ]
      },
      {
        "id": "C007",
        "name": "御史大夫",
        "note": "秦汉三公之一、副丞相，成帝绥和元年罢置大司空，建平二年朱博奏复置，位次有序，为中二千石升丞相之阶。",
        "evidence": [
          "p5"
        ]
      },
      {
        "id": "C009",
        "name": "行西王母筹",
        "note": "建平四年关东民无故惊走，持稾或掫一枚转相付与，曰行西王母筹，经郡国二十六至京师，为西汉末年著名民变征象。",
        "evidence": [
          "p34"
        ]
      },
      {
        "id": "C010",
        "name": "断袖",
        "note": "哀帝与董贤昼寝，贤偏藉帝袖，帝欲起而不欲动贤，乃断袖而起，为后世男宠典故。",
        "evidence": [
          "p36"
        ]
      },
      {
        "id": "C011",
        "name": "东园秘器",
        "note": "少府东园署所作御用棺器，哀帝豫以赐董贤。",
        "evidence": [
          "p36"
        ]
      },
      {
        "id": "C012",
        "name": "珠襦玉匣",
        "note": "汉代高级殓服，以珠为襦、以玉为匣（玉衣），哀帝豫赐董贤。",
        "evidence": [
          "p36"
        ]
      },
      {
        "id": "C013",
        "name": "题凑",
        "note": "以柏木黄心累叠棺外、木皆内向的葬制，与便房并为天子诸侯之制，哀帝为董贤冢设之。",
        "evidence": [
          "p36"
        ]
      },
      {
        "id": "C015",
        "name": "尸鸠之诗",
        "note": "《诗经·曹风·尸鸠》，言尸鸠养子平均如一，喻人君布德施惠当均平；鲍宣引之以谏哀帝独厚外亲幸臣。",
        "evidence": [
          "p47"
        ]
      },
      {
        "id": "C016",
        "name": "上兵伐谋",
        "note": "《孙子》语，谓以谋略挫敌为上；息夫躬引之，建言令胡诈为卑爰疐使者上书以间匈奴。",
        "evidence": [
          "p53"
        ]
      },
      {
        "id": "C018",
        "name": "素餐",
        "note": "尸位素餐，谓居位食禄而不尽职，平当自言居大位已负素餐之责。",
        "evidence": [
          "p26"
        ]
      },
      {
        "id": "C019",
        "name": "逆诈",
        "note": "谓敌之诈谋未见而先迎测其情，公孙禄讥息夫躬逆诈、进不信之谋。",
        "evidence": [
          "p54"
        ]
      },
      {
        "id": "C022",
        "name": "诏狱",
        "note": "奉诏系治之狱，朱博等获罪请召诣廷尉诏狱。",
        "evidence": [
          "p19"
        ]
      }
