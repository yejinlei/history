    "events": [
      {
        "id": "E001",
        "name": "罢大司空复置御史大夫",
        "note": "建平二年，以议者言古今异制，朱博奏罢大司空、复置御史大夫，四月戊午更拜朱博为御史大夫，又以丁明为大司马卫将军。",
        "evidence": [
          "p5"
        ]
      },
      {
        "id": "E002",
        "name": "鼓妖殿中钟鸣",
        "note": "朱博、赵玄拜官受策时殿中有大声如钟鸣，李寻以为洪范所谓鼓妖，扬雄以为听失之象、朱博宜将不宜相。",
        "evidence": [
          "p7",
          "p8"
        ]
      },
      {
        "id": "E004",
        "name": "奏免师丹复封高昌侯",
        "note": "丞相朱博、御史大夫赵玄奏高昌侯宏首建尊号之议而复兴、师丹妄称说抑贬尊号，请免丹为庶人，奏可。",
        "evidence": [
          "p10"
        ]
      },
      {
        "id": "E005",
        "name": "王莽遣就国",
        "note": "朱博等奏新都侯王莽前为大司马抑贬尊号，请免为庶人；哀帝以其与太皇太后有属，勿免，遣就国。平阿侯仁藏匿赵昭仪亲属，亦遣就国。",
        "evidence": [
          "p11"
        ]
      },
      {
        "id": "E008",
        "name": "帝太后丁氏崩",
        "note": "建平二年六月庚申，帝太后丁氏崩，诏归葬定陶共皇之园，发陈留、济阴近郡国五万人穿复土。",
        "evidence": [
          "p14"
        ]
      },
      {
        "id": "E010",
        "name": "夏贺良等伏诛李寻解光徙敦煌",
        "note": "改号月余哀帝病如故，贺良等又欲变政事，帝以其言无验，八月诏贺良等反道惑众下狱伏诛，李寻、解光减死一等徙敦煌郡。",
        "evidence": [
          "p17"
        ]
      },
      {
        "id": "E012",
        "name": "朱博奏免傅喜何武朱博自杀",
        "note": "傅太后怨傅喜不已，使孔乡侯傅晏风朱博奏免喜侯；博与赵玄并奏免傅喜、何武为庶人，帝疑其承指，召玄问状辞服，彭宣等奏劾博、玄、晏不道，博自杀国除。",
        "evidence": [
          "p19"
        ]
      },
      {
        "id": "E015",
        "name": "乌孙卑爰疐质匈奴",
        "note": "乌孙卑爰疐侵盗匈奴西界，单于击之，卑爰疐遣子趋逯为质匈奴，汉遣使责让单于归还质子，单于受诏遣归。",
        "evidence": [
          "p22"
        ]
      },
      {
        "id": "E016",
        "name": "刘广汉立为广平王",
        "note": "建平三年春正月，立广德夷王之弟刘广汉为广平王。",
        "evidence": [
          "p24"
        ]
      },
      {
        "id": "E017",
        "name": "桂宫正殿火",
        "note": "建平三年，帝太太后所居桂宫正殿火。",
        "evidence": [
          "p25"
        ]
      },
      {
        "id": "E018",
        "name": "平当不受侯印而薨",
        "note": "哀帝召丞相平当欲封之，当病笃不应，谓受侯印而死有负素餐，遂上书乞骸骨，三月己酉薨。",
        "evidence": [
          "p26"
        ]
      },
      {
        "id": "E019",
        "name": "王嘉为丞相上疏",
        "note": "建平三年夏四月丁酉，王嘉为丞相、王崇为御史大夫；王嘉以时政苛急上疏论择贤、勿责臣以备、宽待二千石。",
        "evidence": [
          "p28"
        ]
      },
      {
        "id": "E020",
        "name": "东平王云狱",
        "note": "无盐危山土自起、瓠山石转立，东平王云及后谒祭之；息夫躬、孙宠、右师谭因宋弘上变事告之，逮后谒下狱验治，云废徙房陵自杀，谒及伍宏、安成共侯夫人放皆弃市，王崇左迁大司农。",
        "evidence": [
          "p31"
        ]
      },
      {
        "id": "E021",
        "name": "傅商封汝昌侯",
        "note": "建平四年，哀帝欲封傅太后从父弟傅商，尚书仆射郑崇谏，傅太后大怒，二月癸卯竟下诏封商为汝昌侯。",
        "evidence": [
          "p35"
        ]
      },
      {
        "id": "E022",
        "name": "董贤宠幸断袖",
        "note": "董贤得幸于哀帝，出则参乘、入御左右，赏赐累巨万；尝昼寝偏藉上袖，帝不欲动贤乃断袖而起；召贤女弟为昭仪，父恭为少府，起大第北阙下，赐武库禁兵、东园秘器，冢茔义陵旁。",
        "evidence": [
          "p36"
        ]
      },
      {
        "id": "E024",
        "name": "董贤等封侯",
        "note": "哀帝欲侯董贤而未有缘，傅嘉劝定息夫躬、孙宠告东平本章，去宋弘、更言因董贤以闻；王嘉、贾延上封事谏，帝不得已且止；八月辛卯卒封董贤高安侯、孙宠方阳侯、息夫躬宜陵侯、右师谭关内侯，又封郑业阳信侯。",
        "evidence": [
          "p39",
          "p41"
        ]
      },
      {
        "id": "E025",
        "name": "毋将隆谏武库兵左迁",
        "note": "哀帝使中黄门发武库兵送董贤及乳母王阿舍，执金吾毋将隆奏请收还武库；傅太后贱买执金吾官婢，隆请更平直，帝诏责其与永信宫争贾，左迁沛郡都尉。",
        "evidence": [
          "p42",
          "p43"
        ]
      },
      {
        "id": "E026",
        "name": "鲍宣上书七亡七死",
        "note": "谏大夫鲍宣上书极言外亲持权、民有七亡七死，请罢退孙宠、息夫躬，征用傅喜、何武、师丹、孔光、彭宣，帝以宣名儒优容之。",
        "evidence": [
          "p44",
          "p45",
          "p46",
          "p47",
          "p48"
        ]
      },
      {
        "id": "E027",
        "name": "匈奴单于愿朝与扬雄上书",
        "note": "匈奴单于上书愿朝五年，时帝被疾，或言匈奴从上游来厌人；黄门郎扬雄上书力谏勿拒，天子感悟，召还使者更报单于书而许之，赐雄帛五十匹、黄金十斤。",
        "evidence": [
          "p49",
          "p50",
          "p51",
          "p52"
        ]
      }
