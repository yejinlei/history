    "name": "客卿",
    "alias": "",
    "note": "以他国之人任卿，范睢初以此位事秦。",
    "evidence": [
     "p14",
     "p18"
    ]
   },
   {
    "id": "C004",
    "name": "虎符",
    "alias": "",
    "note": "调兵之凭证，信陵君使如姬窃之。",
    "evidence": [
     "p55"
    ]
   },
   {
    "id": "C005",
    "name": "奇货可居",
    "alias": "",
    "note": "吕不韦视异人为可囤积之奇货。",
    "evidence": [
     "p63"
    ]
   },
   {
    "id": "C006",
    "name": "义不帝秦",
    "alias": "",
    "note": "鲁仲连宁蹈东海亦不尊秦为帝。",
    "evidence": [
     "p53"
    ]
   },
   {
    "id": "C007",
    "name": "五霸",
    "alias": "",
    "note": "春秋五霸，侯嬴以此期信陵君之功。",
    "evidence": [
     "p55"
    ]
   },
   {
    "id": "C008",
    "name": "汤沐邑",
    "alias": "",
    "note": "供住宿沐浴之封邑，赵以鄗为信陵君汤沐邑。",
    "evidence": [
     "p60"
    ]
   },
   {
    "id": "C009",
    "name": "处士",
    "alias": "",
    "note": "有才德而隐居不仕之人，赵有毛公、薛公。",
    "evidence": [
     "p60"
    ]
   },
   {
    "id": "C010",
    "name": "绨袍之赠",
    "alias": "",
    "note": "须贾赠范睢绨袍，故得不死。",
    "evidence": [
     "p23"
    ]
   },
   {
    "id": "C011",
    "name": "胶柱鼓瑟",
    "alias": "",
    "note": "喻拘泥不知变通，蔺相如以评赵括用兵。",
    "evidence": [
     "p43"
    ]
   },
   {
    "id": "C012",
    "name": "唇亡齿寒",
    "alias": "",
    "note": "喻利害相关，周子以论赵与齐楚。",
    "evidence": [
     "p44"
    ]
   },
   {
    "id": "C013",
    "name": "燕雀处屋",
    "alias": "",
    "note": "喻居安不知祸至，子顺以论魏之危。",
    "evidence": [
     "p48"
    ]
   },
   {
    "id": "C014",
    "name": "因人成事",
    "alias": "",
    "note": "谓依赖他人成事，毛遂以讥同行之十九人。",
    "evidence": [
     "p52"
    ]
   },
   {
    "id": "C015",
    "name": "脱颖而出",
    "alias": "",
    "note": "喻贤才终当显露，毛遂自喻。",
    "evidence": [
     "p52"
    ]
   },
   {
    "id": "C016",
    "name": "尸利素餐",
    "alias": "",
    "note": "谓白白享受俸禄而不尽职，子顺自谓。",
    "evidence": [
     "p48"
    ]
   },
   {
    "id": "C017",
    "name": "四贵",
    "alias": "",
    "note": "指穰侯、华阳君、泾阳君、高陵君，权倾于秦。",
    "evidence": [
     "p22"
    ]
   },
   {
    "id": "C018",
    "name": "上首功",
    "alias": "",
    "note": "秦制以斩敌首计功，鲁仲连斥秦弃礼义而上首功。",
    "evidence": [
     "p53"
    ]
   },
   {
    "id": "C019",
    "name": "歃血",
    "alias": "",
    "note": "盟誓之礼，毛遂奉铜盘请楚王歃血定从。",
    "evidence": [
     "p52"
    ]
   },
   {
    "id": "C020",
    "name": "嫡嗣",
    "alias": "",
    "note": "正妻所生之继承者，吕不韦谋立异人为适嗣。",
    "evidence": [
     "p63"
    ]
   },
   {
    "id": "C021",
    "name": "商贾",
    "alias": "",
    "note": "行商坐贾，鲁仲连谓有所取即为商贾之事。",
    "evidence": [
     "p61"
    ]
   },
   {
    "id": "C022",
    "name": "随坐",
    "alias": "",
    "note": "因连坐而受罚，赵括母请免随坐。",
    "evidence": [
     "p43"
    ]
   }
