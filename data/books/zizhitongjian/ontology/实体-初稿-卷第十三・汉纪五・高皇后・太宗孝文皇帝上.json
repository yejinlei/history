   },
   {
    "id": "E18",
    "name": "文帝分封",
    "alias": [],
    "note": "徙琅邪王泽为燕王，封赵幽王子遂为赵王；后又立宗室及诸子为王。",
    "evidence": [
     "p82",
     "p115"
    ]
   },
   {
    "id": "E19",
    "name": "除收帑相坐律",
    "alias": [],
    "note": "文帝诏废收捕罪人家属连坐之律令。",
    "evidence": [
     "p85"
    ]
   },
   {
    "id": "E20",
    "name": "议建太子",
    "alias": [],
    "note": "有司请蚤建太子，文帝谦让，有司固请，遂立长子启为太子。",
    "evidence": [
     "p86"
    ]
   },
   {
    "id": "E21",
    "name": "立窦皇后",
    "alias": [],
    "note": "立太子母窦氏为皇后，窦氏兄弟由微贱而显，绛、灌为之择师友。",
    "evidence": [
     "p87"
    ]
   },
   {
    "id": "E22",
    "name": "振贷恤困",
    "alias": [],
    "note": "诏振贷鳏寡孤独穷困，赐八十九十以上米肉帛絮，著为养老之政。",
    "evidence": [
     "p88"
    ]
   },
   {
    "id": "E23",
    "name": "开藉田亲耕",
    "alias": [],
    "note": "文帝感贾谊之言，诏开藉田，亲耕以率天下之民。",
    "evidence": [
     "p114"
    ]
   },
   {
    "id": "E24",
    "name": "废诽谤妖言令",
    "alias": [],
    "note": "诏除诽谤、妖言之罪，以开言路、来远方贤良。",
    "evidence": [
     "p116"
    ]
   },
   {
    "id": "E25",
    "name": "田租减半",
    "alias": [],
    "note": "诏赐天下民今年田租之半，为文帝轻徭薄赋之政。",
    "evidence": [
     "p117"
    ]
   },
   {
    "id": "E26",
    "name": "南越去帝号",
    "alias": [],
    "note": "文帝以书谕赵佗，佗顿首谢罪，去帝制、黄屋、左纛，长为藩臣。",
    "evidence": [
     "p95",
     "p96"
    ]
   }
