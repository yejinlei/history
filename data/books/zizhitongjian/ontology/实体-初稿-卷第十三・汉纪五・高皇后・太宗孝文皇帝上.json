  "concepts": [
   {
    "id": "C01",
    "name": "刑白马盟",
    "alias": [
     "白马之盟"
    ],
    "note": "高帝杀白马与群臣盟「非刘氏而王，天下共击之」，为诸吕封王合法性之争所本。",
    "evidence": [
     "p3"
    ]
   },
   {
    "id": "C02",
    "name": "将相和调",
    "alias": [],
    "note": "陆贾谓「天下安，注意相；天下危，注意将」，将相和睦则士豫附，权不分。",
    "evidence": [
     "p54"
    ]
   },
   {
    "id": "C03",
    "name": "左袒",
    "alias": [],
    "note": "太尉入北军令「为吕氏右袒，为刘氏左袒」，军中皆左袒，遂定诛诸吕之势。",
    "evidence": [
     "p71"
    ]
   },
   {
    "id": "C04",
    "name": "卖友",
    "alias": [],
    "note": "班固赞谓郦寄诳吕禄为卖友，然迫于父命、安社稷，其谊可存。",
    "evidence": [
     "p74"
    ]
   },
   {
    "id": "C05",
    "name": "磐石之宗",
    "alias": [],
    "note": "宋昌谓高帝封王子弟、犬牙相制，为磐石之宗，天下服其强。",
    "evidence": [
     "p76"
    ]
   },
   {
    "id": "C06",
    "name": "大横之兆",
    "alias": [],
    "note": "代王卜得大横之兆，占曰「大横庚庚，余为天王，夏启以光」，遂决意入立。",
    "evidence": [
     "p76"
    ]
   },
   {
    "id": "C07",
    "name": "收帑相坐",
    "alias": [],
    "note": "秦法一人有罪并坐其室家，文帝诏除收帑诸相坐律令。",
    "evidence": [
     "p85"
    ]
   },
   {
    "id": "C08",
    "name": "贤良方正",
    "alias": [],
    "note": "文帝诏举贤良、方正、能直言极谏者，汉代选举之始。",
    "evidence": [
     "p103"
    ]
   },
   {
    "id": "C09",
    "name": "进善之旌",
    "alias": [],
    "note": "古时朝设进善之旌，令民进善，文帝诏称之。",
    "evidence": [
     "p116"
    ]
   },
   {
    "id": "C10",
    "name": "诽谤之木",
    "alias": [],
    "note": "古时桥头立柱，使书政治缺失，文帝诏除诽谤妖言之罪。",
    "evidence": [
     "p116"
    ]
   },
   {
    "id": "C11",
    "name": "背本趋末",
    "alias": [],
    "note": "贾谊谓弃农本而事工商末业者众，为天下之大残。",
    "evidence": [
     "p110"
    ]
   },
   {
    "id": "C12",
    "name": "积贮",
    "alias": [],
    "note": "贾谊《论积贮疏》谓积贮为天下之大命，粟多财余则攻取守固战胜。",
    "evidence": [
     "p112"
    ]
   },
   {
    "id": "C13",
    "name": "藉田",
    "alias": [],
    "note": "天子亲耕之田，文帝开藉田亲耕以率天下务农。",
    "evidence": [
     "p114"
    ]
   },
   {
    "id": "C14",
    "name": "人彘",
    "alias": [],
    "note": "吕后残戚夫人为「人彘」，袁盎引以谏慎夫人之坐。",
    "evidence": [
     "p109"
    ]
   },
   {
    "id": "C15",
    "name": "千金之子坐不垂堂",
    "alias": [],
    "note": "袁盎引以谏文帝勿驰峻阪、勿乘危徼幸。",
    "evidence": [
     "p108"
    ]
   },
   {
    "id": "C16",
    "name": "尊卑有序",
    "alias": [],
    "note": "袁盎引「尊卑有序，则上下和」，以正慎夫人与皇后之坐次。",
    "evidence": [
     "p109"
    ]
   },
   {
    "id": "C17",
    "name": "三族罪",
    "alias": [],
